{
  "name": "matin-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site bilingue de Matin – Institut interculturel / Bilingual website for Matin – Intercultural Institute",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "images": "node scripts/optimize-images.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "translations": "node scripts/translations-report.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@lucide/astro": "^1.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "marked": "^18.0.14",
    "simple-icons": "^16.34.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^6.0.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
