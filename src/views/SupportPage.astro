---
/**
 * Support Matin (owner's request, Oct 30 2026). Three ways to help today (membership,
 * volunteering, partnership), then online donations, which open once Matin's bank account
 * and payment service are set up: until then the panel invites people to write. Never
 * claims charity status: the note says plainly that no tax receipts can be issued.
 * Texts drafted by Claude for the owner's review (`support.*` in FR, EN, FA).
 */
import {
  ArrowRight,
  Building2,
  Copy,
  CreditCard,
  Handshake,
  HandHeart,
  HeartHandshake,
  Landmark,
  UserPlus,
} from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getSettings } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const contact = href('contact', lang);
// Donations (owner's request, Oct 30 2026): Interac e-Transfer, Matin's own online form
// once it exists, and « write to us » for businesses and other ways, like other NGOs.
const settings = await getSettings();
const interacEmail = settings.donations?.interacEmail ?? '';
const onlineUrl = settings.donations?.onlineDonationUrl ?? '';
const ways = [
  {
    icon: UserPlus,
    tone: 'brique',
    title: t('support.memberTitle'),
    text: t('support.memberText'),
    cta: t('support.memberCta'),
    href: href('membership', lang),
  },
  {
    icon: HandHeart,
    tone: 'firouzeh',
    title: t('support.volunteerTitle'),
    text: t('support.volunteerText'),
    cta: t('support.volunteerCta'),
    href: `${contact}#${lang === 'fr' ? 'benevolat' : 'volunteer'}`,
  },
  {
    icon: Handshake,
    tone: 'encre',
    title: t('support.partnerTitle'),
    text: t('support.partnerText'),
    cta: t('support.partnerCta'),
    href: `${contact}#write`,
  },
];
---

<PageLayout
  lang={lang}
  title={t('support.title')}
  description={t('support.metaDescription')}
  lede={t('support.lede')}
  ledeStrong
  accent="brique"
  alternates={siteAlternates('support')}
>
  <section class="container-site support" aria-labelledby="ways-title">
    <h2 id="ways-title" class="support__title">{t('support.waysTitle')}</h2>
    <ul class="support__ways">
      {ways.map((w) => (
        <li class="way" data-tone={w.tone}>
          <span class="way__icon" aria-hidden="true">
            <w.icon size={26} />
          </span>
          <h3 class="way__title">{w.title}</h3>
          <p class="way__text">{w.text}</p>
          <a href={w.href} class="way__cta">
            {w.cta}
            <ArrowRight size={16} class="flip-rtl" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>

    <div class="donate" id="don" aria-labelledby="donate-title">
      <span class="donate__icon" aria-hidden="true">
        <HeartHandshake size={30} />
      </span>
      <div class="donate__body">
        <h2 id="donate-title" class="donate__title">{t('support.donateTitle')}</h2>
        <p class="donate__text">{t('support.donateText')}</p>
        <!-- Suggested amounts and monthly giving (NGO review, Oct 30 2026). Information only:
           the amount is chosen in the visitor's own bank or payment page. -->
        <div class="amounts">
          <p class="amounts__label">{t('support.donateAmountsLabel')}</p>
          <ul class="amounts__list">
            {['20', '50', '100'].map((n) => (
              <li class="amounts__chip">{lang === 'en' ? `$${n}` : lang === 'fa' ? `${n} دلار` : `${n} $`}</li>
            ))}
            <li class="amounts__chip amounts__chip--free">{t('support.donateAmountsOther')}</li>
          </ul>
          <p class="amounts__monthly">{t('support.donateMonthly')}</p>
        </div>
        <ul class="donate__ways">
          {interacEmail && (
            <li class="give give--main">
              <span class="give__icon" aria-hidden="true"><Landmark size={22} /></span>
              <h3 class="give__title">{t('support.donateInteracTitle')}</h3>
              <p class="give__text">{t('support.donateInteracText')}</p>
              <p class="give__email">
                <span dir="ltr">{interacEmail}</span>
                <button
                  type="button"
                  class="give__copy"
                  data-copy={interacEmail}
                  data-done={t('support.donateCopied')}
                >
                  <Copy size={16} aria-hidden="true" />
                  <span>{t('support.donateCopy')}</span>
                </button>
              </p>
            </li>
          )}
          {onlineUrl && (
            <li class="give">
              <span class="give__icon" aria-hidden="true"><CreditCard size={22} /></span>
              <h3 class="give__title">{t('support.donateOnlineTitle')}</h3>
              <p class="give__text">{t('support.donateOnlineText')}</p>
              <a href={onlineUrl} class="btn-primary give__btn" target="_blank" rel="noopener">
                {t('support.donateOnlineCta')}
                <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
              </a>
            </li>
          )}
          <li class="give">
            <span class="give__icon" aria-hidden="true"><Building2 size={22} /></span>
            <h3 class="give__title">{t('support.donateOtherTitle')}</h3>
            <p class="give__text">{t('support.donateOtherText')}</p>
            <a href={`${contact}#write`} class="give__link">
              {t('support.donateCta')}
              <ArrowRight size={16} class="flip-rtl" aria-hidden="true" />
            </a>
          </li>
        </ul>
        <p class="donate__note">{t('support.donateNote')}</p>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Copy the Interac address; the button says so for two seconds.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = btn.querySelector('span');
    const original = label?.textContent ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = btn.dataset.done ?? original;
        setTimeout(() => {
          if (label) label.textContent = original;
        }, 2000);
      } catch {
        /* Clipboard unavailable: the address stays visible to copy by hand. */
      }
    });
  }
</script>

<style>
  .support {
    padding-block: 3rem 5rem;
  }
  .support__title {
    margin-block-end: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.75rem);
    font-weight: 800;
    color: var(--matin-encre);
  }
  .support__ways {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    align-items: start;
  }
  @media (min-width: 64rem) {
    .way:nth-child(2) {
      margin-block-start: 2rem;
    }
  }
  .way {
    display: grid;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--matin-white);
    border: 1px solid var(--color-card-edge);
    border-block-start: 6px solid var(--tone);
    border-radius: 0.75rem;
    border-end-start-radius: 2.5rem;
    box-shadow: var(--shadow-card);
  }
  [data-tone='brique'] {
    --tone: var(--matin-brique);
    --tone-ink: var(--matin-brique-ink);
  }
  [data-tone='firouzeh'] {
    --tone: var(--matin-firouzeh);
    --tone-ink: var(--matin-firouzeh-ink);
  }
  [data-tone='encre'] {
    --tone: var(--matin-encre);
    --tone-ink: var(--matin-encre);
  }
  .way__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--tone);
    color: var(--matin-white);
  }
  .way__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--matin-encre);
  }
  .way__text {
    line-height: 1.65;
    color: var(--matin-ink);
  }
  .way__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--tone-ink);
  }
  .way__cta:hover {
    text-decoration: underline;
    text-decoration-color: var(--matin-soleil);
    text-underline-offset: 0.2em;
  }
  .way__cta:focus-visible {
    outline: 3px solid var(--matin-encre);
    outline-offset: 3px;
  }
  .donate {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.5rem;
    margin-block-start: 3.5rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: var(--matin-sable);
    border-radius: 1rem;
    border-start-end-radius: 3rem;
  }
  .donate__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--matin-soleil);
    color: var(--matin-encre);
  }
  .donate__body {
    display: grid;
    gap: 0.8rem;
    max-width: 46rem;
  }
  .donate__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
    font-weight: 800;
    color: var(--matin-encre);
  }
  .donate__text {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--matin-encre);
  }
  .amounts {
    display: grid;
    gap: 0.6rem;
    margin-block: 1rem 1.5rem;
  }
  .amounts__label {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--matin-encre);
  }
  .amounts__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .amounts__chip {
    padding: 0.45rem 1.2rem;
    border-radius: 999px;
    background: var(--matin-white);
    border: 2px solid var(--matin-soleil);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--matin-encre);
  }
  .amounts__chip--free {
    border-style: dashed;
    font-weight: 700;
  }
  .amounts__monthly {
    max-width: 44rem;
    line-height: 1.7;
    color: var(--matin-ink);
  }
  .donate__note {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--matin-ink);
  }
  .donate {
    scroll-margin-top: 7rem;
  }
  .donate__body {
    max-width: none;
  }
  .donate__ways {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin-block: 0.75rem 0.5rem;
  }
  .give {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem;
    background: var(--matin-white);
    border-radius: 0.75rem;
    border-end-end-radius: 2rem;
    border-block-start: 5px solid var(--matin-firouzeh);
  }
  .give--main {
    border-block-start-color: var(--matin-brique);
  }
  .give__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--matin-ivoire);
    color: var(--matin-brique-ink);
  }
  .give__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--matin-encre);
  }
  .give__text {
    line-height: 1.65;
    color: var(--matin-ink);
  }
  .give__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    padding: 0.75rem 1rem;
    background: var(--matin-ivoire);
    border-radius: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--matin-encre);
    word-break: break-all;
  }
  .give__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--matin-brique-ink);
    color: var(--matin-white);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .give__copy:hover {
    background: var(--matin-encre);
  }
  .give__copy:focus-visible,
  .give__link:focus-visible {
    outline: 3px solid var(--matin-encre);
    outline-offset: 3px;
  }
  .give__btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .give__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--matin-firouzeh-ink);
  }
  @media (max-width: 40rem) {
    .donate {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
