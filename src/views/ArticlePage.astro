---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, ExternalLink } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/content/PostCard.astro';
import Prose from '@/components/ui/Prose.astro';
import ShareButtons from '@/components/ui/ShareButtons.astro';
import {
  baseLang,
  categorySegment,
  categorySlugs,
  href,
  path,
  type Alternates,
  type UiLang,
} from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { forLang, getNews, hasPersian, renderMarkdown, slugOf } from '@/lib/content';
import { formatDate } from '@/lib/dates';

interface Props {
  lang: UiLang;
  post: CollectionEntry<'news'>;
}
const { lang, post } = Astro.props;
const t = useTranslations(lang);
const d = post.data;
const title = pick(d.title, lang)!;
const alternates: Alternates = {
  fr: path('news', 'fr', slugOf(post, 'fr')),
  en: path('news', 'en', slugOf(post, 'en')),
  ...(hasPersian(post) && { fa: `/fa/news/${slugOf(post, 'en')}/` }),
};
const site = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(alternates[lang] ?? alternates.en, site).href;
const base = baseLang(lang);
const author = typeof d.author === 'string' ? d.author : pick(d.author, lang)!;
const body = lang === 'fa' ? (d.body.fa ?? d.body.en) : d.body[lang];

// Related: same category first, then most recent.
const all = forLang(await getNews(), lang).filter((p) => p.id !== post.id);
const related = [
  ...all.filter((p) => p.data.category === d.category),
  ...all.filter((p) => p.data.category !== d.category),
].slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: pick(d.excerpt, lang),
  datePublished: d.date.toISOString(),
  inLanguage: { fr: 'fr-CA', en: 'en-CA', fa: 'fa' }[lang],
  ...(d.updated && { dateModified: d.updated.toISOString() }),
  author: { '@type': 'Organization', name: author },
  publisher: { '@id': new URL('/#organization', site).href },
  image: [new URL('/og-default.jpg', site).href],
  mainEntityOfPage: url,
};
---

<PageLayout
  lang={lang}
  title={title}
  lede={pick(d.excerpt, lang)}
  alternates={alternates}
  crumbs={[{ label: t('news.title'), href: href('news', lang) }]}
  type="article"
  jsonLd={[jsonLd]}
>
  <p slot="hero" class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
    <span>
      {t('news.publishedOn')}{' '}
      <time datetime={d.date.toISOString().slice(0, 10)} class="font-semibold text-ink">
        {formatDate(d.date, lang)}
      </time>
    </span>
    {d.updated && (
      <span>
        {t('news.updatedOn')}{' '}
        <time datetime={d.updated.toISOString().slice(0, 10)} class="font-semibold text-ink">
          {formatDate(d.updated, lang)}
        </time>
      </span>
    )}
    <span aria-hidden="true" class="text-gold">
      •
    </span>
    <span>
      {t('news.by')} <span class="font-semibold text-ink">{author}</span>
    </span>
    {[d.category].map((c) => (
      <a
        href={href('news', lang, categorySegment[base], categorySlugs[c][base])}
        class="rounded-full border border-line bg-tint px-3 py-1 text-sm font-bold text-ink no-underline hover:underline"
      >
        {t(`newsCategories.${c}`)}
      </a>
    ))}
  </p>

  <article class="container-site max-w-4xl pt-6 pb-20">
    {d.image && (
      <div class="mb-12 aspect-[16/9] overflow-hidden rounded-[var(--radius-card)] shadow-soft">
        <Picture
          src={d.image}
          alt={pick(d.imageAlt, lang) ?? ''}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280]}
          sizes="(min-width: 896px) 56rem, 100vw"
          class="size-full object-cover"
          loading="eager"
        />
      </div>
    )}
    <Prose html={renderMarkdown(body, lang)} class="mx-auto max-w-3xl text-lg" />
    {d.source && (
      <div class="mx-auto mt-10 max-w-3xl rounded-2xl border-s-4 border-gold bg-tint p-5 text-sm">
        <p class="mb-1 font-bold text-ink">{t('news.sourceIntro')}</p>
        <a
          href={d.source.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-semibold"
        >
          {d.source.name}
          <ExternalLink size={14} aria-hidden="true" />
          <span class="sr-only">{t('a11y.externalLink')}</span>
        </a>
      </div>
    )}
    {d.tags.length > 0 && (
      <ul class="mx-auto mt-10 flex max-w-3xl flex-wrap gap-2" aria-label={t('news.tags')}>
        {d.tags.map((tag) => (
          <li class="rounded-full border border-line px-3 py-1 text-sm text-muted">#{tag}</li>
        ))}
      </ul>
    )}
    <section
      class="get-involved card mx-auto mt-12 max-w-3xl p-6 sm:p-8"
      aria-labelledby="article-involved-title"
    >
      <h2 id="article-involved-title" class="mb-2 text-xl font-bold">
        {t('news.getInvolvedTitle')}
      </h2>
      <p class="mb-5">{t('news.getInvolvedText')}</p>
      <a href={href('contact', lang)} class="btn btn-outline">
        {t('news.getInvolvedCta')}
        <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
      </a>
    </section>
    <div class="mx-auto mt-10 flex max-w-3xl flex-col gap-6 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <ShareButtons lang={lang} url={url} title={title} />
      <a href={href('news', lang)} class="link-arrow text-sm">
        <ArrowLeft size={18} class="flip-rtl" aria-hidden="true" />
        {t('news.backToNews')}
      </a>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bg-tint py-20" aria-labelledby="related-title" data-pagefind-ignore="all">
      <div class="container-site">
        <h2 id="related-title" class="section-title mb-12">
          {t('news.related')}
        </h2>
        <ul class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <li>
              <PostCard post={p} lang={lang} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</PageLayout>
