---
/**
 * News article page (owner's brief, Oct 25 2026: a professionally designed article from
 * a cultural institution). Cream banner with the headline and summary; a wide visual
 * (the article's photo with its credit, or Matin's dialogue motif, never a made-up
 * photo); the text in a comfortable column beside an "At a glance" panel (section, date,
 * author or source, sharing, back to News); for Cultural News, the original source in
 * evidence; then other Matin News, only when real articles exist.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, CalendarDays, ExternalLink, MapPin } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/content/PostCard.astro';
import DialogueArt from '@/components/brand/DialogueArt.astro';
import Prose from '@/components/ui/Prose.astro';
import ShareButtons from '@/components/ui/ShareButtons.astro';
import { href, newsAnchors, path, type Alternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { forLang, getNews, hasPersian, renderMarkdown, slugOf } from '@/lib/content';
import { formatDate } from '@/lib/dates';

interface Props {
  lang: UiLang;
  post: CollectionEntry<'news'>;
}
const { lang, post } = Astro.props;
const t = useTranslations(lang);
const d = post.data;
const title = pick(d.title, lang)!;
const alternates: Alternates = {
  fr: path('news', 'fr', slugOf(post, 'fr')),
  en: path('news', 'en', slugOf(post, 'en')),
  ...(hasPersian(post) && { fa: `/fa/news/${slugOf(post, 'en')}/` }),
};
const site = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(alternates[lang] ?? alternates.en, site).href;
const author = typeof d.author === 'string' ? d.author : pick(d.author, lang)!;
const body = lang === 'fa' ? (d.body.fa ?? d.body.en) : d.body[lang];
const cultural = d.category === 'recommends';
const newsHref = href('news', lang);
const sectionHref = `${newsHref}#${newsAnchors[d.category]}`;

// Other articles of the same section, only real published ones.
const related = forLang(await getNews(), lang)
  .filter((p) => p.id !== post.id && p.data.category === d.category)
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: pick(d.excerpt, lang),
  datePublished: d.date.toISOString(),
  inLanguage: { fr: 'fr-CA', en: 'en-CA', fa: 'fa' }[lang],
  ...(d.updated && { dateModified: d.updated.toISOString() }),
  author: { '@type': 'Organization', name: author },
  publisher: { '@id': new URL('/#organization', site).href },
  image: [new URL('/og-default.jpg', site).href],
  mainEntityOfPage: url,
};
---

<PageLayout
  lang={lang}
  title={title}
  lede={pick(d.excerpt, lang)}
  alternates={alternates}
  crumbs={[{ label: t('news.title'), href: newsHref }]}
  type="article"
  jsonLd={[jsonLd]}
>
  <p slot="hero" class="article-meta">
    <a href={sectionHref} class="article-meta__cat">
      {t(`newsCategories.${d.category}`)}
    </a>
    <span class="article-meta__date">
      <CalendarDays size={17} aria-hidden="true" />
      <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, lang)}</time>
    </span>
  </p>

  <div class="container-site article-wrap">
    <figure class="article-visual">
      {d.image ? (
        <Picture
          src={d.image}
          alt={pick(d.imageAlt, lang) ?? ''}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 90rem) 84rem, 100vw"
          class="article-visual__img"
          loading="eager"
        />
      ) : (
        <DialogueArt
          accent={cultural ? 'teal' : 'mustard'}
          seed={post.id}
          class="article-visual__art"
        />
      )}
      {d.imageCredit && <figcaption class="article-visual__credit">{d.imageCredit}</figcaption>}
    </figure>

    <div class="article-grid">
      <article class="article-main">
        <Prose html={renderMarkdown(body, lang)} class="article-prose" />

        {d.source && (
          <aside class="article-source" aria-label={t('news.sourceIntro')}>
            <p class="article-source__label">{t('news.sourceIntro')}</p>
            <a
              href={d.source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              {d.source.name}
              <ExternalLink size={17} aria-hidden="true" />
              <span class="sr-only">{t('a11y.externalLink')}</span>
            </a>
            <p class="article-source__note">{t('news.sourceNote')}</p>
          </aside>
        )}

        {!cultural && (
          <section class="article-cta" aria-labelledby="article-cta-title">
            <h2 id="article-cta-title" class="article-cta__title">
              {t('news.getInvolvedTitle')}
            </h2>
            <p>{t('news.getInvolvedText')}</p>
            <a href={href('contact', lang)} class="btn btn-primary">
              {t('news.getInvolvedCta')}
              <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
            </a>
          </section>
        )}

        <p class="article-back">
          <a href={newsHref} class="btn btn-outline">
            <ArrowLeft size={18} class="flip-rtl" aria-hidden="true" />
            {t('news.backToNews')}
          </a>
        </p>
      </article>

      <aside class="article-aside" aria-label={t('news.atAGlance')}>
        <div class="glance">
          <p class="glance__title">{t('news.atAGlance')}</p>
          <dl class="glance__list">
            <div>
              <dt>{t('news.category')}</dt>
              <dd>
                <a href={sectionHref}>{t(`newsCategories.${d.category}`)}</a>
              </dd>
            </div>
            {cultural && d.region && (
              <div>
                <dt>{t('news.region')}</dt>
                <dd class="glance__icon">
                  <MapPin size={16} aria-hidden="true" />
                  {t(`newsRegions.${d.region}`)}
                </dd>
              </div>
            )}
            <div>
              <dt>{t('news.publishedOn')}</dt>
              <dd>
                <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, lang)}</time>
              </dd>
            </div>
            {d.updated && (
              <div>
                <dt>{t('news.updatedOn')}</dt>
                <dd>
                  <time datetime={d.updated.toISOString().slice(0, 10)}>
                    {formatDate(d.updated, lang)}
                  </time>
                </dd>
              </div>
            )}
            {cultural && d.source ? (
              <div>
                <dt>{t('news.sourceIntro')}</dt>
                <dd>{d.source.name}</dd>
              </div>
            ) : (
              <div>
                <dt>{t('news.by')}</dt>
                <dd>{author}</dd>
              </div>
            )}
          </dl>
          <ShareButtons lang={lang} url={url} title={title} />
          <a href={newsHref} class="glance__back">
            <ArrowLeft size={18} class="flip-rtl" aria-hidden="true" />
            {t('news.backToNews')}
          </a>
        </div>
      </aside>
    </div>
  </div>

  {related.length > 0 && (
    <section class="article-related" aria-labelledby="related-title" data-pagefind-ignore="all">
      <div class="container-site">
        <h2 id="related-title" class="section-title mb-10">
          {t('news.related')}
        </h2>
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
          {related.map((p) => (
            <li>
              <PostCard post={p} lang={lang} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</PageLayout>

<style>
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-block-start: 1.5rem;
  }
  .article-meta__cat {
    padding: 0.3rem 0.95rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 800;
    text-decoration: none;
  }
  .article-meta__cat:hover {
    background: var(--color-primary-hover);
  }
  .article-meta__date {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .article-meta__date :global(svg) {
    color: var(--color-primary);
  }

  .article-wrap {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(3.5rem, 2.5rem + 3vw, 6rem);
  }
  /* A wide, restrained visual: the photo, or the dialogue motif on warm ivory. */
  .article-visual {
    position: relative;
    margin-block-end: clamp(2.5rem, 2rem + 2vw, 4rem);
    overflow: hidden;
    border-radius: calc(var(--radius-card) * 1.4);
    border-block-end: 6px solid var(--color-teal);
    background: var(--color-ivory);
  }
  .article-visual :global(.article-visual__img) {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }
  .article-visual :global(.article-visual__art) {
    height: clamp(11rem, 8rem + 10vw, 18rem);
  }
  .article-visual__credit {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-end: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 75%, transparent);
    color: var(--color-white);
    font-size: 0.8125rem;
  }

  /* Text column beside the "At a glance" panel; one column on smaller screens. */
  .article-grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  @media (min-width: 64rem) {
    .article-grid {
      grid-template-columns: minmax(0, 46rem) minmax(16rem, 21rem);
      justify-content: space-between;
      align-items: start;
    }
    .article-aside {
      position: sticky;
      inset-block-start: 8rem;
    }
  }
  .article-main :global(.article-prose) {
    font-size: clamp(1.125rem, 1.05rem + 0.25vw, 1.25rem);
    line-height: 1.8;
  }
  .article-main :global(.article-prose > p:first-child) {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.45rem);
    line-height: 1.7;
    color: var(--color-primary);
  }
  /* Section headings with a short teal and gold mark. */
  .article-main :global(.article-prose h2) {
    position: relative;
    margin-block: 2.5rem 1rem;
    padding-block-start: 1rem;
    font-size: clamp(1.5rem, 1.3rem + 0.7vw, 1.875rem);
    font-weight: 800;
    color: var(--color-primary);
  }
  .article-main :global(.article-prose h2::before) {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 1.9rem;
    height: 4px;
    border-radius: 2px;
    background: var(--color-teal);
  }
  .article-main :global(.article-prose h2::after) {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 2.1rem;
    width: 1rem;
    height: 4px;
    border-radius: 2px;
    background: var(--color-gold);
  }
  .article-main :global(.article-prose ul) {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--color-ivory);
  }

  .article-source {
    margin-block-start: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-card);
    border-inline-start: 5px solid var(--color-gold);
    background: var(--color-champagne);
  }
  .article-source__label {
    margin-block-end: 0.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-primary);
  }
  .article-source__note {
    margin-block-start: 0.85rem;
    font-size: 0.9375rem;
  }

  .article-cta {
    margin-block-start: 3rem;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-card);
    border-block-start: 5px solid var(--color-teal);
    background: var(--color-cream);
  }
  .article-cta__title {
    margin-block-end: 0.6rem;
    font-size: clamp(1.375rem, 1.2rem + 0.5vw, 1.625rem);
    font-weight: 800;
  }
  .article-cta p {
    margin-block-end: 1.25rem;
    line-height: 1.7;
  }
  .article-back {
    margin-block-start: 2.5rem;
  }

  .glance {
    display: grid;
    gap: 1.25rem;
    padding: 1.6rem 1.6rem 1.75rem;
    border: 1px solid var(--color-aqua-edge);
    border-block-start: 5px solid var(--color-gold);
    border-radius: var(--radius-card);
    background: var(--color-aqua);
  }
  .glance__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
  }
  .glance__list {
    display: grid;
    gap: 0.85rem;
  }
  .glance__list dt {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-teal-deep);
  }
  .glance__list dd {
    font-weight: 600;
    color: var(--color-primary);
  }
  .glance__icon {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .glance__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-weight: 800;
  }

  .article-related {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
    border-block-start: 4px solid var(--color-gold);
    background: var(--color-cream);
  }
</style>
