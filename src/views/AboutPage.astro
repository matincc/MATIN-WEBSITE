---
/**
 * About page, in this order: Who We Are (photo, text and legal line; moved here from the homepage,
 * owner's brief Oct 25 2026), Our Mission (brick), Our Vision (turquoise) and Legal status
 * (sand) as staggered cards, Our values (six cards at different heights), Our story (sand
 * band with a rising sun) (owner's About brief, Oct 25 2026: no shortcut buttons, no photo
 * pair; scheme A and organic shapes, Oct 29 2026: an arch photo, suns, uneven corners). The
 * President's personal note is on the homepage only (HomeLetter.astro, owner's request
 * Oct 29 2026). The President's biography and the team are on the Our Team
 * page (TeamPage.astro).
 */
import { Picture } from 'astro:assets';
import {
  DoorOpen,
  HeartHandshake,
  LayoutGrid,
  MessagesSquare,
  Palette,
  Users,
} from '@lucide/astro';
import PhotoCredit from '@/components/media/PhotoCredit.astro';
import { photos } from '@/lib/photos';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSettings, getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const [settings, about] = await Promise.all([getSettings(), getSingleton('about')]);

// Same accents as the Mission / Vision / Values links on the homepage.
const blocks: {
  id: string;
  title: string;
  text?: string;
  accent: string;
  /** Card surface: brique and firouzeh take white text, sable navy text. */
  tone: string;
  link?: { href: string; label: string };
  /** Short facts shown as a badge above the text (none at the moment). */
  badge?: string;
}[] = [
  {
    id: 'mission',
    title: t('about.mission'),
    text: pick(settings.mission, lang),
    accent: 'terracotta',
    tone: 'brique',
  },
  {
    id: 'vision',
    title: t('about.vision'),
    text: pick(about.vision, lang),
    accent: 'teal',
    tone: 'firouzeh',
  },
  ...(settings.legal
    ? [
        {
          id: 'legal-status',
          title: t('about.legalStatus'),
          text: settings.legal.statement[lang],
          accent: 'mustard',
          tone: 'sable',
          link: { href: href('legalInfo', lang), label: t('about.legalMore') },
        },
      ]
    : []),
];
// Six surfaces for the values, never a uniform grid (owner's request, Oct 29 2026: less
// rigid): turquoise and brick cards with white text among white and sand ones.
const valueTones = ['firouzeh', 'white', 'sable', 'sable', 'brique', 'white'];

// Thin-line icons, all drawn at the same size and stroke width.
// Equity is four equal squares: never a scale, gavel or other legal symbol.
const icons = {
  dialogue: MessagesSquare,
  respect: HeartHandshake,
  openness: DoorOpen,
  creativity: Palette,
  community: Users,
  equity: LayoutGrid,
};

// Paragraphs are separated by a blank line in about.yaml.
const paragraphs = (text?: string) =>
  (text ?? '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
// Years in Persian digits on the Persian page.
const year = (y: string) => (lang === 'fa' ? y.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]) : y);
// Timeline entries (Persian shows the English text of an entry without a Persian one).
const history = about.history.map((h) => ({
  year: year(h.year),
  title: pick(h.title, lang)!,
  paragraphs: paragraphs(pick(h.text, lang)),
}));
---

<PageLayout
  lang={lang}
  title={t('about.title')}
  description={t('about.lede')}
  alternates={siteAlternates('about')}
>
  <!-- Who we are: the photo in an arch with the morning sun, the text set like a feature -->
  <section id="who-we-are" class="who scroll-mt-24" aria-labelledby="who-we-are-title">
    <div class="container-site who-grid">
      <figure class="who-figure" data-reveal>
        <span class="who-figure__sun" aria-hidden="true"></span>
        <span class="who-figure__dot" aria-hidden="true"></span>
        <div class="who-figure__photo">
          <Picture
            src={photos.tamtams.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[720, 1080, 1440, 1920]}
            sizes="(min-width: 64rem) 100rem, 300vw"
            style={`object-position:${photos.tamtams.focus}`}
          />
        </div>
        <figcaption>
          <PhotoCredit credit={photos.tamtams.credit} />
        </figcaption>
      </figure>
      <div class="who-body">
        <h2 id="who-we-are-title" class="who-title">
          {t('about.whoWeAre')}
        </h2>
        <p class="who-positioning">{t('home.positioning')}</p>
        <p class="who-text">{t('home.whoText')}</p>
        {settings.legal && (
          <p class="who-legal">
            {t('home.legalLine')} ·{' '}
            <a href={href('legalInfo', lang)} class="font-semibold underline">
              {t('home.legalLink')}
            </a>
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Mission, Vision and Legal status: brick, turquoise and sand cards, staggered like a
       sunrise on a sand band, each with its own corner and shape -->
  {blocks.length > 0 && (
    <div class="about-band">
      <span class="about-band__sun" aria-hidden="true"></span>
      <div class="container-site about-blocks">
        {blocks.map((b) => (
          <section
            id={b.id}
            class:list={[
              'about-block scroll-mt-24',
              b.id === 'legal-status' && 'about-block--legal',
            ]}
            data-accent={b.accent}
            data-tone={b.tone}
            data-reveal
            aria-labelledby={`${b.id}-title`}
          >
            <span class="about-block__shape" aria-hidden="true"></span>
            <h2 id={`${b.id}-title`} class="about-block__title">
              {b.title}
            </h2>
            {b.badge && (
              <p class="about-block__badge" dir="ltr">
                {b.badge}
              </p>
            )}
            <p class="about-block__text">{b.text}</p>
            {b.link && (
              <p class="mt-4">
                <a href={b.link.href} class="font-semibold underline">
                  {b.link.label}
                </a>
              </p>
            )}
          </section>
        ))}
      </div>
    </div>
  )}

  <!-- Our values: six cards at different heights and corners, never a uniform grid -->
  <section id="values" class="values scroll-mt-24" aria-labelledby="values-title">
    <span class="values__sun" aria-hidden="true"></span>
    <div class="container-site relative">
      <SectionHeader align="start" id="values-title" title={t('about.values')} />
      <ul class="values-grid">
        {about.values.map((v, i) => {
          const Icon = icons[v.icon];
          return (
            <li class="value-card" data-tone={valueTones[i % valueTones.length]} data-reveal>
              <span class="value-card__icon" aria-hidden="true">
                <Icon size={30} stroke-width={1.6} />
              </span>
              <h3 class="value-card__title">{pick(v.title, lang)}</h3>
              <p class="value-card__text">{pick(v.text, lang)}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Our story: one entry per milestone in about.yaml (history), oldest first, on a sand
       band where the sun rises on the horizon (the same sign as the page banners). -->
  <section id="story" class="story section-pad scroll-mt-24" aria-labelledby="history-title">
    <span class="story__sun" aria-hidden="true"></span>
    <div class="container-site relative">
      <SectionHeader align="start" id="history-title" title={t('about.history')} />
      <ol class="timeline">
        {history.map((h) => (
          <li class="timeline__item" data-reveal>
            <span class="timeline__year">{h.year}</span>
            <article class="timeline__card">
              <h3 class="timeline__title">{h.title}</h3>
              <div class="timeline__text">
                {h.paragraphs.map((para) => (
                  <p>{para}</p>
                ))}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <!-- The President's personal note left the About page (owner's request, Oct 29 2026:
       it was shown twice); its full text is on the Notes from the President page
       (#personal-note), with an excerpt on the homepage. Old links to #president land there. -->
  <span hidden data-letter-href={`${href('notes', lang)}#personal-note`}></span>
</PageLayout>

<script>
  // Old links to the President's note (#president) land on its full text (Notes page).
  const letter = document.querySelector<HTMLElement>('[data-letter-href]')?.dataset.letterHref;
  if (letter && location.hash === '#president') location.replace(letter);
</script>

<style>
  /* Scheme A shapes (owner's request, Oct 29 2026: less boxed, less regular): arches,
     suns and circles as on the homepage, uneven corners, cards at different heights.
     Logical corners so the Persian page mirrors. Flat colours only. */

  /* ---------- Who we are ---------- */
  .who {
    padding-block: 0.5rem clamp(4rem, 3rem + 4vw, 7rem);
  }
  .who-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .who-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3.5rem, 2rem + 5vw, 8rem);
    }
    /* The text sits a little lower than the photo: a feature page, not a form. */
    .who-body {
      padding-block-start: clamp(2rem, 1rem + 3vw, 5rem);
    }
  }
  .who-figure {
    position: relative;
    max-width: 30rem;
    margin-inline: auto;
    width: 100%;
    padding-block-start: 2rem;
  }
  /* The logo's sun behind the arch, and a small turquoise circle in front of it. */
  .who-figure__sun {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: -1.5rem;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-soleil);
  }
  .who-figure__dot {
    position: absolute;
    z-index: 2;
    inset-block-end: 3.5rem;
    inset-inline-end: -1rem;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-firouzeh);
    outline: 0.5rem solid var(--color-paper);
  }
  .who-figure__photo {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 1.75rem 1.75rem;
    margin-inline: 1.5rem 0;
  }
  /* The Tam-Tams photo is wide with a lot of sky: zoom towards the crowd. */
  .who-figure__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.55);
    transform-origin: 50% 96%;
  }
  .who-figure figcaption {
    margin-inline-start: 1.5rem;
  }
  .who-title {
    font-family: var(--font-editorial);
    font-size: clamp(2.5rem, 1.7rem + 3vw, 4.25rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 96;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  :global(html[lang='fa']) .who-title {
    font-weight: 800;
    font-variation-settings: normal;
    letter-spacing: 0;
    line-height: 1.3;
  }
  /* Secondary positioning line: below the title, never in place of the slogan. */
  .who-positioning {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-block: 1.25rem 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.05rem + 0.45vw, 1.4rem);
    font-weight: 800;
    color: var(--color-brique-ink);
  }
  .who-positioning::before {
    content: '';
    flex: none;
    width: 1.5rem;
    height: 0.75rem;
    border-radius: 999px 999px 0 0;
    background: var(--color-soleil);
  }
  /* The approved introduction, set like the opening of a magazine feature. */
  .who-text {
    max-width: 40rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.1rem);
    font-variation-settings:
      'SOFT' 100,
      'opsz' 48;
    line-height: 1.4;
    text-wrap: pretty;
  }
  :global(html[lang='fa']) .who-text {
    font-family: var(--font-sans);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.85;
  }
  .who-legal {
    max-width: 40rem;
    margin-block-start: 1.75rem;
    padding-inline-start: 1.1rem;
    border-inline-start: 3px solid var(--color-firouzeh);
    font-size: 1.0625rem;
  }

  /* ---------- Mission, Vision, Legal status ---------- */
  .about-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem) clamp(4.5rem, 3rem + 5vw, 8rem);
    background: var(--color-sable);
  }
  /* A large pale sun behind the cards. */
  .about-band__sun {
    position: absolute;
    inset-block-start: -8rem;
    inset-inline-end: -8rem;
    width: clamp(18rem, 10rem + 25vw, 34rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-soleil) 30%, var(--color-sable));
  }
  .about-blocks {
    position: relative;
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }
  @media (min-width: 56rem) {
    .about-blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-block[data-tone='firouzeh'] {
      margin-block-start: 3.5rem;
    }
    .about-block--legal {
      grid-column: 1 / -1;
      max-width: 40rem;
    }
  }
  /* Wide screens: three cards of different widths, each a little lower than the last,
     like the sun climbing. */
  @media (min-width: 72rem) {
    .about-blocks {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4.5fr) minmax(0, 3.5fr);
      gap: 2rem;
    }
    .about-block--legal {
      grid-column: auto;
      max-width: none;
      margin-block-start: 7rem;
    }
  }
  /* Persian shows only the Legal status card: keep it compact. */
  .about-block--legal:only-child {
    max-width: 44rem;
    margin-block-start: 0;
  }
  .about-block__badge {
    display: inline-block;
    margin-block-end: 1rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--color-white);
    border: 1px solid var(--color-gold);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  .about-block {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    border-radius: 1.5rem;
  }
  .about-block > :not(.about-block__shape) {
    position: relative;
    z-index: 1;
  }
  .about-block__title {
    margin-block-end: 1.1rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.9rem, 1.4rem + 1.5vw, 2.75rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 72;
    line-height: 1.1;
  }
  :global(html[lang='fa']) .about-block__title {
    font-weight: 800;
    font-variation-settings: normal;
  }
  .about-block__text {
    max-width: 40rem;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem);
    line-height: 1.7;
  }
  .about-block__shape {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  /* Mission: brick, white text (6.4:1), a deep arch corner and the sun rising in it. */
  .about-block[data-tone='brique'] {
    background: var(--color-brique-ink);
    color: var(--color-white);
    border-start-end-radius: 7rem;
    padding-block-end: 5.5rem;
  }
  .about-block[data-tone='brique'] .about-block__title {
    color: var(--color-sable);
  }
  .about-block[data-tone='brique'] .about-block__shape {
    inset-block-end: 0;
    inset-inline-end: 2rem;
    width: 7rem;
    height: 3.5rem;
    border-radius: 999px 999px 0 0;
    background: color-mix(in srgb, var(--color-soleil) 55%, var(--color-brique-ink));
  }
  /* Vision: turquoise, white text (5.0:1), a round corner at the start and a ring. */
  .about-block[data-tone='firouzeh'] {
    background: var(--color-firouzeh);
    color: var(--color-white);
    border-start-start-radius: 7rem;
    padding-block-end: 5rem;
  }
  .about-block[data-tone='firouzeh'] .about-block__title {
    color: var(--color-white);
  }
  .about-block[data-tone='firouzeh'] .about-block__shape {
    inset-block-end: -3.5rem;
    inset-inline-end: -3.5rem;
    width: 10rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.25rem solid color-mix(in srgb, var(--color-white) 16%, var(--color-firouzeh));
  }
  /* Legal status: ivory with navy text, a soft round shape and a small sun. */
  .about-block[data-tone='sable'] {
    background: var(--color-ivory);
    color: var(--color-ink);
    border-radius: 1.5rem 1.5rem 4rem 1.5rem;
    box-shadow: var(--shadow-card);
  }
  .about-block[data-tone='sable'] .about-block__shape {
    inset-block-start: 1.75rem;
    inset-inline-end: 1.75rem;
    width: 2.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-soleil);
  }
  .about-block[data-tone='sable'] .about-block__title {
    padding-inline-end: 3rem;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
  }
  .about-block[data-tone='sable'] a {
    color: var(--color-brique-ink);
  }

  /* ---------- Our values: cards at different heights, never a uniform grid ---------- */
  .values {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 3rem + 4vw, 7rem) clamp(5rem, 3rem + 6vw, 9rem);
    background: var(--color-paper);
  }
  .values__sun {
    position: absolute;
    inset-block-start: clamp(3rem, 2rem + 3vw, 6rem);
    inset-inline-end: clamp(-4rem, -2rem - 3vw, -1rem);
    width: clamp(8rem, 5rem + 10vw, 16rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.25rem solid color-mix(in srgb, var(--color-firouzeh) 18%, var(--color-paper));
  }
  .values-grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 48rem) {
    .values-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Every second card sits lower. */
    .value-card:nth-child(2n) {
      margin-block: 3rem -3rem;
    }
  }
  @media (min-width: 72rem) {
    .values-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
    .value-card:nth-child(2n) {
      margin-block: 0;
    }
    /* The middle column sits lower, the last one a little: an uneven line. */
    .value-card:nth-child(3n + 2) {
      margin-block: 4rem -4rem;
    }
    .value-card:nth-child(3n) {
      margin-block: 1.5rem -1.5rem;
    }
  }
  .value-card {
    position: relative;
    padding: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    border-radius: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.65;
  }
  /* Uneven corners and a slight tilt on a few cards; they straighten on hover. */
  .value-card:nth-child(1) {
    border-start-start-radius: 5rem;
  }
  .value-card:nth-child(2) {
    rotate: -0.8deg;
  }
  .value-card:nth-child(3) {
    border-end-end-radius: 5rem;
  }
  .value-card:nth-child(4) {
    rotate: 0.7deg;
  }
  .value-card:nth-child(5) {
    border-start-end-radius: 5rem;
  }
  .value-card:nth-child(6) {
    border-end-start-radius: 5rem;
    rotate: -0.5deg;
  }
  /* On a desktop pointer each card rises a little, grows slightly and straightens
     (owner's request, Oct 29 2026); its icon turns gently. */
  /* The hover state also applies when the computer asks for reduced motion: it then
     changes at once instead of moving (owner, Oct 29 2026: he saw no change). */
  @media (hover: hover) {
    .value-card {
      transition:
        rotate 0.45s ease,
        translate 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
        scale 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
        box-shadow 0.45s ease;
    }
    .value-card:hover {
      rotate: 0deg;
      translate: 0 -0.9rem;
      scale: 1.04;
      box-shadow: 0 1.25rem 2.5rem -1rem color-mix(in srgb, var(--color-primary) 35%, transparent);
    }
    .value-card__icon {
      transition: rotate 0.45s ease;
    }
    .value-card:hover .value-card__icon {
      rotate: -10deg;
    }
  }
  .value-card__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-block-end: 1.25rem;
    border-radius: 50%;
  }
  .value-card__title {
    margin-block-end: 0.5rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 1.35rem + 0.5vw, 1.85rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 48;
    line-height: 1.15;
  }
  :global(html[lang='fa']) .value-card__title {
    font-weight: 800;
    font-variation-settings: normal;
  }
  .value-card[data-tone='white'] {
    background: var(--color-white);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
  }
  .value-card[data-tone='white'] .value-card__icon {
    background: var(--color-sable);
    color: var(--color-brique-ink);
  }
  .value-card[data-tone='sable'] {
    background: var(--color-sable);
  }
  .value-card[data-tone='sable'] .value-card__icon {
    background: var(--color-white);
    color: var(--color-firouzeh-ink);
  }
  .value-card[data-tone='firouzeh'],
  .value-card[data-tone='brique'] {
    color: var(--color-white);
  }
  .value-card[data-tone='firouzeh'] {
    background: var(--color-firouzeh);
  }
  .value-card[data-tone='brique'] {
    background: var(--color-brique-ink);
  }
