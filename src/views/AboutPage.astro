---
/**
 * About page, in this order: Who We Are, Our Mission, Our Vision, Our values,
 * Our story, Our team, A word from our President. The Persian page shows the values and
 * the team (the other texts have no Persian translation yet) and links to the English page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  ArrowRight,
  DoorOpen,
  HeartHandshake,
  LayoutGrid,
  MessagesSquare,
  Palette,
  Quote,
  Users,
} from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { href, path, siteAlternates, type UiLang } from '@/i18n/routes';
import { faAboutMore } from '@/i18n/fa';
import { useTranslations, pick } from '@/i18n/ui';
import {
  forLang,
  getSettings,
  getSingleton,
  getTeam,
  initials,
  presidentProfileVisible,
} from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const full = lang !== 'fa';
const [settings, about, teamAll, showProfile] = await Promise.all([
  getSettings(),
  getSingleton('about'),
  getTeam(),
  presidentProfileVisible(),
]);
const team = forLang(teamAll, lang);

const blocks = [
  { id: 'who-we-are', title: t('about.whoWeAre'), text: t('home.whoText') },
  { id: 'mission', title: t('about.mission'), text: pick(settings.mission, lang) },
  { id: 'vision', title: t('about.vision'), text: pick(about.vision, lang) },
];

// Thin-line icons, all drawn at the same size and stroke width.
// Equity is four equal squares: never a scale, gavel or other legal symbol.
const icons = {
  dialogue: MessagesSquare,
  respect: HeartHandshake,
  openness: DoorOpen,
  creativity: Palette,
  community: Users,
  equity: LayoutGrid,
};

// The badge shows the initials until a photo is added as
// src/assets/brand/president.jpg (or .jpeg, .png, .webp).
const photos = import.meta.glob<ImageMetadata>('/src/assets/brand/president.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const presidentPhoto = Object.values(photos)[0];
const president = about.president;
---

<PageLayout
  lang={lang}
  title={t('about.title')}
  lede={t('about.lede')}
  alternates={siteAlternates('about')}
>
  {full && (
    <div class="container-site grid max-w-4xl gap-8 pb-20">
      {blocks.map((b) => (
        <section id={b.id} class="card scroll-mt-24 p-6 sm:p-12" aria-labelledby={`${b.id}-title`}>
          <h2 id={`${b.id}-title`} class="mb-5 text-3xl font-bold sm:text-4xl">
            {b.title}
          </h2>
          <p class="text-lg leading-relaxed">{b.text}</p>
        </section>
      ))}
    </div>
  )}

  <!-- Our values -->
  <section id="values" class="scroll-mt-24 bg-tint py-20" aria-labelledby="values-title">
    <div class="container-site">
      <SectionHeader id="values-title" title={t('about.values')} />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {about.values.map((v) => {
          const Icon = icons[v.icon];
          return (
            <li class="card p-8">
              <Icon size={40} stroke-width={1.25} class="mb-5 text-gold-dark" aria-hidden="true" />
              <h3 class="mb-2 text-2xl font-bold">{pick(v.title, lang)}</h3>
              <p>{pick(v.text, lang)}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {!full && (
    <section class="bg-tint pb-20">
      <p class="container-site text-center">
        {faAboutMore.text}{' '}
        <a href={`${path('about', 'en')}?from=fa`} lang="fa" class="font-semibold underline">
          {faAboutMore.link}
        </a>
      </p>
    </section>
  )}

  {!full && (
    <>
      <!-- Our team: published members only; hidden while there are none -->
      {team.length > 0 && (
        <section id="team" class="scroll-mt-24 bg-tint py-20" aria-labelledby="team-title">
          <div class="container-site">
            <SectionHeader id="team-title" title={t('about.team')} />
            <ul class="team-grid">
              {team.map((m) => (
                <li class="card team-card">
                  {m.data.photo ? (
                    <Image
                      src={m.data.photo}
                      alt={t('about.presidentPhotoAlt', { name: m.data.name })}
                      width={480}
                      height={480}
                      class="team-card__photo"
                    />
                  ) : (
                    <span class="team-card__photo team-card__initials" aria-hidden="true">
                      {initials(m.data.name)}
                    </span>
                  )}
                  <div class="flex flex-1 flex-col gap-2 p-6">
                    <h3 class="text-xl font-bold">{m.data.name}</h3>
                    <p class="font-semibold text-gold-dark">{pick(m.data.role, lang)}</p>
                    {m.data.bio && pick(m.data.bio, lang) && (
                      <p class="text-[0.97rem] leading-relaxed">{pick(m.data.bio, lang)}</p>
                    )}
                    {m.data.linkedin && (
                      <a
                        href={m.data.linkedin}
                        class="link-arrow mt-auto pt-2"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        LinkedIn
                        <span class="sr-only">
                          {t('about.onLinkedin', { name: m.data.name })} {t('a11y.externalLink')}
                        </span>
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </>
  )}

  {full && (
    <>
      <!-- Our story -->
      <section id="story" class="container-site scroll-mt-24 py-20" aria-labelledby="history-title">
        <SectionHeader id="history-title" title={t('about.history')} />
        <ol class="timeline">
          {about.history.map((h) => (
            <li class="timeline__item">
              <span class="timeline__year">{h.year}</span>
              <div class="card p-6 sm:p-10">
                <h3 class="mb-3 text-2xl font-bold">{pick(h.title, lang)}</h3>
                <p class="text-lg leading-relaxed">{pick(h.text, lang)}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- Our team: published members only; hidden while there are none -->
      {team.length > 0 && (
        <section id="team" class="scroll-mt-24 bg-tint py-20" aria-labelledby="team-title">
          <div class="container-site">
            <SectionHeader id="team-title" title={t('about.team')} />
            <ul class="team-grid">
              {team.map((m) => (
                <li class="card team-card">
                  {m.data.photo ? (
                    <Image
                      src={m.data.photo}
                      alt={t('about.presidentPhotoAlt', { name: m.data.name })}
                      width={480}
                      height={480}
                      class="team-card__photo"
                    />
                  ) : (
                    <span class="team-card__photo team-card__initials" aria-hidden="true">
                      {initials(m.data.name)}
                    </span>
                  )}
                  <div class="flex flex-1 flex-col gap-2 p-6">
                    <h3 class="text-xl font-bold">{m.data.name}</h3>
                    <p class="font-semibold text-gold-dark">{pick(m.data.role, lang)}</p>
                    {m.data.bio && pick(m.data.bio, lang) && (
                      <p class="text-[0.97rem] leading-relaxed">{pick(m.data.bio, lang)}</p>
                    )}
                    {m.data.linkedin && (
                      <a
                        href={m.data.linkedin}
                        class="link-arrow mt-auto pt-2"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        LinkedIn
                        <span class="sr-only">
                          {t('about.onLinkedin', { name: m.data.name })} {t('a11y.externalLink')}
                        </span>
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- A word from our President: the only section allowed its deep teal background. -->
      <section
        id="president"
        class="president on-dark scroll-mt-24 py-20"
        aria-labelledby="president-title"
      >
        <div class="container-site grid items-center gap-12 md:grid-cols-[18rem_1fr]">
          <div class="mx-auto">
            {presidentPhoto ? (
              <Image
                src={presidentPhoto}
                alt={t('about.presidentPhotoAlt', { name: president.name })}
                width={320}
                height={320}
                class="president__photo"
              />
            ) : (
              <span class="badge badge--initials size-56" aria-hidden="true">
                {initials(president.name)}
              </span>
            )}
          </div>
          <figure>
            <h2 class="president__label" id="president-title">
              {t('about.founderTitle')}
            </h2>
            <Quote size={44} class="mb-4 text-gold" stroke-width={1.25} aria-hidden="true" />
            <blockquote class="font-display text-2xl leading-snug text-white italic sm:text-3xl">
              <p>{pick(president.message, lang)}</p>
            </blockquote>
            <figcaption class="mt-6">
              <span class="block font-semibold text-gold">{president.name}</span>
              <span class="text-sm text-cream">{pick(president.title, lang)}</span>
            </figcaption>
            {showProfile && (
              <a href={href('president', lang)} class="btn btn-primary mt-8">
                {t('about.meetPresident')}
                <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
              </a>
            )}
          </figure>
        </div>
      </section>
    </>
  )}
</PageLayout>

<style>
  /* Blue band like the footer; gold text on blue is 4.7:1. */
  .president {
    background: var(--color-primary);
  }
  .president__label {
    margin-block-end: 1.25rem;
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.16em;
    color: var(--color-gold);
  }
  /* Portrait: square, softly rounded, thin gold frame. */
  .president__photo {
    width: 18rem;
    max-width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 3px solid var(--color-gold);
  }
  /* Team: up to three per row, the same square portrait and card height for everyone. */
  .team-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  @media (min-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .team-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }
  .team-card__photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .team-card__initials {
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-cream);
  }
  /* Round badge: cream circle with a thin gold border. */
  .badge {
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 3px solid var(--color-gold);
  }
  .badge--initials {
    font-family: var(--font-display);
    font-size: 3.75rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-cream);
  }

  /* Timeline: year on the left, gold dot on the vertical line, card on the right. */
  .timeline {
    position: relative;
    display: grid;
    gap: 2rem;
    max-width: 56rem;
    margin-inline: auto;
    padding-inline-start: 2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--color-gold);
  }
  .timeline__item {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    inset-inline-start: -2rem;
    top: 0.4rem;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--color-gold);
    box-shadow: 0 0 0 4px var(--color-white);
  }
  .timeline__year {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }
  @media (min-width: 768px) {
    .timeline {
      padding-inline-start: 0;
      gap: 0;
    }
    .timeline::before {
      inset-inline-start: 9rem;
    }
    .timeline__item {
      grid-template-columns: 7rem 1fr;
      gap: 4rem;
      padding-block: 1rem;
    }
    .timeline__item::before {
      inset-inline-start: calc(9rem - 0.45rem);
      top: 1.4rem;
    }
    .timeline__year {
      text-align: end;
      padding-top: 0.15rem;
    }
  }
</style>
