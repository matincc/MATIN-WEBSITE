---
/**
 * About page, in this order: Who We Are (photo, text and NEQ; moved here from the homepage,
 * owner's brief Oct 25 2026), Our Mission (navy), Our Vision (deep teal) and Legal status
 * (aqua) as coloured cards on an ivory band, Our values (six coloured cards), Our story
 * (aqua band), A personal note from our President (owner's About brief, Oct 25 2026: no
 * shortcut buttons, no photo pair). The Persian page shows the values, the story and the
 * founder's note (Who We Are, Mission and Vision have no Persian translation yet) and
 * links to the English page. The President's biography and the team are on the Our Team
 * page (TeamPage.astro).
 */
import { Picture } from 'astro:assets';
import {
  DoorOpen,
  HeartHandshake,
  LayoutGrid,
  MessagesSquare,
  Palette,
  Quote,
  Users,
} from '@lucide/astro';
import PhotoCredit from '@/components/media/PhotoCredit.astro';
import { photos } from '@/lib/photos';
import PageLayout from '@/layouts/PageLayout.astro';
import DialogueArt from '@/components/brand/DialogueArt.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { href, path, siteAlternates, type UiLang } from '@/i18n/routes';
import { faAboutMore } from '@/i18n/fa';
import { useTranslations, pick } from '@/i18n/ui';
import { getSettings, getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const full = lang !== 'fa';
const [settings, about] = await Promise.all([getSettings(), getSingleton('about')]);

// Same accents as the Mission / Vision / Values links on the homepage.
// Persian has only the legal status block (the others have no Persian translation yet).
const blocks: {
  id: string;
  title: string;
  text?: string;
  accent: string;
  /** Card surface: navy and teal are dark cards with white text, aqua a light one. */
  tone: string;
  link?: { href: string; label: string };
  /** Short facts shown as a badge above the text (Legal status: the NEQ). */
  badge?: string;
}[] = [
  ...(full
    ? [
        {
          id: 'mission',
          title: t('about.mission'),
          text: pick(settings.mission, lang),
          accent: 'navy',
          tone: 'navy',
        },
        {
          id: 'vision',
          title: t('about.vision'),
          text: pick(about.vision, lang),
          accent: 'teal',
          tone: 'teal',
        },
      ]
    : []),
  ...(settings.legal
    ? [
        {
          id: 'legal-status',
          title: t('about.legalStatus'),
          text: settings.legal.statement[lang],
          accent: 'mustard',
          tone: 'aqua',
          link: { href: href('legalInfo', lang), label: t('about.legalMore') },
          badge: t('footer.neq', { neq: settings.legal.neq }),
        },
      ]
    : []),
];
// Six coordinated surfaces for the values (owner's brief, Oct 25 2026): dark navy and deep
// teal cards alternate with aqua and champagne ones.
const valueTones = ['navy', 'aqua', 'champagne', 'teal', 'champagne', 'aqua'];

// Thin-line icons, all drawn at the same size and stroke width.
// Equity is four equal squares: never a scale, gavel or other legal symbol.
const icons = {
  dialogue: MessagesSquare,
  respect: HeartHandshake,
  openness: DoorOpen,
  creativity: Palette,
  community: Users,
  equity: LayoutGrid,
};

const president = about.president;

// Paragraphs are separated by a blank line in about.yaml.
const paragraphs = (text?: string) =>
  (text ?? '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
// Years in Persian digits on the Persian page.
const year = (y: string) => (lang === 'fa' ? y.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]) : y);
// Timeline entries shown in this language (Persian only where a Persian text exists).
const history = about.history
  .filter((h) => lang !== 'fa' || (h.title.fa && h.text.fa))
  .map((h) => ({
    year: year(h.year),
    title: pick(h.title, lang)!,
    paragraphs: paragraphs(pick(h.text, lang)),
  }));
const message = paragraphs(lang === 'fa' ? president.message.fa : president.message[lang]);
const founderName = pick(president.displayName, lang) || president.name;
const founderRole = pick(president.signature, lang) || pick(president.title, lang);
---

<PageLayout
  lang={lang}
  title={t('about.title')}
  description={t('about.lede')}
  alternates={siteAlternates('about')}
>
  <!-- Who we are: photo and text side by side -->
  {full && (
    <section id="who-we-are" class="scroll-mt-24 pt-4 pb-20" aria-labelledby="who-we-are-title">
      <div class="container-site who-grid">
        <figure class="who-figure" data-reveal>
          <span class="who-figure__block" aria-hidden="true"></span>
          <div class="who-figure__photo">
            <Picture
              src={photos.tamtams.src}
              alt=""
              formats={['avif', 'webp']}
              widths={[720, 1080, 1440, 1920]}
              sizes="(min-width: 64rem) 100rem, 300vw"
              style={`object-position:${photos.tamtams.focus}`}
            />
          </div>
          <figcaption>
            <PhotoCredit credit={photos.tamtams.credit} />
          </figcaption>
        </figure>
        <div class="who-body">
          <h2 id="who-we-are-title" class="who-title">
            {t('about.whoWeAre')}
          </h2>
          <p class="who-positioning">{t('home.positioning')}</p>
          <p class="who-text">{t('home.whoText')}</p>
          {settings.legal && (
            <p class="who-legal">
              {t('home.legalLine', { neq: settings.legal.neq })} ·{' '}
              <a href={href('legalInfo', lang)} class="font-semibold underline">
                {t('home.legalLink')}
              </a>
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Mission, Vision and Legal status: navy, deep teal and aqua cards on an ivory band -->
  {blocks.length > 0 && (
    <div class="about-band">
      <div class="container-site about-blocks">
        {blocks.map((b) => (
          <section
            id={b.id}
            class:list={[
              'about-block scroll-mt-24',
              b.id === 'legal-status' && 'about-block--legal',
            ]}
            data-accent={b.accent}
            data-tone={b.tone}
            data-reveal
            aria-labelledby={`${b.id}-title`}
          >
            <h2 id={`${b.id}-title`} class="about-block__title">
              {b.title}
            </h2>
            {b.badge && (
              <p class="about-block__badge" dir="ltr">
                {b.badge}
              </p>
            )}
            <p class="about-block__text">{b.text}</p>
            {b.link && (
              <p class="mt-4">
                <a href={b.link.href} class="font-semibold underline">
                  {b.link.label}
                </a>
              </p>
            )}
          </section>
        ))}
      </div>
    </div>
  )}

  <!-- Our values -->
  <section id="values" class="values scroll-mt-24 py-20" aria-labelledby="values-title">
    <div class="container-site">
      <SectionHeader align="start" id="values-title" title={t('about.values')} />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {about.values.map((v, i) => {
          const Icon = icons[v.icon];
          return (
            <li class="value-card" data-tone={valueTones[i % valueTones.length]} data-reveal>
              <span class="value-card__icon" aria-hidden="true">
                <Icon size={30} stroke-width={1.6} />
              </span>
              <h3 class="value-card__title">{pick(v.title, lang)}</h3>
              <p class="value-card__text">{pick(v.text, lang)}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {!full && (
    <section class="values pb-20">
      <p class="container-site text-center">
        {faAboutMore.text}{' '}
        <a href={`${path('about', 'en')}?from=fa`} lang="fa" class="font-semibold underline">
          {faAboutMore.link}
        </a>
      </p>
    </section>
  )}

  <!-- Our story: one entry per milestone in about.yaml (history), oldest first. -->
  <section id="story" class="story section-pad scroll-mt-24" aria-labelledby="history-title">
    <DialogueArt accent="teal" seed="story" class="story__art" />
    <div class="container-site relative">
      <SectionHeader align="start" id="history-title" title={t('about.history')} />
      <ol class="timeline">
        {history.map((h) => (
          <li class="timeline__item" data-reveal>
            <span class="timeline__year">{h.year}</span>
            <article class="timeline__card">
              <h3 class="timeline__title">{h.title}</h3>
              <div class="timeline__text">
                {h.paragraphs.map((para) => (
                  <p>{para}</p>
                ))}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- A personal note from our President: a tall letter on cream, a navy head with the
       quotation badge above the title, the message on ivory, then the signature; framed by
       teal and gold blocks and the dialogue motif; paragraphs on the reading side. -->
  {message.length > 0 && (
    <section id="president" class="founder scroll-mt-24" aria-labelledby="president-title">
      <DialogueArt accent="teal" seed="founder" class="founder__art" />
      <div class="container-site">
        <div class="founder__frame">
          <span class="founder__block founder__block--a" aria-hidden="true"></span>
          <span class="founder__block founder__block--b" aria-hidden="true"></span>
          <figure class="founder__note" data-reveal>
            <header class="founder__head">
              <span class="founder__mark" aria-hidden="true">
                <Quote size={28} stroke-width={1.75} />
              </span>
              <h2 class="founder__title" id="president-title">
                {t('about.founderTitle')}
              </h2>
            </header>
            <div class="founder__body">
              <blockquote class="founder__quote">
                {message.map((para) => (
                  <p>{para}</p>
                ))}
              </blockquote>
              <figcaption class="founder__sign">
                <span class="founder__name">{founderName}</span>
                {founderRole && <span class="founder__role">{founderRole}</span>}
              </figcaption>
            </div>
          </figure>
        </div>
      </div>
    </section>
  )}
</PageLayout>

<style>
  /* ---------- Who we are ---------- */
  .who-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .who-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3.5rem, 2rem + 4vw, 7rem);
    }
  }
  .who-figure {
    position: relative;
    max-width: 34rem;
    margin-inline: auto;
    width: 100%;
  }
  /* Teal block offset behind the photo: a quiet graphic accent. */
  .who-figure__block {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-start: -1.25rem;
    width: 70%;
    height: 82%;
    border-radius: var(--radius-card);
    background: var(--color-teal);
  }
  .who-figure__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    margin-inline-start: 0.75rem;
  }
  /* The Tam-Tams photo is wide with a lot of sky: zoom towards the crowd. */
  .who-figure__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.55);
    transform-origin: 50% 96%;
  }
  .who-figure figcaption {
    margin-inline-start: 0.75rem;
  }
  .who-title {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
  }
  .who-title::after {
    content: '';
    display: block;
    width: 4rem;
    height: 3px;
    margin-block-start: 1rem;
    border-radius: 2px;
    background: var(--color-gold);
  }
  /* Secondary positioning line: below the title, never in place of the slogan. */
  .who-positioning {
    margin-block: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 800;
    color: var(--color-teal-deep);
  }
  .who-text {
    max-width: 42rem;
    font-size: clamp(1.25rem, 1.1rem + 0.55vw, 1.5rem);
    line-height: 1.65;
  }
  .who-legal {
    max-width: 42rem;
    margin-block-start: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: 0.9rem;
    border-inline-start: 4px solid var(--color-gold);
    background: var(--color-ivory);
    font-size: 1.0625rem;
  }

  /* Mission, Vision and Legal status on an ivory band (owner's About brief, Oct 25 2026:
     coordinated navy, deep teal, turquoise and matte-gold cards). */
  .about-band {
    padding-block: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    background: var(--color-ivory);
    border-block: 1px solid var(--color-card-edge);
  }
  .about-blocks {
    display: grid;
    gap: 1.75rem;
  }

  /* Mission and Vision side by side; the compact Legal status card joins them as a third
     column on wide screens (owner's brief, Oct 24 2026: it was too wide for its text). */
  @media (min-width: 56rem) {
    .about-blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-block--legal {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 72rem) {
    .about-blocks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .about-block--legal {
      grid-column: auto;
    }
  }
  /* Persian shows only the Legal status card: keep it compact. */
  .about-block--legal:only-child {
    max-width: 44rem;
  }
  .about-block__badge {
    display: inline-block;
    margin-block-end: 1rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--color-white);
    border: 1px solid var(--color-gold);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  .about-block {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
    border-block-start: 6px solid var(--color-gold);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  /* A quiet flat circle in the corner of each card (no gradient). */
  .about-block::after {
    content: '';
    position: absolute;
    inset-block-end: -4.5rem;
    inset-inline-end: -4.5rem;
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    pointer-events: none;
  }
  .about-block > * {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 40rem) {
    .about-block::after {
      width: 7rem;
      height: 7rem;
      inset-block-end: -3.5rem;
      inset-inline-end: -3.5rem;
    }
  }
  .about-block__title {
    margin-block-end: 1.1rem;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 800;
  }
  .about-block__title::after {
    content: '';
    display: block;
    width: 3rem;
    height: 3px;
    margin-block-start: 0.75rem;
    border-radius: 2px;
    background: var(--color-gold);
  }
  /* Navy (Mission) and deep teal (Vision): white text 11.9:1 and 6.2:1, cream titles. */
  .about-block[data-tone='navy'],
  .about-block[data-tone='teal'] {
    border-color: transparent;
    border-block-start-color: var(--color-gold);
    color: var(--color-white);
  }
  .about-block[data-tone='navy'] {
    background: var(--color-primary);
  }
  .about-block[data-tone='teal'] {
    background: var(--color-teal-deep);
  }
  .about-block[data-tone='navy'] .about-block__title,
  .about-block[data-tone='teal'] .about-block__title {
    color: var(--color-cream);
  }
  .about-block[data-tone='navy']::after {
    background: color-mix(in srgb, var(--color-teal) 30%, transparent);
  }
  .about-block[data-tone='teal']::after {
    background: color-mix(in srgb, var(--color-white) 12%, transparent);
  }
  /* Aqua (Legal status): navy text, gold badge edge. */
  .about-block[data-tone='aqua'] {
    background: var(--color-aqua);
    border-color: var(--color-aqua-edge);
    border-block-start-color: var(--color-gold);
  }
  .about-block[data-tone='aqua']::after {
    background: color-mix(in srgb, var(--color-white) 45%, transparent);
  }
  .about-block__text {
    max-width: 44rem;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem);
    line-height: 1.7;
  }
  /* Our values: six coloured cards on warm white (owner's About brief, Oct 25 2026).
     Navy and deep teal take white text; aqua and champagne take navy and ink. */
  .values {
    background: var(--color-paper);
  }
  .value-card {
    height: 100%;
    padding: 2rem;
    border: 1px solid var(--color-card-edge);
    border-block-start: 5px solid var(--color-gold);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .value-card__icon {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    margin-block-end: 1.25rem;
    border-radius: 1rem;
    background: var(--color-white);
    color: var(--color-primary);
  }
  .value-card__title {
    margin-block-end: 0.5rem;
    font-size: 1.5rem;
    font-weight: 800;
  }
  .value-card[data-tone='navy'],
  .value-card[data-tone='teal'] {
    border-color: transparent;
    border-block-start-color: var(--color-gold);
    color: var(--color-white);
  }
  .value-card[data-tone='navy'] {
    background: var(--color-primary);
  }
  .value-card[data-tone='teal'] {
    background: var(--color-teal-deep);
  }
  .value-card[data-tone='navy'] .value-card__title,
  .value-card[data-tone='teal'] .value-card__title {
    color: var(--color-cream);
  }
  .value-card[data-tone='navy'] .value-card__icon {
    background: color-mix(in srgb, var(--color-white) 12%, var(--color-primary));
    color: var(--color-gold);
  }
  .value-card[data-tone='teal'] .value-card__icon {
    background: var(--color-cream);
    color: var(--color-teal-deep);
  }
  .value-card[data-tone='aqua'] {
    background: var(--color-aqua);
    border-color: var(--color-aqua-edge);
    border-block-start-color: var(--color-primary);
  }
  .value-card[data-tone='champagne'] {
    background: var(--color-champagne);
    border-block-start-color: var(--color-teal);
  }
  /* Round badge: cream circle with a thin gold border. */
  .badge {
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 3px solid var(--color-gold);
  }
  .badge--initials {
    font-family: var(--font-display);
    font-size: 3.75rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-cream);
  }

  /* Our story on an aqua band with the dialogue motif (owner's About brief, Oct 25 2026):
     navy years, a navy line with gold-ringed markers, ivory cards with a gold top edge. */
  .story {
    position: relative;
    overflow: hidden;
    background: var(--color-aqua);
    border-block: 1px solid var(--color-aqua-edge);
  }
  .story :global(.story__art) {
    position: absolute;
    inset-block-end: -5rem;
    inset-inline-start: -6rem;
    width: min(34rem, 70vw);
    opacity: 0.35;
  }
  /* Timeline: year on the left, marker on the vertical line, card on the right. */
  /* Our story: the year in large type on the reading side, a teal marker on the
     line, then a wide card whose paragraphs keep a comfortable measure. */
  .timeline {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-inline-start: 2.25rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.5rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 3px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-primary) 55%, var(--color-aqua));
  }
  .timeline__item {
    position: relative;
    display: grid;
    gap: 1rem;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    inset-inline-start: -2.25rem;
    top: 0.6rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--color-primary);
    box-shadow:
      0 0 0 4px var(--color-gold),
      0 0 0 8px var(--color-aqua);
  }
  .timeline__year {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
  }
  .timeline__card {
    padding: clamp(1.75rem, 1.2rem + 2.5vw, 3.5rem);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
    border-block-start: 6px solid var(--color-gold);
    border-inline-start: 6px solid var(--color-teal-deep);
    border-radius: var(--radius-card);
    background: var(--color-ivory);
  }
  .timeline__title {
    margin-block-end: 1.25rem;
    font-size: clamp(1.75rem, 1.4rem + 1.3vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
  }
  .timeline__text {
    display: grid;
    gap: 1.35rem;
    max-width: 52rem;
    font-size: clamp(1.1875rem, 1.08rem + 0.45vw, 1.4375rem);
    line-height: 1.8;
  }
  /* The invitation that closes the entry stands out a little. */
  .timeline__text > p:last-child:not(:first-child) {
    font-weight: 600;
    color: var(--color-primary);
  }
  @media (min-width: 56rem) {
    .timeline {
      padding-inline-start: 0;
    }
    .timeline::before {
      inset-inline-start: 14rem;
    }
    .timeline__item {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 4rem;
    }
    .timeline__item::before {
      inset-inline-start: calc(14rem - 0.5rem);
      top: 1.1rem;
    }
    .timeline__year {
      text-align: end;
    }
  }

  /* A personal note from our President (owner's About brief, Oct 25 2026: warmer colour,
     a taller letter). On cream: a letter about 50rem wide, a navy head (white title 11.9:1,
     gold badge 5.3:1), the message on ivory (ink 13:1), teal and gold blocks behind two
     corners and the dialogue motif in the background. */
  .founder {
