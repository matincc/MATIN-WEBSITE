---
/**
 * About page, in this order: Who We Are, Our Mission, Our Vision, Our values, Our story,
 * A personal note from our founder. The Persian page shows the values, the story and the
 * founder's note (Who We Are, Mission and Vision have no Persian translation yet) and
 * links to the English page. The President's biography and the team are on the Our Team
 * page (TeamPage.astro).
 */
import {
  DoorOpen,
  HeartHandshake,
  LayoutGrid,
  MessagesSquare,
  Palette,
  Quote,
  Users,
} from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import DialogueArt from '@/components/brand/DialogueArt.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { href, path, siteAlternates, type UiLang } from '@/i18n/routes';
import { faAboutMore } from '@/i18n/fa';
import { useTranslations, pick } from '@/i18n/ui';
import { getSettings, getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const full = lang !== 'fa';
const [settings, about] = await Promise.all([getSettings(), getSingleton('about')]);

// Same accents as the Mission / Vision / Values links on the homepage.
// Persian has only the legal status block (the others have no Persian translation yet).
const blocks: {
  id: string;
  title: string;
  text?: string;
  accent: string;
  link?: { href: string; label: string };
  /** Short facts shown as a badge above the text (Legal status: the NEQ). */
  badge?: string;
}[] = [
  ...(full
    ? [
        { id: 'who-we-are', title: t('about.whoWeAre'), text: t('home.whoText'), accent: 'navy' },
        {
          id: 'mission',
          title: t('about.mission'),
          text: pick(settings.mission, lang),
          accent: 'coral',
        },
        {
          id: 'vision',
          title: t('about.vision'),
          text: pick(about.vision, lang),
          accent: 'mustard',
        },
      ]
    : []),
  ...(settings.legal
    ? [
        {
          id: 'legal-status',
          title: t('about.legalStatus'),
          text: settings.legal.statement[lang],
          accent: 'teal',
          link: { href: href('legalInfo', lang), label: t('about.legalMore') },
          badge: t('footer.neq', { neq: settings.legal.neq }),
        },
      ]
    : []),
];
const valueAccents = ['coral', 'mustard', 'teal', 'terracotta'];

// Thin-line icons, all drawn at the same size and stroke width.
// Equity is four equal squares: never a scale, gavel or other legal symbol.
const icons = {
  dialogue: MessagesSquare,
  respect: HeartHandshake,
  openness: DoorOpen,
  creativity: Palette,
  community: Users,
  equity: LayoutGrid,
};

const president = about.president;

// Paragraphs are separated by a blank line in about.yaml.
const paragraphs = (text?: string) =>
  (text ?? '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
// Years in Persian digits on the Persian page.
const year = (y: string) => (lang === 'fa' ? y.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]) : y);
// Timeline entries shown in this language (Persian only where a Persian text exists).
const history = about.history
  .filter((h) => lang !== 'fa' || (h.title.fa && h.text.fa))
  .map((h) => ({
    year: year(h.year),
    title: pick(h.title, lang)!,
    paragraphs: paragraphs(pick(h.text, lang)),
  }));
const message = paragraphs(lang === 'fa' ? president.message.fa : president.message[lang]);
const founderName = pick(president.displayName, lang) || president.name;
const founderRole = pick(president.signature, lang) || pick(president.title, lang);
---

<PageLayout
  lang={lang}
  title={t('about.title')}
  description={t('about.lede')}
  alternates={siteAlternates('about')}
>
  {blocks.length > 0 && (
    <div class="container-site about-blocks pb-20">
      {blocks.map((b) => (
        <section
          id={b.id}
          class:list={[
            'about-block scroll-mt-24',
            b.id === 'who-we-are' && 'about-block--lead',
            b.id === 'legal-status' && 'about-block--legal',
          ]}
          data-accent={b.accent}
          data-reveal
          aria-labelledby={`${b.id}-title`}
        >
          <h2 id={`${b.id}-title`} class="about-block__title">
            {b.title}
          </h2>
          {b.badge && (
            <p class="about-block__badge" dir="ltr">
              {b.badge}
            </p>
          )}
          <p class="about-block__text">{b.text}</p>
          {b.link && (
            <p class="mt-4">
              <a href={b.link.href} class="font-semibold underline">
                {b.link.label}
              </a>
            </p>
          )}
        </section>
      ))}
    </div>
  )}

  <!-- Our values -->
  <section id="values" class="scroll-mt-24 bg-tint py-20" aria-labelledby="values-title">
    <div class="container-site">
      <SectionHeader align="start" id="values-title" title={t('about.values')} />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {about.values.map((v, i) => {
          const Icon = icons[v.icon];
          return (
            <li class="card value-card p-8" data-accent={valueAccents[i % valueAccents.length]}>
              <span class="value-card__icon" aria-hidden="true">
                <Icon size={30} stroke-width={1.6} />
              </span>
              <h3 class="mb-2 text-2xl font-bold">{pick(v.title, lang)}</h3>
              <p>{pick(v.text, lang)}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {!full && (
    <section class="bg-tint pb-20">
      <p class="container-site text-center">
        {faAboutMore.text}{' '}
        <a href={`${path('about', 'en')}?from=fa`} lang="fa" class="font-semibold underline">
          {faAboutMore.link}
        </a>
      </p>
    </section>
  )}

  <!-- Our story: one entry per milestone in about.yaml (history), oldest first. -->
  <section id="story" class="section-pad scroll-mt-24" aria-labelledby="history-title">
    <div class="container-site">
      <SectionHeader align="start" id="history-title" title={t('about.history')} />
      <ol class="timeline">
        {history.map((h) => (
          <li class="timeline__item" data-reveal>
            <span class="timeline__year">{h.year}</span>
            <article class="timeline__card">
              <h3 class="timeline__title">{h.title}</h3>
              <div class="timeline__text">
                {h.paragraphs.map((para) => (
                  <p>{para}</p>
                ))}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- A personal note from our founder: a light letter on cream, framed by flat colour
       blocks and the dialogue motif; paragraphs on the reading side (right in Persian). -->
  {message.length > 0 && (
    <section id="president" class="founder scroll-mt-24" aria-labelledby="president-title">
      <DialogueArt accent="teal" seed="founder" class="founder__art" />
      <div class="container-site">
        <div class="founder__frame">
          <span class="founder__block founder__block--a" aria-hidden="true"></span>
          <span class="founder__block founder__block--b" aria-hidden="true"></span>
          <figure class="founder__note" data-reveal>
            <header class="founder__head">
              <span class="founder__mark" aria-hidden="true">
                <Quote size={28} stroke-width={1.75} />
              </span>
              <h2 class="founder__title" id="president-title">
                {t('about.founderTitle')}
              </h2>
            </header>
            <blockquote class="founder__quote">
              {message.map((para) => (
                <p>{para}</p>
              ))}
            </blockquote>
            <figcaption class="founder__sign">
              <span class="founder__name">{founderName}</span>
              {founderRole && <span class="founder__role">{founderRole}</span>}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
  )}
</PageLayout>

<style>
  /* Who we are (wide lead), then Mission and Vision side by side on wide screens. */
  .about-blocks {
    display: grid;
    gap: 1.75rem;
  }
  /* Mission and Vision side by side; the compact Legal status card joins them as a third
     column on wide screens (owner's brief, Oct 24 2026: it was too wide for its text). */
  @media (min-width: 56rem) {
    .about-blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-block--lead,
    .about-block--legal {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 72rem) {
    .about-blocks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .about-block--legal {
      grid-column: auto;
    }
  }
  /* Persian shows only the Legal status card: keep it compact. */
  .about-block--legal:only-child {
    max-width: 44rem;
  }
  .about-block__badge {
    display: inline-block;
    margin-block-end: 1rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--color-tint);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  .about-block {
    padding: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
    border-block-start: 6px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  .about-block__title {
    margin-block-end: 1.1rem;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 800;
  }
  .about-block__text {
    max-width: 44rem;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem);
    line-height: 1.7;
  }
  /* The lead block: navy band, larger type, white text (11.9:1). */
  .about-block--lead {
    display: grid;
    gap: 1rem 4rem;
    border: none;
    background: var(--color-primary);
    color: var(--color-cream);
  }
  @media (min-width: 64rem) {
    .about-block--lead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }
  }
  .about-block--lead .about-block__title {
    color: var(--color-white);
  }
  .about-block--lead .about-block__title::after {
    content: '';
    display: block;
    width: 4rem;
    height: 3px;
    margin-block-start: 1rem;
    background: var(--color-gold);
  }
  .about-block--lead .about-block__text {
    max-width: none;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    line-height: 1.6;
  }
  .value-card {
    border-block-start: 5px solid var(--accent);
  }
  .value-card__icon {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    margin-block-end: 1.25rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--accent) 22%, var(--color-white));
    color: var(--color-primary);
  }
  /* Round badge: cream circle with a thin gold border. */
  .badge {
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 3px solid var(--color-gold);
  }
  .badge--initials {
    font-family: var(--font-display);
    font-size: 3.75rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-cream);
  }

  /* Timeline: year on the left, gold dot on the vertical line, card on the right. */
  /* Our story: the year in large type on the reading side, a terracotta marker on the
     line, then a wide card whose paragraphs keep a comfortable measure. */
  .timeline {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-inline-start: 2.25rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.5rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 2px;
    background: color-mix(in srgb, var(--color-terracotta) 45%, var(--color-white));
  }
  .timeline__item {
    position: relative;
    display: grid;
    gap: 1rem;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    inset-inline-start: -2.25rem;
    top: 0.6rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--color-terracotta);
    box-shadow: 0 0 0 5px var(--color-paper);
  }
  .timeline__year {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-terracotta-deep);
  }
  .timeline__card {
    padding: clamp(1.75rem, 1.2rem + 2.5vw, 3.5rem);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
    border-block-start: 6px solid var(--color-terracotta);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  .timeline__title {
    margin-block-end: 1.25rem;
    font-size: clamp(1.75rem, 1.4rem + 1.3vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
  }
  .timeline__text {
    display: grid;
    gap: 1.35rem;
    max-width: 52rem;
    font-size: clamp(1.1875rem, 1.08rem + 0.45vw, 1.4375rem);
    line-height: 1.8;
  }
  /* The invitation that closes the entry stands out a little. */
  .timeline__text > p:last-child:not(:first-child) {
    font-weight: 600;
    color: var(--color-primary);
  }
  @media (min-width: 56rem) {
    .timeline {
      padding-inline-start: 0;
    }
    .timeline::before {
      inset-inline-start: 14rem;
    }
    .timeline__item {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 4rem;
    }
    .timeline__item::before {
      inset-inline-start: calc(14rem - 0.5rem);
      top: 1.1rem;
    }
    .timeline__year {
      text-align: end;
    }
  }

  /* A personal note from our founder: a white letter on cream, about 52rem wide, with
     two flat colour blocks behind its corners and the dialogue motif in the background.
     Text on white: ink 14:1, navy 11.9:1, terracotta-deep labels 6.8:1. */
  .founder {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 2.5rem + 5vw, 7.5rem);
    background: var(--color-tint);
  }
  .founder :global(.founder__art) {
    position: absolute;
    inset-block-start: -4rem;
    inset-inline-end: -6rem;
    width: min(38rem, 70vw);
    opacity: 0.45;
  }
  .founder__frame {
    position: relative;
    max-width: 56rem;
    margin-inline: auto;
  }
  .founder__block {
    position: absolute;
    border-radius: var(--radius-card);
  }
  .founder__block--a {
    inset-block-start: -1rem;
    inset-inline-start: -1rem;
    width: 9rem;
    height: 9rem;
    background: var(--color-gold);
  }
  .founder__block--b {
    inset-block-end: -1rem;
    inset-inline-end: -1rem;
    width: 40%;
    height: 7rem;
    background: var(--color-terracotta);
  }
  .founder__note {
    position: relative;
    padding: clamp(2rem, 1.2rem + 3.5vw, 4.5rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  .founder__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block-end: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    padding-block-end: 1.5rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-gold) 60%, transparent);
  }
  .founder__mark {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-gold);
  }
  .founder__title {
    font-size: clamp(1.625rem, 1.25rem + 1.4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
  }
  /* Paragraphs on the reading side, a comfortable measure and generous spacing. */
  .founder__quote {
    display: grid;
    gap: 1.4rem;
    max-width: 46rem;
    font-size: clamp(1.1875rem, 1.08rem + 0.45vw, 1.4375rem);
    line-height: 1.8;
    color: var(--color-ink);
    text-align: start;
  }
  /* The opening paragraph a little larger, the closing invitation a little warmer. */
  .founder__quote > p:first-child {
    font-size: 1.08em;
    color: var(--color-primary);
  }
  .founder__quote > p:last-child:not(:first-child) {
    font-weight: 600;
    color: var(--color-primary);
  }
  .founder__sign {
    display: grid;
    gap: 0.3rem;
    justify-items: start;
    margin-block-start: 2.5rem;
  }
  .founder__sign::before {
    content: '';
    width: 4rem;
    height: 3px;
    margin-block-end: 1rem;
    border-radius: 2px;
    background: var(--color-gold);
  }
  .founder__name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
    font-weight: 800;
    color: var(--color-primary);
  }
  .founder__role {
    font-size: 1.0625rem;
    color: var(--color-terracotta-deep);
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .founder__block--a {
      width: 5rem;
      height: 5rem;
      inset-block-start: -0.6rem;
      inset-inline-start: -0.6rem;
    }
    .founder__block--b {
      inset-block-end: -0.6rem;
      inset-inline-end: -0.6rem;
      height: 4rem;
    }
  }
</style>
