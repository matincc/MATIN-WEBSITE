---
/**
 * About page, in this order: Who We Are, Our Mission, Our Vision, Our President,
 * Our values, Our story, Our team, A word from our President. The Persian page shows
 * the values, Our President and the team (the other texts have no Persian translation
 * yet) and links to the English page.
 */
import { Image } from 'astro:assets';
import {
  DoorOpen,
  HeartHandshake,
  LayoutGrid,
  MessagesSquare,
  Palette,
  Quote,
  Users,
} from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PresidentSection from '@/components/content/PresidentSection.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { path, siteAlternates, type UiLang } from '@/i18n/routes';
import { faAboutMore } from '@/i18n/fa';
import { useTranslations, pick } from '@/i18n/ui';
import { forLang, getSettings, getSingleton, getTeam, initials } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const full = lang !== 'fa';
const [settings, about, teamAll] = await Promise.all([
  getSettings(),
  getSingleton('about'),
  getTeam(),
]);
const team = forLang(teamAll, lang);

// Same accents as the Mission / Vision / Values links on the homepage.
const blocks = [
  { id: 'who-we-are', title: t('about.whoWeAre'), text: t('home.whoText'), accent: 'navy' },
  {
    id: 'mission',
    title: t('about.mission'),
    text: pick(settings.mission, lang),
    accent: 'coral',
  },
  { id: 'vision', title: t('about.vision'), text: pick(about.vision, lang), accent: 'mustard' },
];
const valueAccents = ['coral', 'mustard', 'teal', 'terracotta'];

// Thin-line icons, all drawn at the same size and stroke width.
// Equity is four equal squares: never a scale, gavel or other legal symbol.
const icons = {
  dialogue: MessagesSquare,
  respect: HeartHandshake,
  openness: DoorOpen,
  creativity: Palette,
  community: Users,
  equity: LayoutGrid,
};

const president = about.president;
---

<PageLayout
  lang={lang}
  title={t('about.title')}
  lede={t('about.lede')}
  alternates={siteAlternates('about')}
>
  {full && (
    <div class="container-site about-blocks pb-20">
      {blocks.map((b, i) => (
        <section
          id={b.id}
          class:list={['about-block scroll-mt-24', i === 0 && 'about-block--lead']}
          data-accent={b.accent}
          data-reveal
          aria-labelledby={`${b.id}-title`}
        >
          <h2 id={`${b.id}-title`} class="about-block__title">
            {b.title}
          </h2>
          <p class="about-block__text">{b.text}</p>
        </section>
      ))}
    </div>
  )}

  {full && <PresidentSection lang={lang} />}

  <!-- Our values -->
  <section id="values" class="scroll-mt-24 bg-tint py-20" aria-labelledby="values-title">
    <div class="container-site">
      <SectionHeader align="start" id="values-title" title={t('about.values')} />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {about.values.map((v, i) => {
          const Icon = icons[v.icon];
          return (
            <li class="card value-card p-8" data-accent={valueAccents[i % valueAccents.length]}>
              <span class="value-card__icon" aria-hidden="true">
                <Icon size={30} stroke-width={1.6} />
              </span>
              <h3 class="mb-2 text-2xl font-bold">{pick(v.title, lang)}</h3>
              <p>{pick(v.text, lang)}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {!full && (
    <section class="bg-tint pb-20">
      <p class="container-site text-center">
        {faAboutMore.text}{' '}
        <a href={`${path('about', 'en')}?from=fa`} lang="fa" class="font-semibold underline">
          {faAboutMore.link}
        </a>
      </p>
    </section>
  )}

  {!full && (
    <>
      <PresidentSection lang={lang} />
      <!-- Our team: published members only; hidden while there are none -->
      {team.length > 0 && (
        <section id="team" class="scroll-mt-24 bg-tint py-20" aria-labelledby="team-title">
          <div class="container-site">
            <SectionHeader align="start" id="team-title" title={t('about.team')} />
            <ul class="team-grid">
              {team.map((m) => (
                <li class="card team-card">
                  {m.data.photo ? (
                    <Image
                      src={m.data.photo}
                      alt={t('about.presidentPhotoAlt', { name: m.data.name })}
                      width={480}
                      height={480}
                      class="team-card__photo"
                    />
                  ) : (
                    <span class="team-card__photo team-card__initials" aria-hidden="true">
                      {initials(m.data.name)}
                    </span>
                  )}
                  <div class="flex flex-1 flex-col gap-2 p-6">
                    <h3 class="text-xl font-bold">{m.data.name}</h3>
                    <p class="font-semibold text-gold-dark">{pick(m.data.role, lang)}</p>
                    {m.data.bio && pick(m.data.bio, lang) && (
                      <p class="text-[0.97rem] leading-relaxed">{pick(m.data.bio, lang)}</p>
                    )}
                    {m.data.linkedin && (
                      <a
                        href={m.data.linkedin}
                        class="link-arrow mt-auto pt-2"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        LinkedIn
                        <span class="sr-only">
                          {t('about.onLinkedin', { name: m.data.name })} {t('a11y.externalLink')}
                        </span>
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </>
  )}

  {full && (
    <>
      <!-- Our story -->
      <section id="story" class="container-site scroll-mt-24 py-20" aria-labelledby="history-title">
        <SectionHeader align="start" id="history-title" title={t('about.history')} />
        <ol class="timeline">
          {about.history.map((h) => (
            <li class="timeline__item">
              <span class="timeline__year">{h.year}</span>
              <div class="card p-6 sm:p-10">
                <h3 class="mb-3 text-2xl font-bold">{pick(h.title, lang)}</h3>
                <p class="text-lg leading-relaxed">{pick(h.text, lang)}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- Our team: published members only; hidden while there are none -->
      {team.length > 0 && (
        <section id="team" class="scroll-mt-24 bg-tint py-20" aria-labelledby="team-title">
          <div class="container-site">
            <SectionHeader align="start" id="team-title" title={t('about.team')} />
            <ul class="team-grid">
              {team.map((m) => (
                <li class="card team-card">
                  {m.data.photo ? (
                    <Image
                      src={m.data.photo}
                      alt={t('about.presidentPhotoAlt', { name: m.data.name })}
                      width={480}
                      height={480}
                      class="team-card__photo"
                    />
                  ) : (
                    <span class="team-card__photo team-card__initials" aria-hidden="true">
                      {initials(m.data.name)}
                    </span>
                  )}
                  <div class="flex flex-1 flex-col gap-2 p-6">
                    <h3 class="text-xl font-bold">{m.data.name}</h3>
                    <p class="font-semibold text-gold-dark">{pick(m.data.role, lang)}</p>
                    {m.data.bio && pick(m.data.bio, lang) && (
                      <p class="text-[0.97rem] leading-relaxed">{pick(m.data.bio, lang)}</p>
                    )}
                    {m.data.linkedin && (
                      <a
                        href={m.data.linkedin}
                        class="link-arrow mt-auto pt-2"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        LinkedIn
                        <span class="sr-only">
                          {t('about.onLinkedin', { name: m.data.name })} {t('a11y.externalLink')}
                        </span>
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- A word from our President: the only section allowed its deep teal background. -->
      <section
        id="president"
        class="president on-dark scroll-mt-24 py-20"
        aria-labelledby="president-title"
      >
        <div class="container-site max-w-4xl text-center">
          <figure>
            <h2 class="president__label" id="president-title">
              {t('about.founderTitle')}
            </h2>
            <Quote
              size={44}
              class="mx-auto mb-4 text-gold"
              stroke-width={1.25}
              aria-hidden="true"
            />
            <blockquote class="font-display text-2xl leading-snug text-white italic sm:text-3xl">
              <p>{pick(president.message, lang)}</p>
            </blockquote>
            <figcaption class="mt-6">
              <span class="block font-semibold text-gold">{president.name}</span>
              <span class="text-sm text-cream">{pick(president.title, lang)}</span>
            </figcaption>
          </figure>
        </div>
      </section>
    </>
  )}
</PageLayout>

<style>
  /* Who we are (wide lead), then Mission and Vision side by side on wide screens. */
  .about-blocks {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 56rem) {
    .about-blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-block--lead {
      grid-column: 1 / -1;
    }
  }
  .about-block {
    padding: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    border: 1px solid var(--color-line);
    border-block-start: 6px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  .about-block__title {
    margin-block-end: 1.1rem;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 800;
  }
  .about-block__text {
    max-width: 44rem;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem);
    line-height: 1.7;
  }
  /* The lead block: navy band, larger type, white text (11.9:1). */
  .about-block--lead {
    display: grid;
    gap: 1rem 4rem;
    border: none;
    background: var(--color-primary);
    color: var(--color-cream);
  }
  @media (min-width: 64rem) {
    .about-block--lead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }
  }
  .about-block--lead .about-block__title {
    color: var(--color-white);
  }
  .about-block--lead .about-block__title::after {
    content: '';
    display: block;
    width: 4rem;
    height: 3px;
    margin-block-start: 1rem;
    background: var(--color-gold);
  }
  .about-block--lead .about-block__text {
    max-width: none;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    line-height: 1.6;
  }
  .value-card {
    border-block-start: 5px solid var(--accent);
  }
  .value-card__icon {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    margin-block-end: 1.25rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--accent) 22%, var(--color-white));
    color: var(--color-primary);
  }
  /* Navy band like the footer; mustard text on navy is 5.3:1. */
  .president {
    background: var(--color-primary);
  }
  .president__label {
    margin-block-end: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.16em;
    color: var(--color-gold);
  }
  /* Team: up to three per row, the same square portrait and card height for everyone. */
  .team-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  @media (min-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .team-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }
  .team-card__photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .team-card__initials {
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-cream);
  }
  /* Round badge: cream circle with a thin gold border. */
  .badge {
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 3px solid var(--color-gold);
  }
  .badge--initials {
    font-family: var(--font-display);
    font-size: 3.75rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-cream);
  }

  /* Timeline: year on the left, gold dot on the vertical line, card on the right. */
  .timeline {
    position: relative;
    display: grid;
    gap: 2rem;
    max-width: 64rem;
    padding-inline-start: 2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--color-teal);
  }
  .timeline__item {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    inset-inline-start: -2rem;
    top: 0.4rem;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--color-coral);
    box-shadow: 0 0 0 4px var(--color-paper);
  }
  .timeline__year {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }
  @media (min-width: 768px) {
    .timeline {
      padding-inline-start: 0;
      gap: 0;
    }
    .timeline::before {
      inset-inline-start: 9rem;
    }
    .timeline__item {
      grid-template-columns: 7rem 1fr;
      gap: 4rem;
      padding-block: 1rem;
    }
    .timeline__item::before {
      inset-inline-start: calc(9rem - 0.45rem);
      top: 1.4rem;
    }
    .timeline__year {
      text-align: end;
      padding-top: 0.15rem;
    }
  }
</style>
