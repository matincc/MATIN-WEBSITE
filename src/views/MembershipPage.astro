---
/**
 * Become a Member (owner's request, Oct 28 2026). 1. The three membership categories
 * (individual, organization, elected officials) as accent cards, with the note that
 * membership is free until December 31, 2027 (owner's decision, Oct 28 2026). 2. The application form (Netlify form
 * « adhesion ») beside the three steps of the process. Linked from the footer and the
 * Contact page, not from the header menu.
 */
import { ArrowRight, Building, Landmark, User } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import MembershipForm from '@/components/forms/MembershipForm.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = [
  {
    id: 'individual',
    icon: User,
    accent: 'navy',
    title: t('membership.individualTitle'),
    who: t('membership.individualWho'),
    rights: t('membership.individualRights'),
  },
  {
    id: 'organization',
    icon: Building,
    accent: 'mustard',
    title: t('membership.organizationTitle'),
    who: t('membership.organizationWho'),
    rights: t('membership.organizationRights'),
  },
  {
    id: 'elected',
    icon: Landmark,
    accent: 'teal',
    title: t('membership.electedTitle'),
    who: t('membership.electedWho'),
    rights: t('membership.electedRights'),
  },
];
const steps = [t('membership.step1'), t('membership.step2'), t('membership.step3')];
const nf = new Intl.NumberFormat(lang === 'fa' ? 'fa-IR' : 'en-CA');
---

<PageLayout
  lang={lang}
  title={t('membership.title')}
  description={t('membership.metaDescription')}
  lede={t('membership.lede')}
  ledeStrong
  alternates={siteAlternates('membership')}
>
  <section
    id="categories"
    class="categories-band scroll-mt-24 py-16 sm:py-20"
    aria-labelledby="categories-title"
  >
    <div class="container-site">
      <SectionHeader
        align="start"
        id="categories-title"
        title={t('membership.typesTitle')}
        subtitle={t('membership.typesSubtitle')}
      />
      <ul class="category-grid">
        {categories.map((c) => (
          <li class="card category-card" data-accent={c.accent} data-reveal>
            <span class="category-card__icon" aria-hidden="true">
              <c.icon size={26} />
            </span>
            <h3 class="category-card__title">{c.title}</h3>
            <p>{c.who}</p>
            <p class="category-card__rights">{c.rights}</p>
          </li>
        ))}
      </ul>
      <p class="fee-note">{t('membership.feeNote')}</p>
    </div>
  </section>

  <section id="apply" class="apply-band scroll-mt-24 py-16 sm:py-20" aria-labelledby="apply-title">
    <div class="container-site grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:items-start">
      <div class="card form-panel p-6 sm:p-10">
        <h2 id="apply-title" class="mb-3 text-3xl font-bold">
          {t('membership.formTitle')}
        </h2>
        <p class="mb-8 text-lg">{t('membership.formIntro')}</p>
        <MembershipForm lang={lang} />
      </div>
      <aside class="card steps-card p-8" aria-labelledby="steps-title">
        <h2 id="steps-title" class="mb-6 text-2xl font-bold">
          {t('membership.stepsTitle')}
        </h2>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="steps__n" aria-hidden="true">
                {nf.format(i + 1)}
              </span>
              <span>{s}</span>
            </li>
          ))}
        </ol>
        <p class="mt-8 mb-4 font-semibold">{t('membership.questions')}</p>
        <a href={`${href('contact', lang)}#write`} class="btn btn-outline">
          {t('nav.contact')}
          <ArrowRight size={18} class="rtl:-scale-x-100" aria-hidden="true" />
        </a>
      </aside>
    </div>
  </section>
</PageLayout>

<style>
  .categories-band {
    background: var(--color-paper);
  }
  .category-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  /* Three ways to join (owner, Oct 31 2026: the cards were the colour of the page): each card
     has its own full colour (navy, saffron, turquoise), one deep corner and its own height. */
  .category-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 2rem 1.85rem;
    border: 0;
    border-radius: 1.25rem;
    border-start-end-radius: 4.5rem;
    font-size: 1.1rem;
    line-height: 1.7;
    box-shadow: 0 18px 36px -24px color-mix(in srgb, var(--matin-encre) 60%, transparent);
  }
  .category-card[data-accent='navy'] {
    --card-bg: var(--matin-encre);
    --card-fg: var(--matin-white);
    --card-tile: var(--matin-soleil);
    --card-tile-fg: var(--matin-encre);
  }
  .category-card[data-accent='mustard'] {
    --card-bg: var(--matin-soleil);
    --card-fg: var(--matin-encre);
    --card-tile: var(--matin-encre);
    --card-tile-fg: var(--matin-soleil);
    border-start-end-radius: 1.25rem;
    border-end-start-radius: 4.5rem;
  }
  .category-card[data-accent='teal'] {
    --card-bg: var(--matin-firouzeh-ink);
    --card-fg: var(--matin-white);
    --card-tile: var(--matin-white);
    --card-tile-fg: var(--matin-firouzeh-ink);
  }
  .category-card.category-card {
    background: var(--card-bg);
    color: var(--card-fg);
  }
  @media (min-width: 64rem) {
    .category-grid {
      align-items: start;
    }
    .category-card[data-accent='mustard'] {
      margin-block-start: 2.5rem;
    }
    .category-card[data-accent='teal'] {
      margin-block-start: 1.25rem;
    }
  }
  .category-card__icon {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: var(--card-tile);
    color: var(--card-tile-fg);
  }
  .category-card__title {
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 800;
    color: inherit;
  }
  .category-card__rights {
    margin-block-start: auto;
    padding-block-start: 0.9rem;
    border-block-start: 2px solid color-mix(in srgb, currentColor 35%, transparent);
    font-weight: 700;
    color: inherit;
  }
  /* « Membership is free until December 31, 2027 » stands out (owner, Oct 31 2026):
     bold, larger, in the editorial serif and terracotta, on a pale saffron ribbon. */
  .fee-note {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    margin-block-start: 2.5rem;
    padding: 1rem 1.6rem;
    border-radius: 999px;
    border-start-start-radius: 0.5rem;
    background: color-mix(in srgb, var(--matin-soleil) 24%, var(--matin-white));
    border: 2px solid var(--matin-soleil);
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.85rem);
    font-weight: 800;
    line-height: 1.35;
    color: var(--matin-brique-ink);
  }
  .fee-note::before {
    content: '';
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--matin-soleil);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--matin-soleil) 35%, transparent);
  }
  :global(html[lang='fa']) .fee-note {
    font-family: var(--font-display);
  }
  .apply-band {
    background: var(--color-teal-pale);
    border-block: 1px solid var(--color-teal-edge);
  }
  .form-panel {
    background: var(--color-ivory);
    border-block-start: 6px solid var(--color-gold);
  }
  .steps-card {
    background: var(--color-white);
    border-block-start: 6px solid var(--color-teal);
  }
  .steps {
    display: grid;
    gap: 1.1rem;
  }
  .steps li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    line-height: 1.6;
  }
  .steps__n {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 800;
  }
</style>
