---
/**
 * Our Team (French, English and Persian), in three parts (owner's brief, Oct 24 2026):
 * the President (portrait and biography, from src/content/about/about.yaml), the
 * Executive Team (people who coordinate and manage day-to-day operations) and the
 * Advisors & Friends of Matin (voluntary contributors, never presented as staff).
 * Members are the published entries in src/content/team/, placed by their `group`.
 * Board members (governance) are kept apart and not shown here yet.
 * No empty cards: a section without members shows one short line instead. (The former
 * silhouette places, PersonSilhouette.astro, are kept for later use.)
 */
import { Image } from 'astro:assets';
import { ChevronDown, ExternalLink } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PresidentSection from '@/components/content/PresidentSection.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Prose from '@/components/ui/Prose.astro';
import { siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { forLang, getTeam, initials, renderMarkdown } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const team = forLang(await getTeam(), lang);
const groups = [
  {
    id: 'executive-team',
    title: t('nav.teamExecutive'),
    lede: t('team.executiveLede'),
    empty: t('team.executiveEmpty'),
    members: team.filter((m) => m.data.group === 'executive' || m.data.group === 'staff'),
    accent: 'teal',
    accents: ['navy', 'teal', 'mustard'],
  },
  {
    id: 'advisors',
    title: t('nav.teamAdvisors'),
    lede: t('team.advisorsLede'),
    empty: t('team.advisorsEmpty'),
    members: team.filter((m) => m.data.group === 'advisor'),
    accent: 'mustard',
    accents: ['teal', 'mustard', 'navy'],
  },
];
---

<PageLayout lang={lang} title={t('nav.team')} alternates={siteAlternates('team')}>
  <PresidentSection lang={lang} />

  <!-- "#team" is kept for older links to the team section. The two groups sit side by
       side as compact panels; a group with members spans the full width. -->
  <section id="team" class="team-groups scroll-mt-24" aria-label={t('nav.team')}>
    <div class="container-site team-groups__grid">
      {groups.map((g) => (
        <section
          id={g.id}
          class:list={[
            'team-group card scroll-mt-24',
            g.members.length > 0 && 'team-group--full',
          ]}
          data-accent={g.accent}
          aria-labelledby={`${g.id}-title`}
        >
          <SectionHeader
            id={`${g.id}-title`}
            title={g.title}
            subtitle={g.lede}
            align="start"
            class="mb-5"
          />
          {g.members.length > 0 ? (
            <ul class="team-grid">
              {g.members.map((m, i) => {
                const bio = m.data.bio && pick(m.data.bio, lang);
                const full = m.data.fullBio && pick(m.data.fullBio, lang);
                return (
                  <li class="card team-card" data-accent={g.accents[i % g.accents.length]}>
                    {m.data.photo ? (
                      <Image
                        src={m.data.photo}
                        alt={t('team.photoAlt', { name: m.data.name })}
                        width={480}
                        height={480}
                        class="team-card__photo"
                      />
                    ) : (
                      <span class="team-card__photo team-card__initials" aria-hidden="true">
                        {initials(m.data.name)}
                      </span>
                    )}
                    <div class="team-card__body">
                      <h3 class="team-card__name">{m.data.name}</h3>
                      <p class="team-card__role">{pick(m.data.role, lang)}</p>
                      {bio && <p class="team-card__bio">{bio}</p>}
                      {full && (
                        <details class="team-card__more">
                          <summary>
                            {t('team.readMore')}
                            <ChevronDown size={18} aria-hidden="true" />
                          </summary>
                          <Prose html={renderMarkdown(full, lang)} class="team-card__full" />
                        </details>
                      )}
                      {m.data.linkedin && (
                        <a
                          href={m.data.linkedin}
                          class="team-card__linkedin"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {t('team.linkedin')}
                          <ExternalLink size={16} aria-hidden="true" />
                          <span class="sr-only">
                            {t('about.onLinkedin', { name: m.data.name })}{' '}
                            {t('a11y.externalLink')}
                          </span>
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="team-empty">{g.empty}</p>
          )}
        </section>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  /* Up to four across on wide screens; the same square portrait for everyone. */
  .team-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  @media (min-width: 80rem) {
    .team-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .team-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-block-start: 5px solid var(--accent);
  }
  .team-card__photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .team-card__initials {
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-cream);
  }
  .team-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.6rem 1.75rem;
  }
  .team-card__name {
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .team-card__role {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent-ink);
  }
  .team-card__bio {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  /* "Read the full biography": a native disclosure, keyboard accessible. */
  .team-card__more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-primary);
  }
  .team-card__more summary::-webkit-details-marker {
    display: none;
  }
  .team-card__more summary :global(svg) {
    transition: transform 0.2s;
  }
  .team-card__more[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .team-card__more :global(.team-card__full) {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .team-card__linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
  }
  /* The two groups on a cream band: compact panels side by side on wide screens. */
  .team-groups {
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
    background: var(--color-cream);
  }
  .team-groups__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 56rem) {
    .team-groups__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .team-group {
    padding: clamp(1.5rem, 1.1rem + 1.5vw, 2.5rem);
    border-block-start: 5px solid var(--accent);
  }
  .team-group--full {
    grid-column: 1 / -1;
  }
  .team-group :global(.section-title) {
    font-size: clamp(1.75rem, 1.45rem + 1.1vw, 2.375rem);
  }
  .team-group :global(.section-subtitle) {
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  /* A group without members: one short, honest line. */
  .team-empty {
    max-width: 40rem;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-gold);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card__more summary :global(svg) {
      transition: none;
    }
  }
</style>
