---
/**
 * Our Team (French, English and Persian), in three parts (owner's brief, Oct 24 2026):
 * the President (portrait and biography, from src/content/about/about.yaml), the
 * Executive Team (people who coordinate and manage day-to-day operations) and the
 * Advisors & Friends of Matin (voluntary contributors, never presented as staff).
 * Members are the published entries in src/content/team/, placed by their `group`.
 * Board members (governance) are kept apart and not shown here yet.
 * Layout: the Executive Team on a soft turquoise panel showing only its members (owner's
 * request, Oct 28 2026), then, in place of the former Advisors & Friends list, one invitation
 * to share one's expertise as a volunteer or advisor, linked to the volunteer form on the
 * contact page (owner's request, Oct 28 2026; `#advisors` kept for the menu and older links).
 * Adding a member is one YAML file in src/content/team/ (name, role, photo, bio, LinkedIn).
 * Between the two, « What Culture Means to Us » (owner's brief, Oct 29 2026): three members'
 * own words on culture (CultureVoices.astro, texts in src/lib/cultureVoices.ts).
 */
import { Image } from 'astro:assets';
import {
  ArrowDown,
  ArrowRight,
  ArrowUpRight,
  ChevronDown,
  Globe,
  HandHeart,
  Lightbulb,
  MapPin,
} from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PresidentSection from '@/components/content/PresidentSection.astro';
import CultureVoices from '@/components/content/CultureVoices.astro';
import { cultureVoices } from '@/lib/cultureVoices';
import { teamText } from '@/lib/teamStrings';
import '@/styles/name-tag.css';
import teamCollabPhoto from '@/assets/photos/team-collaboration.jpg';
import Prose from '@/components/ui/Prose.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { forLang, getTeam, initials, renderMarkdown } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const team = forLang(await getTeam(), lang);
const executive = team.filter((m) => m.data.group === 'executive' || m.data.group === 'staff');
// Each person keeps one colour across the page: the field behind the photo and the name
// tag here, and the same tag in « What Culture Means to Us » below.
const tones: Record<string, string> = {
  '01-reza-moafi-executive-director': 'encre',
  '02-mina-karimian': 'brique',
  '03-hakan': 'caramel',
  '04-benoit-akpaki': 'cocoa',
};
// Board of Directors (owner's word, Oct 30 2026): the three founding members. Names and
// photos come from their existing team entries; only the board role is set here.
const board = (
  [
    ['01-reza-moafi-executive-director', 'team.boardExecutive'],
    ['02-mina-karimian', 'team.boardTreasurer'],
    ['04-benoit-akpaki', 'team.boardSecretary'],
  ] as const
)
  .map(([id, role]) => {
    const m = team.find((x) => x.id === id);
    return m && { id, role: t(role), name: (lang === 'fa' && m.data.nameFa) || m.data.name, photo: m.data.photo };
  })
  .filter((m) => m !== undefined);
const voiceIds = new Set(cultureVoices.map((v) => v.member));
const volunteerHref = `${href('collaboration', lang)}#${lang === 'fr' ? 'benevolat' : 'volunteer'}`;
// Experts join the Advisory Circle (owner's request, Oct 31 2026).
const advisorsHref = `${href('collaboration', lang)}#${advisorsAnchor(lang)}`;
const advCta = advisorStrings(lang).teamCta;
const joinWays = [
  { icon: MapPin, label: t('team.joinWayInPerson') },
  { icon: Globe, label: t('team.joinWayOnline') },
  { icon: HandHeart, label: t('team.joinWayVolunteer') },
  { icon: Lightbulb, label: t('team.joinWayAdvisor') },
];
import { advisorStrings, advisorsAnchor } from '@/i18n/advisors';
---

<PageLayout accent="encre" lang={lang} title={t('nav.team')} alternates={siteAlternates('team')}>
  <PresidentSection lang={lang} />

  <!-- "#team" is kept for older links to the team section. -->
  <section id="team" class="team-groups scroll-mt-24" aria-label={t('nav.team')}>
    <div class="container-site team-groups__stack">
      {/* Board of Directors first, above the Executive Team (owner, Oct 31 2026). */}
      {board.length > 0 && (
        <section id="board" class="board scroll-mt-24" aria-labelledby="board-title" data-reveal>
          <span class="board__sun" aria-hidden="true" />
          <header class="board__head">
            <h2 id="board-title" class="board__title">{t('team.boardTitle')}</h2>
            <p class="board__lede">{t('team.boardLede')}</p>
          </header>
          {/* Owner, Oct 31 2026: less rigid. Arched portraits at different heights that slide
             in and drift gently; a sideways, swipeable row on phones and tablets. */}
          <ul class="board__list">
            {board.map((m, i) => (
              <li class="board__member" style={`--i: ${i}`}>
                <div class="board__frame">
                  <span class="board__field" aria-hidden="true" />
                  {m.photo ? (
                    <Image
                      src={m.photo}
                      alt={t('team.photoAlt', { name: m.name })}
                      widths={[240, 360, 480]}
                      sizes="(min-width: 64rem) 16rem, 70vw"
                      class="board__photo"
                    />
                  ) : (
                    <span class="board__photo board__initials" aria-hidden="true">
                      {initials(m.name)}
                    </span>
                  )}
                </div>
                <span class="board__role">{m.role}</span>
                <span class="board__name">{m.name}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section id="executive-team" class="crew scroll-mt-24" aria-labelledby="executive-team-title">
        <header class="crew__head">
          <div>
            <p class="crew__kicker">{teamText('peopleBehind', lang)}</p>
            <h2 id="executive-team-title" class="crew__title">
              {t('nav.teamExecutive')}
            </h2>
          </div>
          <p class="crew__lede">{t('team.executiveLede')}</p>
        </header>
        {executive.length === 0 && <p class="team-empty">{t('team.executiveEmpty')}</p>}
        <ul class="crew__list">
          {executive.map((m, i) => {
            const bio = m.data.bio && pick(m.data.bio, lang);
            const full = m.data.fullBio && pick(m.data.fullBio, lang);
            const name = (lang === 'fa' && m.data.nameFa) || m.data.name;
            const voice = voiceIds.has(m.id);
            return (
              <li
                class="crew__member"
                data-tone={tones[m.id] ?? 'brique'}
                data-reveal
                style={`--reveal-delay:${i * 140}ms`}
              >
                <div class="crew__frame">
                  <span class="crew__field" aria-hidden="true" />
                  {m.data.photo ? (
                    <Image
                      src={m.data.photo}
                      alt={t('team.photoAlt', { name })}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 64rem) 19rem, (min-width: 36rem) 42vw, 72vw"
                      class="crew__photo"
                    />
                  ) : (
                    <span class="crew__photo crew__initials" aria-hidden="true">
                      {initials(m.data.name)}
                    </span>
                  )}
                </div>
                <div class="crew__tag name-tag" data-tone={tones[m.id] ?? 'brique'}>
                  <span class="name-tag__hole" aria-hidden="true" />
                  <span class="name-tag__who">
                    <h3 class="name-tag__name">{name}</h3>
                    <span class="name-tag__role">{pick(m.data.role, lang)}</span>
                  </span>
                </div>
                {bio && <p class="crew__bio">{bio}</p>}
                {full && (
                  <details class="crew__more">
                    <summary>
                      {t('team.readMore')}
                      <ChevronDown size={18} aria-hidden="true" />
                    </summary>
                    <Prose html={renderMarkdown(full, lang)} class="crew__full" />
                  </details>
                )}
                {voice && (
                  <a href={`#voice-${m.id}`} class="crew__link">
                    {teamText('inWords', lang, { name: name.split(' ')[0] })}
                    <ArrowDown size={16} aria-hidden="true" />
                  </a>
                )}
                {m.data.linkedin && (
                  <a
                    href={m.data.linkedin}
                    class="crew__link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t('team.linkedin')}
                    <ArrowUpRight size={16} aria-hidden="true" />
                    <span class="sr-only">
                      {t('about.onLinkedin', { name })} {t('a11y.externalLink')}
                    </span>
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </section>

      <CultureVoices lang={lang} />

      <section id="advisors" class="team-join scroll-mt-24" aria-labelledby="advisors-title">
        <div class="team-join__text">
          <h2 id="advisors-title" class="team-group__title">
            {t('team.joinTitle')}
          </h2>
          <p class="team-join__lede">{t('team.joinText')}</p>
          <ul class="team-join__ways">
            {joinWays.map((w) => (
              <li>
                <w.icon size={18} aria-hidden="true" />
                {w.label}
              </li>
            ))}
          </ul>
          <a href={volunteerHref} class="btn btn-primary team-join__cta">
            {t('team.joinCta')}
            <ArrowRight size={18} aria-hidden="true" class="rtl:-scale-x-100" />
          </a>
          <a href={advisorsHref} class="btn btn-secondary team-join__cta team-join__cta--adv">
            {advCta}
            <ArrowRight size={18} aria-hidden="true" class="rtl:-scale-x-100" />
          </a>
        </div>
        <figure class="team-join__art" aria-hidden="true">
          <Image
            src={teamCollabPhoto}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(min-width: 56rem) 40vw, 92vw"
            class="team-join__img team-join__photo"
          />
          <span class="team-join__block"></span>
        </figure>
      </section>
    </div>
  </section>
</PageLayout>

<style>
  /* The two groups stacked (owner's brief, Oct 25 2026), each a full-width panel. */
  /* A coloured ground behind the two panels (owner's brief, Oct 27 2026: no plain white). */
  /* Warmer (owner's request, Oct 29 2026): ivory ground with a quiet sun ring. */
  .team-groups {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    background: var(--team-ground, var(--color-ivory));
  }
  .team-groups::before {
    content: '';
    position: absolute;
    inset-block-start: 40%;
    inset-inline-start: clamp(-8rem, -3rem - 6vw, -3rem);
    width: clamp(12rem, 6rem + 16vw, 24rem);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.5rem solid color-mix(in srgb, var(--color-soleil) 30%, var(--color-ivory));
  }
  .team-groups__stack {
    position: relative;
  }
  .team-groups__stack {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  /* The invitation to collaborate (owner's request, Oct 28 2026): warm cream, a teal top
     edge, the text beside the community illustration on a mustard block. */
  .team-join {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding: clamp(1.5rem, 0.75rem + 3vw, 3.5rem);
    border-radius: calc(var(--radius-card) * 1.4);
    border-start-start-radius: 8rem;
    border-end-end-radius: 4rem;
    /* Warm terracotta with white text (owner, Oct 31 2026: the sable panel was pale). */
    background: var(--matin-brique-ink);
    color: var(--matin-white);
  }
  .team-join .team-group__title,
  .team-join .team-join__lede {
    color: var(--matin-white);
  }
  .team-join :focus-visible {
    outline-color: var(--matin-soleil);
  }
  @media (min-width: 56rem) {
    .team-join {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }
  .team-join__lede {
    max-width: 44rem;
    margin-block-start: 1rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.8;
    color: var(--color-ink);
  }
  .team-join__ways {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 1.5rem;
  }
  .team-join__ways li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    /* Light saffron chips with navy text on the terracotta panel, lighter than the saffron
       button so they read as labels (owner, Oct 31 2026: not white). */
    color: var(--matin-encre);
    background: color-mix(in srgb, var(--matin-soleil) 45%, var(--matin-ivoire));
  }
  .team-join__ways li:nth-child(2n) {
    translate: 0 0.4rem;
  }
  .team-join__cta {
    margin-block-start: 1.75rem;
  }
  .team-join__art {
    position: relative;
    width: 100%;
    max-width: 28rem;
    justify-self: center;
    padding-block-end: 1rem;
  }
  .team-join__art :global(.team-join__img) {
    position: relative;
    z-index: 1;
  }
  /* The owner's photo of people working together (Oct 31 2026), in place of the drawing:
     rounded, one deep corner, a white mount, the saffron sun behind it. */
  .team-join__art :global(.team-join__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 55% 40%;
    border: 6px solid var(--matin-ivoire);
    border-radius: 1.25rem;
    border-start-end-radius: 4rem;
    box-shadow: 0 18px 36px -20px color-mix(in srgb, var(--matin-encre) 70%, transparent);
  }
  .team-join__block {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: -1rem;
    width: 55%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-soleil);
  }
  .team-group__title {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 1.5rem + 1.6vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-primary);
  }
  .team-group__lede {
    margin-block-start: 0.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-ink);
  }
  .team-empty {
    margin-block-start: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  /* ---------- The Executive Team: a photographic spread, not cards ----------
     (owner's brief « The People Behind Matin », Oct 29 2026). Four equal portraits, each
     on its own colour field offset behind it, at different heights; each name on the
     same paper tag the person wears in « What Culture Means to Us » below. No panel. */
  .crew {
    padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem) 0;
  }
  .crew__head {
    display: grid;
    gap: 1rem 3rem;
    align-items: end;
    max-width: 78rem;
    margin-inline: auto;
    margin-block-end: clamp(2.75rem, 2rem + 3vw, 4.5rem);
  }
  @media (min-width: 56rem) {
    .crew__head {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
  .crew__kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brique-ink);
  }
  .crew__kicker::before {
    content: '';
    width: 2.5rem;
    height: 3px;
    border-radius: 2px;
    background: var(--color-soleil);
  }
  :global(html[lang='fa']) .crew__kicker {
    letter-spacing: 0;
    font-size: 1.05rem;
  }
  .crew__title {
    margin-block-start: 0.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.35rem, 1.5rem + 3vw, 4.25rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 144;
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--color-primary);
  }
  :global(html[lang='fa']) .crew__title {
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0;
  }
  .crew__lede {
    max-width: 30rem;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .crew__list {
    display: grid;
    gap: 3.5rem 2rem;
    max-width: 78rem;
    margin-inline: auto;
  }
  .crew__member {
    --field: var(--matin-brique-ink);
    --shift: 1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .crew__member[data-tone='encre'] {
    --field: var(--matin-firouzeh);
  }
  .crew__member[data-tone='caramel'] {
    --field: color-mix(in srgb, var(--matin-soleil) 70%, var(--matin-brique));
  }
  .crew__member[data-tone='cocoa'] {
    --field: color-mix(in srgb, var(--matin-brique-ink) 55%, var(--matin-nuit));
  }
  .crew__frame {
    position: relative;
    width: 100%;
  }
  /* The colour field, offset behind the photo: down and towards the end, or the start. */
  .crew__field {
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    background: var(--field);
    translate: var(--shift) var(--shift);
  }
  :global([dir='rtl']) .crew__field {
    translate: calc(var(--shift) * -1) var(--shift);
  }
  .crew__member:nth-child(even) .crew__field {
    translate: calc(var(--shift) * -1) var(--shift);
  }
  :global([dir='rtl']) .crew__member:nth-child(even) .crew__field {
    translate: var(--shift) var(--shift);
  }
  .crew__photo {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: 0.5rem;
  }
  /* One deep corner, alternating from portrait to portrait (logical, so Persian mirrors). */
  .crew__member:nth-child(4n + 1) :is(.crew__photo, .crew__field) {
    border-start-start-radius: 5rem;
  }
  .crew__member:nth-child(4n + 2) :is(.crew__photo, .crew__field) {
    border-end-end-radius: 5rem;
  }
  .crew__member:nth-child(4n + 3) :is(.crew__photo, .crew__field) {
    border-start-end-radius: 5rem;
  }
  .crew__member:nth-child(4n + 4) :is(.crew__photo, .crew__field) {
    border-end-start-radius: 5rem;
  }
  .crew__initials {
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-primary);
    background: var(--color-sable);
  }
  /* The tag overlaps the bottom of the photo, on alternate sides. */
  .crew__tag {
    max-width: 92%;
    margin-block-start: -2.25rem;
    margin-inline-start: -0.5rem;
    rotate: -1.5deg;
  }
  .crew__member:nth-child(even) .crew__tag {
    align-self: flex-end;
    margin-inline: 0 -0.5rem;
    rotate: 1.5deg;
  }
  .crew__bio {
    margin-block-start: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .crew__more {
    margin-block-start: 0.75rem;
  }
  .crew__more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-primary);
  }
  .crew__more summary::-webkit-details-marker {
    display: none;
  }
  .crew__more[open] summary :global(svg) {
    rotate: 180deg;
  }
  .crew__more :global(.crew__full) {
    margin-block-start: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .crew__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    margin-block-start: 0.85rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-firouzeh-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-firouzeh-ink) 35%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.3s ease;
  }
  .crew__member:nth-child(even) .crew__link {
    align-self: flex-end;
  }
  .crew__link + .crew__link {
    margin-block-start: 0;
  }
  .crew__link:hover {
    text-decoration-color: currentColor;
  }

  /* Phones: one portrait after the other, alternately on the start and end side. */
  .crew__member {
    width: min(78%, 22rem);
  }
  .crew__member:nth-child(even) {
    justify-self: end;
  }
  /* Tablets: two by two, the second column lower. */
  @media (min-width: 36rem) {
    .crew__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem clamp(2.5rem, 1rem + 4vw, 4rem);
    }
    .crew__member,
    .crew__member:nth-child(even) {
      width: auto;
      justify-self: stretch;
    }
    .crew__member:nth-child(even) {
      margin-block-start: 4rem;
    }
  }
  /* Wide screens: four across at four different heights, like prints pinned on a wall. */
  @media (min-width: 64rem) {
    .crew__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: clamp(2rem, 0.5rem + 2.5vw, 3.5rem);
    }
    .crew__member:nth-child(4n + 1) {
      margin-block-start: 0;
    }
    .crew__member:nth-child(4n + 2) {
      margin-block-start: 4.5rem;
    }
    .crew__member:nth-child(4n + 3) {
      margin-block-start: 1.5rem;
    }
    .crew__member:nth-child(4n + 4) {
      margin-block-start: 6rem;
    }
  }

  /* Hover: the photo rises, its colour field slides out a little, the tag straightens.
     The state also applies under reduced motion, without movement (owner, Oct 29 2026). */
  @media (hover: hover) {
    .crew__photo,
    .crew__field,
    .crew__tag {
      transition:
        translate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
