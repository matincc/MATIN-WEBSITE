---
/**
 * Our Team (French, English and Persian), in three parts (owner's brief, Oct 24 2026):
 * the President (portrait and biography, from src/content/about/about.yaml), the
 * Executive Team (people who coordinate and manage day-to-day operations) and the
 * Advisors & Friends of Matin (voluntary contributors, never presented as staff).
 * Members are the published entries in src/content/team/, placed by their `group`.
 * Board members (governance) are kept apart and not shown here yet.
 * Layout (owner's brief, Oct 25 2026): the two groups stacked, Executive Team first on a soft
 * turquoise panel, then Advisors on warm cream; each shows five places: published members
 * first, then neutral "Profile coming soon" places (never invented people). Adding a member
 * is one YAML file in src/content/team/ (name, role, photo, bio, LinkedIn); it takes the
 * next place, and a group with more than five members simply grows.
 */
import { Image } from 'astro:assets';
import { ChevronDown, ExternalLink } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PresidentSection from '@/components/content/PresidentSection.astro';
import PersonSilhouette from '@/components/content/PersonSilhouette.astro';
import Prose from '@/components/ui/Prose.astro';
import { siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { forLang, getTeam, initials, renderMarkdown } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const team = forLang(await getTeam(), lang);
const SLOTS = 5;
const groups = [
  {
    id: 'executive-team',
    title: t('nav.teamExecutive'),
    lede: t('team.executiveLede'),
    empty: t('team.executiveEmpty'),
    members: team.filter((m) => m.data.group === 'executive' || m.data.group === 'staff'),
    accent: 'teal',
    accents: ['navy', 'teal', 'mustard'],
  },
  {
    id: 'advisors',
    title: t('nav.teamAdvisors'),
    lede: t('team.advisorsLede'),
    empty: t('team.advisorsEmpty'),
    members: team.filter((m) => m.data.group === 'advisor'),
    accent: 'mustard',
    accents: ['teal', 'mustard', 'navy'],
  },
];
---

<PageLayout lang={lang} title={t('nav.team')} alternates={siteAlternates('team')}>
  <PresidentSection lang={lang} />

  <!-- "#team" is kept for older links to the team section. -->
  <section id="team" class="team-groups scroll-mt-24" aria-label={t('nav.team')}>
    <div class="container-site team-groups__stack">
      {groups.map((g) => (
        <section
          id={g.id}
          class:list={['team-group scroll-mt-24', `team-group--${g.id}`]}
          data-accent={g.accent}
          aria-labelledby={`${g.id}-title`}
        >
          <div class="team-group__head">
            <h2 id={`${g.id}-title`} class="team-group__title">
              {g.title}
            </h2>
            <p class="team-group__lede">{g.lede}</p>
            {g.members.length === 0 && <p class="team-empty">{g.empty}</p>}
          </div>
          <ul class="team-grid">
            {g.members.map((m, i) => {
              const bio = m.data.bio && pick(m.data.bio, lang);
              const full = m.data.fullBio && pick(m.data.fullBio, lang);
              return (
                <li class="team-card" data-accent={g.accents[i % g.accents.length]}>
                  {m.data.photo ? (
                    <Image
                      src={m.data.photo}
                      alt={t('team.photoAlt', { name: m.data.name })}
                      width={320}
                      height={320}
                      class="team-card__avatar"
                    />
                  ) : (
                    <span class="team-card__avatar team-card__initials" aria-hidden="true">
                      {initials(m.data.name)}
                    </span>
                  )}
                  <div class="team-card__body">
                    <h3 class="team-card__name">{m.data.name}</h3>
                    <p class="team-card__role">{pick(m.data.role, lang)}</p>
                    {bio && <p class="team-card__bio">{bio}</p>}
                    {full && (
                      <details class="team-card__more">
                        <summary>
                          {t('team.readMore')}
                          <ChevronDown size={18} aria-hidden="true" />
                        </summary>
                        <Prose html={renderMarkdown(full, lang)} class="team-card__full" />
                      </details>
                    )}
                    {m.data.linkedin && (
                      <a
                        href={m.data.linkedin}
                        class="team-card__linkedin"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {t('team.linkedin')}
                        <ExternalLink size={16} aria-hidden="true" />
                        <span class="sr-only">
                          {t('about.onLinkedin', { name: m.data.name })} {t('a11y.externalLink')}
                        </span>
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
            {Array.from({ length: Math.max(0, SLOTS - g.members.length) }, () => (
              <li class="team-card team-card--soon">
                <span class="team-card__avatar team-card__silhouette" aria-hidden="true">
                  <PersonSilhouette figure="neutral" />
                </span>
                <div class="team-card__body">
                  <p class="team-card__soon">{t('team.comingSoon')}</p>
                  <p class="team-card__group">{g.title}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  /* The two groups stacked (owner's brief, Oct 25 2026), each a full-width panel. */
  .team-groups {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .team-groups__stack {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .team-group {
    padding: clamp(1.1rem, 0.5rem + 2.75vw, 3.5rem);
    border-radius: calc(var(--radius-card) * 1.4);
  }
  /* Executive Team: soft turquoise, navy headings, a matte gold edge. */
  .team-group--executive-team {
    border: 1px solid var(--color-aqua-edge);
    border-block-start: 5px solid var(--color-gold);
    background: var(--color-aqua);
  }
  /* Advisors & Friends: warm cream, teal accents. */
  .team-group--advisors {
    border: 1px solid var(--color-card-edge);
    border-block-start: 5px solid var(--color-teal);
    background: var(--color-cream);
  }
  .team-group__head {
    max-width: 48rem;
    margin-block-end: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem);
  }
  .team-group__title {
    font-size: clamp(1.875rem, 1.5rem + 1.3vw, 2.625rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
  }
  .team-group__lede {
    margin-block-start: 0.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-ink);
  }
  .team-empty {
    margin-block-start: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  /* Five across when they fit comfortably, three on tablets, two on phones; an
     incomplete last row stays centred. */
  .team-grid {
    --cols: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
  .team-grid > li {
    flex: 0 0 calc((100% - (var(--cols) - 1) * 1.25rem) / var(--cols));
  }
  @media (min-width: 40rem) {
    .team-grid {
      --cols: 3;
    }
  }
  @media (min-width: 80rem) {
    .team-grid {
      --cols: 5;
    }
  }
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding: 1.75rem clamp(0.5rem, 0.25rem + 1vw, 1.25rem) 1.5rem;
    border: 1px solid var(--color-card-edge);
    border-block-start: 4px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    box-shadow: var(--shadow-card);
    text-align: center;
  }
  .team-card__avatar {
    display: block;
    flex-shrink: 0;
    width: clamp(6rem, 5rem + 3vw, 8rem);
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 4px var(--color-paper),
      0 0 0 6px var(--color-gold);
  }
  .team-card__initials {
    display: grid;
    place-items: center;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary);
    background: var(--color-cream);
  }
  .team-card__silhouette {
    overflow: hidden;
    background: var(--color-ivory);
  }
  .team-group--executive-team .team-card__silhouette {
    background: var(--color-aqua);
  }
  .team-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    margin-block-start: 1.25rem;
  }
  .team-card__name {
    font-size: 1.3125rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .team-card__role {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent-ink);
  }
  .team-card__bio {
    font-size: 1rem;
    line-height: 1.65;
    text-align: start;
  }
  /* A place not filled yet: same card, quieter text, no invented details. */
  .team-card--soon {
    border-style: dashed;
    border-block-start-style: solid;
    border-block-start-color: var(--color-gold);
    box-shadow: none;
    background: color-mix(in srgb, var(--color-paper) 70%, transparent);
  }
  .team-group--advisors .team-card--soon {
    border-block-start-color: var(--color-teal);
  }
  .team-card__soon {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    font-weight: 800;
    color: var(--color-primary);
  }
  .team-card__group {
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  /* "Read the full biography": a native disclosure, keyboard accessible. */
  .team-card__more {
    width: 100%;
  }
  .team-card__more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-primary);
  }
  .team-card__more summary::-webkit-details-marker {
    display: none;
  }
  .team-card__more summary :global(svg) {
    transition: transform 0.2s;
  }
  .team-card__more[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .team-card__more :global(.team-card__full) {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.7;
    text-align: start;
  }
  .team-card__linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card__more summary :global(svg) {
      transition: none;
    }
  }
</style>
