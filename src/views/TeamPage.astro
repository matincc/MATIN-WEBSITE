---
/**
 * Our Team (French, English and Persian), in three parts (owner's brief, Oct 24 2026):
 * the President (portrait and biography, from src/content/about/about.yaml), the
 * Executive Team (people who coordinate and manage day-to-day operations) and the
 * Advisors & Friends of Matin (voluntary contributors, never presented as staff).
 * Members are the published entries in src/content/team/, placed by their `group`.
 * Board members (governance) are kept apart and not shown here yet.
 * Layout: the Executive Team on a soft turquoise panel showing only its members (owner's
 * request, Oct 28 2026), then, in place of the former Advisors & Friends list, one invitation
 * to share one's expertise as a volunteer or advisor, linked to the volunteer form on the
 * contact page (owner's request, Oct 28 2026; `#advisors` kept for the menu and older links).
 * Adding a member is one YAML file in src/content/team/ (name, role, photo, bio, LinkedIn).
 */
import { Image } from 'astro:assets';
import { ArrowRight, ChevronDown, ExternalLink, Globe, HandHeart, Lightbulb, MapPin } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PresidentSection from '@/components/content/PresidentSection.astro';
import CommunityIllustration from '@/components/brand/CommunityIllustration.astro';
import Prose from '@/components/ui/Prose.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { forLang, getTeam, initials, renderMarkdown } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const team = forLang(await getTeam(), lang);
const groups = [
  {
    id: 'executive-team',
    title: t('nav.teamExecutive'),
    lede: t('team.executiveLede'),
    empty: t('team.executiveEmpty'),
    members: team.filter((m) => m.data.group === 'executive' || m.data.group === 'staff'),
    accent: 'teal',
    accents: ['navy', 'teal', 'mustard'],
  },
];
const volunteerHref = `${href('contact', lang)}#${lang === 'fr' ? 'benevolat' : 'volunteer'}`;
const joinWays = [
  { icon: MapPin, label: t('team.joinWayInPerson') },
  { icon: Globe, label: t('team.joinWayOnline') },
  { icon: HandHeart, label: t('team.joinWayVolunteer') },
  { icon: Lightbulb, label: t('team.joinWayAdvisor') },
];
---

<PageLayout lang={lang} title={t('nav.team')} alternates={siteAlternates('team')}>
  <PresidentSection lang={lang} />

  <!-- "#team" is kept for older links to the team section. -->
  <section id="team" class="team-groups scroll-mt-24" aria-label={t('nav.team')}>
    <div class="container-site team-groups__stack">
      {groups.map((g) => (
        <section
          id={g.id}
          class:list={['team-group scroll-mt-24', `team-group--${g.id}`]}
          data-accent={g.accent}
          aria-labelledby={`${g.id}-title`}
        >
          <div class="team-group__head">
            <h2 id={`${g.id}-title`} class="team-group__title">
              {g.title}
            </h2>
            <p class="team-group__lede">{g.lede}</p>
            {g.members.length === 0 && <p class="team-empty">{g.empty}</p>}
          </div>
          <ul class="team-grid">
            {g.members.map((m, i) => {
              const bio = m.data.bio && pick(m.data.bio, lang);
              const full = m.data.fullBio && pick(m.data.fullBio, lang);
              const name = (lang === 'fa' && m.data.nameFa) || m.data.name;
              return (
                <li class="team-card" data-accent={g.accents[i % g.accents.length]}>
                  {m.data.photo ? (
                    <Image
                      src={m.data.photo}
                      alt={t('team.photoAlt', { name })}
                      width={320}
                      height={320}
                      class="team-card__avatar"
                    />
                  ) : (
                    <span class="team-card__avatar team-card__initials" aria-hidden="true">
                      {initials(m.data.name)}
                    </span>
                  )}
                  <div class="team-card__body">
                    <h3 class="team-card__name">{name}</h3>
                    <p class="team-card__role">{pick(m.data.role, lang)}</p>
                    {bio && <p class="team-card__bio">{bio}</p>}
                    {full && (
                      <details class="team-card__more">
                        <summary>
                          {t('team.readMore')}
                          <ChevronDown size={18} aria-hidden="true" />
                        </summary>
                        <Prose html={renderMarkdown(full, lang)} class="team-card__full" />
                      </details>
                    )}
                    {m.data.linkedin && (
                      <a
                        href={m.data.linkedin}
                        class="team-card__linkedin"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {t('team.linkedin')}
                        <ExternalLink size={16} aria-hidden="true" />
                        <span class="sr-only">
                          {t('about.onLinkedin', { name })} {t('a11y.externalLink')}
                        </span>
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      <section id="advisors" class="team-join scroll-mt-24" aria-labelledby="advisors-title">
        <div class="team-join__text">
          <h2 id="advisors-title" class="team-group__title">{t('team.joinTitle')}</h2>
          <p class="team-join__lede">{t('team.joinText')}</p>
          <ul class="team-join__ways">
            {joinWays.map((w) => (
              <li>
                <w.icon size={18} aria-hidden="true" />
                {w.label}
              </li>
            ))}
          </ul>
          <a href={volunteerHref} class="btn btn-primary team-join__cta">
            {t('team.joinCta')}
            <ArrowRight size={18} aria-hidden="true" class="rtl:-scale-x-100" />
          </a>
        </div>
        <figure class="team-join__art" aria-hidden="true">
          <CommunityIllustration class="team-join__img" />
          <span class="team-join__block"></span>
        </figure>
      </section>
    </div>
  </section>
</PageLayout>

<style>
  /* The two groups stacked (owner's brief, Oct 25 2026), each a full-width panel. */
  /* A coloured ground behind the two panels (owner's brief, Oct 27 2026: no plain white). */
  .team-groups {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
    background: var(--team-ground, var(--color-teal-deep));
  }
  .team-groups__stack {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .team-group {
    padding: clamp(1.1rem, 0.5rem + 2.75vw, 3.5rem);
    border-radius: calc(var(--radius-card) * 1.4);
  }
  /* Executive Team: soft turquoise, navy headings, a matte gold edge. */
  .team-group--executive-team {
    border: 1px solid var(--color-aqua-edge);
    border-block-start: 5px solid var(--color-gold);
    background: var(--color-aqua);
  }
  /* The invitation to collaborate (owner's request, Oct 28 2026): warm cream, a teal top
     edge, the text beside the community illustration on a mustard block. */
  .team-join {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding: clamp(1.5rem, 0.75rem + 3vw, 3.5rem);
    border: 1px solid var(--color-card-edge);
    border-block-start: 5px solid var(--color-teal);
    border-radius: calc(var(--radius-card) * 1.4);
    background: var(--color-cream);
  }
  @media (min-width: 56rem) {
    .team-join {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }
  .team-join__lede {
    max-width: 44rem;
    margin-block-start: 1rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.8;
    color: var(--color-ink);
  }
  .team-join__ways {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 1.5rem;
  }
  .team-join__ways li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--color-teal-edge);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-teal-deep);
    background: var(--color-paper);
  }
  .team-join__cta {
    margin-block-start: 1.75rem;
  }
  .team-join__art {
    position: relative;
    width: 100%;
    max-width: 28rem;
    justify-self: center;
    padding-block-end: 1rem;
  }
  .team-join__art :global(.team-join__img) {
    position: relative;
    z-index: 1;
  }
  .team-join__block {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: -1rem;
    width: 45%;
    height: 55%;
    border-radius: var(--radius-card);
    background: var(--color-gold);
  }
  .team-group__head {
    max-width: 48rem;
    margin-block-end: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem);
  }
  .team-group__title {
    font-size: clamp(1.875rem, 1.5rem + 1.3vw, 2.625rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
  }
  .team-group__lede {
    margin-block-start: 0.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-ink);
  }
  .team-empty {
    margin-block-start: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  /* Five across when they fit comfortably, three on tablets, two on phones; an
     incomplete last row stays centred. */
  .team-grid {
    --cols: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
  .team-grid > li {
    flex: 0 0 calc((100% - (var(--cols) - 1) * 1.25rem) / var(--cols));
  }
  @media (min-width: 40rem) {
    .team-grid {
      --cols: 3;
    }
  }
  @media (min-width: 80rem) {
    .team-grid {
      --cols: 5;
    }
  }
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Every card the same size (owner's brief, Oct 27 2026): cards in a row stretch to
       the tallest, and one shared minimum keeps both groups alike. */
    min-height: var(--team-card-min, 21rem);
    padding: 1.75rem clamp(0.5rem, 0.25rem + 1vw, 1.25rem) 1.5rem;
    border: 1px solid var(--color-card-edge);
    border-block-start: 4px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    box-shadow: var(--shadow-card);
    text-align: center;
  }
  .team-card__avatar {
    display: block;
    flex-shrink: 0;
    width: clamp(6rem, 5rem + 3vw, 8rem);
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 4px var(--color-paper),
      0 0 0 6px var(--color-gold);
  }
  .team-card__initials {
    display: grid;
    place-items: center;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary);
    background: var(--color-cream);
  }
  .team-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    margin-block-start: 1.25rem;
  }
  /* Name and title clearly apart (owner's brief, Oct 27 2026): a larger navy name, then a
     smaller terracotta title under a short gold rule. */
  .team-card__name {
    font-size: clamp(1.3125rem, 1.2rem + 0.4vw, 1.5rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-primary);
  }
  .team-card__role {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-terracotta-deep);
  }
  .team-card__role::before {
    content: '';
    display: block;
    width: 2rem;
    height: 2px;
    margin: 0.15rem auto 0.55rem;
    border-radius: 1px;
    background: var(--color-gold);
  }
  .team-card__bio {
    font-size: 1rem;
    line-height: 1.65;
    text-align: start;
  }
  /* "Read the full biography": a native disclosure, keyboard accessible. */
  .team-card__more {
    width: 100%;
  }
  .team-card__more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-primary);
  }
  .team-card__more summary::-webkit-details-marker {
    display: none;
  }
  .team-card__more summary :global(svg) {
    transition: transform 0.2s;
  }
  .team-card__more[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .team-card__more :global(.team-card__full) {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.7;
    text-align: start;
  }
  .team-card__linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card__more summary :global(svg) {
      transition: none;
    }
  }
</style>
