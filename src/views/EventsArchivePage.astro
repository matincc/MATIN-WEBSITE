---
/** Past events archive: reports, photos and highlights, newest first. */
import PageLayout from '@/layouts/PageLayout.astro';
import EventCardWide from '@/components/content/EventCardWide.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getPastEvents } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const past = await getPastEvents();
---

<PageLayout
  accent="brique"
  lang={lang}
  title={t('events.archiveTitle')}
  lede={t('events.archiveLede')}
  alternates={siteAlternates('eventsArchive')}
  crumbs={[{ label: t('events.title'), href: href('events', lang) }]}
>
  <section class="container-site pt-4 pb-24">
    {past.length > 0 ? (
      <ul class="grid gap-6 lg:grid-cols-2">
        {past.map((event) => (
          <li>
            <EventCardWide event={event} lang={lang} past />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">{t('events.archiveEmpty')}</p>
    )}
  </section>
</PageLayout>
