---
/**
 * Legal Information: the institute's legal identity (names, nonprofit status,
 * legal basis, official domain and email, address). The address is the city only
 * (Montréal, Québec, Canada) unless a street address is set in site.yaml.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getDocuments, getSettings } from '@/lib/content';
import { pick } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = await getSettings();
const legal = s.legal!;
// Annual reports and governance (NGO review, Oct 30 2026): always shown, with the real
// documents once published (src/content/documents/), never a sample.
const docs = (await getDocuments()).filter((d) => d.data.file && !d.data.placeholder);
const a = legal.registeredAddress;
const domain = new URL(legal.website).host;
const email = legal.email;

const rows: { label: string; value: string; href?: string; ltr?: boolean }[] = [
  { label: t('legalInfo.status'), value: t('legalInfo.statusValue') },
  { label: t('legalInfo.jurisdiction'), value: t('legalInfo.jurisdictionValue') },
  { label: t('legalInfo.basis'), value: t('legalInfo.basisValue') },
  { label: t('legalInfo.registry'), value: t('legalInfo.registryValue') },
  { label: t('legalInfo.representative'), value: legal.representative, ltr: true },
  { label: t('legalInfo.website'), value: domain, href: legal.website, ltr: true },
  ...(email
    ? [{ label: t('legalInfo.email'), value: email, href: `mailto:${email}`, ltr: true }]
    : []),
];
---

<PageLayout
  accent="encre"
  lang={lang}
  title={t('legalInfo.title')}
  lede={t('legalInfo.lede')}
  alternates={siteAlternates('legalInfo')}
>
  <div class="container-site legal-stack grid max-w-4xl gap-8 pt-4 pb-24">
    <section class="card p-6 sm:p-12" aria-labelledby="statement-title">
      <h2 id="statement-title" class="mb-5 text-3xl font-bold sm:text-4xl">
        {t('legalInfo.status')}
      </h2>
      <p class="text-lg leading-relaxed">{legal.statement[lang]}</p>
      <p class="mt-4 text-lg leading-relaxed">{t('legalInfo.operator')}</p>
    </section>

    <section class="card p-6 sm:p-12" aria-labelledby="details-title">
      <h2 id="details-title" class="mb-6 text-3xl font-bold sm:text-4xl">
        {t('legalInfo.detailsTitle')}
      </h2>
      <dl class="legal-list">
        <div>
          <dt>{t('legalInfo.names')}</dt>
          <dd>
            <ul class="space-y-1">
              <li>
                <span lang="fr">{legal.names.fr}</span>{' '}
                <span class="text-muted">({t('legalInfo.nameFr')})</span>
              </li>
              <li>
                <span lang="en">{legal.names.en}</span>{' '}
                <span class="text-muted">({t('legalInfo.nameEn')})</span>
              </li>
              <li>
                <span lang="fa" dir="rtl">
                  {legal.names.fa}
                </span>{' '}
                <span class="text-muted">({t('legalInfo.nameFa')})</span>
              </li>
            </ul>
          </dd>
        </div>
        {rows.map((r) => (
          <div>
            <dt>{r.label}</dt>
            <dd dir={r.ltr ? 'ltr' : undefined} class={r.ltr && lang === 'fa' ? 'text-right' : ''}>
              {r.href ? (
                <a href={r.href} class="break-all">
                  {r.value}
                </a>
              ) : (
                r.value
              )}
            </dd>
          </div>
        ))}
        <div>
          <dt>{t('legalInfo.address')}</dt>
          {a ? (
            <dd dir="ltr" class={lang === 'fa' ? 'text-right' : ''}>
              <address class="not-italic">
                {a.street}
                <br />
                {a.city}, {a.province}
                <br />
                {a.postalCode}
                <br />
                {a.country}
              </address>
            </dd>
          ) : (
            <dd>
              <address class="not-italic">{t('legalInfo.addressValue')}</address>
            </dd>
          )}
        </div>
      </dl>
    </section>

    <section id="documents" class="card legal-docs p-6 sm:p-12" aria-labelledby="docs-title">
      <h2 id="docs-title" class="mb-4 text-3xl font-bold sm:text-4xl">{t('about.documents')}</h2>
      <p class="text-lg leading-relaxed">{t('about.documentsLede')}</p>
      {
        docs.length ? (
          <ul class="mt-6 space-y-3">
            {docs.map((d) => (
              <li>
                <a href={d.data.file} class="text-lg font-semibold" download>
                  {pick(d.data.title, lang)} ({d.data.year}) · {t('about.download')}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="legal-docs__empty mt-6 text-lg leading-relaxed">{t('about.documentsEmpty')}</p>
        )
      }
    </section>
  </div>
</PageLayout>

<style>
  /* Less regular (owner's request, Oct 29 2026): the two cards are offset from each
     other, the first one on a sand ground with the sun in its corner. */
  .legal-stack > section:first-child {
    position: relative;
    overflow: hidden;
    background: var(--color-sable);
    border-color: transparent;
  }
  .legal-stack > section:first-child::after {
    content: '';
    position: absolute;
    inset-block-end: -2.5rem;
    inset-inline-end: 2.5rem;
    width: 5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-soleil);
  }
  @media (min-width: 48rem) {
    .legal-stack > section:first-child {
      margin-inline-end: 4rem;
    }
    .legal-stack > section:nth-child(2) {
      margin-inline-start: 4rem;
    }
  }
  .legal-docs {
    border-block-start: 5px solid var(--color-firouzeh);
  }
  .legal-docs__empty {
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 2px dashed color-mix(in srgb, var(--matin-encre) 25%, transparent);
  }
  @media (min-width: 48rem) {
    .legal-stack > section.legal-docs {
      margin-inline-end: 2rem;
    }
  }
  .legal-list > div {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-line);
  }
  .legal-list > div:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .legal-list dt {
    font-weight: 700;
    color: var(--color-primary);
  }
  @media (min-width: 640px) {
    .legal-list > div {
      grid-template-columns: 16rem 1fr;
    }
  }
</style>
