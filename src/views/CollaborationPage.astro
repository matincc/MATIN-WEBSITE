---
/**
 * Collaboration (owner's requests, Oct 31 2026): the homepage shows Matin itself; the ways
 * to work with Matin live here, in the menu before Contact. Four boxes, in the owner's
 * order: Membership, Volunteer Team, Advisory Circle, Partners & Supporters. Each box
 * opens its own panel with its form (adhesion, benevolat, conseillers), so the page stays
 * short. Without JavaScript every panel is shown. Menu anchors (#adhesion, #benevolat,
 * #conseillers, #partenaires and their English forms) open the matching panel; old
 * Contact anchors are forwarded here.
 */
import { ArrowRight, BadgeCheck, ChevronDown, HandHeart, Handshake, Lightbulb, Video } from '@lucide/astro';
import { storyStrings } from '@/i18n/stories';
import PageLayout from '@/layouts/PageLayout.astro';
import PartnersSection from '@/components/trust/PartnersSection.astro';
import VolunteerForm from '@/components/forms/VolunteerForm.astro';
import MembershipForm from '@/components/forms/MembershipForm.astro';
import AdvisorForm from '@/components/forms/AdvisorForm.astro';
import { advisorStrings } from '@/i18n/advisors';
import { collabStrings, collabAnchors } from '@/i18n/collab';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = collabStrings(lang);
const ids = collabAnchors(lang);
const inv = await getSingleton('involvement');
const adv = advisorStrings(lang);
const boxes = [
  { key: 'membership', id: ids.membership, Icon: BadgeCheck, title: t('membership.title'), teaser: t('membership.lede'), cta: c.open },
  { key: 'volunteer', id: ids.volunteer, Icon: HandHeart, title: t('involved.volunteerTitle'), teaser: c.volunteerTeaser, cta: c.open },
  { key: 'advisors', id: ids.advisors, Icon: Lightbulb, title: adv.title, teaser: c.advisorsTeaser, cta: c.open },
  { key: 'partners', id: ids.partners, Icon: Handshake, title: c.partners, teaser: c.partnersTeaser, cta: c.openPartners },
];
// The old « Share Your Expertise » anchor now leads to the Advisory Circle.
const aliases = { expertise: ids.advisors, 'advisors': ids.advisors };
---

<PageLayout
  accent="firouzeh"
  lang={lang}
  title={c.title}
  lede={c.lede}
  ledeStrong
  alternates={siteAlternates('collaboration')}
>
  <div class="collab scroll-mt-24" data-own-ground data-collab data-aliases={JSON.stringify(aliases)}>
    <div class="container-site">
      <p class="collab__hint">{c.lede2}</p>
      <ul class="collab__boxes">
        {boxes.map((b, i) => (
          <li>
            <button
              type="button"
              class={`collab-box collab-box--${b.key}`}
              aria-expanded="false"
              aria-controls={b.id}
              data-collab-toggle={b.id}
            >
              <span class="collab-box__icon" aria-hidden="true"><b.Icon size={26} /></span>
              <span class="collab-box__n" aria-hidden="true">{lang === 'fa' ? ['۱', '۲', '۳', '۴'][i] : `0${i + 1}`}</span>
              <span class="collab-box__title">{b.title}</span>
              <span class="collab-box__teaser">{b.teaser}</span>
              <span class="collab-box__cta">
                <span class="collab-box__open">{b.cta}</span>
                <span class="collab-box__close">{c.close}</span>
                <ChevronDown size={20} aria-hidden="true" class="collab-box__chev" />
              </span>
            </button>
          </li>
        ))}
        {/* « My Story in 15 Seconds » (owner, Nov 1 2026): a box that leads to its own
            page in the Gallery; no form here. */}
        <li>
          <a href={href('stories', lang)} class="collab-box collab-box--story">
            <span class="collab-box__icon" aria-hidden="true"><Video size={26} /></span>
            <span class="collab-box__n" aria-hidden="true">{lang === 'fa' ? '۵' : '05'}</span>
            <span class="collab-box__title">{storyStrings(lang).title}</span>
            <span class="collab-box__teaser">{c.storyTeaser}</span>
            <span class="collab-box__cta collab-box__cta--link">
              {c.storyCta}
              <ArrowRight size={18} aria-hidden="true" class="rtl:-scale-x-100" />
            </span>
          </a>
        </li>
      </ul>

      <section id={ids.membership} class="collab-panel collab-panel--membership scroll-mt-24" aria-labelledby="membership-title" data-collab-panel>
        <h2 id="membership-title" class="collab-panel__title">{t('membership.formTitle')}</h2>
        <p class="membership-fee">{t('membership.feeNote')}</p>
        <p class="mb-8 text-lg">{t('membership.formIntro')}</p>
        <MembershipForm lang={lang} action={`${href('collaboration', lang)}?sent=1#${ids.membership}`} />
        <p class="careers-note">
          <a href={href('membership', lang)}>{t('membership.typesTitle')}</a>
        </p>
      </section>

      <section id={ids.volunteer} class="collab-panel collab-panel--volunteer scroll-mt-24" aria-labelledby="volunteer-title" data-collab-panel>
        <h2 id="volunteer-title" class="collab-panel__title">{t('involved.volunteerTitle')}</h2>
        {inv.volunteerIntro && <p class="collab-panel__intro">{pick(inv.volunteerIntro, lang)}</p>}
        <VolunteerForm lang={lang} />
        <p class="careers-note">
          {t('contact.careersNote')} <a href={href('careers', lang)}>{t('contact.careersLink')}</a>
        </p>
      </section>

      <section id={ids.advisors} class="collab-panel collab-panel--advisors scroll-mt-24" aria-labelledby="advisors-title" data-collab-panel>
        <h2 id="advisors-title" class="collab-panel__title">{adv.title}</h2>
        <p class="collab-panel__intro">{adv.lede}</p>
        <ol class="adv-steps">
          {[
            [adv.how1Title, adv.how1Text],
            [adv.how2Title, adv.how2Text],
            [adv.how3Title, adv.how3Text],
          ].map(([title, text], i) => (
            <li class="adv-step">
              <span class="adv-step__n" aria-hidden="true">{lang === 'fa' ? ['۱', '۲', '۳'][i] : i + 1}</span>
              <h3 class="adv-step__title">{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
        <h3 class="mb-6 text-2xl font-bold">{adv.formTitle}</h3>
        <AdvisorForm lang={lang} />
      </section>

      <section id={ids.partners} class="collab-panel collab-panel--partners scroll-mt-24" aria-labelledby="partners-panel-title" data-collab-panel>
        <h2 id="partners-panel-title" class="collab-panel__title">{c.partners}</h2>
        <PartnersSection lang={lang} embedded />
      </section>
    </div>
  </div>
</PageLayout>

<script>
  // Boxes open one panel at a time; the URL anchor opens its panel (menu links, form
  // thank-you redirects). Without this script every panel stays visible.
  const root = document.querySelector<HTMLElement>('[data-collab]');
  if (root) {
    const aliases: Record<string, string> = JSON.parse(root.dataset.aliases || '{}');
    root.classList.add('is-enhanced');
    const toggles = [...root.querySelectorAll<HTMLElement>('[data-collab-toggle]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-collab-panel]')];
    const open = (id: string | null, scroll: boolean) => {
      panels.forEach((p) => (p.hidden = p.id !== id));
      toggles.forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.collabToggle === id)));
      const panel = id && document.getElementById(id);
      if (panel && scroll) panel.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    };
    toggles.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.collabToggle ?? null;
        const isOpen = b.getAttribute('aria-expanded') === 'true';
        open(isOpen ? null : id, !isOpen);
        history.replaceState(null, '', isOpen || !id ? location.pathname + location.search : '#' + id);
      }),
    );
    const fromHash = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      const id = aliases[h] || h;
      if (panels.some((p) => p.id === id)) open(id, true);
      else open(null, false);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>

<style>
  /* ---------- Four boxes that open their forms (owner, Oct 31 2026) ---------- */
  /* A livelier ground (owner, Nov 1 2026): pale turquoise with a large saffron sun and a
     terracotta arch at its edges, flat shapes only. */
  .collab {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    background: color-mix(in srgb, var(--matin-firouzeh) 30%, var(--matin-ivoire));
  }
  .collab::before,
  .collab::after {
    content: '';
    position: absolute;
    z-index: -1;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .collab::before {
    inset-block-start: -8rem;
    inset-inline-end: -6rem;
    width: clamp(16rem, 10rem + 18vw, 28rem);
    background: color-mix(in srgb, var(--matin-soleil) 65%, var(--matin-ivoire));
  }
  .collab::after {
    inset-block-end: -10rem;
    inset-inline-start: -8rem;
    width: clamp(18rem, 12rem + 20vw, 32rem);
    border-radius: 50% 50% 0 0;
    background: color-mix(in srgb, var(--matin-brique) 40%, var(--matin-ivoire));
  }
  .collab__hint:not(#o) {
    font-weight: 600;
    color: var(--matin-encre);
  }
  .collab__hint {
    margin-block-end: 1.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    color: var(--color-ink);
  }
  .collab__boxes {
    display: grid;
    gap: clamp(1rem, 0.75rem + 1vw, 1.5rem);
  }
  @media (min-width: 40rem) {
    .collab__boxes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .collab__boxes {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    /* Three boxes on the first row, two wider ones under them. */
    .collab__boxes > li {
      grid-column: span 2;
    }
    .collab__boxes > li:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
  @media (min-width: 90rem) {
    .collab__boxes {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .collab__boxes > li,
    .collab__boxes > li:nth-child(n + 4) {
      grid-column: auto;
    }
  }
  @media (min-width: 40rem) and (max-width: 59.99rem) {
    .collab__boxes > li:last-child {
      grid-column: 1 / -1;
    }
  }
  .collab-box--story:not(#o) {
    --box-bg: var(--matin-white);
    --box-fg: var(--matin-encre);
    --box-sun: var(--matin-brique);
    outline: 4px solid var(--matin-brique-ink);
    outline-offset: -4px;
    border-radius: 1.25rem;
    border-start-end-radius: 4rem;
    border-end-start-radius: 4rem;
    text-decoration: none;
  }
  .collab-box--story:hover {
    color: var(--box-fg);
  }
  .collab-box--story .collab-box__icon {
    background: var(--matin-brique-ink);
    color: var(--matin-white);
  }
  .collab-box--story .collab-box__n {
    color: var(--matin-white);
  }
  .collab-box--story .collab-box__cta {
    background: var(--matin-brique-ink);
    color: var(--matin-white);
  }
  .collab:not(.is-enhanced) .collab-box__cta--link {
    display: inline-flex;
  }
  .collab__boxes > li {
    display: flex;
  }
  .collab-box {
    --box-bg: var(--matin-brique-ink);
    --box-fg: var(--matin-white);
    --box-sun: var(--matin-soleil);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    width: 100%;
    padding: 1.6rem 1.5rem 1.4rem;
    border: 0;
    border-radius: 1.25rem;
    border-start-end-radius: 4rem;
    background: var(--box-bg);
    color: var(--box-fg);
    text-align: start;
    cursor: pointer;
    box-shadow: 0 18px 32px -24px color-mix(in srgb, var(--matin-encre) 80%, transparent);
    transition:
      translate 0.3s ease,
      box-shadow 0.3s ease;
  }
  .collab-box::after {
    /* A sun rising at the box's top corner. */
    content: '';
    position: absolute;
    inset-block-start: -2.75rem;
    inset-inline-end: -2.75rem;
    width: 7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--box-sun);
    opacity: 0.9;
  }
  .collab-box--volunteer {
    --box-bg: var(--matin-firouzeh-ink);
    --box-sun: var(--matin-brique);
    border-radius: 1.25rem;
    border-end-end-radius: 4rem;
  }
  .collab-box--advisors {
    --box-bg: var(--matin-encre);
    border-radius: 1.25rem;
    border-start-start-radius: 4rem;
  }
  .collab-box--partners {
    --box-bg: var(--matin-soleil);
    --box-fg: var(--matin-encre);
    --box-sun: var(--matin-firouzeh);
    border-radius: 1.25rem;
    border-end-start-radius: 4rem;
  }
  .collab-box:hover {
    translate: 0 -4px;
    box-shadow: 0 24px 40px -22px color-mix(in srgb, var(--matin-encre) 85%, transparent);
  }
  .collab-box:focus-visible {
    outline: 3px solid var(--matin-encre);
    outline-offset: 3px;
  }
  .collab-box[aria-expanded='true'] {
    box-shadow:
      0 0 0 4px var(--matin-ivoire),
      0 0 0 7px var(--box-bg);
  }
  .collab-box__icon {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--box-fg) 16%, transparent);
  }
  .collab-box__n {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: 1.15rem;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--matin-encre);
  }
  .collab-box--partners .collab-box__n {
    color: var(--matin-white);
  }
  .collab-box__title {
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.6rem);
    font-weight: 700;
    line-height: 1.2;
  }
  :global(html[lang='fa']) .collab-box__title {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.5;
  }
  .collab-box__teaser {
    flex: 1;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.95;
  }
  .collab-box__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--matin-ivoire);
    color: var(--matin-encre);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.975rem;
  }
  .collab-box__close,
  .collab-box[aria-expanded='true'] .collab-box__open {
    display: none;
  }
  .collab-box[aria-expanded='true'] .collab-box__close {
    display: inline;
  }
  .collab-box__chev {
    transition: rotate 0.3s ease;
  }
  .collab-box[aria-expanded='true'] .collab-box__chev {
    rotate: 180deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .collab-box,
    .collab-box__chev {
      transition: none;
    }
    .collab-box:hover {
      translate: none;
    }
  }
  /* Without JavaScript the toggles do nothing, so they are just signposts. */
  .collab:not(.is-enhanced) .collab-box__cta {
    display: none;
  }

  /* ---------- The panels ---------- */
  .collab-panel {
    margin-block-start: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: 1.5rem;
    border-start-end-radius: 6rem;
    border-block-start: 8px solid var(--panel-edge, var(--matin-brique-ink));
    background: var(--panel-bg, color-mix(in srgb, var(--matin-soleil) 30%, var(--matin-ivoire)));
  }
  .collab-panel[hidden] {
    display: none;
  }
  .collab-panel--volunteer {
    --panel-edge: var(--matin-firouzeh-ink);
    --panel-bg: color-mix(in srgb, var(--matin-firouzeh) 20%, var(--matin-ivoire));
  }
  .collab-panel--advisors {
    /* Warm apricot, no longer cool grey-blue (owner, Nov 1 2026). */
    --panel-edge: var(--matin-brique-ink);
    --panel-bg: color-mix(in srgb, var(--matin-brique) 18%, color-mix(in srgb, var(--matin-soleil) 14%, var(--matin-ivoire)));
  }
  .collab-panel--partners {
    /* Pale saffron, no longer white (owner, Nov 1 2026). */
    --panel-edge: var(--matin-soleil);
    --panel-bg: color-mix(in srgb, var(--matin-soleil) 24%, var(--matin-ivoire));
  }
  .collab-panel__title {
    margin-block-end: 1rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--matin-encre);
  }
  :global(html[lang='fa']) .collab-panel__title {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.5;
  }
  .collab-panel__intro {
    max-width: 52rem;
    margin-block-end: 2rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.75;
  }
  .collab-panel :global(form) {
    max-width: 60rem;
  }
  .membership-fee {
    margin-block: -0.5rem 1.5rem;
    display: inline-block;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    background: var(--matin-ivoire);
    font-weight: 800;
    color: var(--matin-brique-ink);
  }
  .form-panel--membership:not(#o) {
    max-width: 60rem;
    border-block-start-color: var(--matin-brique-ink);
    border-start-end-radius: 6rem;
    background: color-mix(in srgb, var(--matin-soleil) 34%, var(--matin-ivoire));
  }
  .volunteer-band {
    background: color-mix(in srgb, var(--matin-firouzeh) 18%, var(--matin-ivoire));
  }
  .careers-note {
    margin-block-start: 1.5rem;
    font-size: 1.05rem;
  }
  .careers-note a {
    font-weight: 700;
  }
  .form-panel--volunteer:not(#o) {
    max-width: 60rem;
    border-block-start-color: var(--matin-soleil);
    border-start-end-radius: 6rem;
    background: color-mix(in srgb, var(--matin-brique) 22%, var(--matin-ivoire));
  }
  .advisors-band {
    background: color-mix(in srgb, var(--matin-encre) 10%, var(--matin-ivoire));
  }
  .adv-steps {
    display: grid;
    gap: 1rem;
    margin-block: 0 2.5rem;
    max-width: 72rem;
  }
  @media (min-width: 56rem) {
    .adv-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .adv-step {
    position: relative;
    padding: 1.4rem 1.5rem 1.5rem;
    border-radius: 1rem;
    border-start-end-radius: 2.75rem;
    background: var(--matin-encre);
    color: var(--color-white);
  }
  .adv-step:nth-child(2) {
    background: var(--matin-firouzeh-ink);
  }
  .adv-step:nth-child(3) {
    background: var(--matin-brique-ink);
  }
  .adv-step__n {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-block-end: 0.75rem;
    border-radius: 50%;
    background: var(--matin-soleil);
    color: var(--matin-encre);
    font-family: var(--font-display);
    font-weight: 800;
  }
  .adv-step__title:not(#o) {
    margin-block-end: 0.35rem;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-white);
  }
  .adv-step p {
    line-height: 1.6;
  }
  .form-panel--advisors:not(#o) {
    max-width: 60rem;
    border-block-start-color: var(--matin-encre);
    border-start-end-radius: 6rem;
    background: color-mix(in srgb, var(--matin-firouzeh) 20%, var(--matin-ivoire));
  }
</style>
