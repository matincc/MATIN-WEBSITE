---
/**
 * Homepage (French, English and Persian). Shows only real content: events and news
 * sections fall back to short, welcoming empty states until entries exist.
 * The photographs are openly licensed views of Montréal (see src/lib/photos.ts), shown
 * with their credits; they illustrate the themes, they do not document Matin activities.
 */
import { ArrowRight, Eye, HeartHandshake, Target } from '@lucide/astro';
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/brand/HomeHero.astro';
import CulturesRibbon from '@/components/brand/CulturesRibbon.astro';
import SpotlightBanner from '@/components/content/SpotlightBanner.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import EventCard from '@/components/content/EventCard.astro';
import ExpireEvents from '@/components/content/ExpireEvents.astro';
import PostCard from '@/components/content/PostCard.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import PhotoCredit from '@/components/media/PhotoCredit.astro';
import AreasGrid from '@/components/content/AreasGrid.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { forLang, getNews, getUpcomingEvents, isMatinEvent } from '@/lib/content';
import { photos } from '@/lib/photos';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const [upcomingAll, postsAll] = await Promise.all([getUpcomingEvents(), getNews()]);
// Persian pages only list entries whose Persian translation has been reviewed.
// Up to 3 upcoming events, Matin's own first (the sort is stable, so dates stay in order).
const visible = forLang(upcomingAll, lang).filter((e) => e.data.status !== 'cancelled');
// One highlighted event gets the large banner; it is not repeated in the cards below.
const spotlight = visible.find((e) => e.data.spotlight);
const upcoming = visible
  .filter((e) => e !== spotlight)
  .sort((a, b) => Number(!isMatinEvent(a)) - Number(!isMatinEvent(b)))
  .slice(0, 3);
// Up to 3 recent articles; a single article is shown as one wide, featured card.
const posts = forLang(postsAll, lang).slice(0, 3);

const aboutHref = href('about', lang);
const whoCards = [
  { id: 'mission', label: t('nav.mission'), icon: Target, accent: 'coral' },
  { id: 'vision', label: t('nav.vision'), icon: Eye, accent: 'mustard' },
  { id: 'values', label: t('nav.values'), icon: HeartHandshake, accent: 'teal' },
  // The Persian About page has the values section only.
].filter((c) => lang !== 'fa' || c.id === 'values');
---

<BaseLayout
  lang={lang}
  alternates={siteAlternates('home')}
  footerNewsletter={false}
  searchable={false}
>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p class="mt-4 rounded-2xl bg-tint p-4 text-center font-semibold text-ink" role="status">
      {t('newsletter.confirmed')}
    </p>
  </div>

  <HomeHero lang={lang} />
  <CulturesRibbon lang={lang} />

  <!-- Who we are: photo and text side by side, then the three About links -->
  <section id="who-we-are" class="section-pad scroll-mt-24 bg-paper" aria-labelledby="who-title">
    <div class="container-site who-grid">
      <figure class="who-figure" data-reveal>
        <span class="who-figure__block" aria-hidden="true"></span>
        <div class="who-figure__photo">
          <Picture
            src={photos.parade.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[480, 720, 960]}
            sizes="(min-width: 64rem) 34rem, 92vw"
            style={`object-position:${photos.parade.focus}`}
          />
        </div>
        <figcaption>
          <PhotoCredit credit={photos.parade.credit} />
        </figcaption>
      </figure>
      <div class="who-body">
        <SectionHeader id="who-title" title={t('home.whoTitle')} align="start" class="mb-7" />
        <p class="who-text" data-reveal>
          {t('home.whoText')}
        </p>
        <nav aria-label={t('home.whoCardsLabel')} class="mt-10">
          <ul class="who-links">
            {whoCards.map((c, i) => (
              <li data-reveal style={`--reveal-delay:${i * 110}ms`}>
                <a href={`${aboutHref}#${c.id}`} class="who-link" data-accent={c.accent}>
                  <span class="who-link__icon" aria-hidden="true">
                    <c.icon size={26} stroke-width={1.75} />
                  </span>
                  <span class="who-link__label">{c.label}</span>
                  <ArrowRight size={22} class="who-link__arrow flip-rtl" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <!-- Areas of work: three large photo cards, each with its own accent -->
  <section class="section-pad bg-tint" aria-labelledby="areas-title">
    <div class="container-site">
      <SectionHeader
        id="areas-title"
        eyebrow={t('home.areasEyebrow')}
        eyebrowTone="terracotta"
        title={t('home.areasTitle')}
        lede={t('home.areasLede')}
        align="start"
        class="mb-12 lg:mb-16"
      />
      <AreasGrid lang={lang} />
    </div>
  </section>

  <!-- Selected upcoming events: a compact preview of the agenda -->
  <section class="section-pad bg-paper" aria-labelledby="events-title">
    <div class="container-site">
      <SectionHeader
        id="events-title"
        title={t('home.eventsTitle')}
        link={{ href: href('events', lang), label: t('home.eventsAll') }}
        align="start"
        class="mb-10"
      />
      {(upcoming.length > 0 || spotlight) && (
        <ul class="agenda-legend" aria-hidden="true">
          <li>
            <span class="agenda-legend__swatch is-matin" />
            {t('agendaKinds.matin')}
          </li>
          <li>
            <span class="agenda-legend__swatch is-selected" />
            {t('agendaKinds.selected')}
          </li>
        </ul>
      )}
      {spotlight && (
        <div class="mb-10">
          <SpotlightBanner event={spotlight} lang={lang} />
        </div>
      )}
      <div>
        {upcoming.length > 0 && (
          <ul class="events-grid" data-upcoming-list>
            {upcoming.map((event, i) => (
              <li data-reveal style={`--reveal-delay:${i * 120}ms`}>
                <EventCard event={event} lang={lang} />
              </li>
            ))}
          </ul>
        )}
        <p class="empty-line" data-upcoming-empty hidden={upcoming.length > 0 || !!spotlight}>
          {t('home.eventsEmpty')}
        </p>
      </div>
    </div>
  </section>
  <ExpireEvents />

  <!-- News & Insights: shown once there is at least one published article -->
  {posts.length > 0 && (
    <section class="section-pad bg-tint" aria-labelledby="news-title">
      <div class="container-site">
        <SectionHeader
          id="news-title"
          title={t('home.newsTitle')}
          link={{ href: href('news', lang), label: t('home.newsAll') }}
          align="start"
          class="mb-10"
        />
        {posts.length === 1 ? (
          <PostCard post={posts[0]} lang={lang} featured />
        ) : (
          <ul class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <li>
                <PostCard post={post} lang={lang} />
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  <!-- Get involved: warm terracotta band with a photo of Montréal's cultural life -->
  <section class="involved on-terracotta" aria-labelledby="involved-title">
    <div class="container-site involved__grid">
      <figure class="involved__figure" data-reveal>
        <div class="involved__photo">
          <Picture
            src={photos.nuitblanche.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[640, 960, 1280]}
            sizes="(min-width: 64rem) 40rem, 92vw"
            style={`object-position:${photos.nuitblanche.focus}`}
          />
        </div>
        <span class="involved__block" aria-hidden="true"></span>
        <span class="involved__circle" aria-hidden="true">
          <Picture
            src={photos.drummers.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[240, 400, 560]}
            sizes="(min-width: 64rem) 15rem, 9rem"
            style={`object-position:${photos.drummers.focus}`}
          />
        </span>
        <figcaption>
          <PhotoCredit
            credits={[photos.nuitblanche.credit, photos.drummers.credit]}
            class="involved__credit"
          />
        </figcaption>
      </figure>
      <div class="involved__text">
        <SectionHeader
          id="involved-title"
          eyebrow={t('home.involvedEyebrow')}
          title={t('home.involvedTitle')}
          align="start"
          class="mb-7"
        />
        <p class="involved__paragraph" data-reveal>
          {t('home.involvedText')}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-reveal>
          <a href={href('getInvolved', lang)} class="btn btn-primary">
            {t('home.involvedPrimary')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
          <a href="#newsletter" class="btn btn-outline">
            {t('home.involvedSecondary')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter: one wide card, invitation on teal, form on white -->
  <section
    id="newsletter"
    class="scroll-mt-24 bg-paper py-14 sm:py-20"
    aria-labelledby="newsletter-title"
  >
    <div class="container-site">
      <div class="newsletter-card">
        <div class="newsletter-card__intro on-teal">
          <SectionHeader
            id="newsletter-title"
            eyebrow={t('newsletter.eyebrow')}
            title={t('newsletter.title')}
            align="start"
            class="mb-5"
          />
          <p class="newsletter-card__text">{t('newsletter.text')}</p>
          <div class="mosaic newsletter-card__mosaic" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
        <div class="newsletter-card__form">
          <NewsletterForm lang={lang} id="home-newsletter" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    const note = document.querySelector<HTMLElement>('[data-newsletter-confirmed]');
    if (note) note.hidden = false;
  }
</script>

<style>
  .empty-line {
    max-width: 52rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    font-size: 1.125rem;
    background: var(--color-white);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-inline-start: 4px solid var(--color-gold);
  }

  /* ---------- Who we are ---------- */
  .who-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .who-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3.5rem, 2rem + 4vw, 7rem);
    }
  }
  .who-figure {
    position: relative;
    max-width: 34rem;
    margin-inline: auto;
    width: 100%;
  }
  /* Coral block offset behind the photo: a quiet graphic accent. */
  .who-figure__block {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-start: -1.25rem;
    width: 70%;
    height: 82%;
    border-radius: var(--radius-card);
    background: var(--color-coral);
  }
  .who-figure__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    margin-inline-start: 0.75rem;
  }
  .who-figure__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .who-figure figcaption {
    margin-inline-start: 0.75rem;
  }
  /* About 24px on desktop, comfortable line length. */
  .who-text {
    max-width: 40rem;
    font-size: clamp(1.25rem, 1.1rem + 0.55vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-ink);
  }
  .who-links {
    display: grid;
    gap: 0.85rem;
    max-width: 40rem;
  }
  /* Large link rows: accent icon tile, navy label, arrow. */
  .who-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 1.5rem 1rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.25s;
  }
  .who-link:hover {
    border-color: var(--accent);
    transform: translateX(4px);
    box-shadow: 0 12px 26px -20px color-mix(in srgb, var(--color-primary) 60%, transparent);
  }
  :global([dir='rtl']) .who-link:hover {
    transform: translateX(-4px);
  }
  .who-link__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.9rem;
    background: var(--accent);
    color: var(--color-primary);
  }
  .who-link__label {
    flex: 1;
    font-size: clamp(1.25rem, 1.15rem + 0.35vw, 1.5rem);
    font-weight: 800;
    color: var(--color-primary);
  }
  .who-link :global(.who-link__arrow) {
    flex-shrink: 0;
    color: var(--accent-ink);
  }

  /* ---------- Events ---------- */
  .agenda-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-block-end: 1.75rem;
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .agenda-legend li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .agenda-legend__swatch {
    width: 1.75rem;
    height: 0.75rem;
    border-radius: 999px;
  }
  .agenda-legend__swatch.is-matin {
    background: var(--color-primary);
  }
  .agenda-legend__swatch.is-selected {
    border: 2px solid var(--color-primary);
    background: var(--color-white);
  }
  .events-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  /* ---------- Get involved ---------- */
  .involved {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 2.6rem + 4.5vw, 7rem);
    background: var(--color-terracotta);
  }
  .involved__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .involved__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3.5rem, 2rem + 4vw, 6.5rem);
    }
  }
  .involved__figure {
    position: relative;
  }
  .involved__photo {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
  }
  .involved__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Mustard block peeking out from behind the photo. */
  .involved__block {
    position: absolute;
    inset-block-end: 2.25rem;
    inset-inline-end: -1.25rem;
    width: 45%;
    height: 55%;
    border-radius: var(--radius-card);
    background: var(--color-gold);
  }
  /* Daylight circle overlapping the night photo: a second, warmer view. */
  .involved__circle {
    position: absolute;
    z-index: 2;
    inset-block-start: -2rem;
    inset-inline-end: -1rem;
    width: clamp(8rem, 5rem + 7vw, 15rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 6px solid var(--color-terracotta);
    border-radius: 50%;
    outline: 3px solid var(--color-gold);
  }
  .involved__circle :global(picture),
  .involved__circle :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .involved__figure :global(.involved__credit) {
    position: relative;
    z-index: 1;
    color: var(--color-white);
  }
  .involved__paragraph {
    max-width: 38rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem);
    line-height: 1.65;
    color: var(--color-white);
  }

  /* ---------- Newsletter ---------- */
  .newsletter-card {
    display: grid;
    max-width: 80rem;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-card) * 1.4);
    background: var(--color-white);
  }
  @media (min-width: 56rem) {
    .newsletter-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }
  .newsletter-card__intro {
    position: relative;
    padding: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
    padding-block-end: clamp(3.5rem, 2.8rem + 2.5vw, 5rem);
    background: var(--color-teal-deep);
  }
  .newsletter-card__intro :global(.section-title) {
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.75rem);
  }
  .newsletter-card__text {
    max-width: 34rem;
    font-size: 1.1875rem;
    line-height: 1.65;
  }
  .newsletter-card__mosaic {
    position: absolute;
    inset-inline-start: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
    inset-block-end: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    width: 12rem;
  }
  .newsletter-card__form {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
    font-size: 1.0625rem;
  }
</style>
