---
/**
 * Homepage (French, English and Persian), in this order: what Matin is doing now
 * (Matin in Action, Latest From Matin), how to take part, then who Matin is and its
 * areas of work. Only Matin's own content (src/lib/matin.ts); external selected events
 * are on the Events page. With no Matin item yet, a short message invites visitors
 * to subscribe.
 * The photographs are openly licensed views of Montréal (see src/lib/photos.ts), shown
 * with their credits; they illustrate the themes, they do not document Matin activities.
 */
import {
  ArrowRight,
  CalendarDays,
  ExternalLink,
  Eye,
  HandHeart,
  Handshake,
  HeartHandshake,
  LockKeyhole,
  Mail,
  MapPin,
  MessageCircle,
  Target,
} from '@lucide/astro';
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/brand/HomeHero.astro';
import CulturesRibbon from '@/components/brand/CulturesRibbon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import PhotoCredit from '@/components/media/PhotoCredit.astro';
import AreasGrid from '@/components/content/AreasGrid.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getMatinFeed } from '@/lib/matin';
import { ctaFor } from '@/lib/matinLabels';
import MatinMedia from '@/components/content/MatinMedia.astro';
import MatinCard from '@/components/content/MatinCard.astro';
import { photos } from '@/lib/photos';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Matin's own content only: highlights, Matin's events and published news.
const { featured, items: latest } = await getMatinFeed(lang, 3);

// The next step after seeing what Matin does. Persian Get Involved has no volunteer form.
const involvedHref = href('getInvolved', lang);
const ways = [
  { label: t('home.actAttend'), href: href('events', lang), icon: CalendarDays },
  { label: t('home.actCollaborate'), href: `${involvedHref}#interest`, icon: Handshake },
  {
    label: t('home.actVolunteer'),
    href: `${involvedHref}#${lang === 'fr' ? 'benevolat' : lang === 'en' ? 'volunteer' : 'interest'}`,
    icon: HandHeart,
  },
  { label: t('home.involvedSecondary'), href: '#newsletter', icon: Mail },
  { label: t('home.actContact'), href: href('contact', lang), icon: MessageCircle },
];

const aboutHref = href('about', lang);
const whoCards = [
  { id: 'mission', label: t('nav.mission'), icon: Target, accent: 'coral' },
  { id: 'vision', label: t('nav.vision'), icon: Eye, accent: 'mustard' },
  { id: 'values', label: t('nav.values'), icon: HeartHandshake, accent: 'teal' },
  // The Persian About page has the values section only.
].filter((c) => lang !== 'fa' || c.id === 'values');
---

<BaseLayout
  lang={lang}
  alternates={siteAlternates('home')}
  footerNewsletter={false}
  searchable={false}
>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p class="mt-4 rounded-2xl bg-tint p-4 text-center font-semibold text-ink" role="status">
      {t('newsletter.confirmed')}
    </p>
  </div>

  <HomeHero lang={lang} />
  <CulturesRibbon lang={lang} />

  <!-- Matin in Action: what Matin is doing now. The featured item (a highlight marked
       featured, else Matin's next event, else the latest article), then the latest items.
       Only Matin's own content; see src/content/highlights/README.md. -->
  <section id="action" class="section-pad scroll-mt-24 bg-paper" aria-labelledby="action-title">
    <div class="container-site">
      <SectionHeader
        id="action-title"
        title={t('home.actionTitle')}
        lede={t('home.actionLede')}
        align="start"
        class="mb-10"
      />
      {featured ? (
        <article class="feature" data-reveal>
          <MatinMedia
            item={featured}
            sizes="(min-width: 64rem) 46rem, 92vw"
            class:list={['feature__media', featured.type === 'poster' && 'is-poster']}
          />
          <div class="feature__body">
            <p class="feature__type">{t(`matinTypes.${featured.type}`)}</p>
            <h3 class="feature__title">{featured.title}</h3>
            <ul class="feature__meta">
              <li>
                <CalendarDays size={20} aria-hidden="true" />
                <time datetime={featured.datetime}>{featured.when}</time>
              </li>
              {featured.location && (
                <li>
                  <MapPin size={20} aria-hidden="true" />
                  <span>{featured.location}</span>
                </li>
              )}
            </ul>
            <p class="feature__summary">{featured.summary}</p>
            <a
              href={featured.url}
              class="btn btn-primary self-start"
              target={featured.external ? '_blank' : undefined}
              rel={featured.external ? 'noopener noreferrer' : undefined}
            >
              {featured.ctaLabel ?? ctaFor(featured.type, t)}
              {featured.external ? (
                <ExternalLink size={18} aria-hidden="true" />
              ) : (
                <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
              )}
              {featured.external && <span class="sr-only">{t('a11y.externalLink')}</span>}
            </a>
          </div>
        </article>
      ) : (
        <div class="empty-state">
          <p>{t('home.latestEmpty')}</p>
          <a href="#newsletter" class="btn btn-primary">
            {t('home.involvedSecondary')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Latest From Matin: the next items of the same feed -->
  {latest.length > 0 && (
    <section class="section-pad bg-tint" aria-labelledby="latest-title">
      <div class="container-site">
        <SectionHeader
          id="latest-title"
          title={t('home.latestTitle')}
          link={{ href: href('news', lang), label: t('home.newsAll') }}
          align="start"
          class="mb-10"
        />
        <ul class="latest-grid">
          {latest.map((item, i) => (
            <li data-reveal style={`--reveal-delay:${i * 110}ms`}>
              <MatinCard item={item} lang={lang} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Get involved: warm terracotta band, a people-centred photo beside the invitation -->
  <section class="involved on-terracotta" aria-labelledby="involved-title">
    <div class="container-site involved__grid">
      <figure class="involved__figure" data-reveal>
        <div class="involved__photo">
          <Picture
            src={photos.dialogueCircle.src}
            alt={t('home.involvedPhotoAlt')}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280]}
            sizes="(min-width: 64rem) 40rem, 92vw"
            style={`object-position:${photos.dialogueCircle.focus}`}
          />
        </div>
        <span class="involved__block" aria-hidden="true"></span>
        <figcaption>
          <PhotoCredit credit={photos.dialogueCircle.credit} class="involved__credit" />
        </figcaption>
      </figure>
      <div class="involved__text">
        <SectionHeader
          id="involved-title"
          eyebrow={t('home.involvedEyebrow')}
          title={t('home.involvedTitle')}
          align="start"
          class="mb-7"
        />
        <p class="involved__paragraph" data-reveal>
          {t('home.involvedText')}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-reveal>
          <a href={href('getInvolved', lang)} class="btn btn-primary">
            {t('home.involvedPrimary')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
          <a href="#newsletter" class="btn btn-outline">
            {t('home.involvedSecondary')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
    <div class="container-site">
      <nav class="ways" aria-labelledby="ways-title">
        <h3 id="ways-title" class="ways__title">
          {t('home.actionsTitle')}
        </h3>
        <ul class="ways__list">
          {ways.map((w) => (
            <li>
              <a href={w.href} class="ways__link">
                <w.icon size={24} stroke-width={1.75} aria-hidden="true" />
                <span>{w.label}</span>
                <ArrowRight size={18} class="flip-rtl ways__arrow" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Who we are: photo and text side by side, then the three About links -->
  <section id="who-we-are" class="section-pad scroll-mt-24 bg-paper" aria-labelledby="who-title">
    <div class="container-site who-grid">
      <figure class="who-figure" data-reveal>
        <span class="who-figure__block" aria-hidden="true"></span>
        <div class="who-figure__photo">
          <Picture
            src={photos.tamtams.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[720, 1080, 1440, 1920]}
            sizes="(min-width: 64rem) 100rem, 300vw"
            style={`object-position:${photos.tamtams.focus}`}
          />
        </div>
        <figcaption>
          <PhotoCredit credit={photos.tamtams.credit} />
        </figcaption>
      </figure>
      <div class="who-body">
        <SectionHeader id="who-title" title={t('home.whoTitle')} align="start" class="mb-7" />
        <p class="who-text" data-reveal>
          {t('home.whoText')}
        </p>
        <nav aria-label={t('home.whoCardsLabel')} class="mt-10">
          <ul class="who-links">
            {whoCards.map((c, i) => (
              <li data-reveal style={`--reveal-delay:${i * 110}ms`}>
                <a href={`${aboutHref}#${c.id}`} class="who-link" data-accent={c.accent}>
                  <span class="who-link__icon" aria-hidden="true">
                    <c.icon size={26} stroke-width={1.75} />
                  </span>
                  <span class="who-link__label">{c.label}</span>
                  <ArrowRight size={22} class="who-link__arrow flip-rtl" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <!-- Areas of work: three large photo cards, each with its own accent -->
  <section class="section-pad bg-tint" aria-labelledby="areas-title">
    <div class="container-site">
      <SectionHeader
        id="areas-title"
        eyebrow={t('home.areasEyebrow')}
        eyebrowTone="terracotta"
        title={t('home.areasTitle')}
        lede={t('home.areasLede')}
        align="start"
        class="mb-12 lg:mb-16"
      />
      <AreasGrid lang={lang} />
    </div>
  </section>

  <!-- Newsletter: one warm card, invitation on one side, the form on the other -->
  <section
    id="newsletter"
    class="scroll-mt-24 bg-paper py-14 sm:py-20"
    aria-labelledby="newsletter-title"
  >
    <div class="container-site">
      <div class="newsletter-card">
        <div class="newsletter-card__intro">
          <SectionHeader
            id="newsletter-title"
            eyebrow={t('newsletter.eyebrow')}
            eyebrowTone="terracotta"
            title={t('newsletter.title')}
            align="start"
            class="mb-5"
          />
          <p class="newsletter-card__text">{t('newsletter.text')}</p>
          <div class="mosaic newsletter-card__mosaic" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
        <div class="newsletter-card__form">
          <NewsletterForm lang={lang} id="home-newsletter" />
          <p class="newsletter-card__note">
            <LockKeyhole size={18} aria-hidden="true" />
            {t('newsletter.privacyNote')}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    const note = document.querySelector<HTMLElement>('[data-newsletter-confirmed]');
    if (note) note.hidden = false;
  }
</script>

<style>
  /* ---------- Who we are ---------- */
  .who-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .who-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3.5rem, 2rem + 4vw, 7rem);
    }
  }
  .who-figure {
    position: relative;
    max-width: 34rem;
    margin-inline: auto;
    width: 100%;
  }
  /* Coral block offset behind the photo: a quiet graphic accent. */
  .who-figure__block {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-start: -1.25rem;
    width: 70%;
    height: 82%;
    border-radius: var(--radius-card);
    background: var(--color-coral);
  }
  .who-figure__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    margin-inline-start: 0.75rem;
  }
  /* The Tam-Tams photo is wide with a lot of sky: zoom towards the crowd. */
  .who-figure__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.55);
    transform-origin: 50% 96%;
  }
  .who-figure figcaption {
    margin-inline-start: 0.75rem;
  }
  /* About 24px on desktop, comfortable line length. */
  .who-text {
    max-width: 40rem;
    font-size: clamp(1.25rem, 1.1rem + 0.55vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-ink);
  }
  .who-links {
    display: grid;
    gap: 0.85rem;
    max-width: 40rem;
  }
  /* Large link rows: accent icon tile, navy label, arrow. */
  .who-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 1.5rem 1rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-white);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.25s;
  }
  .who-link:hover {
    border-color: var(--accent);
    transform: translateX(4px);
    box-shadow: 0 12px 26px -20px color-mix(in srgb, var(--color-primary) 60%, transparent);
  }
  :global([dir='rtl']) .who-link:hover {
    transform: translateX(-4px);
  }
  .who-link__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.9rem;
    background: var(--accent);
    color: var(--color-primary);
  }
  .who-link__label {
    flex: 1;
    font-size: clamp(1.25rem, 1.15rem + 0.35vw, 1.5rem);
    font-weight: 800;
    color: var(--color-primary);
  }
  .who-link :global(.who-link__arrow) {
    flex-shrink: 0;
    color: var(--accent-ink);
  }

  /* ---------- Matin in Action ---------- */
  /* The featured item: the visual on one side, the details on the other. */
  .feature {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-card) * 1.4);
    background: var(--color-white);
  }
  .feature :global(.feature__media) {
    aspect-ratio: 4 / 3;
  }
  .feature :global(.feature__media.is-poster) {
    aspect-ratio: 4 / 5;
  }
  .feature__body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.75rem, 1.2rem + 2.5vw, 3.5rem);
    border-block-start: 6px solid var(--color-coral);
  }
  @media (min-width: 64rem) {
    .feature {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: stretch;
    }
    .feature :global(.feature__media) {
      aspect-ratio: auto;
      min-height: 26rem;
    }
    .feature :global(.feature__media.is-poster) {
      min-height: 34rem;
    }
    .feature__body {
      justify-content: center;
      border-block-start: none;
      border-inline-start: 6px solid var(--color-coral);
    }
  }
  .feature__type {
    align-self: flex-start;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .feature__title {
    font-size: clamp(1.875rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    text-wrap: balance;
  }
  .feature__meta {
    display: grid;
    gap: 0.45rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .feature__meta li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .feature__meta :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-terracotta-deep);
  }
  .feature__summary {
    max-width: 38rem;
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem);
    line-height: 1.65;
  }
  .feature :global(.btn) {
    margin-top: 0.5rem;
  }
  .latest-grid {
    display: grid;
    gap: 1.75rem;
    /* auto-fill: one or two cards keep a card's width instead of stretching. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  /* ---------- Ways to take part (inside the Get Involved band) ---------- */
  .ways {
    margin-block-start: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-block-start: 2rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-white) 35%, transparent);
  }
  .ways__title {
    margin-block-end: 1.25rem;
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-white);
  }
  .ways__list {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
  }
  /* White tiles on terracotta: navy text (11.9:1). */
  .ways__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    background: var(--color-white);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
    transition:
      transform 0.2s,
      background-color 0.2s;
  }
  .ways__link:hover {
    background: var(--color-cream);
    transform: translateY(-2px);
  }
  .ways__link :global(svg) {
    flex-shrink: 0;
    color: var(--color-terracotta-deep);
  }
  .ways__link > span {
    flex: 1;
  }
  .ways__link :focus-visible,
  .ways__link:focus-visible {
    outline-color: var(--color-white);
  }

  /* ---------- Get involved ---------- */
  .involved {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 2.6rem + 4.5vw, 7rem);
    background: var(--color-terracotta);
  }
  .involved__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .involved__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 1.5rem + 3vw, 5rem);
    }
  }
  .involved__figure {
    position: relative;
  }
  .involved__photo {
    position: relative;
    z-index: 1;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-card);
  }
  .involved__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Mustard block peeking out from behind the photo. */
  .involved__block {
    position: absolute;
    inset-block-end: 2.25rem;
    inset-inline-end: -1.25rem;
    width: 45%;
    height: 55%;
    border-radius: var(--radius-card);
    background: var(--color-gold);
  }
  .involved__figure :global(.involved__credit) {
    position: relative;
    z-index: 1;
    color: var(--color-white);
  }
  .involved__paragraph {
    max-width: 38rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem);
    line-height: 1.65;
    color: var(--color-white);
  }

  /* ---------- Newsletter ---------- */
  /* One warm cream card: the invitation and the form share the same surface, with a
     terracotta edge; the button is deep teal (white text 6.2:1). */
  .newsletter-card {
    display: grid;
    gap: 2.25rem;
    align-items: center;
    padding: clamp(2rem, 1.2rem + 3vw, 4rem);
    border-radius: calc(var(--radius-card) * 1.4);
    border-inline-start: 8px solid var(--color-terracotta);
    background: var(--color-tint);
  }
  @media (min-width: 56rem) {
    .newsletter-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 4vw, 6rem);
    }
  }
  .newsletter-card__intro :global(.section-title) {
    font-size: clamp(2rem, 1.5rem + 1.6vw, 3rem);
  }
  .newsletter-card__text {
    max-width: 36rem;
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem);
    line-height: 1.65;
    color: var(--color-ink);
  }
  .newsletter-card__mosaic {
    width: 12rem;
    margin-block-start: 1.75rem;
  }
  .newsletter-card__form {
    font-size: 1.0625rem;
  }
  /* Field and button on one aligned row, the same height and shape. */
  .newsletter-card__form :global(.newsletter__label) {
    font-size: 1.0625rem;
    color: var(--color-primary);
  }
  .newsletter-card__form :global(.newsletter__input) {
    min-height: 3.5rem;
    border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
    font-size: 1.0625rem;
  }
  .newsletter-card__form :global(.newsletter__row .btn-primary) {
    min-height: 3.5rem;
    background: var(--color-teal-deep);
    color: var(--color-white);
  }
  .newsletter-card__form :global(.newsletter__row .btn-primary:hover) {
    background: color-mix(in srgb, var(--color-teal-deep) 82%, black);
  }
  .newsletter-card__note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 1.25rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
    font-size: 1rem;
