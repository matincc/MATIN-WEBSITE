---
/**
 * Homepage (French, English and Persian), in this order: Matin in Action (Matin's own
 * featured item, src/lib/matin.ts), Matin's Picks (the same section as on the Events
 * page), the latest news (without the featured article), Matin Moments (featured gallery
 * items), Get Involved, Who We Are, Areas of Work, Cultural Resources & Organizations,
 * newsletter.
 * The photographs are openly licensed views of Montréal (see src/lib/photos.ts), shown
 * with their credits; they illustrate the themes, they do not document Matin activities.
 */
import {
  ArrowRight,
  CalendarDays,
  Download,
  ExternalLink,
  HandHeart,
  Handshake,
  Mail,
  MapPin,
  MessageCircle,
  ZoomIn,
} from '@lucide/astro';
import { getImage } from 'astro:assets';
import CommunityIllustration from '@/components/brand/CommunityIllustration.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import PicksSection from '@/components/content/PicksSection.astro';
import PostCard from '@/components/content/PostCard.astro';
import MatinMoments from '@/components/content/MatinMoments.astro';
import ResourcesTeaser from '@/components/content/ResourcesTeaser.astro';
import ExpireEvents from '@/components/content/ExpireEvents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/brand/HomeHero.astro';
import CulturesRibbon from '@/components/brand/CulturesRibbon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import AreasGrid from '@/components/content/AreasGrid.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getMatinFeed } from '@/lib/matin';
import { articleHref, forLang, getNews } from '@/lib/content';
import { ctaFor } from '@/lib/matinLabels';
import MatinMedia from '@/components/content/MatinMedia.astro';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Matin in Action: Matin's own content only (highlights, Matin's events, published news).
const { featured } = await getMatinFeed(lang, 0);
const posterLarge =
  featured?.poster && featured.image
    ? (
        await getImage({
          src: featured.image,
          width: Math.min(2000, featured.image.width),
          format: 'webp',
        })
      ).src
    : undefined;
// Latest news, after Matin's Picks: the three newest articles, leaving out the one already
// featured in Matin in Action. Hidden when there is no other article.
const latestNews = forLang(await getNews(), lang)
  .filter((p) => articleHref(p, lang) !== featured?.url)
  .slice(0, 3);

// The next step after seeing what Matin does: Get Involved is now part of Contact &
// Collaboration (Oct 24 2026). The Persian page has no volunteer section.
const involvedHref = href('contact', lang);
const ways = [
  { label: t('home.actAttend'), href: href('events', lang), icon: CalendarDays },
  { label: t('home.actCollaborate'), href: `${involvedHref}#write`, icon: Handshake },
  {
    label: t('home.actVolunteer'),
    href: `${involvedHref}#${lang === 'fr' ? 'benevolat' : lang === 'en' ? 'volunteer' : 'write'}`,
    icon: HandHeart,
  },
  { label: t('home.involvedSecondary'), href: '#newsletter', icon: Mail },
  { label: t('home.actContact'), href: href('contact', lang), icon: MessageCircle },
];
---

<BaseLayout lang={lang} alternates={siteAlternates('home')} searchable={false}>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p class="mt-4 rounded-2xl bg-tint p-4 text-center font-semibold text-ink" role="status">
      {t('newsletter.confirmed')}
    </p>
  </div>

  <HomeHero lang={lang} />
  <CulturesRibbon lang={lang} />

  <!-- Matin in Action: what Matin is doing now. The featured item (a highlight marked
       featured, else Matin's next event, else the latest article), then the latest items.
       Only Matin's own content; see src/content/highlights/README.md. -->
  <section id="action" class="section-pad scroll-mt-24 bg-paper" aria-labelledby="action-title">
    <div class="container-site">
      <SectionHeader
        id="action-title"
        title={t('home.actionTitle')}
        lede={t('home.actionLede')}
        align="start"
        class="mb-10"
      />
      {featured ? (
        <article class="feature" data-reveal>
          {posterLarge ? (
            /* A poster opens in the same fullscreen viewer as Gallery → Posters; the
               button beside it still leads to the activity's page. */
            <a
              href={posterLarge}
              class="feature__zoom"
              data-lightbox="feature-poster"
              data-alt={featured.imageAlt}
              data-caption={featured.title}
              aria-label={t('gallery.openPoster', { title: featured.title })}
            >
              <MatinMedia
                item={featured}
                sizes="(min-width: 64rem) 46rem, 92vw"
                class="feature__media is-poster"
              />
              <span class="feature__zoom-icon" aria-hidden="true">
                <ZoomIn size={22} />
              </span>
            </a>
          ) : (
            <MatinMedia
              item={featured}
              sizes="(min-width: 64rem) 46rem, 92vw"
              class:list={['feature__media', featured.poster && 'is-poster']}
            />
          )}
          <div class="feature__body">
            <p class="feature__type">{t(`matinTypes.${featured.type}`)}</p>
            <h3 class="feature__title">{featured.title}</h3>
            <ul class="feature__meta">
              <li>
                <CalendarDays size={20} aria-hidden="true" />
                <time datetime={featured.datetime}>{featured.when}</time>
              </li>
              {featured.location && (
                <li>
                  <MapPin size={20} aria-hidden="true" />
                  <span>{featured.location}</span>
                </li>
              )}
            </ul>
            <p class="feature__summary">{featured.summary}</p>
            <div class="feature__actions">
              <a
                href={featured.url}
                class="btn btn-primary"
                target={featured.external ? '_blank' : undefined}
                rel={featured.external ? 'noopener noreferrer' : undefined}
              >
                {featured.ctaLabel ?? ctaFor(featured.type, t)}
                {featured.external ? (
                  <ExternalLink size={18} aria-hidden="true" />
                ) : (
                  <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
                )}
                {featured.external && <span class="sr-only">{t('a11y.externalLink')}</span>}
              </a>
              {featured.posterDownload && (
                <a
                  href={featured.posterDownload.href}
                  download={featured.posterDownload.filename}
                  class="btn btn-outline"
                >
                  <Download size={18} aria-hidden="true" />
                  {t('events.posterDownload', { format: featured.posterDownload.format })}
                </a>
              )}
            </div>
          </div>
        </article>
      ) : (
        <div class="empty-state">
          <p>{t('home.latestEmpty')}</p>
          <a href="#newsletter" class="btn btn-primary">
            {t('home.involvedSecondary')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Matin's Picks: the same section and data as on the Events page -->
  <PicksSection
    lang={lang}
    class="section-pad bg-tint"
    link={{ href: href('events', lang), label: t('home.eventsAll') }}
  />
  <ExpireEvents />

  <!-- Latest news (News & Insights), without the article featured above -->
  {latestNews.length > 0 && (
    <section
      id="latest-news"
      class="section-pad scroll-mt-24 border-y border-line bg-paper"
      aria-labelledby="latest-news-title"
    >
      <div class="container-site">
        <SectionHeader
          align="start"
          id="latest-news-title"
          title={t('home.newsTitle')}
          link={{ href: href('news', lang), label: t('home.newsAll') }}
          class="mb-12"
        />
        <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
          {latestNews.map((post, i) => (
            <li data-reveal style={`--reveal-delay:${i * 110}ms`}>
              <PostCard post={post} lang={lang} headingLevel="h3" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Matin Moments: featured photos and videos from the gallery -->
  <MatinMoments lang={lang} />

  <!-- Get involved: deep teal band, a bright illustration beside the invitation -->
  <section class="involved on-teal" aria-labelledby="involved-title">
    <div class="container-site involved__grid">
      <div class="involved__figure" data-reveal>
        <CommunityIllustration class="involved__art" />
        <span class="involved__block" aria-hidden="true"></span>
      </div>
      <div class="involved__text">
        <SectionHeader
          id="involved-title"
          eyebrow={t('home.involvedEyebrow')}
          title={t('home.involvedTitle')}
          align="start"
          class="mb-7"
        />
        <p class="involved__paragraph" data-reveal>
          {t('home.involvedText')}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-reveal>
          <a href={involvedHref} class="btn btn-primary">
            {t('home.involvedPrimary')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
          <a href="#newsletter" class="btn btn-outline">
            {t('home.involvedSecondary')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
    <div class="container-site">
      <nav class="ways" aria-labelledby="ways-title">
        <h3 id="ways-title" class="ways__title">
          {t('home.actionsTitle')}
        </h3>
        <ul class="ways__list">
          {ways.map((w) => (
            <li>
              <a href={w.href} class="ways__link">
                <w.icon size={24} stroke-width={1.75} aria-hidden="true" />
                <span>{w.label}</span>
                <ArrowRight size={18} class="flip-rtl ways__arrow" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Areas of work: three large photo cards, each with its own accent -->
  <section class="section-pad bg-tint" aria-labelledby="areas-title">
    <div class="container-site">
      <SectionHeader
        id="areas-title"
        eyebrow={t('home.areasEyebrow')}
        eyebrowTone="teal"
        title={t('home.areasTitle')}
        lede={t('home.areasLede')}
        align="start"
        class="mb-12 lg:mb-16"
      />
      <AreasGrid lang={lang} />
    </div>
  </section>

  <!-- Cultural Resources & Organizations: opens the directory -->
  <ResourcesTeaser lang={lang} />

  {posterLarge && <Lightbox lang={lang} />}
</BaseLayout>

<script>
  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    const note = document.querySelector<HTMLElement>('[data-newsletter-confirmed]');
    if (note) note.hidden = false;
  }
</script>

<style>
  /* ---------- Matin in Action ---------- */
  /* The featured item: the visual on one side, the details on the other. */
  .feature {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-card-edge);
    border-radius: calc(var(--radius-card) * 1.4);
    /* Warm ivory rather than white, with a soft shadow (owner's brief, Oct 25 2026). */
    background: var(--color-ivory);
    box-shadow: var(--shadow-card);
  }
  .feature__zoom {
    position: relative;
    display: block;
    cursor: zoom-in;
  }
  .feature__zoom :global(.feature__media) {
    height: 100%;
  }
  .feature__zoom :global(img) {
    transition: transform 0.5s ease;
  }
  .feature__zoom:hover :global(img) {
    transform: scale(1.03);
  }
  /* Same zoom badge as the Gallery posters and event pages. */
  .feature__zoom-icon {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow: var(--shadow-lift);
  }
  @media (prefers-reduced-motion: reduce) {
    .feature__zoom :global(img) {
      transition: none;
    }
    .feature__zoom:hover :global(img) {
      transform: none;
    }
  }
  .feature :global(.feature__media) {
    aspect-ratio: 4 / 3;
  }
  .feature :global(.feature__media.is-poster) {
    aspect-ratio: 4 / 5;
  }
  .feature__body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.75rem, 1.2rem + 2.5vw, 3.5rem);
    border-block-start: 6px solid var(--color-teal);
  }
  @media (min-width: 64rem) {
    .feature {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: stretch;
    }
    .feature :global(.feature__media) {
      aspect-ratio: auto;
      min-height: 26rem;
    }
    .feature :global(.feature__media.is-poster) {
      min-height: 34rem;
    }
    .feature__body {
      justify-content: center;
      border-block-start: none;
      border-inline-start: 6px solid var(--color-teal);
    }
  }
  .feature__type {
    align-self: flex-start;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .feature__title {
    font-size: clamp(1.875rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    text-wrap: balance;
  }
  .feature__meta {
    display: grid;
    gap: 0.45rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .feature__meta li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .feature__meta :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-teal-deep);
  }
  .feature__summary {
    max-width: 38rem;
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem);
    line-height: 1.65;
  }
  .feature__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* ---------- Ways to take part (inside the Get Involved band) ---------- */
  .ways {
    margin-block-start: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-block-start: 2rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-white) 35%, transparent);
  }
  .ways__title {
    margin-block-end: 1.25rem;
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-white);
  }
  .ways__list {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
  }
  /* White tiles on deep teal: navy text (11.9:1). */
  .ways__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    background: var(--color-white);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
    transition:
      transform 0.2s,
      background-color 0.2s;
  }
  .ways__link:hover {
    background: var(--color-cream);
    transform: translateY(-2px);
  }
  .ways__link :global(svg) {
    flex-shrink: 0;
    color: var(--color-teal-deep);
  }
  .ways__link > span {
    flex: 1;
  }
  .ways__link :focus-visible,
  .ways__link:focus-visible {
    outline-color: var(--color-white);
  }

  /* ---------- Get involved ---------- */
  .involved {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 2.6rem + 4.5vw, 7rem);
    background: var(--color-teal-deep);
  }
  .involved__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .involved__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 1.5rem + 3vw, 5rem);
    }
  }
  .involved__figure {
    position: relative;
  }
  .involved__figure :global(.involved__art) {
    position: relative;
    z-index: 1;
  }
  /* Mustard block peeking out from behind the illustration. */
  .involved__block {
    position: absolute;
    inset-block-end: 2.25rem;
    inset-inline-end: -1.25rem;
    width: 45%;
    height: 55%;
    border-radius: var(--radius-card);
    background: var(--color-gold);
  }
  .involved__paragraph {
    max-width: 38rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem);
    line-height: 1.65;
    color: var(--color-white);
  }
</style>
