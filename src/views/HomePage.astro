---
/**
 * The Living homepage (owner's "Living Cultural Institution" brief, Oct 29 2026; CLAUDE.md
 * section 4d), in French, English and Persian: the hero (unchanged, Tam-Tams photo), Coming
 * up, Who we are (statement and photo collage), Matin in Action as visual stories, the
 * President's note (excerpt), Matin's Picks as a discovery gallery, a full-width pause on
 * Montréal, Programs and Participation, News, Notes from the President, Cultural
 * Resources. Colours `--living-*` and the Fraunces headline face, scoped to `.living`.
 * Every photo outside posters, events and the portrait comes from the image registry
 * src/lib/media.ts (temporary ones are labelled); see docs/IMAGES.md.
 */
import {
  ArrowRight,
  CalendarDays,
  ChevronLeft,
  ChevronRight,
  Clock,
  ExternalLink,
  MapPin,
  Plus,
} from '@lucide/astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Lightbox from '@/components/ui/Lightbox.astro';
import LivingIntro from '@/components/living/LivingIntro.astro';
import PresidentExcerpt from '@/components/living/PresidentExcerpt.astro';
import PicksGallery from '@/components/living/PicksGallery.astro';
import MontrealPause from '@/components/living/MontrealPause.astro';
import LivingPrograms from '@/components/living/LivingPrograms.astro';
import { livingStrings } from '@/i18n/living';
import NewsRegionTabs from '@/components/content/NewsRegionTabs.astro';
import PostCard from '@/components/content/PostCard.astro';
import NoteCard from '@/components/content/NoteCard.astro';
import ResourcesTeaser from '@/components/content/ResourcesTeaser.astro';
import ExpireEvents from '@/components/content/ExpireEvents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AliveHero from '@/components/brand/AliveHero.astro';
import UpcomingStrip from '@/components/content/UpcomingStrip.astro';
import { href, newsAnchors, siteAlternates, type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import { getMatinFeed, type MatinItem } from '@/lib/matin';
import { articleHref, forLang, getNews, getNotes } from '@/lib/content';
import { ctaFor } from '@/lib/matinLabels';
import MatinMedia from '@/components/content/MatinMedia.astro';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Matin in Action: Matin's own content only (highlights, Matin's events, published news).
const { featured } = await getMatinFeed(lang, 0);
const posterLarge =
  featured?.poster && featured.image
    ? (
        await getImage({
          src: featured.image,
          width: Math.min(2000, featured.image.width),
          format: 'webp',
        })
      ).src
    : undefined;
// "Coming soon" posters (owner's brief, Oct 27 2026): one image per language, no dates.
const soon = await Promise.all(
  (await getCollection('comingSoon', (c) => c.data.published))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (c) => {
      const image =
        (lang === 'fa' && c.data.poster.fa) || c.data.poster[lang === 'fa' ? 'en' : lang];
      const item = {
        id: `soon-${c.id}`,
        type: 'poster',
        title: pick(c.data.title, lang)!,
        summary: pick(c.data.summary, lang)!,
        image,
        imageAlt: pick(c.data.posterAlt, lang)!,
        poster: true,
      } as MatinItem;
      const large = (
        await getImage({ src: image, width: Math.min(2000, image.width), format: 'webp' })
      ).src;
      return { item, large };
    }),
);
const slideSizes = '(min-width: 64rem) 22rem, (min-width: 40rem) 46vw, 82vw';
const leadSizes = '(min-width: 64rem) 26rem, (min-width: 40rem) 46vw, 82vw';
// News (owner's brief, Oct 25 2026): Cultural News approved by the President in three
// region tabs, then Matin News, leaving out the article already featured in Matin in Action.
const newsHref = href('news', lang);
const news = forLang(await getNews(), lang);
const culturalNews = news.filter((p) => p.data.category === 'recommends');
const matinNews = news
  .filter((p) => p.data.category === 'matin-news' && articleHref(p, lang) !== featured?.url)
  .slice(0, 3);
// Notes from the President (owner's request, Oct 27 2026): the two latest, on a deep terracotta band.
const notes = await getNotes(2);
const l = livingStrings(lang);
---

<BaseLayout lang={lang} alternates={siteAlternates('home')} searchable={false}>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p class="mt-4 rounded-2xl bg-tint p-4 text-center font-semibold text-ink" role="status">
      {t('newsletter.confirmed')}
    </p>
  </div>

  <div class="alive living">
    <AliveHero lang={lang} />
    {/* Four dates only (owner's request, Oct 28 2026: fewer identical cards). */}
    <UpcomingStrip lang={lang} limit={4} />

    <!-- Who we are: the approved introduction, set large, beside a photo collage -->
    <LivingIntro lang={lang} />

    <!-- Matin in Action as visual stories: the featured activity told large, Matin's
       "coming soon" posters beside it at different heights. Only Matin's own content
       (src/lib/matin.ts, src/content/coming-soon/). Each poster opens in the page's
       fullscreen viewer. On phones the stories scroll sideways. -->
    <section id="action" class="laction scroll-mt-24" aria-labelledby="action-title">
      <div class="container-site">
        <header class="laction__head" data-reveal>
          <h2 id="action-title" class="living-title">
            {t('home.actionTitle')}
          </h2>
          <p class="living-lede">{t('home.actionLede')}</p>
        </header>
        {featured || soon.length > 0 ? (
          <div class="laction__stories" data-carousel>
            <ul class="laction__track" data-carousel-track>
              {featured && (
                <li class="laction__item laction__item--lead">
                  <article class="story story--lead" data-reveal>
                    {posterLarge ? (
                      <a
                        href={posterLarge}
                        class="story__zoom"
                        data-lightbox="action-posters"
                        data-alt={featured.imageAlt}
                        data-caption={featured.title}
                        aria-label={t('gallery.openPoster', { title: featured.title })}
                      >
                        <MatinMedia
                          item={featured}
                          sizes={leadSizes}
                          class="story__media is-poster"
                        />
                        <span class="story__plus" aria-hidden="true">
                          <Plus size={24} />
                        </span>
                      </a>
                    ) : (
                      <MatinMedia
                        item={featured}
                        sizes={leadSizes}
                        class:list={['story__media', featured.poster && 'is-poster']}
                      />
                    )}
                    <div class="story__caption">
                      <p class="story__label story__label--lead">{l.featured}</p>
                      <h3 class="story__title">{featured.title}</h3>
                      {!featured.poster && (
                        <>
                          <p class="story__when">
                            <CalendarDays size={18} aria-hidden="true" />
                            <time datetime={featured.datetime}>{featured.when}</time>
                            {featured.location && (
                              <>
                                <MapPin size={18} aria-hidden="true" />
                                <span>{featured.location}</span>
                              </>
                            )}
                          </p>
                          <p class="story__summary">{featured.summary}</p>
                        </>
                      )}
                      <a
                        href={featured.url}
                        class="living-btn"
                        target={featured.external ? '_blank' : undefined}
                        rel={featured.external ? 'noopener noreferrer' : undefined}
                      >
                        {featured.ctaLabel ?? ctaFor(featured.type, t)}
                        {featured.external ? (
                          <ExternalLink size={18} aria-hidden="true" />
                        ) : (
                          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
                        )}
                        {featured.external && <span class="sr-only">{t('a11y.externalLink')}</span>}
                      </a>
                    </div>
                  </article>
                </li>
              )}
              {soon.map((p, i) => (
                <li class="laction__item">
                  <article class="story" data-reveal style={`--reveal-delay:${(i + 1) * 120}ms`}>
                    <a
                      href={p.large}
                      class="story__zoom"
                      data-lightbox="action-posters"
                      data-alt={p.item.imageAlt}
                      data-caption={`${p.item.title} · ${t('home.comingSoon')}`}
                      aria-label={t('gallery.openPoster', { title: p.item.title })}
                    >
                      <MatinMedia item={p.item} sizes={slideSizes} class="story__media is-poster" />
                      <span class="story__plus" aria-hidden="true">
                        <Plus size={24} />
                      </span>
                    </a>
                    <div class="story__caption">
                      <p class="story__label">
                        <Clock size={16} aria-hidden="true" />
                        {t('home.comingSoon')}
                      </p>
                      <h3 class="story__title">{p.item.title}</h3>
                      <p class="story__subtitle">{p.item.summary}</p>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
            <div class="laction__nav" data-carousel-nav hidden>
              <button type="button" class="laction__arrow" data-carousel-prev>
                <ChevronLeft size={22} class="flip-rtl" aria-hidden="true" />
                <span class="sr-only">{t('home.carouselPrev')}</span>
              </button>
              <button type="button" class="laction__arrow" data-carousel-next>
                <ChevronRight size={22} class="flip-rtl" aria-hidden="true" />
                <span class="sr-only">{t('home.carouselNext')}</span>
              </button>
            </div>
          </div>
        ) : (
          <div class="empty-state">
            <p>{t('home.latestEmpty')}</p>
          </div>
        )}
      </div>
    </section>

    <!-- A Personal Note from Our President: photo, first paragraph, link to the full note -->
    <PresidentExcerpt lang={lang} />

    <!-- Matin's Picks: a discovery gallery (same data as the Events page) -->
    <PicksGallery lang={lang} />
    <ExpireEvents />

    <!-- A full-width pause: Montréal -->
    <MontrealPause lang={lang} />

    <!-- Programs and Participation -->
    <LivingPrograms lang={lang} />

    <!-- News, set like a cultural publication: Cultural News in region tabs, then Matin News -->
    <section id="latest-news" class="lnews scroll-mt-24" aria-labelledby="latest-news-title">
      <div class="container-site">
        <header class="lnews__head" data-reveal>
          <div>
            <h2 id="latest-news-title" class="living-title">
              {t('home.newsTitle')}
            </h2>
            <p class="living-lede">{t('news.lede')}</p>
          </div>
          <a href={href('news', lang)} class="living-link">
            {t('home.newsAll')}
            <ArrowRight size={20} class="flip-rtl" aria-hidden="true" />
          </a>
        </header>
        <div class="news-wire">
          <div class="lnews__sub">
            <h3 class="lnews__subtitle">{t('news.culturalTitle')}</h3>
            <a
              href={`${newsHref}#${newsAnchors.recommends}`}
              class="living-link living-link--small"
            >
              {t('news.allCultural')}
              <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
            </a>
          </div>
          <NewsRegionTabs
            lang={lang}
            posts={culturalNews}
            perTab={4}
            id="home-cultural"
            level={4}
          />
        </div>
        {matinNews.length > 0 && (
          <div class="lnews__matin">
            <div class="lnews__sub">
              <h3 class="lnews__subtitle">{t('news.matinTitle')}</h3>
              <a
                href={`${newsHref}#${newsAnchors['matin-news']}`}
                class="living-link living-link--small"
              >
                {t('news.allMatin')}
                <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
              </a>
            </div>
            <ul
              class:list={[
                'grid gap-6 lg:gap-8',
                matinNews.length > 1 && 'md:grid-cols-2 lg:grid-cols-3',
              ]}
            >
              {matinNews.map((post) => (
                <li>
                  <PostCard
                    post={post}
                    lang={lang}
                    headingLevel="h4"
                    featured={matinNews.length === 1}
                  />
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <!-- Notes from the President: the latest LinkedIn notes, hidden while there are none -->
    {notes.length > 0 && (
      <section
        id="president-notes"
        class="lnotes scroll-mt-24"
        aria-labelledby="president-notes-title"
      >
        <div class="container-site">
          <header class="lnews__head">
            <div>
              <h2 id="president-notes-title" class="living-title">
                {t('notes.title')}
              </h2>
              <p class="living-lede">{t('notes.homeLede')}</p>
            </div>
            <a href={href('notes', lang)} class="living-link">
              {t('notes.all')}
              <ArrowRight size={20} class="flip-rtl" aria-hidden="true" />
            </a>
          </header>
          <ul class:list={['notes-home__list', notes.length > 1 && 'notes-home__list--two']}>
            {notes.map((note) => (
              <li>
                <NoteCard note={note} lang={lang} headingLevel="h3" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Cultural Resources & Organizations: opens the directory -->
    <ResourcesTeaser lang={lang} />
  </div>

  {/* One viewer for the page: the Matin in Action posters. */}
  <Lightbox lang={lang} />
</BaseLayout>

<script>
  // Matin in Action: on phones and tablets the stories scroll sideways; the arrow buttons
  // appear only when they overflow.
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const nav = root.querySelector<HTMLElement>('[data-carousel-nav]')!;
    const rtl = getComputedStyle(root).direction === 'rtl';
    const step = (dir: number) => {
      const slide = track.querySelector<HTMLElement>('.laction__item');
      const width = slide ? slide.offsetWidth + parseFloat(getComputedStyle(track).columnGap) : 300;
      track.scrollBy({ left: dir * width * (rtl ? -1 : 1), behavior: 'smooth' });
    };
    root.querySelector('[data-carousel-prev]')!.addEventListener('click', () => step(-1));
    root.querySelector('[data-carousel-next]')!.addEventListener('click', () => step(1));
    const update = () => (nav.hidden = track.scrollWidth <= track.clientWidth + 2);
    new ResizeObserver(update).observe(track);
    update();
  }

  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    const note = document.querySelector<HTMLElement>('[data-newsletter-confirmed]');
    if (note) note.hidden = false;
  }
</script>

<style>
  /* ================= Living homepage: shared pieces (CLAUDE.md 4d) ================= */
  .living {
    background: var(--living-ivory);
    color: var(--living-charcoal);
  }
  /* Small label above a title: terracotta ink, spaced capitals (Latin). */
  .living :global(.living-kicker) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 0.8rem + 0.2vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--living-terracotta-ink);
  }
  :global(html[lang='fa']) .living :global(.living-kicker) {
    letter-spacing: 0;
    font-size: 1.05rem;
  }
  /* Section headlines: Fraunces, large, soft; Persian keeps Vazirmatn. */
  .living :global(.living-title) {
    margin-block-start: 0.5rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 5rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 144;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--living-charcoal);
    text-wrap: balance;
  }
  :global(html[lang='fa']) .living :global(.living-title) {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.75rem);
    font-weight: 900;
    line-height: 1.35;
    letter-spacing: 0;
  }
  .living :global(.living-lede) {
    max-width: 40rem;
    margin-block-start: 1.1rem;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    line-height: 1.6;
    color: var(--living-charcoal);
  }
  /* A text link with a gold rule that thickens on hover, and a moving arrow. */
  .living :global(.living-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--living-charcoal);
    text-decoration: underline;
    text-decoration-color: var(--living-gold);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.35em;
    transition: text-decoration-color 0.3s ease;
  }
  .living :global(.living-link--small) {
    font-size: 1rem;
  }
  .living :global(.living-link svg) {
    color: var(--living-terracotta-ink);
    transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .living :global(.living-link:hover) {
    text-decoration-color: var(--living-terracotta);
  }
  .living :global(.living-link:hover svg) {
    translate: 4px 0;
  }
  :global([dir='rtl']) .living :global(.living-link:hover svg) {
    translate: -4px 0;
  }
  /* Main button: deep terracotta with white text (5.5:1), coral with charcoal on hover. */
  .living :global(.living-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    background: var(--living-terracotta-ink);
    color: var(--matin-white);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .living :global(.living-btn:hover) {
    background: var(--living-coral);
    color: var(--living-charcoal);
    transform: translateY(-2px);
  }
  .living :global(:focus-visible) {
    outline-color: var(--living-terracotta-ink);
  }
  /* The Coming up strip sits on the same warm ground. */
  .living :global(.upcoming) {
    background: var(--living-sand);
  }

  /* ================= Matin in Action: stories ================= */
  .laction {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    background: var(--matin-paper);
    border-start-end-radius: clamp(3rem, 8vw, 9rem);
  }
  .laction__head {
    max-width: 48rem;
    margin-block-end: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  /* Phones and tablets: one story and a peek of the next, swiped. */
  .laction__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--living-terracotta) transparent;
    padding: 0.75rem 0.5rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .laction__track {
      grid-auto-columns: 46%;
    }
  }
  .laction__item {
    scroll-snap-align: start;
  }
  /* Wide screens: the featured story large on the reading side, the next ones smaller,
     at different heights, like a magazine spread. */
  @media (min-width: 64rem) {
    .laction__track {
      grid-auto-flow: row;
      grid-template-columns: minmax(0, 7.4fr) minmax(0, 2.8fr) minmax(0, 2.8fr);
      gap: clamp(1.5rem, 1rem + 2vw, 3rem);
      align-items: start;
      overflow: visible;
    }
    .laction__item:nth-child(2) {
      margin-block-start: 7rem;
    }
    .laction__item:nth-child(3) {
      margin-block-start: 2rem;
    }
    .laction__item:nth-child(3n + 4) {
      grid-column: 1;
    }
    .story--lead {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: end;
      gap: 2rem;
    }
  }
  .laction__nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
  }
  .laction__nav[hidden] {
    display: none;
  }
  .laction__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--living-terracotta-ink);
    color: var(--matin-white);
  }
  .laction__arrow:hover {
    background: var(--living-coral);
    color: var(--living-charcoal);
  }
  .story {
    display: grid;
    gap: 1.25rem;
  }
  .story__zoom {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 1.25rem;
    box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--living-charcoal) 60%, transparent);
    cursor: zoom-in;
    transition:
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      rotate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Posters pinned slightly off-straight (owner's request, Oct 28 2026). */
  .laction__item:nth-child(3n + 1) .story__zoom {
    rotate: -1.2deg;
  }
  .laction__item:nth-child(3n + 2) .story__zoom {
    rotate: 1.4deg;
  }
  .laction__item:nth-child(3n) .story__zoom {
    rotate: -0.6deg;
  }
  .story :global(.story__media) {
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  /* Matin's posters are 906 × 1280: the frame takes their exact shape. */
  .story :global(.story__media.is-poster) {
    aspect-ratio: 906 / 1280;
  }
  .story__zoom :global(img) {
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .story__zoom:hover {
      rotate: 0deg;
      transform: translateY(-6px);
    }
    .story__zoom:hover :global(img) {
      transform: scale(1.03);
    }
  }
  .story__plus {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--living-charcoal);
    color: var(--living-ivory);
    transition: background-color 0.3s ease;
  }
  .story__zoom:hover .story__plus {
    background: var(--living-gold);
    color: var(--living-charcoal);
  }
  .story__caption {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .story__label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--living-gold);
    color: var(--living-charcoal);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .story__label--lead {
    background: var(--living-coral);
  }
  :global(html[lang='fa']) .story__label {
    letter-spacing: 0;
