---
/**
 * Homepage (French, English and Persian), in this order: Matin in Action (Matin's own
 * featured item, src/lib/matin.ts, and the "coming soon" posters in one carousel), Matin's
 * Picks (the same section as on the Events
 * page), the latest news (without the featured article), Matin Moments (featured gallery
 * items), Get Involved, Who We Are, Areas of Work, Cultural Resources & Organizations,
 * newsletter.
 * The photographs are openly licensed views of Montréal (see src/lib/photos.ts), shown
 * with their credits; they illustrate the themes, they do not document Matin activities.
 */
import {
  ArrowRight,
  CalendarDays,
  ChevronLeft,
  ChevronRight,
  Clock,
  ExternalLink,
  MapPin,
  Plus,
} from '@lucide/astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Lightbox from '@/components/ui/Lightbox.astro';
import NewsRegionTabs from '@/components/content/NewsRegionTabs.astro';
import PicksSection from '@/components/content/PicksSection.astro';
import PostCard from '@/components/content/PostCard.astro';
import MatinMoments from '@/components/content/MatinMoments.astro';
import ResourcesTeaser from '@/components/content/ResourcesTeaser.astro';
import ExpireEvents from '@/components/content/ExpireEvents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/brand/HomeHero.astro';
import CulturesRibbon from '@/components/brand/CulturesRibbon.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import AreasGrid from '@/components/content/AreasGrid.astro';
import { href, newsAnchors, siteAlternates, type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import { getMatinFeed, type MatinItem } from '@/lib/matin';
import { articleHref, forLang, getNews } from '@/lib/content';
import { ctaFor } from '@/lib/matinLabels';
import MatinMedia from '@/components/content/MatinMedia.astro';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Matin in Action: Matin's own content only (highlights, Matin's events, published news).
const { featured } = await getMatinFeed(lang, 0);
const posterLarge =
  featured?.poster && featured.image
    ? (
        await getImage({
          src: featured.image,
          width: Math.min(2000, featured.image.width),
          format: 'webp',
        })
      ).src
    : undefined;
// "Coming soon" posters (owner's brief, Oct 27 2026): one image per language, no dates.
const soon = await Promise.all(
  (await getCollection('comingSoon', (c) => c.data.published))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (c) => {
      const image =
        (lang === 'fa' && c.data.poster.fa) || c.data.poster[lang === 'fa' ? 'en' : lang];
      const item = {
        id: `soon-${c.id}`,
        type: 'poster',
        title: pick(c.data.title, lang)!,
        summary: pick(c.data.summary, lang)!,
        image,
        imageAlt: pick(c.data.posterAlt, lang)!,
        poster: true,
      } as MatinItem;
      const large = (
        await getImage({ src: image, width: Math.min(2000, image.width), format: 'webp' })
      ).src;
      return { item, large };
    }),
);
const slideSizes = '(min-width: 64rem) 28rem, (min-width: 48rem) 46vw, 85vw';
// News (owner's brief, Oct 25 2026): Cultural News approved by the President in three
// region tabs, then Matin News, leaving out the article already featured in Matin in Action.
const newsHref = href('news', lang);
const news = forLang(await getNews(), lang);
const culturalNews = news.filter((p) => p.data.category === 'recommends');
const matinNews = news
  .filter((p) => p.data.category === 'matin-news' && articleHref(p, lang) !== featured?.url)
  .slice(0, 3);
---

<BaseLayout lang={lang} alternates={siteAlternates('home')} searchable={false}>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p class="mt-4 rounded-2xl bg-tint p-4 text-center font-semibold text-ink" role="status">
      {t('newsletter.confirmed')}
    </p>
  </div>

  <HomeHero lang={lang} />
  <CulturesRibbon lang={lang} />

  <!-- Matin in Action: what Matin is doing now. The featured item (a highlight marked
       featured, else Matin's next event, else the latest article), then the latest items.
       Only Matin's own content; see src/content/highlights/README.md. -->
  <section id="action" class="section-pad scroll-mt-24 bg-paper" aria-labelledby="action-title">
    <div class="container-site">
      <SectionHeader
        id="action-title"
        title={t('home.actionTitle')}
        lede={t('home.actionLede')}
        align="start"
        class="mb-10"
      />
      {/* Matin in Action carousel (owner's brief, Oct 27 2026): the featured activity, then
          Matin's "coming soon" posters (src/content/coming-soon/). Every poster opens in the
          page's fullscreen viewer, as one group; three across on wide screens, swiped on
          smaller ones with the arrow buttons. */}
      {featured || soon.length > 0 ? (
        <div class="action-carousel" data-carousel>
          <ul class="action-track" data-carousel-track>
            {featured && (
              <li class="action-slide">
                <article class:list={['feature', featured.poster && 'feature--poster']} data-reveal>
                  {posterLarge ? (
                    /* A poster opens in the same fullscreen viewer as Gallery → Posters; the
                       button under it leads to the activity's page (the poster download stays
                       on that page and in the Gallery, not on the homepage: owner's request,
                       Oct 27 2026). */
                    <a
                      href={posterLarge}
                      class="feature__zoom"
                      data-lightbox="action-posters"
                      data-alt={featured.imageAlt}
                      data-caption={featured.title}
                      aria-label={t('gallery.openPoster', { title: featured.title })}
                    >
                      <MatinMedia
                        item={featured}
                        sizes={slideSizes}
                        class="feature__media is-poster"
                      />
                      <span class="feature__zoom-icon" aria-hidden="true">
                        <Plus size={24} />
                      </span>
                    </a>
                  ) : (
                    <MatinMedia
                      item={featured}
                      sizes={slideSizes}
                      class:list={['feature__media', featured.poster && 'is-poster']}
                    />
                  )}
                  {/* No side panel (owner's request, Oct 27 2026): a poster already carries
                      its details, so only the title and the activity button sit under it. */}
                  <div class="feature__caption">
                    <h3 class="feature__title">{featured.title}</h3>
                    {!featured.poster && (
                      <>
                        <p class="feature__when">
                          <CalendarDays size={18} aria-hidden="true" />
                          <time datetime={featured.datetime}>{featured.when}</time>
                          {featured.location && (
                            <>
                              <MapPin size={18} aria-hidden="true" />
                              <span>{featured.location}</span>
                            </>
                          )}
                        </p>
                        <p class="feature__summary">{featured.summary}</p>
                      </>
                    )}
                    <div class="feature__actions">
                      <a
                        href={featured.url}
                        class="btn btn-primary"
                        target={featured.external ? '_blank' : undefined}
                        rel={featured.external ? 'noopener noreferrer' : undefined}
                      >
                        {featured.ctaLabel ?? ctaFor(featured.type, t)}
                        {featured.external ? (
                          <ExternalLink size={18} aria-hidden="true" />
                        ) : (
                          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
                        )}
                        {featured.external && <span class="sr-only">{t('a11y.externalLink')}</span>}
                      </a>
                    </div>
                  </div>
                </article>
              </li>
            )}
            {soon.map((p) => (
              <li class="action-slide">
                <article class="feature feature--poster feature--soon" data-reveal>
                  <a
                    href={p.large}
                    class="feature__zoom"
                    data-lightbox="action-posters"
                    data-alt={p.item.imageAlt}
                    data-caption={`${p.item.title} · ${t('home.comingSoon')}`}
                    aria-label={t('gallery.openPoster', { title: p.item.title })}
                  >
                    <MatinMedia item={p.item} sizes={slideSizes} class="feature__media is-poster" />
                    <span class="feature__zoom-icon" aria-hidden="true">
                      <Plus size={24} />
                    </span>
                  </a>
                  <div class="feature__caption">
                    <p class="feature__soon">
                      <Clock size={16} aria-hidden="true" />
                      {t('home.comingSoon')}
                    </p>
                    <h3 class="feature__title">{p.item.title}</h3>
                    <p class="feature__subtitle">{p.item.summary}</p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
          <div class="action-carousel__nav" data-carousel-nav hidden>
            <button type="button" class="action-carousel__btn" data-carousel-prev>
              <ChevronLeft size={22} class="flip-rtl" aria-hidden="true" />
              <span class="sr-only">{t('home.carouselPrev')}</span>
            </button>
            <button type="button" class="action-carousel__btn" data-carousel-next>
              <ChevronRight size={22} class="flip-rtl" aria-hidden="true" />
              <span class="sr-only">{t('home.carouselNext')}</span>
            </button>
          </div>
        </div>
      ) : (
        <div class="empty-state">
          <p>{t('home.latestEmpty')}</p>
          <a href="#newsletter" class="btn btn-primary">
            {t('home.involvedSecondary')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        </div>
      )}

    </div>
  </section>

  <!-- Matin's Picks: the same section and data as on the Events page -->
  <PicksSection
    lang={lang}
    class="section-pad bg-tint"
    link={{ href: href('events', lang), label: t('home.eventsAll') }}
  />
  <ExpireEvents />

  <!-- News (owner's brief, Oct 25 2026): Cultural News in region tabs, then Matin News -->
  <section
    id="latest-news"
    class="news-band on-dark section-pad scroll-mt-24"
    aria-labelledby="latest-news-title"
  >
    <div class="container-site">
      <SectionHeader
        align="start"
        id="latest-news-title"
        title={t('home.newsTitle')}
        subtitle={t('news.lede')}
        link={{ href: href('news', lang), label: t('home.newsAll') }}
        class="mb-10"
      />
      <div class="news-wire">
        <div class="news-panel__head">
          <h3 class="news-panel__title">{t('news.culturalTitle')}</h3>
          <a href={`${newsHref}#${newsAnchors.recommends}`} class="link-arrow">
            {t('news.allCultural')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        </div>
        <NewsRegionTabs lang={lang} posts={culturalNews} perTab={3} id="home-cultural" level={4} />
      </div>
      {matinNews.length > 0 && (
        <div class="matin-news">
          <div class="news-panel__head">
            <h3 class="news-panel__title">{t('news.matinTitle')}</h3>
            <a href={`${newsHref}#${newsAnchors['matin-news']}`} class="link-arrow">
              {t('news.allMatin')}
              <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
            </a>
          </div>
          {/* A single article takes the wide card, so no empty columns are left beside it. */}
          <ul
            class:list={[
              'grid gap-6 lg:gap-8',
              matinNews.length > 1 && 'md:grid-cols-2 lg:grid-cols-3',
            ]}
          >
            {matinNews.map((post) => (
              <li>
                <PostCard
                  post={post}
                  lang={lang}
                  headingLevel="h4"
                  featured={matinNews.length === 1}
                />
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- Matin Moments: featured photos and videos from the gallery -->
  <MatinMoments lang={lang} />

  <!-- Areas of work: deep teal band (owner's brief, Oct 25 2026), the introduction set
       large directly under the title, then the three photo cards -->
  <section class="section-pad areas-band on-teal" aria-labelledby="areas-title">
    <div class="container-site">
      <div class="areas-head">
        <SectionHeader
          id="areas-title"
          eyebrow={t('home.areasEyebrow')}
          title={t('home.areasTitle')}
          align="start"
          class="mb-6"
        />
        <p class="areas-intro" data-reveal>
          {t('home.areasLede')}
        </p>
      </div>
      <AreasGrid lang={lang} />
    </div>
  </section>

  <!-- Cultural Resources & Organizations: opens the directory -->
  <ResourcesTeaser lang={lang} />

  {/* One viewer for the page: the featured poster and the images of Matin's Picks. */}
  <Lightbox lang={lang} />
</BaseLayout>

<script>
  // Matin in Action carousel: the arrow buttons appear only when the posters overflow.
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const nav = root.querySelector<HTMLElement>('[data-carousel-nav]')!;
    const rtl = getComputedStyle(root).direction === 'rtl';
    const step = (dir: number) => {
      const slide = track.querySelector<HTMLElement>('.action-slide');
      const width = slide ? slide.offsetWidth + parseFloat(getComputedStyle(track).columnGap) : 300;
      track.scrollBy({ left: dir * width * (rtl ? -1 : 1), behavior: 'smooth' });
    };
    root.querySelector('[data-carousel-prev]')!.addEventListener('click', () => step(-1));
    root.querySelector('[data-carousel-next]')!.addEventListener('click', () => step(1));
    const update = () => (nav.hidden = track.scrollWidth <= track.clientWidth + 2);
    new ResizeObserver(update).observe(track);
    update();
  }

  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    const note = document.querySelector<HTMLElement>('[data-newsletter-confirmed]');
    if (note) note.hidden = false;
  }
</script>

<style>
  /* ---------- Matin in Action ---------- */
  /* Carousel: one poster and a peek of the next on phones, two on tablets, three
     across on wide screens (owner's brief, Oct 27 2026). */
  .action-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 85%;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-block: 0.5rem 1rem;
    padding-inline: 0.25rem;
  }
  @media (min-width: 48rem) {
    .action-track {
      grid-auto-columns: calc((100% - clamp(1.25rem, 1rem + 1.5vw, 2.25rem)) / 2);
    }
  }
  @media (min-width: 64rem) {
    .action-track {
      grid-auto-columns: calc((100% - 2 * clamp(1.25rem, 1rem + 1.5vw, 2.25rem)) / 3);
    }
  }
  .action-slide {
    scroll-snap-align: start;
  }
  .action-carousel__nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
  .action-carousel__nav[hidden] {
    display: none;
  }
  .action-carousel__btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow: var(--shadow-card);
  }
  .action-carousel__btn:hover {
    background: var(--color-gold);
    color: var(--color-primary);
  }
  .feature {
    display: grid;
    gap: 1.25rem;
  }
  .feature__zoom {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: calc(var(--radius-card) * 1.2);
    box-shadow: var(--shadow-card);
    cursor: zoom-in;
  }
  .feature :global(.feature__media) {
    overflow: hidden;
    border-radius: calc(var(--radius-card) * 1.2);
    aspect-ratio: 4 / 3;
  }
  .feature :global(.feature__media.is-poster) {
    aspect-ratio: 4 / 5;
  }
  .feature__zoom :global(img) {
    transition: transform 0.5s ease;
  }
  .feature__zoom:hover :global(img) {
    transform: scale(1.03);
  }
  .feature__zoom:hover .feature__zoom-icon {
    background: var(--color-gold);
    color: var(--color-primary);
  }
  /* Same zoom badge as the Gallery posters and event pages. */
  .feature__zoom-icon {
    position: absolute;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow: var(--shadow-lift);
  }
  @media (prefers-reduced-motion: reduce) {
    .feature__zoom :global(img) {
      transition: none;
    }
    .feature__zoom:hover :global(img) {
      transform: none;
    }
  }
  .feature__caption {
    display: grid;
    gap: 0.8rem;
  }
  .feature__title {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.125rem);
    font-weight: 800;
    line-height: 1.15;
    text-wrap: balance;
  }
  /* "Coming soon": a clear gold label on the posters not yet scheduled. */
  .feature__soon {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    justify-self: start;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .feature__subtitle {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-terracotta-deep);
  }
  .feature__when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .feature__when :global(svg) {
    color: var(--color-teal-deep);
  }
  .feature__summary {
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .feature__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ---------- News & Insights ---------- */
  /* Cultural News: editorial list straight on the page (.news-wire in global.css). */
  .news-panel__title {
    font-size: clamp(1.5rem, 1.3rem + 0.7vw, 2rem);
    font-weight: 800;
  }
  .news-panel__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-block-end: 1.25rem;
  }
  .news-panel__head .news-panel__title {
    margin-block-end: 0;
  }
  .matin-news {
    margin-block-start: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  /* ---------- Areas of work ---------- */
  /* The deep teal of the former Get Involved band (white text 6.2:1). */
  .areas-band {
    background: var(--color-teal-deep);
  }
  .areas-head {
    max-width: 56rem;
    margin-block-end: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .areas-intro {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    line-height: 1.6;
    color: var(--color-white);
  }
  /* Cards on teal: warm ivory, a gold edge and a clearer call to action. */
  .areas-band :global(.area-card) {
    border-color: transparent;
    background: var(--color-ivory);
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--color-primary) 70%, transparent);
  }
  .areas-band :global(.area-card__title) {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
  }
  .areas-band :global(.area-card__text) {
    font-size: 1.1875rem;
    color: var(--color-ink);
  }
  .areas-band :global(.area-card__cta) {
    align-self: flex-start;
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-white);
  }
  .areas-band :global(.photo-credit a) {
    color: inherit;
  }
</style>
