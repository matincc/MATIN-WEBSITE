---
/**
 * Homepage (French, English and Persian). Shows only real content: events and news
 * sections fall back to short, welcoming empty states until entries exist.
 */
import {
  ArrowRight,
  BookOpen,
  Eye,
  HeartHandshake,
  Landmark,
  Target,
  UsersRound,
} from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/brand/HomeHero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import EventCard from '@/components/content/EventCard.astro';
import ExpireEvents from '@/components/content/ExpireEvents.astro';
import PostCard from '@/components/content/PostCard.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { forLang, getNews, getUpcomingEvents, isMatinEvent } from '@/lib/content';
import { newsCategories } from '@/lib/taxonomy';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const [upcomingAll, postsAll] = await Promise.all([getUpcomingEvents(), getNews()]);
// Persian pages only list entries whose Persian translation has been reviewed.
// Up to 3 upcoming events, Matin's own first (the sort is stable, so dates stay in order).
const upcoming = forLang(upcomingAll, lang)
  .filter((e) => e.data.status !== 'cancelled')
  .sort((a, b) => Number(!isMatinEvent(a)) - Number(!isMatinEvent(b)))
  .slice(0, 3);
const posts = forLang(postsAll, lang);
const newsTabs = newsCategories.map((c) => ({
  id: c,
  label: t(`newsCategories.${c}`),
  posts: posts.filter((p) => p.data.category === c).slice(0, 2),
}));
const anyNews = newsTabs.some((tab) => tab.posts.length);

const aboutHref = href('about', lang);
const whoCards = [
  { id: 'mission', label: t('nav.mission'), icon: Target },
  { id: 'vision', label: t('nav.vision'), icon: Eye },
  { id: 'values', label: t('nav.values'), icon: HeartHandshake },
  // The Persian About page has the values section only.
].filter((c) => lang !== 'fa' || c.id === 'values');
const areas = [
  { title: t('home.area1Title'), text: t('home.area1Text'), icon: UsersRound },
  { title: t('home.area2Title'), text: t('home.area2Text'), icon: Landmark },
  { title: t('home.area3Title'), text: t('home.area3Text'), icon: BookOpen },
];
const interestHref = `${href('getInvolved', lang)}#interest`;
---

<BaseLayout
  lang={lang}
  alternates={siteAlternates('home')}
  footerNewsletter={false}
  searchable={false}
>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p class="mt-4 rounded-2xl bg-tint p-4 text-center font-semibold text-ink" role="status">
      {t('newsletter.confirmed')}
    </p>
  </div>

  <HomeHero lang={lang} />

  <!-- Who we are -->
  <section id="who-we-are" class="scroll-mt-24 bg-cream py-20 sm:py-24" aria-labelledby="who-title">
    <div class="container-site">
      <SectionHeader id="who-title" title={t('home.whoTitle')} class="mb-8" />
      <p class="who-text mx-auto text-center">{t('home.whoText')}</p>
      <nav aria-label={t('home.whoCardsLabel')} class="mt-12">
        <ul class="grid gap-5 sm:grid-cols-3">
          {whoCards.map((c) => (
            <li>
              <a href={`${aboutHref}#${c.id}`} class="card who-card on-dark">
                <c.icon
                  size={28}
                  stroke-width={1.25}
                  class="shrink-0 text-gold"
                  aria-hidden="true"
                />
                <span class="flex-1 text-xl font-bold text-white">{c.label}</span>
                <ArrowRight size={20} class="flip-rtl shrink-0 text-gold" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Areas of work -->
  <section class="bg-tint py-20 sm:py-24" aria-labelledby="areas-title">
    <div class="container-site">
      <SectionHeader
        id="areas-title"
        eyebrow={t('home.areasEyebrow')}
        title={t('home.areasTitle')}
        lede={t('home.areasLede')}
      />
      <ul class="grid gap-6 lg:grid-cols-3">
        {areas.map((a) => (
          <li>
            <a href={href('programs', lang)} class="card area-card">
              <a.icon size={36} stroke-width={1.25} class="text-gold-dark" aria-hidden="true" />
              <h3 class="area-title font-bold">{a.title}</h3>
              <p class="text-[1.07rem] leading-relaxed">{a.text}</p>
              <span class="link-arrow mt-auto pt-2">
                {t('common.learnMore')}
                <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Selected upcoming events: a compact preview of the agenda -->
  <section
    class:list={['bg-cream', upcoming.length > 0 ? 'py-20 sm:py-24' : 'py-16']}
    aria-labelledby="events-title"
  >
    <div class="container-site">
      <SectionHeader
        id="events-title"
        title={t('home.eventsTitle')}
        class={upcoming.length > 0 ? 'mb-12' : 'mb-8'}
      />
      <div>
        {upcoming.length > 0 && (
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-upcoming-list>
            {upcoming.map((event) => (
              <li>
                <EventCard event={event} lang={lang} />
              </li>
            ))}
          </ul>
        )}
        <p class="empty-line" data-upcoming-empty hidden={upcoming.length > 0}>
          {t('home.eventsEmpty')}
        </p>
      </div>
      <div class="mt-10 text-center">
        <a href={href('events', lang)} class="btn btn-outline">
          {t('home.eventsAll')}
          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
  <ExpireEvents />

  <!-- News: shown once there is at least one real post -->
  {anyNews && (
    <section class="bg-tint py-20 sm:py-24" aria-labelledby="news-title">
      <div class="container-site">
        <SectionHeader
          id="news-title"
          title={t('home.newsTitle')}
          link={{ href: href('news', lang), label: t('home.newsAll') }}
        />
        <div data-tabs>
          <div role="tablist" aria-label={t('home.newsTabs')} class="tablist">
            {newsTabs.map((tab, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                aria-controls={`panel-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class="tab"
              >
                {tab.label}
              </button>
            ))}
          </div>
          {newsTabs.map((tab, i) => (
            <div
              role="tabpanel"
              id={`panel-${tab.id}`}
              aria-labelledby={`tab-${tab.id}`}
              tabindex="0"
              hidden={i > 0}
              class="pt-8"
            >
              {tab.posts.length > 0 ? (
                <ul class="grid gap-10 md:grid-cols-2">
                  {tab.posts.map((post) => (
                    <li>
                      <PostCard post={post} lang={lang} />
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty-line">{t('home.newsEmptyCategory')}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Get involved -->
  <section class="on-dark bg-primary py-20 sm:py-24" aria-labelledby="involved-title">
    <div class="container-site">
      <SectionHeader
        id="involved-title"
        eyebrow={t('home.involvedEyebrow')}
        title={t('home.involvedTitle')}
        class="mb-8"
      />
      <p class="mx-auto max-w-3xl text-center text-lg leading-relaxed text-cream sm:text-xl">
        {t('home.involvedText')}
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a href={interestHref} class="btn btn-primary">
          {t('home.involvedPrimary')}
          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section
    id="newsletter"
    class="scroll-mt-24 bg-cream py-16 sm:py-20"
    aria-labelledby="newsletter-title"
  >
    <div class="container-site">
      <div class="card newsletter-card">
        <SectionHeader
          id="newsletter-title"
          eyebrow={t('newsletter.eyebrow')}
          title={t('newsletter.title')}
          lede={t('newsletter.text')}
          class="mb-8"
        />
        <NewsletterForm lang={lang} id="home-newsletter" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    const note = document.querySelector<HTMLElement>('[data-newsletter-confirmed]');
    if (note) note.hidden = false;
  }

  // Accessible tabs (WAI-ARIA pattern): arrow keys move between tabs (mirrored in RTL).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const rtl = getComputedStyle(root).direction === 'rtl';
        const next = rtl ? 'ArrowLeft' : 'ArrowRight';
        const prev = rtl ? 'ArrowRight' : 'ArrowLeft';
        let j = -1;
        if (e.key === next) j = (i + 1) % tabs.length;
        if (e.key === prev) j = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') j = 0;
        if (e.key === 'End') j = tabs.length - 1;
        if (j >= 0) {
          e.preventDefault();
          select(tabs[j], true);
        }
      });
    });
  });
</script>

<style>
  .empty-line {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    font-size: 1.1rem;
    background: var(--color-white);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-inline-start: 4px solid var(--color-gold);
  }
  /* About 24px on desktop across the full width, so the short paragraph fits
     in two or three lines (owner's request); about 18px on mobile. */
  .who-text {
    max-width: 1216px;
    font-size: clamp(1.125rem, 0.98rem + 0.55vw, 1.5rem);
    line-height: 1.6;
  }
  /* Deep blue fill with white text and gold icons (requested by the owner),
     a little darker on hover. */
  .who-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem 1.75rem;
    text-decoration: none;
    background: var(--color-primary);
    border-color: var(--color-primary);
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .who-card:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-gold);
  }
  .area-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 2.25rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .area-card:hover {
    border-color: var(--color-gold);
  }
  .area-title {
    /* Long titles: keep them on balanced lines with the same height in all three cards */
    min-height: 2.6em;
    font-size: clamp(1.3rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.3;
    text-wrap: balance;
  }
  .tablist {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    border-block-end: 2px solid var(--color-line);
  }
  .tab {
    position: relative;
    min-height: 3rem;
    padding: 0.6rem 1.2rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-muted);
    cursor: pointer;
    border-radius: 0.75rem 0.75rem 0 0;
  }
  .tab:hover {
    color: var(--color-ink);
    background: var(--color-white);
  }
  .tab[aria-selected='true'] {
    color: var(--color-ink);
  }
  .tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    inset-inline: 0.6rem;
    bottom: -2px;
    height: 3px;
    border-radius: 3px;
    background: var(--color-gold);
  }
  .newsletter-card {
    max-width: 48rem;
    margin-inline: auto;
    padding: 2.5rem;
  }
  @media (min-width: 40rem) {
    .newsletter-card {
      padding: 3rem;
    }
  }
</style>
