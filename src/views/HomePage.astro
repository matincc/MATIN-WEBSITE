---
/**
 * Homepage (French, English and Persian). Shows only real content: events and news
 * sections fall back to short, welcoming empty states until entries exist.
 */
import {
  ArrowRight,
  BookOpen,
  Eye,
  HeartHandshake,
  Landmark,
  Target,
  UsersRound,
} from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/brand/HomeHero.astro';
import CulturesRibbon from '@/components/brand/CulturesRibbon.astro';
import SpotlightBanner from '@/components/content/SpotlightBanner.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import EventRow from '@/components/content/EventRow.astro';
import ExpireEvents from '@/components/content/ExpireEvents.astro';
import PostCard from '@/components/content/PostCard.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { forLang, getNews, getUpcomingEvents, isMatinEvent } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const [upcomingAll, postsAll] = await Promise.all([getUpcomingEvents(), getNews()]);
// Persian pages only list entries whose Persian translation has been reviewed.
// Up to 3 upcoming events, Matin's own first (the sort is stable, so dates stay in order).
const visible = forLang(upcomingAll, lang).filter((e) => e.data.status !== 'cancelled');
// One highlighted event gets the large banner; it is not repeated in the cards below.
const spotlight = visible.find((e) => e.data.spotlight);
const upcoming = visible
  .filter((e) => e !== spotlight)
  .sort((a, b) => Number(!isMatinEvent(a)) - Number(!isMatinEvent(b)))
  .slice(0, 3);
// Up to 3 recent articles; a single article is shown as one wide, featured card.
const posts = forLang(postsAll, lang).slice(0, 3);

const aboutHref = href('about', lang);
const whoCards = [
  { id: 'mission', label: t('nav.mission'), icon: Target },
  { id: 'vision', label: t('nav.vision'), icon: Eye },
  { id: 'values', label: t('nav.values'), icon: HeartHandshake },
  // The Persian About page has the values section only.
].filter((c) => lang !== 'fa' || c.id === 'values');
const areas = [
  { title: t('home.area1Title'), text: t('home.area1Text'), icon: UsersRound },
  { title: t('home.area2Title'), text: t('home.area2Text'), icon: Landmark },
  { title: t('home.area3Title'), text: t('home.area3Text'), icon: BookOpen },
];
---

<BaseLayout
  lang={lang}
  alternates={siteAlternates('home')}
  footerNewsletter={false}
  searchable={false}
>
  <!-- Shown when Brevo's confirmation link brings the visitor back (?infolettre=confirmee). -->
  <div class="container-site" data-newsletter-confirmed hidden>
    <p class="mt-4 rounded-2xl bg-tint p-4 text-center font-semibold text-ink" role="status">
      {t('newsletter.confirmed')}
    </p>
  </div>

  <HomeHero lang={lang} />
  <CulturesRibbon lang={lang} />

  <!-- Who we are -->
  <section id="who-we-are" class="scroll-mt-24 bg-cream py-20 sm:py-24" aria-labelledby="who-title">
    <div class="container-site">
      <SectionHeader id="who-title" title={t('home.whoTitle')} class="mb-8" />
      <p class="who-text mx-auto text-center" data-reveal>{t('home.whoText')}</p>
      <nav aria-label={t('home.whoCardsLabel')} class="mt-12">
        <ul class="grid gap-5 sm:grid-cols-3">
          {whoCards.map((c, i) => (
            <li data-reveal style={`--reveal-delay:${i * 120}ms`}>
              <a href={`${aboutHref}#${c.id}`} class="card card-lift who-card on-dark">
                <c.icon
                  size={28}
                  stroke-width={1.25}
                  class="shrink-0 text-gold"
                  aria-hidden="true"
                />
                <span class="flex-1 text-xl font-bold text-white">{c.label}</span>
                <ArrowRight size={20} class="flip-rtl shrink-0 text-gold" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Areas of work -->
  <section class="bg-tint py-20 sm:py-24" aria-labelledby="areas-title">
    <div class="container-site">
      <SectionHeader
        id="areas-title"
        eyebrow={t('home.areasEyebrow')}
        title={t('home.areasTitle')}
        lede={t('home.areasLede')}
      />
      <ul class="grid gap-6 lg:grid-cols-3">
        {areas.map((a, i) => (
          <li data-reveal style={`--reveal-delay:${i * 140}ms`}>
            <a href={href('programs', lang)} class="card card-lift area-card">
              <span class="area-icon" aria-hidden="true">
                <a.icon size={34} stroke-width={1.5} />
              </span>
              <h3 class="area-title font-bold">{a.title}</h3>
              <p class="text-[1.07rem] leading-relaxed">{a.text}</p>
              <span class="link-arrow mt-auto pt-2">
                {t('common.learnMore')}
                <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Selected upcoming events: a compact preview of the agenda -->
  <section
    class:list={['bg-cream', upcoming.length > 0 || spotlight ? 'py-20 sm:py-24' : 'py-16']}
    aria-labelledby="events-title"
  >
    <div class="container-site">
      <SectionHeader
        id="events-title"
        title={t('home.eventsTitle')}
        class={upcoming.length > 0 || spotlight ? 'mb-12' : 'mb-8'}
      />
      {spotlight && (
        <div class="mb-12">
          <SpotlightBanner event={spotlight} lang={lang} />
        </div>
      )}
      <div>
        {upcoming.length > 0 && (
          <ul class="grid gap-6" data-upcoming-list>
            {upcoming.map((event, i) => (
              <li data-reveal style={`--reveal-delay:${i * 120}ms`}>
                <EventRow event={event} lang={lang} />
              </li>
            ))}
          </ul>
        )}
        <p class="empty-line" data-upcoming-empty hidden={upcoming.length > 0 || !!spotlight}>
          {t('home.eventsEmpty')}
        </p>
      </div>
      <div class="mt-10 text-center">
        <a href={href('events', lang)} class="btn btn-outline">
          {t('home.eventsAll')}
          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
  <ExpireEvents />

  <!-- News & Insights: shown once there is at least one published article -->
  {posts.length > 0 && (
    <section class="bg-tint py-20 sm:py-24" aria-labelledby="news-title">
      <div class="container-site">
        <SectionHeader id="news-title" title={t('home.newsTitle')} />
        {posts.length === 1 ? (
          <PostCard post={posts[0]} lang={lang} featured />
        ) : (
          <ul class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <li>
                <PostCard post={post} lang={lang} />
              </li>
            ))}
          </ul>
        )}
        <div class="mt-12 text-center">
          <a href={href('news', lang)} class="btn btn-outline">
            {t('home.newsAll')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Get involved -->
  <section class="on-dark bg-primary py-20 sm:py-24" aria-labelledby="involved-title">
    <div class="container-site">
      <SectionHeader
        id="involved-title"
        eyebrow={t('home.involvedEyebrow')}
        title={t('home.involvedTitle')}
        class="mb-8"
      />
      <p class="mx-auto max-w-3xl text-center text-lg leading-relaxed text-cream sm:text-xl">
        {t('home.involvedText')}
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a href={href('getInvolved', lang)} class="btn btn-primary">
          {t('home.involvedPrimary')}
          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
        </a>
        <a href="#newsletter" class="btn btn-outline">
          {t('home.involvedSecondary')}
        </a>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section
    id="newsletter"
    class="scroll-mt-24 bg-cream py-16 sm:py-20"
    aria-labelledby="newsletter-title"
  >
    <div class="container-site">
      <div class="card newsletter-card">
        <SectionHeader
          id="newsletter-title"
          eyebrow={t('newsletter.eyebrow')}
          title={t('newsletter.title')}
          lede={t('newsletter.text')}
          class="mb-8"
        />
        <NewsletterForm lang={lang} id="home-newsletter" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URL(location.href).searchParams.get('infolettre') === 'confirmee') {
    const note = document.querySelector<HTMLElement>('[data-newsletter-confirmed]');
    if (note) note.hidden = false;
  }
</script>

<style>
  .empty-line {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    font-size: 1.1rem;
    background: var(--color-white);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-inline-start: 4px solid var(--color-gold);
  }
  /* About 24px on desktop across the full width, so the short paragraph fits
     in two or three lines (owner's request); about 18px on mobile. */
  .who-text {
    max-width: 1216px;
    font-size: clamp(1.125rem, 0.98rem + 0.55vw, 1.5rem);
    line-height: 1.6;
  }
  /* Deep blue fill with white text and gold icons (requested by the owner),
     a little darker on hover. */
  .who-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem 1.75rem;
    text-decoration: none;
    background: var(--color-primary);
    border-color: var(--color-primary);
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .who-card:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-gold);
  }
  .area-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 2.25rem;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .area-card {
    border-block-start: 4px solid var(--color-gold);
  }
  .area-card:hover {
    border-color: var(--color-gold);
  }
  /* Round blue badge with a gold icon at the top of each card. */
  .area-icon {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-gold);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .area-card:hover .area-icon {
    transform: rotate(-8deg) scale(1.06);
  }
  .area-title {
    /* Long titles: keep them on balanced lines with the same height in all three cards */
    min-height: 2.6em;
    font-size: clamp(1.3rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.3;
    text-wrap: balance;
  }
  .newsletter-card {
    max-width: 48rem;
    margin-inline: auto;
    padding: 2.5rem;
  }
  @media (min-width: 40rem) {
    .newsletter-card {
      padding: 3rem;
    }
  }
</style>
