---
import PageLayout from '@/layouts/PageLayout.astro';
import Prose from '@/components/ui/Prose.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getLegal, getSettings, renderMarkdown } from '@/lib/content';
import { formatDate } from '@/lib/dates';

interface Props {
  lang: UiLang;
  page: 'privacy' | 'terms' | 'accessibility';
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const [doc, settings] = await Promise.all([getLegal(page), getSettings()]);
const officer = settings.privacyOfficer;

// {{privacyOfficer}} in the text is replaced by the person in charge (Law 25),
// so the policy always shows the details from the site settings. Until a person is
// named there, the policy points to the Contact page.
const officerMd = officer
  ? `**${officer.name}**, ${pick(officer.title, lang)}  \n[${officer.email}](mailto:${officer.email})`
  : t('legal.officerFallback', { href: href('contact', lang) });
const body = pick(doc.body, lang)!.replaceAll('{{privacyOfficer}}', officerMd);

// Give each section heading an anchor and list them in the "On this page" contents.
const slug = (text: string) =>
  text
    .replace(/<[^>]+>/g, '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const toc: { id: string; label: string }[] = [];
const html = renderMarkdown(body, lang).replace(/<h2>(.*?)<\/h2>/g, (_, inner: string) => {
  const id = slug(inner) || `section-${toc.length + 1}`;
  toc.push({ id, label: inner.replace(/<[^>]+>/g, '') });
  return `<h2 id="${id}">${inner}</h2>`;
});
---

<PageLayout
  accent="encre"
  lang={lang}
  title={pick(doc.title, lang)!}
  alternates={siteAlternates(page)}
>
  <p slot="hero" class="mt-6 text-sm text-muted">
    {t('legal.updated', { date: formatDate(doc.updated, lang) })}
  </p>
  <div class="container-site legal-layout pt-4 pb-24">
    {toc.length > 1 && (
      <nav class="legal-toc" aria-label={t('legal.onThisPage')}>
        <p class="legal-toc__title">{t('legal.onThisPage')}</p>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.id}`} set:html={h.label} />
            </li>
          ))}
        </ol>
      </nav>
    )}
    <article class="legal-body">
      <Prose html={html} class="text-lg" />
    </article>
  </div>
</PageLayout>

<style>
  /* A comfortable reading column (about 80 characters) and, on wide screens, the
     contents of the page beside it, so the text is not a narrow strip in empty space. */
  .legal-layout {
    display: grid;
    gap: 2.5rem;
  }
  /* Coloured panels, not white boxes (owner, Oct 31 2026): the text on pale saffron with
     navy ink, the contents on navy. */
  .legal-body {
    max-width: 48rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: 1.5rem;
    border-start-end-radius: 5rem;
    background: color-mix(in srgb, var(--matin-soleil) 16%, var(--matin-white));
    border-block-start: 6px solid var(--matin-brique);
    color: var(--matin-encre);
  }
  .legal-body :global(p),
  .legal-body :global(li) {
    color: var(--matin-encre);
  }
  .legal-body :global(h2) {
    scroll-margin-top: 7rem;
  }
  .legal-toc {
    padding: 1.75rem 1.9rem;
    border-radius: 1.25rem;
    border-end-start-radius: 4rem;
    background: var(--matin-encre);
    color: var(--matin-white);
  }
  .legal-toc__title {
    margin-block-end: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--matin-soleil);
  }
  .legal-toc a {
    color: var(--matin-white);
  }
  .legal-toc li::marker {
    color: var(--matin-soleil);
    font-weight: 800;
  }
  .legal-toc :focus-visible {
    outline-color: var(--matin-soleil);
  }
  .legal-toc ol {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 1.25rem;
    list-style: decimal;
    font-size: 1.0625rem;
    line-height: 1.45;
  }
  .legal-toc a {
    text-decoration: none;
  }
  .legal-toc a:hover {
    text-decoration: underline;
  }
  @media (min-width: 64rem) {
    .legal-layout {
      grid-template-columns: minmax(0, 48rem) minmax(16rem, 24rem);
      justify-content: space-between;
      align-items: start;
      gap: 4rem;
    }
    .legal-body {
      grid-row: 1;
      grid-column: 1;
    }
    .legal-toc {
      grid-column: 2;
      position: sticky;
      top: 7rem;
    }
  }
</style>
