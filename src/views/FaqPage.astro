---
import PageLayout from '@/layouts/PageLayout.astro';
import Accordion from '@/components/ui/Accordion.astro';
import { alternatesFor, path, type Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getFaq, renderMarkdown } from '@/lib/content';
import { faqTopics } from '@/lib/taxonomy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const faq = await getFaq();
const groups = faqTopics
  .map((topic) => ({ topic, items: faq.filter((f) => f.data.topic === topic) }))
  .filter((g) => g.items.length);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: pick(f.data.question, lang),
    acceptedAnswer: { '@type': 'Answer', text: pick(f.data.answer, lang) },
  })),
};
---

<PageLayout
  lang={lang}
  title={t('faq.title')}
  lede={t('faq.lede')}
  alternates={alternatesFor('faq')}
  jsonLd={[jsonLd]}
>
  <nav slot="hero" aria-label={t('faq.topics')} class="mt-8" hidden={groups.length === 0}>
    <ul class="flex flex-wrap gap-2">
      {groups.map((g) => (
        <li>
          <a
            href={`#${g.topic}`}
            class="inline-block rounded-full border border-line bg-white px-4 py-2.5 font-bold text-ink no-underline hover:bg-tint hover:underline"
          >
            {t(`faq.${g.topic}`)}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="container-site max-w-4xl space-y-14 pt-4 pb-20">
    {groups.length === 0 && <p class="card p-8 text-center text-lg">{t('faq.empty')}</p>}
    {groups.map((g) => (
      <section id={g.topic} aria-labelledby={`${g.topic}-title`}>
        <h2 id={`${g.topic}-title`} class="mb-6 text-3xl font-bold">
          {t(`faq.${g.topic}`)}
        </h2>
        <Accordion
          items={g.items.map((f) => ({
            id: `q-${f.id}`,
            question: pick(f.data.question, lang)!,
            answerHtml: renderMarkdown(f.data.answer[lang], lang),
          }))}
        />
      </section>
    ))}

    <div class="card flex flex-col items-start gap-5 p-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-2xl font-bold text-primary">{t('faq.stillQuestions')}</p>
      <a href={path('contact', lang)} class="btn btn-primary">
        {t('faq.contactUs')}
      </a>
    </div>
  </div>
</PageLayout>
