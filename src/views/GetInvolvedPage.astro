---
/**
 * Get Involved: three pathways (individual participation, institutional and professional
 * collaboration, staying connected), the expression-of-interest form and, in French and
 * English, volunteer roles. The newsletter form is the one in the footer (#stay-connected).
 * Membership and donations are not offered (Matin hasn't opened them).
 */
import { ArrowRight, Landmark, Mail, UsersRound } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import InterestForm from '@/components/forms/InterestForm.astro';
import VolunteerForm from '@/components/forms/VolunteerForm.astro';
import { siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const inv = await getSingleton('involvement');
const full = lang !== 'fa';
const volunteerId = lang === 'fr' ? 'benevolat' : 'volunteer';
// "interest" stays the same in every language: other pages link to #interest.
const pathways = [
  {
    icon: UsersRound,
    title: t('involved.pathIndividualTitle'),
    text: t('involved.pathIndividualText'),
    cta: t('involved.pathIndividualCta'),
    href: '#interest',
    accent: 'coral',
  },
  {
    icon: Landmark,
    title: t('involved.pathInstitutionalTitle'),
    text: t('involved.pathInstitutionalText'),
    cta: t('involved.pathInstitutionalCta'),
    href: '#interest',
    accent: 'mustard',
  },
  {
    icon: Mail,
    title: t('involved.pathConnectedTitle'),
    text: t('involved.pathConnectedText'),
    cta: t('involved.pathConnectedCta'),
    href: '#stay-connected',
    accent: 'teal',
  },
];
---

<PageLayout
  lang={lang}
  title={t('involved.title')}
  lede={t('involved.lede')}
  alternates={siteAlternates('getInvolved')}
>
  <!-- Pathways -->
  <section class="container-site pt-4 pb-16" aria-labelledby="paths-title">
    <SectionHeader id="paths-title" title={t('involved.pathsTitle')} align="start" class="mb-10" />
    <ul class="grid gap-6 md:grid-cols-3">
      {pathways.map((p, i) => (
        <li
          class="card path-card"
          data-accent={p.accent}
          data-reveal
          style={`--reveal-delay:${i * 110}ms`}
        >
          <span class="path-card__icon" aria-hidden="true">
            <p.icon size={30} stroke-width={1.6} />
          </span>
          <h3 class="path-card__title">{p.title}</h3>
          <p class="text-[1.0625rem] leading-relaxed">{p.text}</p>
          <a href={p.href} class="path-card__btn mt-auto">
            {p.cta}
            <ArrowRight size={22} class="flip-rtl" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-3xl text-[0.95rem] text-muted">{t('involved.pathsNote')}</p>
  </section>

  <!-- Interest -->
  <section id="interest" class="scroll-mt-24 bg-tint py-20" aria-labelledby="interest-title">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <SectionHeader align="start" id="interest-title" title={t('interest.title')} />
        <p class="-mt-4 text-lg leading-relaxed text-ink">{t('interest.intro')}</p>
      </div>
      <div class="card self-start p-6 sm:p-10">
        <InterestForm lang={lang} />
      </div>
    </div>
  </section>

  {full && (
    <>
      <!-- Volunteer -->
      <section id={volunteerId} class="scroll-mt-24 py-20" aria-labelledby="volunteer-title">
        <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.15fr]">
          <div>
            <SectionHeader
              align="start"
              id="volunteer-title"
              title={t('involved.volunteer')}
              lede={inv.volunteerIntro && pick(inv.volunteerIntro, lang)}
            />
            <ul class="space-y-4">
              {inv.roles.map((r) => (
                <li class="card p-6">
                  <h3 class="mb-1 text-xl font-bold">{pick(r.title, lang)}</h3>
                  <p class="text-muted">{pick(r.text, lang)}</p>
                </li>
              ))}
            </ul>
          </div>
          <div class="card self-start p-6 sm:p-10">
            <h3 class="mb-6 text-2xl font-bold">{t('involved.volunteerForm')}</h3>
            <VolunteerForm lang={lang} roles={inv.roles.map((r) => pick(r.title, lang)!)} />
          </div>
        </div>
      </section>
    </>
  )}
</PageLayout>

<style>
  .path-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: clamp(1.75rem, 1.4rem + 1vw, 2.5rem);
    border-block-start: 6px solid var(--accent);
  }
  .path-card__icon {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 1rem;
    background: var(--accent);
    color: var(--color-primary);
  }
  [data-accent='teal'] .path-card__icon {
    color: var(--color-white);
  }
  .path-card__title {
    font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.6rem);
    font-weight: 800;
    line-height: 1.25;
  }
  /* Large button in the card's own colour and shape, like the icon tile above it
     (owner's request). Text is large and extra bold, so navy on coral (3.5:1) and
     white on teal (3.9:1) meet the contrast rule for large text. */
  .path-card__btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3.75rem;
    margin-block-start: 0.5rem;
    padding: 0.85rem 1.35rem;
    border-radius: 1rem;
    background: var(--accent);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  [data-accent='teal'] .path-card__btn {
    color: var(--color-white);
  }
  .path-card__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px -12px color-mix(in srgb, var(--accent) 80%, black);
  }
  .path-card__btn:active {
    transform: none;
  }
  .path-card__btn :global(svg) {
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .path-card__btn:hover :global(svg) {
    transform: translateX(3px);
  }
  :global([dir='rtl']) .path-card__btn:hover :global(svg) {
    transform: scaleX(-1) translateX(3px);
  }
</style>
