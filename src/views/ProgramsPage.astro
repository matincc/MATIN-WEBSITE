---
import PageLayout from '@/layouts/PageLayout.astro';
import FilterBar from '@/components/ui/FilterBar.astro';
import ProgramCard from '@/components/content/ProgramCard.astro';
import AreasGrid from '@/components/content/AreasGrid.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getPrograms } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const programs = await getPrograms();
const present = [...new Set(programs.map((p) => p.data.category))];
---

<PageLayout
  lang={lang}
  title={t('programs.title')}
  lede={t('programs.lede')}
  alternates={siteAlternates('programs')}
  searchable={false}
>
  <!-- The three areas of work frame the programs (same cards as on the homepage). -->
  <section class="container-site pt-4 pb-20" aria-labelledby="areas-title">
    <SectionHeader
      id="areas-title"
      eyebrow={t('home.areasEyebrow')}
      eyebrowTone="teal"
      title={t('home.areasTitle')}
      lede={t('home.areasLede')}
      align="start"
      class="mb-12"
    />
    <AreasGrid lang={lang} linked={false} />
  </section>

  <section class="container-site pt-6 pb-24">
    {present.length > 1 && (
      <FilterBar
        target="program-list"
        label={t('programs.filterLabel')}
        allLabel={t('programs.all')}
        options={present.map((c) => ({ value: c, label: t(`categories.${c}`) }))}
      />
    )}
    {programs.length === 0 && <p class="empty-state">{t('programs.empty')}</p>}
    <ul id="program-list" class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {programs.map((program) => (
        <li data-category={program.data.category}>
          <ProgramCard program={program} lang={lang} headingLevel="h2" />
        </li>
      ))}
    </ul>
    <p class="empty-state" data-filter-empty="program-list" hidden>
      {t('programs.noResults')}
    </p>
  </section>
</PageLayout>
