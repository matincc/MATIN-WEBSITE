---
/**
 * News & Insights list: all articles (paged), a heading page or a category page. Three
 * headings (owner's choice, Oct 25 2026): Matin News, Articles & Insights (Perspectives,
 * Culture & Cities, Research & Publications, Partnerships & Initiatives) and Matin
 * Recommends (cultural news, in three region tabs: Montréal, Canada, Around the World).
 * The first page opens with those tabs (up to three stories each), then Matin's own
 * news and articles (owner's brief, Oct 25 2026).
 */
import type { CollectionEntry } from 'astro:content';
import { Rss } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/content/PostCard.astro';
import Pagination from '@/components/ui/Pagination.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import NewsRegionTabs from '@/components/content/NewsRegionTabs.astro';
import { categorySegment, categorySlugs, path, type Lang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { newsSections, type NewsListKey, type NewsSection } from '@/lib/taxonomy';
import { getNews, newsCategories as newsCategoriesOf } from '@/lib/content';

interface Props {
  lang: Lang;
  posts: CollectionEntry<'news'>[];
  current?: number;
  last?: number;
  category?: NewsListKey;
}
const { lang, posts, current = 1, last = 1, category } = Astro.props;
const t = useTranslations(lang);
const sections = Object.keys(newsSections) as NewsSection[];
// The heading the page belongs to (a category page belongs to its heading).
const section = category
  ? sections.find(
      (s) => (newsSections[s] as readonly string[]).includes(category) || s === category,
    )
  : undefined;
// Under Articles & Insights: its categories that have published articles.
const used = newsCategoriesOf(await getNews());
const subCategories =
  section === 'insights' ? newsSections.insights.filter((c) => used.includes(c)) : [];

const pageHref = (l: Lang, n: number) => (n === 1 ? path('news', l) : path('news', l, 'page', n));
const catHref = (l: Lang, c: NewsListKey) =>
  path('news', l, categorySegment[l], categorySlugs[c][l]);
const alternates = category
  ? { fr: catHref('fr', category), en: catHref('en', category) }
  : { fr: pageHref('fr', current), en: pageHref('en', current) };

const title = category
  ? t('news.categoryTitle', { category: t(`newsCategories.${category}`) })
  : t('news.title');
// First page: cultural news in region tabs, then Matin's own news and articles.
const landing = current === 1 && !category;
const allPosts = await getNews();
const cultural = landing ? allPosts.filter((p) => p.data.category === 'recommends') : [];
const listed = landing ? posts.filter((p) => p.data.category !== 'recommends') : posts;
const lead = landing ? listed[0] : undefined;
const rest = lead ? listed.slice(1) : listed;
const metaTitle =
  !category && current > 1 ? `${title} — ${t('pagination.page', { n: current })}` : title;
const emptyText =
  category === 'recommends'
    ? t('news.recommendsEmpty')
    : category
      ? t('news.sectionEmpty')
      : t('news.empty');
---

<PageLayout
  lang={lang}
  title={title}
  metaTitle={metaTitle}
  lede={t('news.lede')}
  alternates={alternates}
  searchable={false}
  crumbs={category ? [{ label: t('news.title'), href: path('news', lang) }] : []}
>
  <section class="container-site pt-4 pb-24">
    <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <nav aria-label={t('news.sections')} class="flex flex-col gap-3">
        <ul class="flex flex-wrap gap-2">
          <li>
            <a
              href={path('news', lang)}
              class="chip-link"
              aria-current={!category ? 'page' : undefined}
            >
              {t('news.allCategories')}
            </a>
          </li>
          {sections.map((s) => (
            <li>
              <a
                href={catHref(lang, s)}
                class="chip-link"
                aria-current={category === s ? 'page' : section === s ? 'true' : undefined}
              >
                {t(`newsCategories.${s}`)}
              </a>
            </li>
          ))}
        </ul>
        {subCategories.length > 1 && (
          <ul class="flex flex-wrap gap-2" aria-label={t('news.categories')}>
            {subCategories.map((c) => (
              <li>
                <a
                  href={catHref(lang, c)}
                  class="chip-link chip-link--sub"
                  aria-current={category === c ? 'page' : undefined}
                >
                  {t(`newsCategories.${c}`)}
                </a>
              </li>
            ))}
          </ul>
        )}
      </nav>
      <a href={`/${lang}/rss.xml`} class="link-arrow shrink-0 text-sm">
        <Rss size={18} class="text-gold-dark" aria-hidden="true" />
        {t('news.rss')}
      </a>
    </div>

    {category === 'recommends' ? (
      <NewsRegionTabs lang={lang} posts={posts} id="cultural-news" />
    ) : (
      <>
        {landing && (
          <section class="cultural-band" aria-labelledby="cultural-title">
            <SectionHeader
              align="start"
              id="cultural-title"
              title={t('news.culturalTitle')}
              subtitle={t('news.culturalLede')}
              link={
                cultural.length > 0
                  ? { href: catHref(lang, 'recommends'), label: t('news.allCultural') }
                  : undefined
              }
              class="mb-8"
            />
            <NewsRegionTabs lang={lang} posts={cultural} perTab={3} id="cultural-news" />
          </section>
        )}
        {landing && (
          <SectionHeader
            align="start"
            id="matin-news-title"
            title={t('news.matinTitle')}
            class="mt-20 mb-10"
          />
        )}
        {listed.length > 0 ? (
          <>
            {/* On the first page, the latest article leads as a wide featured story. */}
            {lead && <PostCard post={lead} lang={lang} headingLevel="h3" featured />}
            {rest.length > 0 && (
              <ul
                class:list={[
                  'grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3',
                  lead && 'mt-14',
                ]}
              >
                {rest.map((post) => (
                  <li>
                    <PostCard post={post} lang={lang} headingLevel={landing ? 'h3' : 'h2'} />
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <p class="empty-state">{emptyText}</p>
        )}
      </>
    )}

    <Pagination lang={lang} current={current} last={last} href={(n) => pageHref(lang, n)} />
  </section>
</PageLayout>

<style>
  .chip-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 1.15rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary);
    text-decoration: none;
    background: var(--color-white);
    border: 1.5px solid var(--color-line);
  }
  .chip-link:hover {
    border-color: var(--color-primary);
  }
  /* Cultural news: a pale teal band inside the page (owner's brief, Oct 25 2026). */
  .cultural-band {
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    border-radius: calc(var(--radius-card) * 1.4);
    border: 1px solid var(--color-teal-edge);
    background: var(--color-teal-pale);
  }
  .chip-link--sub {
    min-height: 2.4rem;
    font-size: 0.85rem;
  }
  .chip-link[aria-current='true'] {
    border-color: var(--color-primary);
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }
  .chip-link[aria-current='page'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }
</style>
