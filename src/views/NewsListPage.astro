---
/**
 * News (owner's brief, Oct 25 2026): one page, two sections that are never mixed.
 * 1. Cultural News (#cultural-news): external stories the President approved, in three
 *    region tabs (Montréal, Canada, Around the World), laid out like a news page (no
 *    panel, no cards, Oct 27 2026); each story names its source and links to it.
 * 2. Matin News (#matin-news): the institute's official news on a warm cream band, the
 *    newest as a wide lead card.
 * Only published entries reach this page: proposed or rejected stories never enter the
 * repository (src/content/news/README.md). French, English and Persian (Persian shows
 * the entries whose Persian text was reviewed, with a note when others exist).
 */
import { Rss } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/content/PostCard.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import NewsRegionTabs from '@/components/content/NewsRegionTabs.astro';
import { path, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { forLang, getNews, hasPersian } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const all = await getNews();
const posts = forLang(all, lang);
const cultural = posts.filter((p) => p.data.category === 'recommends');
const matin = posts.filter((p) => p.data.category === 'matin-news');
const [lead, ...rest] = matin;
// Persian: some entries may not have a Persian text yet (shown in English).
const untranslated = lang === 'fa' && posts.some((p) => !hasPersian(p));
const alternates = siteAlternates('news');
---

<PageLayout
  lang={lang}
  title={t('news.title')}
  lede={t('news.lede')}
  alternates={alternates}
  searchable={false}
>
  {untranslated && (
    <p class="container-site news-note">
      {t('news.otherLanguages')}{' '}
      <a href={path('news', 'en')} hreflang="en">
        {t('news.otherLanguagesLink')}
      </a>
    </p>
  )}

  <section
    id="cultural-news"
    class="news-cultural on-dark scroll-mt-28"
    aria-labelledby="cultural-title"
  >
    <div class="container-site">
      <div class="news-wire">
        <SectionHeader
          align="start"
          id="cultural-title"
          title={t('news.culturalTitle')}
          subtitle={t('news.culturalLede')}
          class="mb-8"
        />
        <NewsRegionTabs lang={lang} posts={cultural} id="cultural-news-tabs" />
      </div>
    </div>
  </section>

  <section id="matin-news" class="news-matin scroll-mt-28" aria-labelledby="matin-news-title">
    <div class="container-site">
      <SectionHeader
        align="start"
        id="matin-news-title"
        title={t('news.matinTitle')}
        subtitle={t('news.matinLede')}
        class="mb-10"
      />
      {lead ? (
        <>
          <PostCard post={lead} lang={lang} featured />
          {rest.length > 0 && (
            <ul class="stagger-grid mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
              {rest.map((post) => (
                <li>
                  <PostCard post={post} lang={lang} />
                </li>
              ))}
            </ul>
          )}
        </>
      ) : (
        <p class="empty-state">{t('news.matinEmpty')}</p>
      )}
      <p class="mt-12">
        <a href={`/${lang}/rss.xml`} class="link-arrow text-base">
          <Rss size={18} aria-hidden="true" />
          {t('news.rss')}
        </a>
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .news-note {
    padding-block-start: 1.5rem;
    font-size: 1.0625rem;
  }
  .news-cultural {
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  /* Matin News (scheme A, Oct 29 2026): on the sable ground, so the page keeps one dark
     moment only (Cultural News); the white cards still stand out. */
  .news-matin {
    padding-block: clamp(3rem, 2rem + 3vw, 5.5rem);
    background: var(--color-sable);
  }
</style>
