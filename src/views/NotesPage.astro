---
/**
 * Notes from the President (owner's request, Oct 27 2026): the short posts Reza Moafi
 * first publishes on LinkedIn, newest first, as LinkedIn-style cards on the deep teal band,
 * with a portrait card beside the feed on wide screens. One YAML file per note in
 * src/content/notes/ (see its README). Layout examples (`sample: true`) never reach the
 * live site.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowRight, ExternalLink } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import NoteCard from '@/components/content/NoteCard.astro';
import HomeLetter from '@/components/content/HomeLetter.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import { getNotes, getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const notes = await getNotes();
const hasSamples = notes.some((n) => n.data.sample);
const { president: p } = await getSingleton('about');
const photos = import.meta.glob<ImageMetadata>('/src/assets/brand/president.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const portrait = Object.values(photos)[0];
const name = lang === 'fa' ? 'رضا معافی' : p.name;
---

<PageLayout
  lang={lang}
  title={t('notes.title')}
  lede={t('notes.lede')}
  alternates={siteAlternates('notes')}
  crumbs={[{ label: t('nav.news'), href: href('news', lang) }]}
>
  {/* The President's complete personal note (owner's brief, Oct 29 2026: the homepage
      shows an excerpt and links here). */}
  <HomeLetter lang={lang} id="personal-note" />

  <section class="notes-band" aria-label={t('notes.title')}>
    <div class="container-site notes-grid">
      <aside class="notes-author" aria-label={t('notes.author')}>
        <div class="notes-author__card">
          {portrait && (
            <Image src={portrait} alt="" width={320} height={320} class="notes-author__photo" />
          )}
          <p class="notes-author__name">{name}</p>
          <p class="notes-author__role">{pick(p.title, lang)}</p>
          <p class="notes-author__org">{t('president.org')}</p>
          <div class="mosaic notes-author__mosaic" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          {p.linkedin && (
            <a
              href={p.linkedin}
              class="btn btn-primary w-full"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('notes.follow')}
              <ExternalLink size={18} aria-hidden="true" />
              <span class="sr-only">{t('a11y.externalLink')}</span>
            </a>
          )}
          <a href="#personal-note" class="link-arrow notes-author__more">
            {t('president.readMessage')}
            <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
          </a>
        </div>
      </aside>

      <div class="notes-feed">
        {hasSamples && (
          <p class="notes-preview" role="note">
            {t('notes.sampleNote')}
          </p>
        )}
        {notes.length > 0 ? (
          <ol class="notes-list">
            {notes.map((note) => (
              <li>
                <NoteCard note={note} lang={lang} fold={false} />
              </li>
            ))}
          </ol>
        ) : (
          <p class="notes-empty">{t('notes.empty')}</p>
        )}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Scheme A (Oct 29 2026): sable ground instead of the deep teal band. */
  .notes-band {
    background: var(--color-sable);
    padding-block: clamp(3rem, 2rem + 3vw, 5.5rem);
  }
  .notes-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 64rem) {
    .notes-grid {
      grid-template-columns: 19rem minmax(0, 46rem);
      justify-content: center;
      gap: 3rem;
    }
    .notes-author {
      position: sticky;
      top: 7rem;
    }
  }
  .notes-author__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 2rem 1.5rem;
    border-radius: var(--radius-card);
    border-top: 6px solid var(--color-gold);
    background: var(--color-ivory);
    color: var(--color-ink);
    text-align: center;
  }
  .notes-author__photo {
    width: 8.5rem;
    height: 8.5rem;
    margin-bottom: 0.75rem;
    border-radius: 999px;
    object-fit: cover;
    box-shadow:
      0 0 0 4px var(--color-ivory),
      0 0 0 7px var(--color-gold);
  }
  .notes-author__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
  }
  .notes-author__role {
    font-weight: 600;
    color: var(--color-teal-deep);
  }
  .notes-author__org {
    font-size: 0.95rem;
  }
  .notes-author__mosaic {
    width: 7rem;
    margin: 0.9rem 0 1.1rem;
  }
  @media (max-width: 63.99rem) {
    .notes-author__card {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1.25rem;
      align-items: center;
      padding: 1.5rem;
      text-align: start;
    }
    .notes-author__photo {
      grid-row: span 3;
      width: 5.5rem;
      height: 5.5rem;
      margin: 0;
    }
    .notes-author__mosaic,
    .notes-author__card > .btn,
    .notes-author__more {
      grid-column: 1 / -1;
    }
    .notes-author__mosaic {
      margin: 0.9rem 0;
    }
  }
  .notes-author__more {
    margin-top: 0.9rem;
    font-size: 0.95rem;
  }
  .notes-feed {
    min-width: 0;
  }
  .notes-list {
    display: grid;
    gap: 1.75rem;
  }
  .notes-preview {
    margin-bottom: 1.75rem;
    padding: 1rem 1.25rem;
    border-radius: 0.9rem;
    border: 2px dashed var(--color-gold);
    background: var(--color-champagne);
    color: var(--color-ink);
    font-weight: 600;
  }
  .notes-empty {
    padding: 2.5rem 2rem;
    border-radius: var(--radius-card);
    border-top: 6px solid var(--color-gold);
    background: var(--color-ivory);
    color: var(--color-ink);
    font-size: 1.15rem;
    text-align: center;
  }
</style>
