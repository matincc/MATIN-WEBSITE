---
/**
 * Notes from Our President as a living editorial journal (owner's brief, Oct 29 2026),
 * replacing the LinkedIn-style feed of Oct 27: an intro with his casual photo (his own
 * file, never cropped hard or retouched), the welcome note pinned as « Un mot pour
 * commencer », the latest note featured, then « D'autres réflexions et histoires » as wide
 * rows (six at a time). Every note opens on its own page (NoteArticlePage). Newest first,
 * the latest featured automatically: adding a note is one YAML file in src/content/notes/.
 * Layout examples (`sample: true`) never reach the live site.
 */
import { Picture } from 'astro:assets';
import { ArrowRight, Clock, ExternalLink, Pin } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JournalCrumbs from '@/components/notes/JournalCrumbs.astro';
import LeafRule from '@/components/brand/LeafRule.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import { getNotes, getSingleton } from '@/lib/content';
import { formatDate } from '@/lib/dates';
import { typo } from '@/lib/frenchTypo';
import { breadcrumbJsonLd } from '@/lib/seo';
import { noteHref, noteView, readingTime, splitParagraphs, welcomeHref } from '@/lib/notes';
import portrait from '@/assets/photos/president-casual.jpg';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const tt = (s: string) => (lang === 'fr' ? typo(s, 'fr') : s);
const site = Astro.site ?? new URL(Astro.url.origin);

const notes = await getNotes();
const hasSamples = notes.some((n) => n.data.sample);
const [latest, ...older] = notes;
const SHOWN = 6;

const { president: p } = await getSingleton('about');
const name = pick(p.displayName, lang) || p.name;
const role = pick(p.title, lang);
const message = (lang === 'fa' ? p.message?.fa : p.message?.[lang]) ?? '';
const welcome = message ? splitParagraphs(lang === 'fr' ? typo(message, 'fr') : message) : [];

const title = t('notes.journalTitle');
const trail = [
  { label: t('common.home'), href: href('home', lang) },
  { label: t('nav.news'), href: href('news', lang) },
  { label: title, href: href('notes', lang) },
];
const dir = (l: string) => (l === 'fa' ? 'rtl' : 'ltr');
---

<BaseLayout
  lang={lang}
  title={title}
  description={t('notes.journalSubtitle')}
  alternates={siteAlternates('notes')}
  jsonLd={[
    breadcrumbJsonLd(
      trail.map((c) => ({ name: c.label, url: c.href })),
      site,
    ),
  ]}
>
  <section class="jr-hero" aria-labelledby="page-title">
    <div class="container-site">
      <JournalCrumbs lang={lang} trail={trail} />
      <div class="jr-hero__grid">
        <div class="jr-hero__text">
          <h1 id="page-title" class="jr-hero__title">{title}</h1>
          <LeafRule class="jr-hero__rule" />
          <p class="jr-hero__subtitle">{tt(t('notes.journalSubtitle'))}</p>
          <p class="jr-hero__intro">{tt(t('notes.lede'))}</p>
        </div>

        <figure class="jr-portrait">
          <div class="jr-portrait__frame">
            <span class="jr-portrait__sun" aria-hidden="true"></span>
            <Picture
              src={portrait}
              alt={t('about.presidentPhotoAlt', { name })}
              formats={['avif', 'webp']}
              widths={[320, 480, 640, 800]}
              sizes="(min-width: 64rem) 24rem, 80vw"
              class="jr-portrait__img"
              loading="eager"
            />
          </div>
          <figcaption class="jr-portrait__caption">
            <span class="jr-portrait__name">{name}</span>
            <span class="jr-portrait__role">{role}</span>
            <span class="jr-portrait__org">{t('president.org')}</span>
            {p.linkedin && (
              <a href={p.linkedin} class="jr-portrait__in" target="_blank" rel="noopener noreferrer">
                {t('notes.linkedin')}
                <ExternalLink size={15} aria-hidden="true" />
                <span class="sr-only">{t('a11y.externalLink')}</span>
              </a>
            )}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {welcome.length > 0 && (
    <section id="personal-note" class="jr-pinned scroll-mt-24" aria-labelledby="jr-pinned-title">
      <div class="container-site">
        <article class="jr-pinned__card jr-link-card" data-reveal>
          <p class="jr-label jr-label--pin">
            <Pin size={16} aria-hidden="true" />
            {t('notes.pinned')}
          </p>
          <h2 id="jr-pinned-title" class="jr-pinned__title">
            <a href={welcomeHref(lang)} class="jr-stretch">
              {t('about.founderTitle')}
            </a>
          </h2>
          <p class="jr-pinned__excerpt">{welcome[0]}</p>
          <p class="jr-meta">
            <span class="jr-meta__item">
              <Clock size={16} aria-hidden="true" />
              {t('news.readingTime', { n: readingTime(message, lang) })}
            </span>
            <span class="jr-go" aria-hidden="true">
              {t('notes.readWelcome')}
              <ArrowRight size={18} class="flip-rtl" />
            </span>
          </p>
        </article>
      </div>
    </section>
  )}

  <section class="jr-journal" aria-label={title}>
    <div class="container-site">
      {hasSamples && (
        <p class="jr-preview" role="note">
          {t('notes.sampleNote')}
        </p>
      )}

      {latest ? (
        (() => {
          const v = noteView(latest, lang);
          const foreign = v.foreign ? { lang: v.shownLang, dir: dir(v.shownLang) } : {};
          return (
            <article class="jr-feature jr-link-card" aria-labelledby="jr-feature-title" data-reveal>
              <div class="jr-feature__aside">
                <span class="jr-feature__sun" aria-hidden="true"></span>
                <p class="jr-label">{t('notes.latest')}</p>
                <p class="jr-feature__date">
                  <time datetime={v.datetime}>{formatDate(latest.data.date, lang)}</time>
                </p>
                <p class="jr-meta__item">
                  <Clock size={16} aria-hidden="true" />
                  {t('news.readingTime', { n: v.minutes })}
                </p>
              </div>
              <div class="jr-feature__body">
                {v.foreign && (
                  <p class="jr-lang">
                    {t('notes.originalLanguage', {
                      language: t(`notes.languageNames.${v.shownLang}`),
                    })}
                  </p>
                )}
                <h2 id="jr-feature-title" class="jr-feature__title" {...foreign}>
                  <a href={noteHref(latest, lang)} class="jr-stretch">
                    {v.headline ?? t('notes.noteOf', { date: formatDate(latest.data.date, lang) })}
                  </a>
                </h2>
                <p class="jr-feature__excerpt" {...foreign}>
                  {v.excerpt}
                </p>
                {v.isTranslation && (
                  <p class="jr-translation">
                    {t('notes.translatedFrom', {
                      language: t(`notes.languageNames.${latest.data.original}`),
                    })}
                  </p>
                )}
                <span class="jr-go" aria-hidden="true">
                  {t('notes.readFull')}
                  <ArrowRight size={18} class="flip-rtl" />
                </span>
              </div>
            </article>
          );
        })()
      ) : (
        <p class="jr-empty">{t('notes.empty')}</p>
      )}

      {older.length > 0 && (
        <section class="jr-archive" aria-labelledby="jr-archive-title">
          <h2 id="jr-archive-title" class="jr-archive__title" data-reveal>
            {t('notes.archiveTitle')}
          </h2>
          <ol class="jr-archive__list" data-archive data-shown={SHOWN}>
            {older.map((note) => {
              const v = noteView(note, lang);
              const foreign = v.foreign ? { lang: v.shownLang, dir: dir(v.shownLang) } : {};
              return (
                <li>
                  <article class="jr-row jr-link-card" aria-labelledby={`jr-${note.id}`}>
                    <p class="jr-row__date">
                      <time datetime={v.datetime}>{formatDate(note.data.date, lang)}</time>
                    </p>
                    <div class="jr-row__body">
                      <h3 id={`jr-${note.id}`} class="jr-row__title" {...foreign}>
                        <a href={noteHref(note, lang)} class="jr-stretch">
                          {v.headline ??
                            t('notes.noteOf', { date: formatDate(note.data.date, lang) })}
                        </a>
                      </h3>
                      <p class="jr-row__excerpt" {...foreign}>
                        {v.excerpt}
                      </p>
                    </div>
                    <p class="jr-row__end">
                      <span class="jr-meta__item">
                        <Clock size={16} aria-hidden="true" />
                        {t('news.readingTime', { n: v.minutes })}
                      </span>
                      <span class="jr-go" aria-hidden="true">
                        {t('notes.continue')}
                        <ArrowRight size={18} class="flip-rtl" />
                      </span>
                    </p>
                  </article>
                </li>
              );
            })}
          </ol>
          {older.length > SHOWN && (
            <p class="jr-archive__more">
              <button type="button" class="btn btn-outline" data-archive-more hidden>
                {t('notes.showMore')}
              </button>
            </p>
          )}
        </section>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // « Afficher plus de notes »: the archive shows six rows at a time (all without JavaScript).
  const list = document.querySelector<HTMLElement>('[data-archive]');
  const more = document.querySelector<HTMLButtonElement>('[data-archive-more]');
  if (list && more) {
    const step = Number(list.dataset.shown) || 6;
    const rows = [...list.children] as HTMLElement[];
    rows.slice(step).forEach((row) => (row.hidden = true));
    more.hidden = false;
    more.addEventListener('click', () => {
      const hidden = rows.filter((row) => row.hidden);
      hidden.slice(0, step).forEach((row) => (row.hidden = false));
      hidden[0]?.querySelector('a')?.focus();
      if (hidden.length <= step) more.hidden = true;
    });
  }
</script>

<style>
  /* ---------- Intro: the journal's cover ---------- */
  .jr-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-aube);
    padding-block: 2.25rem clamp(3.5rem, 2rem + 4vw, 6rem);
  }
  .jr-hero__grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
    margin-top: 2.25rem;
  }
  @media (min-width: 60rem) {
    .jr-hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
      gap: clamp(3rem, 1rem + 5vw, 6.5rem);
    }
  }
  .jr-hero__title {
    font-family: var(--font-editorial);
    font-size: clamp(2.6rem, 1.5rem + 4vw, 5.25rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 144;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    text-wrap: balance;
  }
  :global(html[lang='fa']) .jr-hero__title {
    font-weight: 800;
    font-variation-settings: normal;
    line-height: 1.3;
    letter-spacing: 0;
  }
  .jr-hero__text :global(.jr-hero__rule) {
    width: 11rem;
    margin-block: 1.5rem 1.75rem;
  }
  .jr-hero__subtitle {
    max-width: 46rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.85rem);
    font-style: italic;
    font-weight: 500;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.4;
    color: var(--color-brique-ink);
  }
  :global(html[lang='fa']) .jr-hero__subtitle {
    font-style: normal;
    font-weight: 600;
    line-height: 1.8;
  }
  .jr-hero__intro {
    max-width: 36rem;
    margin-top: 1.25rem;
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-ink);
  }

  /* The President's own photo, whole (no hard crop), on a warm paper layer set off to one
     side, with the logo's sun rising behind it. */
  .jr-portrait {
    justify-self: center;
    width: min(100%, 17rem);
  }
  @media (min-width: 60rem) {
    .jr-portrait {
      width: min(100%, 24rem);
    }
  }
  .jr-portrait__frame {
    position: relative;
    isolation: isolate;
  }
  .jr-portrait__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    translate: 1.1rem 1.1rem;
    border-radius: 1.5rem 1.5rem 6rem 1.5rem;
    background: var(--color-brique-pale);
    border: 1px solid color-mix(in srgb, var(--color-brique) 25%, transparent);
  }
  :global([dir='rtl']) .jr-portrait__frame::before {
    translate: -1.1rem 1.1rem;
    border-radius: 1.5rem 1.5rem 1.5rem 6rem;
  }
  .jr-portrait__sun {
    position: absolute;
    z-index: -2;
    inset-block-start: -2.25rem;
    inset-inline-end: -2.25rem;
    width: 7rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--color-soleil);
    opacity: 0.85;
  }
  .jr-portrait__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.5rem 1.5rem 6rem 1.5rem;
    border: 6px solid var(--color-ivory);
    box-shadow: 0 1.5rem 3rem -1.75rem color-mix(in srgb, var(--color-ink) 60%, transparent);
  }
  :global([dir='rtl']) .jr-portrait__frame :global(img) {
    border-radius: 1.5rem 1.5rem 1.5rem 6rem;
  }
  .jr-portrait__caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 2rem;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-soleil);
  }
  .jr-portrait__name {
    font-family: var(--font-editorial);
    font-size: 1.5rem;
    font-weight: 700;
    font-variation-settings: 'SOFT' 100;
    color: var(--color-primary);
  }
  .jr-portrait__role {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-brique-ink);
  }
  .jr-portrait__org {
    font-size: 0.95rem;
    color: var(--color-ink);
  }
  .jr-portrait__in {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-firouzeh-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-firouzeh) 45%, transparent);
    text-underline-offset: 4px;
  }
  .jr-portrait__in:hover {
    text-decoration-color: var(--color-gold);
  }

  /* ---------- Shared pieces ---------- */
  .jr-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brique-ink);
  }
  :global(html[lang='fa']) .jr-label {
    letter-spacing: 0;
    font-size: 1rem;
  }
  .jr-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }
  .jr-meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  /* The whole card is one link (its title); the arrow line is its visible cue. */
  .jr-link-card {
    position: relative;
    transition:
      translate 0.35s ease,
      box-shadow 0.35s ease;
  }
  .jr-stretch {
    color: inherit;
    text-decoration: none;
  }
  .jr-stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .jr-stretch:focus-visible {
    outline: none;
  }
  .jr-link-card:has(.jr-stretch:focus-visible) {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }
  .jr-go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-primary);
    position: relative;
  }
  /* A gold underline draws in under the arrow line when the card is hovered or focused. */
  .jr-go::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -3px;
    height: 2px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }
  :global([dir='rtl']) .jr-go::after {
    transform-origin: right;
  }
  .jr-link-card:is(:hover, :focus-within) .jr-go::after {
    transform: scaleX(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .jr-link-card:hover {
      translate: 0 -0.35rem;
      box-shadow: 0 1.5rem 2.75rem -1.5rem color-mix(in srgb, var(--color-primary) 35%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .jr-link-card:hover {
      translate: none;
    }
  }
  .jr-lang,
  .jr-translation {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--color-ink);
  }
  .jr-lang {
    margin-bottom: 0.6rem;
  }
  .jr-translation {
    margin-top: 0.75rem;
  }

  /* ---------- « Un mot pour commencer »: pinned over the cover's edge ---------- */
  .jr-pinned {
    position: relative;
    margin-top: clamp(-3rem, -1.5rem - 1.5vw, -1.5rem);
  }
  .jr-pinned__card {
    max-width: 62rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: 1.5rem 1.5rem 1.5rem 4.5rem;
    border: 1px solid var(--color-card-edge);
    border-top: 5px solid var(--color-soleil);
    background: var(--color-ivory);
    box-shadow: var(--shadow-card);
  }
  :global([dir='rtl']) .jr-pinned__card {
    border-radius: 1.5rem 1.5rem 4.5rem 1.5rem;
  }
  .jr-pinned__title {
    margin-top: 0.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 1.25rem + 1.2vw, 2.3rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 72;
    line-height: 1.2;
    color: var(--color-primary);
    text-wrap: balance;
  }
  .jr-pinned__excerpt {
    max-width: 68ch;
    margin-top: 0.9rem;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------- The journal: latest note, then the archive ---------- */
  .jr-journal {
    padding-block: clamp(3rem, 2rem + 3vw, 5.5rem);
  }
  .jr-feature {
    display: grid;
    overflow: hidden;
    border-radius: 1.5rem 4.5rem 1.5rem 1.5rem;
    border: 1px solid var(--color-card-edge);
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }
  :global([dir='rtl']) .jr-feature {
    border-radius: 4.5rem 1.5rem 1.5rem 1.5rem;
  }
  @media (min-width: 52rem) {
    .jr-feature {
      grid-template-columns: minmax(14rem, 0.42fr) minmax(0, 1fr);
    }
  }
  .jr-feature__aside {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 2rem clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--color-sable);
  }
  .jr-feature__aside > :not(.jr-feature__sun) {
    position: relative;
  }
  .jr-feature__sun {
    position: absolute;
    inset-block-end: -4.5rem;
    inset-inline-end: -3.5rem;
    width: 11rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--color-soleil);
    opacity: 0.55;
  }
  .jr-feature__date {
    font-family: var(--font-editorial);
    font-size: 1.6rem;
    font-weight: 600;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.25;
    color: var(--color-primary);
  }
  .jr-feature__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }
  .jr-feature__title {
    font-family: var(--font-editorial);
    font-size: clamp(1.85rem, 1.3rem + 2vw, 3rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 144;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-brique-ink);
    text-wrap: balance;
  }
  .jr-feature__excerpt {
    max-width: 68ch;
    margin-top: 1.1rem;
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .jr-feature__body .jr-go {
    margin-top: 1.5rem;
  }
  :global(html[lang='fa']) :is(.jr-feature__title, .jr-pinned__title, .jr-row__title) {
    font-weight: 800;
    font-variation-settings: normal;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .jr-archive {
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
  }
  .jr-archive__title {
    font-family: var(--font-editorial);
    font-size: clamp(1.75rem, 1.35rem + 1.5vw, 2.6rem);
    font-weight: 700;
    font-variation-settings: 'SOFT' 100;
    color: var(--color-primary);
  }
  .jr-archive__list {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .jr-row {
    display: grid;
    gap: 0.75rem 2rem;
    padding: 1.5rem clamp(1.25rem, 1rem + 1.5vw, 2rem);
