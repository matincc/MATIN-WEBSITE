---
import { Picture, getImage } from 'astro:assets';
import { Expand } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import VideoFacade from '@/components/ui/VideoFacade.astro';
import { alternatesFor, type Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getAlbums } from '@/lib/content';
import { formatDate } from '@/lib/dates';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const albums = await getAlbums();

// Large version for the lightbox (max 1800 px wide, WebP).
const albumsWithLarge = await Promise.all(
  albums.map(async (album) => ({
    album,
    photos: await Promise.all(
      album.data.photos.map(async (p) => ({
        ...p,
        large: (
          await getImage({ src: p.image, width: Math.min(1800, p.image.width), format: 'webp' })
        ).src,
      })),
    ),
  })),
);
const videos = albums.flatMap((a) => a.data.videos);
---

<PageLayout
  lang={lang}
  title={t('gallery.title')}
  lede={t('gallery.lede')}
  alternates={alternatesFor('gallery')}
>
  <section class="container-site pt-4 pb-20" aria-labelledby="albums-title">
    <h2 id="albums-title" class="sr-only">
      {t('gallery.albums')}
    </h2>
    {albums.length === 0 && <p class="empty-state">{t('gallery.empty')}</p>}
    <div class="space-y-20">
      {albumsWithLarge.map(({ album, photos }) => (
        <section aria-labelledby={`album-${album.id}`}>
          <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow mb-2">
                {formatDate(album.data.date, lang)} · {t('gallery.photos', { n: photos.length })}
              </p>
              <h3 id={`album-${album.id}`} class="text-3xl font-bold">
                {pick(album.data.title, lang)}
              </h3>
              {album.data.description && (
                <p class="mt-3 max-w-2xl">{pick(album.data.description, lang)}</p>
              )}
            </div>
          </div>
          <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
            {photos.map((photo, i) => {
              const alt = pick(photo.alt, lang) ?? '';
              return (
                <li class:list={[i === 0 && 'col-span-2 row-span-2']}>
                  <a
                    href={photo.large}
                    class="thumb group"
                    data-lightbox={album.id}
                    data-alt={alt}
                    data-caption={pick(photo.caption, lang) ?? ''}
                    aria-label={t('gallery.openPhoto', { alt })}
                  >
                    <Picture
                      src={photo.image}
                      alt=""
                      formats={['avif', 'webp']}
                      widths={i === 0 ? [480, 800, 1100] : [300, 480, 640]}
                      sizes={
                        i === 0
                          ? '(min-width: 1024px) 50vw, 100vw'
                          : '(min-width: 1024px) 25vw, 50vw'
                      }
                      class="size-full object-cover transition duration-500 group-hover:scale-105"
                    />
                    <span class="thumb__icon" aria-hidden="true">
                      <Expand size={18} />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>

  {videos.length > 0 && (
    <section class="bg-tint py-20" aria-labelledby="videos-title">
      <div class="container-site">
        <h2 id="videos-title" class="section-title mb-12">
          {t('gallery.videos')}
        </h2>
        <ul class="grid gap-10 md:grid-cols-2">
          {videos.map((v) => (
            <li>
              <VideoFacade lang={lang} youtubeId={v.youtubeId} title={pick(v.title, lang)!} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Lightbox lang={lang} />
</PageLayout>

<style>
  .thumb {
    position: relative;
    display: block;
    height: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 1rem;
    box-shadow: var(--shadow-soft);
  }
  .thumb__icon {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-white) 90%, transparent);
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.25s;
  }
  .thumb:hover .thumb__icon,
  .thumb:focus-visible .thumb__icon {
    opacity: 1;
    transform: none;
  }
</style>
