---
/**
 * Gallery: Matin's introductory video (once set), the official posters of Matin's own and
 * co-organized events (a row that scrolls, each poster opens full screen with zoom; the
 * download stays an explicit button on the event page), then one section per album
 * (title, date, place, description, photos that open in an enlarged viewer, videos).
 * Filters: All, Photos, Videos, Posters, Events (albums of Matin events). The Gallery
 * menu links to #photos, #videos and #posters. Albums: src/content/gallery/ or the admin
 * (/admin/). Only real Matin content, published with consent.
 */
import { Picture, getImage } from 'astro:assets';
import { ArrowRight, CalendarDays, ChevronLeft, ChevronRight, Expand, MapPin } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import GalleryVideo from '@/components/ui/GalleryVideo.astro';
import DialogueArt from '@/components/brand/DialogueArt.astro';
import { alternatesFor, path, type Lang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getAlbums, getEvents, getIntroVideo, slugOf } from '@/lib/content';
import { formatDate } from '@/lib/dates';
import { albumAnchor, youtubeId } from '@/lib/gallery';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const [albums, intro, events] = await Promise.all([getAlbums(), getIntroVideo(), getEvents()]);

// Official posters of Matin's own and co-organized events, newest first.
const posters = await Promise.all(
  events
    .filter((e) => e.data.image && e.data.imageIsPoster)
    .sort((a, b) => b.startDate.getTime() - a.startDate.getTime())
    .map(async (e) => ({
      id: e.id,
      image: e.data.image!,
      title: pick(e.data.title, lang)!,
      alt: pick(e.data.imageAlt, lang) ?? '',
      date: e.startDate,
      href: path('events', lang, slugOf(e, lang)),
      large: (
        await getImage({
          src: e.data.image!,
          width: Math.min(2000, e.data.image!.width),
          format: 'webp',
        })
      ).src,
    })),
);

// Large version for the viewer (max 1800 px wide, WebP).
const albumsWithLarge = await Promise.all(
  albums.map(async (album) => ({
    album,
    photos: await Promise.all(
      album.data.photos.map(async (p) => ({
        ...p,
        large: (
          await getImage({ src: p.image, width: Math.min(1800, p.image.width), format: 'webp' })
        ).src,
      })),
    ),
  })),
);
const hasPhotos = albums.some((a) => a.data.photos.length > 0);
const hasVideos = !!intro || albums.some((a) => a.data.videos.length > 0);
const hasEvents = albums.some((a) => a.data.isEvent);
const filters = [
  { key: '', label: t('gallery.filterAll') },
  hasPhotos && { key: 'photos', label: t('gallery.filterPhotos') },
  hasVideos && { key: 'videos', label: t('gallery.filterVideos') },
  posters.length > 0 && { key: 'posters', label: t('gallery.filterPosters') },
  hasEvents && { key: 'events', label: t('gallery.filterEvents') },
].filter((f) => !!f) as { key: string; label: string }[];
const empty = albums.length === 0 && !intro;
---

<PageLayout
  lang={lang}
  title={t('gallery.title')}
  lede={t('gallery.lede')}
  alternates={alternatesFor('gallery')}
>
  <div class="container-site pt-2 pb-24">
    {empty && (
      <div class="gallery-empty scroll-mt-28" id="photos">
        <span id="videos" class="scroll-mt-28" aria-hidden="true"></span>
        <DialogueArt accent="navy" seed="gallery" class="gallery-empty__art" />
        <p class="gallery-empty__text">
          <span class="gallery-empty__label">{t('gallery.comingSoon')}</span>
          {t('gallery.empty')}
        </p>
      </div>
    )}

    {/* Targets of the Gallery menu (#photos, #videos, #posters) while a kind has no
        section of its own; with JavaScript the matching filter is also applied. */}
    {!empty && (
      <span id="photos" class="block scroll-mt-28" aria-hidden="true">
        <span id="videos" class="block scroll-mt-28" />
      </span>
    )}
    {posters.length === 0 && <span id="posters" class="block scroll-mt-28" aria-hidden="true" />}

    {filters.length > 2 && (
      <div
        class="gallery-filter invisible"
        role="group"
        aria-label={t('gallery.filterLabel')}
        data-gallery-filter
      >
        {filters.map((f, i) => (
          <button
            type="button"
            class="chip"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-show={f.key}
          >
            {f.label}
          </button>
        ))}
      </div>
    )}
    <p class="empty-state" data-gallery-noresults hidden>
      {t('gallery.noResults')}
    </p>

    {posters.length > 0 && (
      <section
        id="posters"
        class="posters scroll-mt-28"
        data-kind="posters"
        aria-labelledby="posters-title"
      >
        <div class="posters__head">
          <div>
            <h2 id="posters-title" class="album-title">
              {t('gallery.postersTitle')}
            </h2>
            <p class="album__text">{t('gallery.postersLede')}</p>
          </div>
          {posters.length > 3 && (
            <div class="posters__nav" data-posters-nav hidden>
              <button type="button" class="posters__btn" data-posters-prev>
                <ChevronLeft size={22} class="flip-rtl" aria-hidden="true" />
                <span class="sr-only">{t('gallery.previousPosters')}</span>
              </button>
              <button type="button" class="posters__btn" data-posters-next>
                <ChevronRight size={22} class="flip-rtl" aria-hidden="true" />
                <span class="sr-only">{t('gallery.nextPosters')}</span>
              </button>
            </div>
          )}
        </div>
        <ul class="posters__row" data-posters-row>
          {posters.map((p) => (
            <li class="poster-card">
              <a
                href={p.large}
                class="poster-card__img"
                data-lightbox="posters"
                data-alt={p.alt}
                data-caption={p.title}
                aria-label={t('gallery.openPoster', { title: p.title })}
              >
                <Picture
                  src={p.image}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 64rem) 22rem, 70vw"
                />
                <span class="thumb__icon" aria-hidden="true">
                  <Expand size={18} />
                </span>
              </a>
              <h3 class="poster-card__title">{p.title}</h3>
              <p class="poster-card__meta">
                <time datetime={p.date.toISOString().slice(0, 10)}>{formatDate(p.date, lang)}</time>
              </p>
              <a href={p.href} class="link-arrow poster-card__link">
                {t('gallery.viewEvent')}
                <ArrowRight size={16} class="flip-rtl" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {intro && (
      <section
        id="intro"
        class="intro-video scroll-mt-28"
        data-kind="videos"
        aria-labelledby="intro-video-title"
      >
        <h2 id="intro-video-title" class="album-title">
          {pick(intro.title, lang)}
        </h2>
        <GalleryVideo
          lang={lang}
          title={pick(intro.title, lang)!}
          youtubeId={youtubeId(intro.youtube)}
          file={intro.file}
          thumbnail={intro.thumbnail}
          bare
        />
      </section>
    )}

    <div class="space-y-20">
      {albumsWithLarge.map(({ album, photos }) => {
        const d = album.data;
        const where = pick(d.location, lang);
        const description = pick(d.description, lang);
        return (
          <section
            id={albumAnchor(album)}
            class="album scroll-mt-28"
            aria-labelledby={`${albumAnchor(album)}-title`}
            data-album
            data-event={d.isEvent ? '1' : '0'}
          >
            <header class="album__head">
              <h2 id={`${albumAnchor(album)}-title`} class="album-title">
                {pick(d.title, lang)}
              </h2>
              <ul class="album__meta">
                <li>
                  <CalendarDays size={18} aria-hidden="true" />
                  <time datetime={d.date.toISOString().slice(0, 10)}>
                    {formatDate(d.date, lang)}
                  </time>
                </li>
                {where && (
                  <li>
                    <MapPin size={18} aria-hidden="true" />
                    {where}
                  </li>
                )}
                {photos.length > 0 && <li>{t('gallery.photos', { n: photos.length })}</li>}
                {d.videos.length > 0 && <li>{t('gallery.videoCount', { n: d.videos.length })}</li>}
              </ul>
              {description && <p class="album__text">{description}</p>}
            </header>
            {d.cover && (
              <Picture
                src={d.cover}
                alt=""
                formats={['avif', 'webp']}
                widths={[720, 1080, 1440, 1920]}
                sizes="(min-width: 90rem) 84rem, 94vw"
                class="album__cover"
              />
            )}

            {photos.length > 0 && (
              <ul class="photo-grid" data-kind="photos">
                {photos.map((photo, i) => {
                  const alt = pick(photo.alt, lang) ?? '';
                  const first = i === 0 && photos.length > 2;
                  return (
                    <li class:list={[first && 'photo-grid__first']}>
                      <a
                        href={photo.large}
                        class="thumb group"
                        data-lightbox={album.id}
                        data-alt={alt}
                        data-caption={pick(photo.caption, lang) ?? ''}
                        aria-label={t('gallery.openPhoto', { alt })}
                      >
                        <Picture
                          src={photo.image}
                          alt=""
                          formats={['avif', 'webp']}
                          widths={first ? [480, 800, 1100] : [300, 480, 640]}
                          sizes={
                            first
                              ? '(min-width: 1024px) 50vw, 100vw'
                              : '(min-width: 1024px) 25vw, 50vw'
                          }
                          class="thumb__img"
                        />
                        <span class="thumb__icon" aria-hidden="true">
                          <Expand size={18} />
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}

            {d.videos.length > 0 && (
              <ul class="video-grid" data-kind="videos">
                {d.videos.map((v) => (
                  <li>
                    <GalleryVideo
                      lang={lang}
                      title={pick(v.title, lang)!}
                      youtubeId={youtubeId(v.youtube)}
                      file={v.file}
                      thumbnail={v.thumbnail}
                    />
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })}
    </div>
  </div>

  <Lightbox lang={lang} />
</PageLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-gallery-filter]');
  if (bar) {
    bar.classList.remove('invisible');
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-show]')];
    const albums = [...document.querySelectorAll<HTMLElement>('[data-album]')];
    const intro = document.querySelector<HTMLElement>('.intro-video');
    const posters = document.querySelector<HTMLElement>('.posters');
    const noResults = document.querySelector<HTMLElement>('[data-gallery-noresults]');
    const show = (what: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.show === what)));
      let visible = 0;
      // Photos or Videos: only that kind of media; Posters: the posters only; Events:
      // albums of Matin events.
      for (const album of albums) {
        let any = false;
        album.querySelectorAll<HTMLElement>('[data-kind]').forEach((list) => {
          list.hidden = (what === 'photos' || what === 'videos') && list.dataset.kind !== what;
          if (!list.hidden) any = true;
        });
        album.hidden =
          !any || what === 'posters' || (what === 'events' && album.dataset.event !== '1');
        if (!album.hidden) visible++;
      }
      if (intro) {
        intro.hidden = what !== '' && what !== 'videos';
        if (!intro.hidden) visible++;
      }
      if (posters) {
        posters.hidden = what !== '' && what !== 'posters';
        if (!posters.hidden) visible++;
      }
      if (noResults) noResults.hidden = visible > 0;
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.show ?? '')));
    // The Gallery menu links to #photos, #videos and #posters: open with that filter.
    const fromHash = () => {
      const what = location.hash.slice(1);
      if (buttons.some((b) => b.dataset.show === what)) {
        show(what);
        bar.scrollIntoView({ block: 'start' });
      }
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }

  // Posters row: previous / next buttons scroll by one screen of posters.
  const row = document.querySelector<HTMLElement>('[data-posters-row]');
  const nav = document.querySelector<HTMLElement>('[data-posters-nav]');
  if (row && nav) {
    nav.hidden = false;
    const step = (dir: number) => {
      const rtl = getComputedStyle(row).direction === 'rtl';
      row.scrollBy({ left: dir * (rtl ? -1 : 1) * row.clientWidth * 0.9, behavior: 'smooth' });
    };
    nav.querySelector('[data-posters-prev]')?.addEventListener('click', () => step(-1));
    nav.querySelector('[data-posters-next]')?.addEventListener('click', () => step(1));
  }
</script>

<style>
  .posters {
    margin-bottom: 5rem;
  }
  .posters__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.75rem;
  }
  .posters__nav {
    display: flex;
    gap: 0.6rem;
  }
  .posters__btn {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-gold);
    background: var(--color-white);
    color: var(--color-primary);
    cursor: pointer;
  }
  .posters__btn:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }
  .posters__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 20rem);
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
  }
  .poster-card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .poster-card__img {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-card-edge);
    background: var(--color-cream);
    box-shadow: var(--shadow-card);
    cursor: zoom-in;
  }
  .poster-card__img :global(picture) {
    display: block;
    height: 100%;
  }
  .poster-card__img .thumb__icon {
    opacity: 1;
    transform: none;
  }
  .poster-card__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
  }
  .poster-card__img:hover :global(img) {
    transform: scale(1.04);
  }
  .poster-card__title {
    margin-top: 0.6rem;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .poster-card__meta {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-gold-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .poster-card__img :global(img) {
      transition: none;
    }
    .poster-card__img:hover :global(img) {
      transform: none;
    }
  }
  .gallery-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-end: 3rem;
  }
  .chip {
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem;
    border: 1.5px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--color-gold);
  }
  .chip[aria-pressed='true'] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
  }
  /* Nothing published yet: the dialogue motif and a short note, no sample pictures. */
  .gallery-empty {
    position: relative;
    margin-bottom: 4rem;
    overflow: hidden;
    height: clamp(20rem, 12rem + 18vw, 30rem);
    border-radius: var(--radius-card);
    background: var(--color-tint);
  }
  .gallery-empty :global(.gallery-empty__art) {
    width: 100%;
    height: 100%;
  }
  .gallery-empty__text {
    position: absolute;
    inset-inline: 1.25rem;
    inset-block-end: 1.25rem;
    max-width: 32rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: var(--color-white);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .gallery-empty__label {
    display: block;
    margin-block-end: 0.25rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-terracotta-deep);
  }
  .intro-video {
    max-width: 60rem;
    margin-block-end: 4.5rem;
  }
  .album-title {
    margin-block-end: 0.75rem;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
  }
  .album__head {
    max-width: 46rem;
    margin-block-end: 1.75rem;
  }
  .album__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .album__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .album__meta :global(svg) {
    color: var(--color-terracotta-deep);
  }
  .album__text {
    margin-block-start: 1rem;
    font-size: 1.125rem;
    line-height: 1.7;
  }
  .album :global(.album__cover) {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    margin-block-end: 1rem;
    border-radius: var(--radius-card);
    object-fit: cover;
  }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  @media (min-width: 64rem) {
    .photo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .photo-grid__first {
    grid-column: span 2;
    grid-row: span 2;
  }
  .video-grid {
    display: grid;
    gap: 2rem;
    margin-block-start: 2rem;
  }
  @media (min-width: 48rem) {
    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .thumb {
    position: relative;
    display: block;
    height: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-tint);
  }
  .thumb :global(.thumb__img),
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .thumb:hover :global(img) {
    transform: scale(1.04);
  }
  .thumb__icon {
    position: absolute;
    inset-inline-end: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: var(--color-primary);
    background: var(--color-white);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s,
      transform 0.25s;
  }
  .thumb:hover .thumb__icon,
  .thumb:focus-visible .thumb__icon {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img),
    .thumb__icon {
      transition: none;
    }
  }
</style>
