---
import { Picture, getImage } from 'astro:assets';
import {
  ArrowLeft,
  CalendarPlus,
  Clock,
  Download,
  ExternalLink,
  MapPin,
  Ticket,
} from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import CoverArt from '@/components/content/CoverArt.astro';
import Prose from '@/components/ui/Prose.astro';
import ShareButtons from '@/components/ui/ShareButtons.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import { baseLang, href, path, type Alternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { cityOf, placeName, renderMarkdown, slugOf, type EventEntry } from '@/lib/content';
import { formatWhen } from '@/lib/dates';
import { subjectCover } from '@/lib/taxonomy';
import { googleCalendarUrl, mapUrl } from '@/lib/calendar';

interface Props {
  lang: UiLang;
  event: EventEntry;
}
const { lang, event } = Astro.props;
const t = useTranslations(lang);
const d = event.data;
const title = pick(d.title, lang)!;
// Matin events with a reviewed Persian text also have a Persian page (/fa/events/…).
const faPage = d.faReviewed && d.kind !== 'selected';
const alternates: Alternates = {
  fr: path('events', 'fr', slugOf(event, 'fr')),
  en: path('events', 'en', slugOf(event, 'en')),
  ...(faPage && { fa: `/fa/events/${slugOf(event, 'en')}/` }),
};
// Calendar files and links use French or English (the fallback language for Persian).
const calLang = baseLang(lang);
const place = placeName(event, lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(alternates[lang] ?? alternates.en, site).href;
const ended = event.endDate < new Date();
const tz = d.timeZone;
const price =
  d.price.type === 'free'
    ? t('events.free')
    : d.price.type === 'paid'
      ? pick(d.price.label, lang) || t('events.paid')
      : t('events.priceUnknown');
const online = d.format === 'online' || !d.location;
// After the event: report, highlights and captioned photos (each shown only if filled in).
const report = d.report && pick(d.report, lang);
const highlights = d.highlights.map((h) => pick(h, lang)!).filter(Boolean);
const photos = await Promise.all(
  d.photos.map(async (p) => ({
    ...p,
    large: (await getImage({ src: p.image, width: Math.min(1800, p.image.width), format: 'webp' }))
      .src,
  })),
);
const icsHref = `/ics/${event.id}-${calLang}.ics`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description: pick(d.summary, lang),
  startDate: event.startDate.toISOString(),
  endDate: event.endDate.toISOString(),
  eventStatus: {
    scheduled: 'https://schema.org/EventScheduled',
    postponed: 'https://schema.org/EventPostponed',
    cancelled: 'https://schema.org/EventCancelled',
  }[d.status],
  eventAttendanceMode: {
    'in-person': 'https://schema.org/OfflineEventAttendanceMode',
    online: 'https://schema.org/OnlineEventAttendanceMode',
    hybrid: 'https://schema.org/MixedEventAttendanceMode',
  }[d.format],
  inLanguage: lang === 'fr' ? 'fr-CA' : lang === 'fa' ? 'fa' : 'en-CA',
  url,
  image: [new URL('/og-default.jpg', site).href],
  location: online
    ? { '@type': 'VirtualLocation', url: d.registrationUrl ?? url }
    : {
        '@type': 'Place',
        name: place,
        address: {
          '@type': 'PostalAddress',
          streetAddress: d.location!.address,
          addressLocality: cityOf(event, lang),
          addressCountry: d.country === 'Canada' ? 'CA' : d.country,
        },
      },
  organizer:
    d.kind === 'co-organized'
      ? [
          { '@id': new URL('/#organization', site).href },
          { '@type': 'Organization', name: d.organizer.name, url: d.organizer.url },
        ]
      : { '@id': new URL('/#organization', site).href },
  // Price details only when stated; never guessed.
  ...(d.price.type === 'free' && {
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'CAD', url: d.registrationUrl ?? url },
    isAccessibleForFree: true,
  }),
};
---

<PageLayout
  lang={lang}
  title={title}
  eyebrow={t(`agendaKinds.${d.kind}`)}
  lede={pick(d.summary, lang)}
  alternates={alternates}
  crumbs={[{ label: t('events.title'), href: href('events', lang) }]}
  type="event"
  jsonLd={[jsonLd]}
>
  <div class="container-site grid gap-12 pt-6 pb-24 lg:grid-cols-[1fr_23rem]">
    <article>
      <div
        class:list={[
          'relative mb-10 overflow-hidden rounded-[var(--radius-card)] shadow-soft',
          d.image && d.imageIsPoster ? 'event-poster' : 'aspect-[16/9]',
        ]}
      >
        {d.image && d.imageIsPoster ? (
          <Picture
            src={d.image}
            alt={pick(d.imageAlt, lang) ?? ''}
            formats={['avif', 'webp']}
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1024px) 40rem, 100vw"
            class="mx-auto block h-auto w-full max-w-[40rem]"
            loading="eager"
          />
        ) : d.image ? (
          <Picture
            src={d.image}
            alt={pick(d.imageAlt, lang) ?? ''}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="size-full object-cover"
            loading="eager"
          />
        ) : (
          <CoverArt category={subjectCover[d.subject]} seed={event.id} class="size-full" />
        )}
        {ended && (
          <span class="absolute top-4 left-4 rounded-full border border-line bg-white px-4 py-1.5 text-sm font-bold text-ink">
            {t('events.ended')}
          </span>
        )}
      </div>
      <Prose html={renderMarkdown(pick(d.body, lang) ?? '', lang)} class="text-lg" />
      {report && (
        <section class="mt-14" aria-labelledby="report-title">
          <h2 id="report-title" class="mb-5 text-3xl font-bold">
            {t('events.report')}
          </h2>
          <Prose html={renderMarkdown(report, lang)} class="text-lg" />
        </section>
      )}
      {highlights.length > 0 && (
        <section class="mt-12" aria-labelledby="highlights-title">
          <h2 id="highlights-title" class="mb-5 text-3xl font-bold">
            {t('events.highlights')}
          </h2>
          <ul class="space-y-3">
            {highlights.map((h) => (
              <li class="rounded-xl border-s-4 border-gold bg-white p-4 text-lg shadow-soft">
                {h}
              </li>
            ))}
          </ul>
        </section>
      )}
      {photos.length > 0 && (
        <section class="mt-12" aria-labelledby="photos-title">
          <h2 id="photos-title" class="mb-5 text-3xl font-bold">
            {t('events.photos')}
          </h2>
          <ul class="grid gap-5 sm:grid-cols-2">
            {photos.map((p) => {
              const alt = pick(p.alt, lang) ?? '';
              const caption = pick(p.caption, lang);
              return (
                <li>
                  <figure>
                    <a
                      href={p.large}
                      data-lightbox={`event-${event.id}`}
                      data-alt={alt}
                      data-caption={caption ?? ''}
                      aria-label={t('gallery.openPhoto', { alt })}
                      class="block overflow-hidden rounded-2xl shadow-soft"
                    >
                      <Picture
                        src={p.image}
                        alt=""
                        formats={['avif', 'webp']}
                        widths={[400, 640, 900]}
                        sizes="(min-width: 640px) 40vw, 100vw"
                        class="aspect-[4/3] w-full object-cover"
                      />
                    </a>
                    {caption && <figcaption class="mt-2 text-sm text-muted">{caption}</figcaption>}
                  </figure>
                </li>
              );
            })}
          </ul>
          <Lightbox lang={lang} />
        </section>
      )}
      <div class="mt-12 border-t border-line pt-6">
        <ShareButtons lang={lang} url={url} title={title} />
      </div>
    </article>

    <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
      <div class="card overflow-hidden">
        <ul class="divide-y divide-line/70 px-6">
          <li class="flex gap-3 py-5">
            <Clock size={20} class="mt-0.5 shrink-0 text-ink" aria-hidden="true" />
            <div>
              <p class="text-xs font-bold tracking-wider text-muted uppercase">
                {t('events.when')}
              </p>
              <div class="mt-0.5 font-semibold text-ink">
                <time datetime={event.startDate.toISOString()}>
                  {formatWhen(event.startDate, d.end ? event.endDate : undefined, lang, {
                    allDay: d.allDay,
                    timeZone: tz,
                  })}
                </time>
              </div>
            </div>
          </li>
          <li class="flex gap-3 py-5">
            <MapPin size={20} class="mt-0.5 shrink-0 text-ink" aria-hidden="true" />
            <div>
              <p class="text-xs font-bold tracking-wider text-muted uppercase">
                {t('events.where')}
              </p>
              {online ? (
                <div class="mt-0.5 font-semibold text-ink">{t('agendaFormats.online')}</div>
              ) : (
                <div class="mt-0.5 text-ink">
                  <span class="block font-semibold">{place}</span>
                  <span class="block text-sm">{d.location!.address ?? cityOf(event, lang)}</span>
                  {d.format === 'hybrid' && (
                    <span class="block text-sm">{t('agendaFormats.hybrid')}</span>
                  )}
                  <a
                    href={mapUrl(d.location!, place)}
                    class="mt-1 inline-block text-sm font-semibold"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t('events.viewMap')}
                    <span class="sr-only">{t('a11y.externalLink')}</span>
                  </a>
                </div>
              )}
            </div>
          </li>
          {price && (
            <li class="flex gap-3 py-5">
              <Ticket size={20} class="mt-0.5 shrink-0 text-ink" aria-hidden="true" />
              <div>
                <p class="text-xs font-bold tracking-wider text-muted uppercase">
                  {t('events.price')}
                </p>
                <div class="mt-0.5 font-semibold text-ink">{price}</div>
              </div>
            </li>
          )}
        </ul>
        {!ended && d.registrationUrl && (
          <div class="px-6 pb-6">
            <a
              href={d.registrationUrl}
              class="btn btn-primary w-full"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('events.register')}
              <ExternalLink size={16} aria-hidden="true" />
              <span class="sr-only">{t('a11y.externalLink')}</span>
            </a>
          </div>
        )}
      </div>

      {!ended && (
        <div class="card p-6">
          <h2 class="mb-4 flex items-center gap-2 font-sans text-sm font-bold tracking-[0.15em] text-ink uppercase">
            <CalendarPlus size={18} class="text-gold-dark" aria-hidden="true" />
            {t('events.addToCalendar')}
          </h2>
          <div class="flex flex-col gap-2">
            <a href={icsHref} class="btn btn-outline" download>
              <Download size={16} aria-hidden="true" />
              {t('events.icsDownload')}
            </a>
            <a
              href={googleCalendarUrl(event, calLang, url)}
              class="btn btn-outline"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('events.googleCalendar')}
              <ExternalLink size={16} aria-hidden="true" />
              <span class="sr-only">{t('a11y.externalLink')}</span>
            </a>
          </div>
        </div>
      )}

      <a href={href('events', lang)} class="link-arrow">
        <ArrowLeft size={18} aria-hidden="true" />
        {t('events.backToEvents')}
      </a>
    </aside>
  </div>
</PageLayout>

<style>
  /* An official poster is shown whole, on a cream ground. */
  .event-poster {
    padding: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    background: var(--color-tint);
  }
</style>
