---
/**
 * Cultural Resources & Organizations (owner's brief, Oct 25 2026): a curated directory of
 * major cultural institutions and organizations in five categories (Canadian municipal,
 * Québec, Canadian federal, cultural & community organizations and institutions,
 * international), each a
 * coloured module of logo cards (`OrgCard`) that open the official website in a new tab.
 * A listing never implies a partnership, endorsement or affiliation: the notice says so at
 * the top (a "member" or "partner" badge appears only where the owner confirmed it).
 * Entries: src/content/resources/ (or the admin, /admin/). Below the directory: International
 * Cultural Networks (#networks, src/content/networks/, shown once entries exist) and
 * Cultural Policy & Strategic Documents (#policy, src/content/policies/). FR, EN and FA.
 */
import {
  ArrowDown,
  ArrowRight,
  BookOpen,
  CircleAlert,
  FileText,
  ListFilter,
  MapPin,
} from '@lucide/astro';
import OrgCard from '@/components/content/OrgCard.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { baseLang, href, siteAlternates, type UiLang } from '@/i18n/routes';
import { guideStrings } from '@/lib/localGuide';
import { useTranslations, pick } from '@/i18n/ui';
import { getNetworks, getPolicies, getResources, orgName } from '@/lib/content';
import { resourceCategories } from '@/lib/taxonomy';
import { resourceAccents, resourceIcons } from '@/lib/resourceIcons';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const [resources, networks, policies] = await Promise.all([
  getResources(),
  getNetworks(),
  getPolicies(),
]);
const base = baseLang(lang);
// A policy's title in the page's language, else the language the publisher used.
const policyTitle = (p: (typeof policies)[number]) =>
  p.data.title[base] ?? p.data.title.fr ?? p.data.title.en!;
const num = new Intl.NumberFormat(lang === 'fa' ? 'fa-IR' : 'en-CA');
const groups = resourceCategories
  .map((c) => ({ category: c, items: resources.filter((r) => r.data.category === c) }))
  .filter((g) => g.items.length);
---

<PageLayout
  accent="encre"
  lang={lang}
  title={t('resources.title')}
  lede={t('resources.lede')}
  alternates={siteAlternates('resources')}
>
  <!-- The parts of the page, as quick links under the title (the category filter sits
       above the directory itself). -->
  <nav slot="hero" class="res-jump" aria-label={t('legal.onThisPage')}>
    <a href="#directory" class="res-jump__link" data-accent="navy" data-jump>
      <span class="res-jump__icon" aria-hidden="true">
        <BookOpen size={18} />
      </span>
      {t('nav.resourcesDirectory')}
      <ArrowDown size={16} class="res-jump__arrow" aria-hidden="true" />
    </a>
    <a href="#policy" class="res-jump__link" data-accent="mustard">
      <span class="res-jump__icon" aria-hidden="true">
        <FileText size={18} />
      </span>
      {t('resources.policyTitle')}
      <ArrowDown size={16} class="res-jump__arrow" aria-hidden="true" />
    </a>
    <!-- The Local Guide (Oct 30 2026): its own page. -->
    <a href={href('localGuide', lang)} class="res-jump__link" data-accent="teal">
      <span class="res-jump__icon" aria-hidden="true">
        <MapPin size={18} />
      </span>
      {guideStrings(lang).title}
      <ArrowRight size={16} class="res-jump__arrow flip-rtl" aria-hidden="true" />
    </a>
  </nav>

  <div class="directory-band">
    <div id="directory" class="container-site scroll-mt-28 pt-8 pb-16">

      {groups.length === 0 && <p class="empty-state">{t('resources.empty')}</p>}

      {groups.length > 1 && (
        <div
          class="directory-filter invisible"
          role="group"
          aria-labelledby="directory-filter-label"
          data-directory-filter
        >
          <p id="directory-filter-label" class="directory-filter__label">
            <ListFilter size={20} aria-hidden="true" />
            {t('resources.filterLabel')}
          </p>
          <div class="directory-filter__chips">
            <button type="button" class="chip" aria-pressed="true" data-cat="">
              <span class="chip__dot" aria-hidden="true"></span>
              {t('resources.all')}
            </button>
            {groups.map(({ category }) => (
              <button type="button" class="chip" aria-pressed="false" data-cat={category}>
                <span class="chip__dot" aria-hidden="true"></span>
                {t(`resources.${category}`)}
              </button>
            ))}
          </div>
        </div>
      )}

      <div class="directory-groups">
        {groups.map(({ category, items }) => {
          const Icon = resourceIcons[category];
          return (
            <section
              id={`cat-${category}`}
              class="directory-group scroll-mt-28"
              aria-labelledby={`res-${category}`}
              data-category={category}
            >
              <div class="directory-head">
                <span class="directory-head__icon" aria-hidden="true">
                  <Icon size={26} stroke-width={1.75} />
                </span>
                <div class="directory-head__text">
                  <h2 id={`res-${category}`} class="directory-title">
                    {t(`resources.${category}`)}
                  </h2>
                  <p class="directory-lede">{t(`resources.${category}Lede`)}</p>
                </div>
                <span class="directory-count">
                  <strong>{num.format(items.length)}</strong> {t('resources.count')}
                </span>
              </div>
              <ul class:list={['org-list', category === 'municipal' && 'org-list--three']}>
                {items.map((r) => (
                  <OrgCard
                    lang={lang}
                    name={orgName(r, lang)}
                    label={pick(r.data.label, lang) || orgName(r, lang)}
                    url={r.data.url}
                    logo={r.data.logo}
                    description={pick(r.data.description, lang)}
                    kind={pick(r.data.kind, lang)}
                    status={r.data.status}
                    accent={resourceAccents[category]}
                  />
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    </div>
  </div>

  {networks.length > 0 && (
    <section
      id="networks"
      class="networks-band scroll-mt-28 py-16 sm:py-20"
      aria-labelledby="networks-title"
    >
      <div class="container-site">
        <SectionHeader
          align="start"
          id="networks-title"
          title={t('resources.networksTitle')}
          lede={t('resources.networksLede')}
          class="mb-10"
        />
        <ul class="org-list">
          {networks.map((n) => {
            const name = (base === 'en' && n.data.nameEn) || n.data.name;
            return (
              <OrgCard
                lang={lang}
                name={name}
                label={name}
                url={n.data.url}
                logo={n.data.logo}
                description={pick(n.data.description, lang)}
                status={n.data.status}
                accent="teal"
              />
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section
    id="policy"
    class="policy-band scroll-mt-28 py-16 sm:py-20"
    aria-labelledby="policy-title"
  >
    <div class="container-site">
      <SectionHeader
        align="start"
        id="policy-title"
        title={t('resources.policyTitle')}
        lede={t('resources.policyLede')}
        class="mb-10"
      />
      {policies.length > 0 ? (
        <ul class="policy-list">
          {policies.map((p, i) => (
            <li class="card policy" data-tone={i % 3}>
              <span class="policy__icon" aria-hidden="true">
                <FileText size={22} stroke-width={1.75} />
              </span>
              <div class="policy__body">
                <h3 class="policy__title">
                  <a
                    href={p.data.url ?? p.data.file}
                    target={p.data.url ? '_blank' : undefined}
                    rel={p.data.url ? 'noopener noreferrer' : undefined}
                  >
                    {policyTitle(p)}
                    {p.data.url && <span class="sr-only">{t('a11y.externalLink')}</span>}
                  </a>
                </h3>
                <p class="policy__meta">
                  {p.data.publisher} · {p.data.year} ·{' '}
                  {t(`resources.jurisdiction_${p.data.jurisdiction}`)}
                </p>
                {pick(p.data.description, lang) && (
                  <p class="org-card__text">{pick(p.data.description, lang)}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="res-empty" data-accent="mustard">
          <span class="res-empty__icon" aria-hidden="true">
            <FileText size={26} stroke-width={1.6} />
          </span>
          <span>{t('resources.policyEmpty')}</span>
        </p>
      )}
    </div>
  </section>

  <!-- Moved to the end of the page (owner, Oct 31 2026). -->
  <div class="notice-band">
    <div class="container-site">
      <!-- Independence notice (owner's briefs, Oct 25 2026: a strong, clearly visible
           notice on deep teal with a gold edge and a gold "please note" badge). -->
      <aside class="directory-notice" aria-labelledby="directory-notice-title">
        <span class="directory-notice__icon" aria-hidden="true">
          <CircleAlert size={28} stroke-width={2.25} />
        </span>
        <div>
          <p id="directory-notice-title" class="directory-notice__title">
            {t('resources.noticeTitle')}
          </p>
          <p>{t('resources.notice')}</p>
        </div>
      </aside>
    </div>
  </div>
</PageLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-directory-filter]');
  if (bar) {
    bar.classList.remove('invisible');
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')];
    const show = (cat: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      sections.forEach((s) => (s.hidden = !!cat && s.dataset.category !== cat));
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.cat ?? '')));
    // A quick link under the title always shows every category again before jumping.
    document
      .querySelectorAll<HTMLAnchorElement>('[data-jump]')
      .forEach((a) => a.addEventListener('click', () => show('')));
    // Opened from a category link on the homepage (#cat-federal…): show that category.
    const fromHash = location.hash.replace(/^#cat-/, '');
    if (fromHash && buttons.some((b) => b.dataset.cat === fromHash)) show(fromHash);
  }
</script>

<style>
  /* Quick links under the title: white pills with a coloured icon tile. */
  .res-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }
  .res-jump__link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3rem;
    padding: 0.4rem 1.1rem 0.4rem 0.45rem;
    border: 1px solid var(--color-card-edge);
    border-radius: 999px;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .res-jump__link:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
  }
  .res-jump__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--color-white);
  }
  .res-jump__link[data-accent='navy'] .res-jump__icon {
    color: var(--color-gold);
  }
  .res-jump__link[data-accent='mustard'] .res-jump__icon {
    color: var(--color-primary);
  }
  .res-jump :global(.res-jump__arrow) {
    color: var(--color-teal-deep);
  }
  .networks-band {
    background: var(--color-aqua);
    border-block: 1px solid var(--color-aqua-edge);
  }
  .policy-band {
    background: var(--color-champagne);
  }
  .policy-band .policy {
    border-inline-start: 5px solid var(--color-gold);
  }
  /* Empty sections: a finished ivory panel with an accent edge, rather than a bare line. */
  .res-empty {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--color-card-edge);
    border-inline-start: 5px solid var(--accent);
    border-radius: calc(var(--radius-card) * 1.2);
    background: var(--color-ivory);
    box-shadow: var(--shadow-card);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-primary);
  }
  .res-empty__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-gold);
  }
  /* Category filter (owner's brief, Oct 25 2026: more colour, clearly interactive): a soft
     turquoise panel; champagne pills with a dot in each category's colour; the selected
     pill takes its category's colour (navy, deep teal, matte gold). */
  .directory-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.25rem;
    margin-block-end: 3rem;
    padding: 1.1rem 1.35rem;
    border: 1px solid var(--color-aqua-edge);
    border-radius: calc(var(--radius-card) * 1.1);
    background: var(--color-aqua);
  }
  .directory-filter__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-primary);
  }
  .directory-filter__label :global(svg) {
    color: var(--color-teal-deep);
  }
  .directory-filter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .chip {
    --chip-color: var(--color-primary);
    --chip-ink: var(--color-white);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem 0.5rem 0.9rem;
    border: 1.5px solid var(--color-card-edge);
    /* Long French names wrap on phones: a soft rounded rectangle rather than a pill. */
    border-radius: 1.4rem;
    background: var(--color-champagne);
    box-shadow: 0 2px 6px -3px color-mix(in srgb, var(--color-primary) 35%, transparent);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    text-align: start;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .chip[data-cat='municipal'] {
    --chip-color: var(--color-terracotta-deep);
  }
  .chip[data-cat='quebec'] {
    --chip-color: var(--color-teal-deep);
  }
  .chip[data-cat='community'] {
    --chip-color: var(--color-gold);
    --chip-ink: var(--color-primary);
  }
  .chip[data-cat='international'] {
    --chip-color: var(--color-teal);
  }
  .chip__dot {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--chip-color);
    box-shadow: 0 0 0 2px var(--color-white);
  }
  .chip:hover {
    border-color: var(--color-gold);
    background: var(--color-cream);
    transform: translateY(-1px);
  }
  .chip[aria-pressed='true'] {
    border-color: var(--chip-color);
    background: var(--chip-color);
    box-shadow:
      0 0 0 3px var(--color-white),
      0 0 0 5px var(--chip-color);
    color: var(--chip-ink);
  }
  /* Teal is not text-safe: the selected international pill uses navy with a teal ring. */
  .chip[data-cat='international'][aria-pressed='true'] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
  }
  .chip[aria-pressed='true'] .chip__dot {
    background: var(--chip-ink);
    box-shadow: none;
  }
  .chip[data-cat='international'][aria-pressed='true'] .chip__dot {
    background: var(--color-teal);
    box-shadow: 0 0 0 2px var(--color-white);
  }
  .org-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .policy-list {
    display: grid;
    gap: 1.25rem;
    max-width: 60rem;
  }
  .policy {
    display: flex;
    gap: 1.1rem;
    padding: 1.4rem 1.6rem;
  }
  .policy__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 0.9rem;
    color: var(--color-primary);
    background: var(--color-gold);
  }
  .policy__title {
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.35;
  }
  .policy__meta {
    margin-block: 0.3rem 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-gold-dark);
  }
  .org-card__text {
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  /* The directory: warm ivory band; four modules, each with its own colour treatment
     (owner's brief, Oct 25 2026: warmer, less white; navy, teal, gold, turquoise). Flat
     colours only, per the site's no-gradient rule. */
  .directory-band {
    /* Joins the banner directly (the banner keeps a bottom margin on other pages). */
    margin-block-start: -3rem;
    background: var(--color-ivory);
  }
  .directory-notice {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 64rem;
    margin-block-end: 2.5rem;
    padding: 1.35rem 1.6rem;
    border-inline-start: 7px solid var(--color-gold);
    border-radius: var(--radius-card);
    background: var(--color-teal-deep);
    box-shadow: 0 16px 30px -22px color-mix(in srgb, var(--color-primary) 70%, transparent);
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-white);
  }
  .directory-notice__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-gold) 35%, transparent);
    color: var(--color-primary);
  }
  .directory-notice__title {
    margin-block-end: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-cream);
  }
  /* Directory groups (scheme A, Oct 29 2026): one quiet pattern for every category, a
     white head with a thick top edge and an icon tile in the category's colour, then the
     cards on the ivory ground. The colour names the category; the page stays calm. */
  .directory-group {
    --cat: var(--color-primary);
    --cat-ink: var(--color-white);
    --body-bg: var(--color-paper);
    --org-surface: var(--color-white);
    overflow: hidden;
    border: 1px solid var(--color-card-edge);
    border-radius: calc(var(--radius-card) * 1.3);
    border-start-end-radius: 6rem;
    background: var(--body-bg);
    box-shadow: var(--shadow-card);
  }
  /* Less regular (owner's request, Oct 29 2026): the deep corner alternates from one
     category to the next, and in the two-column lists the second card sits lower. */
  .directory-group:nth-child(2n) {
    border-start-end-radius: calc(var(--radius-card) * 1.3);
    border-end-start-radius: 6rem;
  }
  .directory-group[data-category='municipal'] {
    --cat: var(--color-brique);
  }
  .directory-group[data-category='quebec'] {
    --cat: var(--color-firouzeh);
  }
  .directory-group[data-category='community'] {
    --cat: var(--color-soleil);
    --cat-ink: var(--color-primary);
  }
  .directory-group[data-category='international'] {
    --cat: var(--color-firouzeh-ink);
  }
  .directory-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem 1.25rem;
    align-items: center;
    padding: clamp(1.25rem, 0.9rem + 1.4vw, 2rem) clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    border-block-start: 6px solid var(--cat);
    border-block-end: 1px solid var(--color-card-edge);
    background: var(--color-white);
    color: var(--color-primary);
  }
  @media (min-width: 56rem) {
    .directory-head {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
  }
  .directory-head__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: var(--cat);
    color: var(--cat-ink);
  }
  .directory-title {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-primary);
  }
  .directory-lede {
    max-width: 60rem;
    margin-block-start: 0.4rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink);
  }
  .directory-count {
    grid-column: 1 / -1;
    justify-self: start;
    padding: 0.3rem 0.95rem;
    border-radius: 999px;
    background: var(--color-sable);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  @media (min-width: 56rem) {
    .directory-count {
      grid-column: auto;
    }
  }
  /* Two wide cards per row on large screens, one on phones and tablets. */
  .org-list {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
  }
  .networks-band .org-list {
    padding: 0;
  }
  @media (min-width: 64rem) {
    .org-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .org-list:not(.org-list--three) > :global(:nth-child(2n)) {
      margin-block: 1.75rem -1.75rem;
    }
    .directory-group .org-list:not(.org-list--three) {
      padding-block-end: calc(clamp(1.25rem, 0.8rem + 2vw, 2.25rem) + 1.75rem);
    }
  }
  @media (min-width: 72rem) {
    .org-list--three > :global(:nth-child(3n + 2)) {
      margin-block: 1.75rem -1.75rem;
    }
    .org-list--three {
      padding-block-end: calc(clamp(1.25rem, 0.8rem + 2vw, 2.25rem) + 1.75rem);
    }
  }
  /* The municipalities (owner's brief, Oct 25 2026): three across on desktop, two on
     tablets, one on phones; the logo sits above the text so every card stays balanced. */
  .org-list--three :global(.org) {
    grid-template-columns: minmax(0, 1fr);
    gap: 1.1rem;
  }
  .org-list--three :global(.org__logo) {
    height: 7.5rem;
  }
  @media (min-width: 40rem) {
