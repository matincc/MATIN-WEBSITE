---
/**
 * One note from the President on its own page (owner's brief, Oct 29 2026): a shareable
 * address, a generous title, the date and reading time, the text on a comfortable reading
 * measure (about 68 characters), the closing question set apart, an optional photo, the
 * author in a quiet line, and a way back to the journal. No modal. Also renders the
 * welcome note (« Un mot personnel de notre président », `president.message` in
 * about.yaml) when `welcome` is set; it has no date, so none is shown.
 */
import type { CollectionEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import { ArrowLeft, ArrowRight, Clock, ExternalLink, Pin } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JournalCrumbs from '@/components/notes/JournalCrumbs.astro';
import LeafRule from '@/components/brand/LeafRule.astro';
import ShareButtons from '@/components/ui/ShareButtons.astro';
import { href, type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import { getNotes, getSingleton } from '@/lib/content';
import { formatDate } from '@/lib/dates';
import { typo } from '@/lib/frenchTypo';
import { breadcrumbJsonLd } from '@/lib/seo';
import {
  noteAlternates,
  noteHref,
  noteView,
  readingTime,
  splitParagraphs,
  welcomeAlternates,
  welcomeHref,
} from '@/lib/notes';
import portrait from '@/assets/photos/president-casual.jpg';

interface Props {
  lang: UiLang;
  note?: CollectionEntry<'notes'>;
  welcome?: boolean;
}
const { lang, note, welcome = false } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const dirOf = (l: string) => (l === 'fa' ? 'rtl' : 'ltr');

const { president: p } = await getSingleton('about');
const name = pick(p.displayName, lang) || p.name;
const role = pick(p.title, lang);
const notes = await getNotes();

// One shape for both kinds of page.
let title: string;
let paragraphs: string[];
let minutes: string;
let date: Date | undefined;
let foreignLang: UiLang | undefined;
let translationOf: UiLang | undefined;
let url: string;
let alternates;
let image: CollectionEntry<'notes'>['data']['image'];
let imageAlt = '';
let imageCredit: string | undefined;
let linkedin: string | undefined;

if (note) {
  const v = noteView(note, lang);
  title = v.headline ?? t('notes.noteOf', { date: formatDate(note.data.date, lang) });
  paragraphs = [...v.paragraphs];
  minutes = v.minutes;
  date = note.data.date;
  foreignLang = v.foreign ? v.shownLang : undefined;
  translationOf = v.isTranslation ? note.data.original : undefined;
  url = noteHref(note, lang);
  alternates = noteAlternates(note);
  image = note.data.image;
  imageAlt = pick(note.data.imageAlt, lang) ?? '';
  imageCredit = note.data.imageCredit;
  linkedin = note.data.linkedin;
} else {
  const raw = (lang === 'fa' ? p.message?.fa : p.message?.[lang]) ?? '';
  const message = lang === 'fr' ? typo(raw, 'fr') : raw;
  title = t('about.founderTitle');
  paragraphs = splitParagraphs(message);
  minutes = readingTime(message, lang);
  url = welcomeHref(lang);
  alternates = welcomeAlternates();
}

// The closing question of a post, set apart as an invitation to reply.
const last = paragraphs.at(-1) ?? '';
const question =
  note && paragraphs.length > 1 && /[?؟]$/.test(last) ? paragraphs.pop() : undefined;
const foreign = foreignLang ? { lang: foreignLang, dir: dirOf(foreignLang) } : {};

// Keep reading: the welcome note (when this is not it) and the latest other notes.
const others = notes.filter((n) => n.id !== note?.id).slice(0, welcome ? 3 : 2);
const welcomeExcerpt = !welcome
  ? splitParagraphs((lang === 'fa' ? p.message?.fa : p.message?.[lang]) ?? '')[0]
  : undefined;

const journal = href('notes', lang);
const trail = [
  { label: t('common.home'), href: href('home', lang) },
  { label: t('nav.news'), href: href('news', lang) },
  { label: t('notes.journalTitle'), href: journal },
  { label: title, href: url },
];
const pageUrl = new URL(url, site).href;
const description = (paragraphs[0] ?? '').replace(/\s+/g, ' ').slice(0, 200);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  ...(date && { datePublished: date.toISOString() }),
  inLanguage: { fr: 'fr-CA', en: 'en-CA', fa: 'fa' }[foreignLang ?? lang],
  author: { '@type': 'Person', name: p.name, jobTitle: role },
  publisher: { '@id': new URL('/#organization', site).href },
  mainEntityOfPage: pageUrl,
};
---

<BaseLayout
  lang={lang}
  title={`${title} · ${t('notes.journalTitle')}`}
  description={description}
  alternates={alternates}
  type="article"
  jsonLd={[
    breadcrumbJsonLd(
      trail.map((c) => ({ name: c.label, url: c.href })),
      site,
    ),
    jsonLd,
  ]}
>
  <article class="na" aria-labelledby="page-title">
    <header class="na-head">
      <div class="container-site na-head__inner">
        <JournalCrumbs lang={lang} trail={trail} />
        <a href={journal} class="na-back">
          <ArrowLeft size={18} class="flip-rtl" aria-hidden="true" />
          {t('notes.back')}
        </a>
        {welcome && (
          <p class="na-label">
            <Pin size={16} aria-hidden="true" />
            {t('notes.pinned')}
          </p>
        )}
        {foreignLang && (
          <p class="na-lang">
            {t('notes.originalLanguage', { language: t(`notes.languageNames.${foreignLang}`) })}
          </p>
        )}
        <h1 id="page-title" class="na-title" {...foreign}>
          {title}
        </h1>
        <LeafRule class="na-rule" />
        <p class="na-meta">
          <span class="na-byline">
            <Image src={portrait} alt="" width={96} height={96} class="na-avatar" />
            <span>
              <span class="na-byline__name">{name}</span>
              <span class="na-byline__role">{role}</span>
            </span>
          </span>
          {date && (
            <time datetime={date.toISOString().slice(0, 10)} class="na-meta__item">
              {formatDate(date, lang)}
            </time>
          )}
          <span class="na-meta__item">
            <Clock size={16} aria-hidden="true" />
            {t('news.readingTime', { n: minutes })}
          </span>
        </p>
        {translationOf && (
          <p class="na-translation">
            {t('notes.translatedFrom', { language: t(`notes.languageNames.${translationOf}`) })}
          </p>
        )}
      </div>
    </header>

    <div class="na-body">
      <div class="container-site">
        <div class="na-text" {...foreign}>
          {paragraphs.map((para) => (
            <p>{para}</p>
          ))}
          {question && <p class="na-question">{question}</p>}
        </div>

        {image && (
          <figure class="na-figure">
            <Picture
              src={image}
              alt={imageAlt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(min-width: 64rem) 48rem, 92vw"
            />
            {imageCredit && <figcaption class="na-credit">{imageCredit}</figcaption>}
          </figure>
        )}

        <footer class="na-foot">
          {linkedin && (
            <a href={linkedin} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              {t('notes.onLinkedin')}
              <ExternalLink size={18} aria-hidden="true" />
              <span class="sr-only">{t('a11y.externalLink')}</span>
            </a>
          )}
          <ShareButtons lang={lang} url={pageUrl} title={title} />
          <a href={journal} class="na-back na-back--end">
            <ArrowLeft size={18} class="flip-rtl" aria-hidden="true" />
            {t('notes.back')}
          </a>
        </footer>
      </div>
    </div>
  </article>

  {(welcomeExcerpt || others.length > 0) && (
    <section class="na-more" aria-labelledby="na-more-title">
      <div class="container-site">
        <h2 id="na-more-title" class="na-more__title">{t('notes.keepReading')}</h2>
        <ul class="na-more__list">
          {welcomeExcerpt && (
            <li>
              <a href={welcomeHref(lang)} class="na-card" data-reveal>
                <span class="na-card__label">{t('notes.pinned')}</span>
                <span class="na-card__title">{t('about.founderTitle')}</span>
                <span class="na-card__excerpt">{welcomeExcerpt}</span>
                <span class="na-card__go">
                  {t('notes.readWelcome')}
                  <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
                </span>
              </a>
            </li>
          )}
          {others.map((n) => {
            const v = noteView(n, lang);
            const f = v.foreign ? { lang: v.shownLang, dir: dirOf(v.shownLang) } : {};
            return (
              <li>
                <a href={noteHref(n, lang)} class="na-card" data-reveal>
                  <span class="na-card__label">{formatDate(n.data.date, lang)}</span>
                  <span class="na-card__title" {...f}>
                    {v.headline ?? t('notes.noteOf', { date: formatDate(n.data.date, lang) })}
                  </span>
                  <span class="na-card__excerpt" {...f}>
                    {v.excerpt}
                  </span>
                  <span class="na-card__go">
                    {t('notes.continue')}
                    <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .na-head {
    position: relative;
    overflow: hidden;
    background: var(--color-aube);
    border-block-end: 3px solid var(--color-primary);
  }
  .na-head::after {
    content: '';
    position: absolute;
    inset-block-end: -6rem;
    inset-inline-end: -4rem;
    width: clamp(10rem, 6rem + 14vw, 20rem);
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--color-soleil);
    opacity: 0.6;
    pointer-events: none;
  }
  .na-head__inner {
    position: relative;
    z-index: 1;
    padding-block: 2.25rem clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .na-head__inner > :not(nav) {
    max-width: 52rem;
  }
  .na-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.25s ease;
  }
  .na-back:hover {
    text-decoration-color: var(--color-gold);
  }
  .na-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brique-ink);
  }
  :global(html[lang='fa']) .na-label {
    letter-spacing: 0;
    font-size: 1rem;
  }
  .na-lang,
  .na-translation {
    margin-top: 1rem;
    font-style: italic;
    color: var(--color-ink);
  }
  .na-title {
    margin-top: 1.25rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.25rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 144;
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--color-primary);
    text-wrap: balance;
  }
  .na-title:lang(fa) {
    font-family: var(--font-editorial);
  }
  :global(html[lang='fa']) .na-title {
    font-weight: 800;
    font-variation-settings: normal;
    line-height: 1.4;
    letter-spacing: 0;
  }
  .na-head :global(.na-rule) {
    width: 10rem;
    margin-block: 1.5rem;
  }
  .na-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }
  .na-byline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .na-byline > span {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .na-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: cover;
    object-position: 50% 20%;
    box-shadow:
      0 0 0 3px var(--color-ivory),
      0 0 0 5px var(--color-soleil);
  }
  .na-byline__name {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-primary);
  }
  .na-byline__role {
    font-size: 0.92rem;
    color: var(--color-ink);
  }
  .na-meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  /* The reading column: about 68 characters, the text font the owner approved for his
     notes (rounded Nunito; Vazirmatn in Persian). */
  .na-body {
    background: var(--color-ivory);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .na-text {
    max-width: 68ch;
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.08rem + 0.3vw, 1.3rem);
    font-weight: 500;
    line-height: 1.85;
    color: var(--color-ink);
    white-space: pre-line;
  }
  .na-text > p + p {
    margin-top: 1.1em;
  }
  .na-text > p:first-child::first-line {
    font-weight: 700;
    color: var(--color-primary);
  }
  .na-question {
    margin-top: 1.75em !important;
    padding: 1.1rem 1.4rem;
    border-radius: 1.25rem;
    border-end-start-radius: 0.3rem;
    background: var(--color-aqua);
    color: var(--color-primary);
    font-weight: 700;
  }
  .na-figure {
    max-width: 48rem;
    margin: 2.5rem auto 0;
  }
  .na-figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
  }
  .na-credit {
    margin-top: 0.4rem;
    font-size: 0.8rem;
  }
  .na-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    max-width: 68ch;
    margin: 3rem auto 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }
  .na-back--end {
    margin-top: 0;
    margin-inline-start: auto;
  }

  .na-more {
    background: var(--color-sable);
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .na-more__title {
    font-family: var(--font-editorial);
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.3rem);
    font-weight: 700;
    font-variation-settings: 'SOFT' 100;
    color: var(--color-primary);
  }
  .na-more__list {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 52rem) {
    .na-more__list {
      grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    }
  }
  .na-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.75rem;
    border-radius: 1.25rem 1.25rem 1.25rem 3.5rem;
    border: 1px solid var(--color-card-edge);
    border-top: 5px solid var(--color-soleil);
    background: var(--color-ivory);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      translate 0.35s ease,
      box-shadow 0.35s ease;
  }
  :global([dir='rtl']) .na-card {
    border-radius: 1.25rem 1.25rem 3.5rem 1.25rem;
  }
  .na-more__list > li:nth-child(2) .na-card {
    border-top-color: var(--color-firouzeh);
  }
  .na-more__list > li:nth-child(3) .na-card {
    border-top-color: var(--color-brique);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .na-card:hover {
      translate: 0 -0.35rem;
      box-shadow: 0 1.5rem 2.75rem -1.5rem color-mix(in srgb, var(--color-primary) 35%, transparent);
    }
  }
  .na-card__label {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-brique-ink);
  }
  .na-card__title {
    font-family: var(--font-editorial);
    font-size: 1.4rem;
    font-weight: 700;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.25;
    color: var(--color-primary);
  }
  :global(html[lang='fa']) .na-card__title {
    font-weight: 800;
    font-variation-settings: normal;
    line-height: 1.5;
  }
  .na-card__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .na-card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-primary);
  }
  .na-card:hover .na-card__go {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 4px;
  }
</style>
