---
/**
 * Contact & Collaboration (owner's brief, Oct 24 2026: Get Involved merged here).
 * 1. Write to us: the smart contact form (individual or organization) beside the
 *    contact details, on a pale teal band. 2. Volunteer: the owner's invitation and a
 *    compact volunteer form under it (role cards removed, owner's brief Oct 27 2026). The "Three Ways to Connect" cards were removed
 *    (owner's brief, Oct 25 2026). The newsletter stays in the footer
 *    (#stay-connected). Old Get Involved addresses redirect here (netlify.toml); the
 *    anchors #interest, #benevolat and #volunteer still work.
 */
import { Clock, Mail, MapPin, Phone } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import teamCollabPhoto from '@/assets/photos/team-collaboration.jpg';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import MapFacade from '@/components/ui/MapFacade.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSettings, getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = await getSettings();
const collabHref = href('collaboration', lang);
// Each detail appears only once it is set in the site settings.
const a = s.address;
const address = a && `${a.street}, ${a.city} (${a.region}) ${a.postalCode}`;
const details = [
  a && {
    icon: MapPin,
    label: t('contact.address'),
    value: `${a.street}\n${a.city} (${a.region}) ${a.postalCode}`,
  },
  s.phone && {
    icon: Phone,
    label: t('contact.phone'),
    value: s.phone,
    href: `tel:${s.phone.replace(/[^\d+]/g, '')}`,
  },
  s.email && { icon: Mail, label: t('contact.email'), value: s.email, href: `mailto:${s.email}` },
  s.hours && { icon: Clock, label: t('contact.hours'), value: pick(s.hours, lang) },
  // The registered address is shown only on the Legal Information page.
  !a &&
    s.legal && {
      icon: MapPin,
      label: t('contact.registeredAddress'),
      value: t('contact.registeredAddressLink'),
      href: href('legalInfo', lang),
      local: true,
    },
].filter((d) => !!d) as {
  icon: typeof MapPin;
  label: string;
  value?: string;
  href?: string;
  local?: boolean;
}[];
---

<PageLayout
  accent="brique"
  lang={lang}
  title={t('contact.title')}
  lede={t('contact.lede')}
  ledeStrong
  alternates={siteAlternates('contact')}
>
  <!-- Write to us (#interest kept for older links to the expression-of-interest form) -->
  <div id="write" class="write-band scroll-mt-24 py-16 sm:py-20">
    <span id="interest" class="block scroll-mt-24" aria-hidden="true"></span>
    <div class="container-site grid gap-10 lg:grid-cols-[1.25fr_1fr]">
      <section class="card form-panel p-6 sm:p-10" aria-labelledby="form-title">
        <h2 id="form-title" class="mb-6 text-3xl font-bold">
          {t('contact.formTitle')}
        </h2>
        <ContactForm lang={lang} volunteerHref={`${collabHref}#${lang === 'fr' ? 'benevolat' : 'volunteer'}`} />
      </section>

      <div class="space-y-8">
        <section class="card info-panel p-8" aria-labelledby="info-title">
          <h2 id="info-title" class="mb-6 text-2xl font-bold">
            {t('contact.infoTitle')}
          </h2>
          {details.length > 0 && (
            <ul class="mb-8 space-y-5">
              {details.map((d) => (
                <li class="flex gap-4">
                  <d.icon size={22} class="mt-0.5 shrink-0 text-gold-dark" aria-hidden="true" />
                  <div>
                    <p class="text-sm font-bold tracking-wider text-muted uppercase">{d.label}</p>
                    {d.href ? (
                      <a
                        href={d.href}
                        class:list={['text-ink', d.local ? 'underline' : 'break-all']}
                        dir={d.local ? undefined : 'ltr'}
                      >
                        {d.value}
                      </a>
                    ) : (
                      <div class="whitespace-pre-line">{d.value}</div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
          <h3 class="mb-3 font-sans text-sm font-bold tracking-wider text-muted uppercase">
            {t('contact.follow')}
          </h3>
          <SocialLinks lang={lang} social={s.social} />
        </section>

        {/* The owner's photo replaces the community illustration (owner, Oct 31 2026),
            in an arch with a saffron sun behind it. Illustrative photo: alt="". */}
        <figure class="contact-art">
          <span class="contact-art__block" aria-hidden="true"></span>
          <Image
            src={teamCollabPhoto}
            alt=""
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 30rem, 90vw"
            class="contact-art__img"
          />
        </figure>

        {address && (
          <section aria-labelledby="map-title">
            <h2 id="map-title" class="sr-only">
              {t('contact.mapTitle')}
            </h2>
            <MapFacade lang={lang} address={address} />
          </section>
        )}
      </div>
    </div>
  </div>

  {/* Membership, volunteering and the Advisory Circle moved to the Collaboration page
     (owner's request, Oct 31 2026); old links to their anchors are sent there. */}
</PageLayout>

<script define:vars={{ collabHref }}>
  // Old links to Contact sections that moved to Collaboration (Oct 31 2026).
  const moved = ['adhesion', 'membership', 'benevolat', 'volunteer', 'conseillers', 'advisory-circle'];
  const id = location.hash.slice(1);
  if (moved.includes(id)) location.replace(collabHref + location.search + '#' + id);
</script>

<style>
  /* Colourful page (owner, Oct 31 2026: « like the other pages, no white »): each band
     has its own pale ground, each panel a contrasting tint; inputs stay white so the
     fields read clearly. Text navy or ink on every tint (8:1 or more); white on encre. */
  .write-band {
    background: color-mix(in srgb, var(--matin-soleil) 24%, var(--matin-ivoire));
  }
  .form-panel:not(#o) {
    border: none;
    border-block-start: 8px solid var(--matin-firouzeh-ink);
    border-start-end-radius: 5rem;
    background: color-mix(in srgb, var(--matin-firouzeh) 26%, var(--matin-ivoire));
  }
  .info-panel:not(#o) {
    border: none;
    border-block-start: 8px solid var(--matin-soleil);
    border-end-end-radius: 4rem;
    background: var(--matin-encre);
    color: var(--color-white);
  }
  .info-panel :is(h2, h3, p, a, div):not(#o) {
    color: var(--color-white);
  }
  .info-panel :global(svg.text-gold-dark) {
    color: var(--matin-soleil);
  }
  .info-panel a:not(#o):focus-visible {
    outline-color: var(--matin-soleil);
  }
  .contact-art {
    position: relative;
    max-width: 30rem;
    margin-inline: auto;
    padding: 1.25rem 1.25rem 0 0;
  }
  .contact-art :global(.contact-art__img) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14rem 14rem 1.5rem 1.5rem;
    border: 8px solid var(--matin-ivoire);
    box-shadow: 0 24px 40px -26px color-mix(in srgb, var(--matin-encre) 70%, transparent);
  }
  .contact-art__block {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: 45%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--matin-brique);
  }
  .membership-band {
    background: color-mix(in srgb, var(--matin-brique) 16%, var(--matin-ivoire));
  }
  .membership-fee {
    margin-block: -0.5rem 1.5rem;
    display: inline-block;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    background: var(--matin-ivoire);
    font-weight: 800;
    color: var(--matin-brique-ink);
  }
  .form-panel--membership:not(#o) {
    max-width: 60rem;
    border-block-start-color: var(--matin-brique-ink);
    border-start-end-radius: 6rem;
    background: color-mix(in srgb, var(--matin-soleil) 34%, var(--matin-ivoire));
  }
  .volunteer-band {
    background: color-mix(in srgb, var(--matin-firouzeh) 18%, var(--matin-ivoire));
  }
  .careers-note {
    margin-block-start: 1.5rem;
    font-size: 1.05rem;
  }
  .careers-note a {
    font-weight: 700;
  }
  .form-panel--volunteer:not(#o) {
    max-width: 60rem;
    border-block-start-color: var(--matin-soleil);
    border-start-end-radius: 6rem;
    background: color-mix(in srgb, var(--matin-brique) 22%, var(--matin-ivoire));
  }
  .advisors-band {
    background: color-mix(in srgb, var(--matin-encre) 10%, var(--matin-ivoire));
  }
  .adv-steps {
    display: grid;
    gap: 1rem;
    margin-block: 0 2.5rem;
    max-width: 72rem;
  }
  @media (min-width: 56rem) {
    .adv-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .adv-step {
    position: relative;
    padding: 1.4rem 1.5rem 1.5rem;
    border-radius: 1rem;
    border-start-end-radius: 2.75rem;
    background: var(--matin-encre);
    color: var(--color-white);
  }
  .adv-step:nth-child(2) {
    background: var(--matin-firouzeh-ink);
  }
  .adv-step:nth-child(3) {
    background: var(--matin-brique-ink);
  }
  .adv-step__n {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-block-end: 0.75rem;
    border-radius: 50%;
    background: var(--matin-soleil);
    color: var(--matin-encre);
    font-family: var(--font-display);
    font-weight: 800;
  }
  .adv-step__title:not(#o) {
    margin-block-end: 0.35rem;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-white);
  }
  .adv-step p {
    line-height: 1.6;
  }
  .form-panel--advisors:not(#o) {
    max-width: 60rem;
    border-block-start-color: var(--matin-encre);
    border-start-end-radius: 6rem;
    background: color-mix(in srgb, var(--matin-firouzeh) 20%, var(--matin-ivoire));
  }
</style>
