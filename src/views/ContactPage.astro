---
/**
 * Contact & Collaboration (owner's brief, Oct 24 2026: Get Involved merged here).
 * 1. Write to us: the smart contact form (individual or organization) beside the
 *    contact details, on a pale teal band. 2. Volunteer: the owner's invitation and a
 *    compact volunteer form under it (role cards removed, owner's brief Oct 27 2026). The "Three Ways to Connect" cards were removed
 *    (owner's brief, Oct 25 2026). The newsletter stays in the footer
 *    (#stay-connected). Old Get Involved addresses redirect here (netlify.toml); the
 *    anchors #interest, #benevolat and #volunteer still work.
 */
import { Clock, Mail, MapPin, Phone } from '@lucide/astro';
import PageLayout from '@/layouts/PageLayout.astro';
import CommunityIllustration from '@/components/brand/CommunityIllustration.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import VolunteerForm from '@/components/forms/VolunteerForm.astro';
import MapFacade from '@/components/ui/MapFacade.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { href, siteAlternates, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSettings, getSingleton } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = await getSettings();
const inv = await getSingleton('involvement');
// The volunteer form exists in all three languages.
const hasVolunteer = true;
const volunteerId = lang === 'fr' ? 'benevolat' : 'volunteer';
// Each detail appears only once it is set in the site settings.
const a = s.address;
const address = a && `${a.street}, ${a.city} (${a.region}) ${a.postalCode}`;
const details = [
  a && {
    icon: MapPin,
    label: t('contact.address'),
    value: `${a.street}\n${a.city} (${a.region}) ${a.postalCode}`,
  },
  s.phone && {
    icon: Phone,
    label: t('contact.phone'),
    value: s.phone,
    href: `tel:${s.phone.replace(/[^\d+]/g, '')}`,
  },
  s.email && { icon: Mail, label: t('contact.email'), value: s.email, href: `mailto:${s.email}` },
  s.hours && { icon: Clock, label: t('contact.hours'), value: pick(s.hours, lang) },
  // The registered address is shown only on the Legal Information page.
  !a &&
    s.legal && {
      icon: MapPin,
      label: t('contact.registeredAddress'),
      value: t('contact.registeredAddressLink'),
      href: href('legalInfo', lang),
      local: true,
    },
].filter((d) => !!d) as {
  icon: typeof MapPin;
  label: string;
  value?: string;
  href?: string;
  local?: boolean;
}[];
---

<PageLayout
  accent="brique"
  lang={lang}
  title={t('contact.title')}
  lede={t('contact.lede')}
  ledeStrong
  alternates={siteAlternates('contact')}
>
  <!-- Write to us (#interest kept for older links to the expression-of-interest form) -->
  <div id="write" class="write-band scroll-mt-24 py-16 sm:py-20">
    <span id="interest" class="block scroll-mt-24" aria-hidden="true"></span>
    <div class="container-site grid gap-10 lg:grid-cols-[1.25fr_1fr]">
      <section class="card form-panel p-6 sm:p-10" aria-labelledby="form-title">
        <h2 id="form-title" class="mb-6 text-3xl font-bold">
          {t('contact.formTitle')}
        </h2>
        <ContactForm lang={lang} volunteerHref={hasVolunteer ? `#${volunteerId}` : undefined} />
      </section>

      <div class="space-y-8">
        <section class="card info-panel p-8" aria-labelledby="info-title">
          <h2 id="info-title" class="mb-6 text-2xl font-bold">
            {t('contact.infoTitle')}
          </h2>
          {details.length > 0 && (
            <ul class="mb-8 space-y-5">
              {details.map((d) => (
                <li class="flex gap-4">
                  <d.icon size={22} class="mt-0.5 shrink-0 text-gold-dark" aria-hidden="true" />
                  <div>
                    <p class="text-sm font-bold tracking-wider text-muted uppercase">{d.label}</p>
                    {d.href ? (
                      <a
                        href={d.href}
                        class:list={['text-ink', d.local ? 'underline' : 'break-all']}
                        dir={d.local ? undefined : 'ltr'}
                      >
                        {d.value}
                      </a>
                    ) : (
                      <div class="whitespace-pre-line">{d.value}</div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
          <h3 class="mb-3 font-sans text-sm font-bold tracking-wider text-muted uppercase">
            {t('contact.follow')}
          </h3>
          <SocialLinks lang={lang} social={s.social} />
        </section>

        {/* The illustration of the former homepage Get Involved band (owner's brief,
            Oct 25 2026), with its mustard block. */}
        <figure class="contact-art" aria-hidden="true">
          <CommunityIllustration class="contact-art__img" />
          <span class="contact-art__block"></span>
        </figure>

        {address && (
          <section aria-labelledby="map-title">
            <h2 id="map-title" class="sr-only">
              {t('contact.mapTitle')}
            </h2>
            <MapFacade lang={lang} address={address} />
          </section>
        )}
      </div>
    </div>
  </div>

  {hasVolunteer && (
    <section
      id={volunteerId}
      class="volunteer-band scroll-mt-24 py-16 sm:py-20"
      aria-labelledby="volunteer-title"
    >
      <div class="container-site">
        <SectionHeader
          align="start"
          id="volunteer-title"
          title={t('involved.volunteerTitle')}
          subtitle={inv.volunteerIntro && pick(inv.volunteerIntro, lang)}
        />
        <!-- A short, compact form right under the invitation (owner's brief, Oct 27 2026). -->
        <div class="card form-panel form-panel--volunteer p-6 sm:p-10">
          <VolunteerForm lang={lang} />
        </div>
        <p class="careers-note">
          {t('contact.careersNote')} <a href={href('careers', lang)}>{t('contact.careersLink')}</a>
        </p>
        <p class="careers-note">
          {t('contact.membershipNote')}{' '}
          <a href={href('membership', lang)}>{t('contact.membershipLink')}</a>
        </p>
      </div>
    </section>
  )}
</PageLayout>

<style>
  /* Scheme A (Oct 29 2026): a sand ground, panels with one deep corner each (less boxed,
     owner's request), mirrored in Persian. Text stays navy or ink (10:1 or more). */
  .write-band {
    background: var(--color-sable);
  }
  .form-panel {
    background: var(--color-ivory);
    border-block-start: 6px solid var(--color-gold);
    border-start-end-radius: 5rem;
  }
  .info-panel {
    background: var(--color-white);
    border-block-start: 6px solid var(--color-teal);
    border-end-end-radius: 4rem;
  }
  .contact-art {
    position: relative;
    max-width: 30rem;
    margin-inline: auto;
    padding-block-end: 1rem;
  }
  .contact-art :global(.contact-art__img) {
    position: relative;
    z-index: 1;
  }
  .contact-art__block {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: -1rem;
    width: 50%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-gold);
  }
  .volunteer-band {
    background: var(--color-paper);
  }
  .careers-note {
    margin-block-start: 1.5rem;
    font-size: 1.05rem;
  }
  .careers-note a {
    font-weight: 700;
  }
  .form-panel--volunteer {
    max-width: 60rem;
    border: 1px solid var(--color-teal-edge);
    border-block-start: 6px solid var(--color-teal);
    border-start-end-radius: 6rem;
  }
</style>
