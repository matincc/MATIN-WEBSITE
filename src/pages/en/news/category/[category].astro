---
import type { GetStaticPaths } from 'astro';
import NewsListPage from '@/views/NewsListPage.astro';
import { categoriesOf, getNews, newsListKeys } from '@/lib/content';
import { categorySlugs } from '@/i18n/routes';

// The three headings always get a page; other categories once they have an article.
export const getStaticPaths = (async () => {
  const posts = await getNews();
  return newsListKeys(posts).map((category) => ({
    params: { category: categorySlugs[category].en },
    props: {
      category,
      posts: posts.filter((p) => categoriesOf(category).includes(p.data.category)),
    },
  }));
}) satisfies GetStaticPaths;
---

<NewsListPage lang="en" {...Astro.props} />
