---
import type { GetStaticPaths } from 'astro';
import NewsListPage from '@/views/NewsListPage.astro';
import { getNews, newsCategories } from '@/lib/content';
import { categorySlugs } from '@/i18n/routes';

// Only categories that have at least one published article get a page.
export const getStaticPaths = (async () => {
  const posts = await getNews();
  return newsCategories(posts).map((category) => ({
    params: { category: categorySlugs[category].en },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}) satisfies GetStaticPaths;
---

<NewsListPage lang="en" {...Astro.props} />
