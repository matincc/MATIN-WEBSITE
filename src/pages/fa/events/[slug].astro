---
import type { GetStaticPaths } from 'astro';
import EventDetailPage from '@/views/EventDetailPage.astro';
import { getEvents, slugOf } from '@/lib/content';

// Same events as the English pages, at the English slug.
export const getStaticPaths = (async () =>
  (await getEvents()).map((event) => ({
    params: { slug: slugOf(event, 'en') },
    props: { event },
  }))) satisfies GetStaticPaths;

const { event } = Astro.props;
---

<EventDetailPage lang="fa" event={event} />
