---
import type { GetStaticPaths } from 'astro';
import ArticlePage from '@/views/ArticlePage.astro';
import { getNews, slugOf } from '@/lib/content';

// Same articles as the English pages, at the English slug.
export const getStaticPaths = (async () =>
  (await getNews()).map((post) => ({
    params: { slug: slugOf(post, 'en') },
    props: { post },
  }))) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<ArticlePage lang="fa" post={post} />
