---
/** Thin gold line on each side of a small gold maple leaf — echoes the logo. Decorative. */
import MapleLeaf from './MapleLeaf.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['leaf-rule', className]} aria-hidden="true">
  <span></span>
  <MapleLeaf size={16} />
  <span></span>
</div>

<style>
  .leaf-rule {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 18rem;
    color: var(--color-gold);
  }
  .leaf-rule span {
    flex: 1;
    height: 1.5px;
    background: currentColor;
  }
  /* On terracotta and teal bands the leaf and lines are cream (decorative). */
  :global(.on-terracotta) .leaf-rule,
  :global(.on-teal) .leaf-rule {
    color: var(--color-cream);
  }
</style>
