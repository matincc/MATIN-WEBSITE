---
/**
 * Cover for a Matin News item without a photo (owner's request, Oct 29 2026, replacing the
 * circle motif): the round sun logo from the header rising gently over a dawn ground, with
 * « Matin News » under it in the three languages, the page's language first. Decorative:
 * the card's title carries the meaning. The logo floats and a ring of saffron rays turns slowly around it (owner, Oct 31 2026: larger and in motion until Matin News opens); all still under reduced motion.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo-matin.png';
import type { UiLang } from '@/i18n/routes';

interface Props {
  lang: UiLang;
  class?: string;
}
const { lang, class: className } = Astro.props;
const labels: { lang: UiLang; text: string }[] = [
  { lang: 'fr', text: 'Nouvelles de Matin' },
  { lang: 'en', text: 'Matin News' },
  { lang: 'fa', text: 'اخبار متین' },
];
const ordered = [
  ...labels.filter((l) => l.lang === lang),
  ...labels.filter((l) => l.lang !== lang),
];
---

<div class:list={['mnews-art', className]} aria-hidden="true">
  <div class="mnews-art__stack">
    <span class="mnews-art__mark">
      <span class="mnews-art__sun"></span>
      <span class="mnews-art__rays"></span>
      <Image src={logo} alt="" width={176} class="mnews-art__logo" loading="lazy" />
    </span>
    <span class="mnews-art__horizon"></span>
    <p class="mnews-art__labels">
      {ordered.map((l, i) => (
        <span
          lang={l.lang}
          dir={l.lang === 'fa' ? 'rtl' : 'ltr'}
          class:list={['mnews-art__label', i === 0 && 'mnews-art__label--main']}
        >
          {l.text}
        </span>
      ))}
    </p>
  </div>
</div>

<style>
  /* Doubled class: card image rules (e.g. .post__img) must not undo the centring. */
  .mnews-art.mnews-art {
    position: relative;
    display: grid !important;
    place-items: center;
    overflow: hidden;
    width: 100%;
    height: 100%;
    min-height: 14rem;
    background: var(--matin-aube);
    /* The logo scales with the card (owner, Oct 31 2026: larger, until Matin News opens). */
    container-type: inline-size;
  }
  /* The logo on the sun rising behind it, over a short gold horizon. */
  .mnews-art__mark {
    position: relative;
    display: grid;
    place-items: center;
  }
  .mnews-art__sun {
    position: absolute;
    width: 150%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--matin-soleil) 45%, var(--matin-ivoire));
    translate: 0 12%;
  }
  /* A ring of short saffron rays around the logo, turning slowly. */
  .mnews-art__rays {
    position: absolute;
    width: 128%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-conic-gradient(
      var(--matin-soleil) 0deg 4deg,
      transparent 4deg 15deg
    );
    -webkit-mask: radial-gradient(circle, transparent 0 60%, #000 61% 70%, transparent 71%);
    mask: radial-gradient(circle, transparent 0 60%, #000 61% 70%, transparent 71%);
    opacity: 0.75;
  }
  .mnews-art__horizon {
    position: relative;
    width: min(20rem, 80%);
    height: 2px;
    margin-block: 0.15rem 0.2rem;
    background: var(--matin-soleil);
  }
  .mnews-art__stack {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding: 2.25rem 1.25rem 1.25rem;
    text-align: center;
  }
  .mnews-art__logo {
    position: relative;
    width: clamp(5.5rem, 31cqi, 14rem);
    height: auto;
    border-radius: 50%;
    background: var(--matin-white);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--matin-white) 70%, transparent);
  }
  .mnews-art__labels {
    position: relative;
    display: grid;
    gap: 0.1rem;
    margin: 0;
  }
  .mnews-art__label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--matin-encre);
  }
  .mnews-art__label--main {
    font-size: clamp(1.15rem, 5cqi, 1.6rem);
    font-weight: 800;
    color: var(--matin-brique-ink);
  }
  /* Small cards (phones): a more compact stack so the three labels fit. */
  @media (max-width: 40rem) {
    .mnews-art__stack {
      gap: 0.5rem;
      padding: 1.5rem 0.75rem 0.75rem;
    }
    .mnews-art__logo {
      width: clamp(5rem, 26cqi, 7rem);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--matin-white) 70%, transparent);
    }
    .mnews-art__label {
      font-size: 0.75rem;
    }
    .mnews-art__label--main {
      font-size: 0.95rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .mnews-art__logo {
      animation: mnews-float 5s ease-in-out infinite;
    }
    .mnews-art__rays {
      animation: mnews-turn 40s linear infinite;
    }
    .mnews-art__sun {
      animation:
        mnews-rise 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both,
        mnews-glow 7s ease-in-out 2.4s infinite;
    }
  }
  @keyframes mnews-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(-5deg) scale(1.03);
    }
  }
  @keyframes mnews-turn {
    to {
      rotate: 1turn;
    }
  }
  @keyframes mnews-rise {
    from {
      translate: 0 45%;
      opacity: 0.4;
    }
  }
  @keyframes mnews-glow {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.06;
    }
  }
</style>
