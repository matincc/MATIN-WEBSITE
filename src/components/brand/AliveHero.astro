---
/**
 * Homepage hero (owner's hero brief, Oct 29 2026, replacing the deep-green panel of the
 * "Matin Alive" hero of Oct 27): one full-width documentary photo of Montréal's public
 * life with the text set straight on it, editorial style, no card or panel. The photo
 * keeps its natural, bright colours everywhere (owner's request, Oct 29 2026: no grey or
 * navy wash, no halo, no filter); only a soft glow hugging the letters keeps them readable.
 * Text in bold brick and both buttons in navy, with a larger slanted gold pen stroke under
 * the headline (owner's request, Oct 29 2026, replacing the white text).
 *
 * Wide screens: the text sits on the right in every language, over the sky and the
 * trees, so the monument column (left of centre) and the crowd's faces stay visible
 * (owner's rule, Oct 27 2026). Below 64rem the photo sits on top and the text follows on
 * the warm-white page.
 *
 * Motion: the text rises in once and the photo zooms in very slowly, once. Nothing moves
 * under prefers-reduced-motion. No script.
 */
import Scribble from '@/components/ui/Scribble.astro';
import '@fontsource/playfair-display/800-italic.css';
import { Picture } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import PhotoCredit from '@/components/media/PhotoCredit.astro';
import { baseLang, href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { aliveStrings } from '@/i18n/alive';
import { heroPhoto } from '@/lib/heroMedia';
import { forLang, getUpcomingEvents, isMatinEvent, slugOf } from '@/lib/content';
import { dateBadge } from '@/lib/dates';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = aliveStrings(lang);
// Owner's request (Oct 30 2026): while Matin has an upcoming activity, the second button
// leads straight to it (its « Je participe » form); otherwise to the volunteer form.
const next = forLang(await getUpcomingEvents(), lang).find(
  (e) => isMatinEvent(e) && e.data.status !== 'cancelled',
);
const nextBadge = next && dateBadge(next.startDate, lang, next.data.timeZone);
const secondary = next
  ? {
      href: `${href('events', lang, slugOf(next, baseLang(lang)))}#rsvp-title`,
      label: a.heroCtaNext.replace('{date}', `${nextBadge!.day} ${nextBadge!.month}`),
    }
  : {
      href: `${href('contact', lang)}#${lang === 'fr' ? 'benevolat' : 'volunteer'}`,
      label: a.heroCtaSecondary,
    };
---

<section class="ahero" aria-labelledby="hero-title">
  <div class="ahero__media" aria-hidden="true">
    <Picture
      src={heroPhoto.src}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="container-site ahero__inner">
    <div class="ahero__copy">
      <p class="ahero__place">{a.heroPlace}</p>
      <h1 id="hero-title" class="ahero__title">
        {/* The institute's name stays in the page's main heading for search engines and
            screen readers; the logo above already shows it. */}
        <span class="sr-only">
          {t('home.heroEyebrow')}
          {lang === 'fr' ? ' : ' : ': '}
        </span>
        <span class="ahero__tagline">{t('home.heroTitle')}</span>
      </h1>
      <Scribble class="ahero__scribble scribble--load" />
      <p class="ahero__line">{a.heroLine}</p>
      <div class="ahero__actions">
        <a href="#action" class="ahero__btn ahero__btn--primary">
          {a.heroCtaPrimary}
          <ArrowRight size={18} class="flip-rtl ahero__arrow" aria-hidden="true" />
        </a>
        {/* The next Matin activity, else the volunteer form (Oct 28 and Oct 30 2026). */}
        <a href={secondary.href} class="ahero__btn ahero__btn--ghost">
          {secondary.label}
        </a>
      </div>
    </div>
  </div>

  <div class="container-site ahero__foot">
    <PhotoCredit credit={heroPhoto.credit} />
  </div>
</section>

<style>
  .ahero {
    /* A soft light glow hugging each brick letter only: the photo itself is never shaded,
       filtered or tinted (owner, Oct 29 2026). */
    --glow: color-mix(in srgb, var(--matin-ivoire) 85%, transparent);
    --halo:
      1.5px 0 0 var(--matin-ivoire), -1.5px 0 0 var(--matin-ivoire), 0 1.5px 0 var(--matin-ivoire),
      0 -1.5px 0 var(--matin-ivoire), 1px 1px 0 var(--matin-ivoire),
      -1px -1px 0 var(--matin-ivoire), 1px -1px 0 var(--matin-ivoire),
      -1px 1px 0 var(--matin-ivoire), 0 0 6px var(--matin-ivoire), 0 0 14px var(--glow),
      0 0 28px var(--glow);
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: clamp(38rem, calc(100svh - 9rem), 52rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--matin-paper);
    color: var(--matin-blue);
  }

  /* ---------- The photo ---------- */
  .ahero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .ahero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, 50% 70%);
    transform-origin: 30% 60%;
  }
  /* An almost imperceptible push-in, once (none under reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    .ahero__media :global(img) {
      animation: ahero-zoom 32s cubic-bezier(0.25, 0.1, 0.25, 1) both;
    }
  }
  @keyframes ahero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }

  /* ---------- The text, straight on the photo ---------- */
  .ahero__inner {
    display: flex;
    align-items: flex-start;
    /* Physical right in every language, away from the monument and the faces. */
    justify-content: flex-end;
    padding-block: clamp(2.5rem, 6vh, 4.5rem) 1rem;
  }
  :global([dir='rtl']) .ahero__inner {
    justify-content: flex-start;
  }
  .ahero__copy {
    position: relative;
    max-width: min(40rem, 48%);
    text-shadow:
      0 0 3px var(--glow),
      0 0 10px var(--glow),
      0 0 26px var(--glow);
  }
  .ahero__place {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 0.8rem + 0.25vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* Brick with a thick ivory halo hugging the letters, so it reads over the leaves
       (owner, Oct 29 2026). The photo itself is untouched. */
    color: var(--matin-encre);
    text-shadow: var(--halo);
  }
  .ahero__place::before {
    content: '';
    width: 2.25rem;
    height: 2px;
    background: var(--alive-gold);
  }
  :global(html[lang='fa']) .ahero__place {
    letter-spacing: 0;
    font-size: 1.25rem;
  }
  .ahero__title {
    margin-block-start: 1.1rem;
  }
  /* The headline: the logo's serif, large and italic. */
  .ahero__tagline {
    display: block;
    font-family: var(--font-brand);
    font-style: italic;
    font-weight: 800;
    font-size: clamp(3.1rem, 1.6rem + 5vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--matin-encre);
    text-wrap: balance;
  }
  :global(html[lang='fa']) .ahero__tagline {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0;
    font-size: clamp(2.7rem, 1.6rem + 4vw, 5.25rem);
  }
  /* Hand-drawn underline under the headline (owner's request, Oct 28 2026), larger and
     slanted like a ballpoint stroke since Oct 29 2026. */
  .ahero__copy :global(.ahero__scribble) {
    width: min(28rem, 92%);
    height: 1.4rem;
    margin-block: 0.4rem 0.4rem;
    margin-inline-start: 0.5rem;
    rotate: -3.5deg;
  }
  :global([dir='rtl']) .ahero__copy :global(.ahero__scribble) {
    rotate: 3.5deg;
  }
  .ahero__copy :global(.ahero__scribble path) {
    stroke: var(--matin-soleil);
    stroke-width: 4.5;
  }
  .ahero__copy :global(.ahero__scribble .scribble__second) {
    stroke-width: 3;
  }
  .ahero__line {
    max-width: 34rem;
    margin-block-start: 0.9rem;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 800;
    line-height: 1.45;
    /* Dark blue (owner, Oct 30 2026; brick before) with a thick ivory halo hugging the
       letters, so it reads over the leaves. The photo itself is untouched. */
    color: var(--matin-encre);
    text-shadow: var(--halo);
  }

  /* ---------- Two quiet buttons ---------- */
  .ahero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    margin-block-start: 2rem;
    text-shadow: none;
  }
  .ahero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      background-color 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease,
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ahero__btn--primary {
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    background: var(--matin-brique-ink);
    color: var(--matin-white);
  }
  .ahero__btn--primary:hover {
    background: var(--alive-gold);
    color: var(--matin-encre);
    transform: translateY(-2px);
  }
  .ahero__btn :global(.ahero__arrow) {
    transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ahero__btn--primary:hover :global(.ahero__arrow) {
    translate: 4px 0;
  }
  :global([dir='rtl']) .ahero__btn--primary:hover :global(.ahero__arrow) {
    translate: -4px 0;
  }
  /* The second action reads as a link with a gold rule that fills in on hover. */
  .ahero__btn--ghost {
    padding-block: 0.4rem;
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    background: var(--matin-brique-ink);
    color: var(--matin-white);
    text-shadow: none;
  }
  .ahero__btn--ghost:hover {
    background: var(--alive-gold);
    color: var(--matin-blue);
    transform: translateY(-2px);
  }
  .ahero__btn:focus-visible {
    outline: 3px solid var(--alive-gold);
    outline-offset: 4px;
  }

  /* The text rises in once, one line after the other. */
  @media (prefers-reduced-motion: no-preference) {
    .ahero__copy > * {
      animation: ahero-rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .ahero__copy > :nth-child(2) {
      animation-delay: 0.15s;
    }
    .ahero__copy > :nth-child(3) {
      animation-delay: 0.25s;
    }
    .ahero__copy > :nth-child(4) {
      animation-delay: 0.35s;
    }
    .ahero__copy > :nth-child(5) {
      animation-delay: 0.5s;
    }
  }
  @keyframes ahero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* ---------- Photo credit ---------- */
  .ahero__foot {
    padding-block-end: 0.9rem;
  }
  .ahero__foot :global(.photo-credit) {
    display: inline-flex;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--matin-ink) 55%, transparent);
    color: var(--matin-white);
    font-size: 0.75rem;
  }
  .ahero__foot :global(.photo-credit a) {
    color: inherit;
  }

  /* ---------- Phones and tablets: the photo on top, fading into navy ---------- */
  @media (max-width: 63.99rem) {
    .ahero {
      min-height: 0;
      grid-template-rows: auto auto auto;
    }
    .ahero__media {
      position: relative;
      grid-row: 1;
      height: clamp(17rem, 52svh, 30rem);
      z-index: 0;
    }
    .ahero__media :global(img) {
      object-position: 30% 65%;
    }
    .ahero__copy,
    .ahero__btn--ghost {
      text-shadow: none;
    }
    /* On the page under the photo: brick, no halo. */
    .ahero__place,
    .ahero__line {
      text-shadow: none;
    }
    .ahero__place,
    .ahero__line {
      color: var(--matin-encre);
    }
    .ahero__inner {
      grid-row: 2;
      position: relative;
      z-index: 1;
      padding-block: 1.75rem 2rem;
    }
    .ahero__copy {
      max-width: 40rem;
    }
    .ahero__foot {
      grid-row: 3;
      padding-block: 0 1rem;
    }
  }
</style>
