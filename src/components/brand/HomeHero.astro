---
/**
 * Homepage hero: an editorial split. A deep navy panel carries the institute's name,
 * the tagline in mustard italic, the paragraph and the two main calls to action; the
 * Montréal skyline photo fills the other side to the edge of the screen. Two overlapping
 * circular photos of people (the dialogue motif) sit on the seam between the two.
 * On phones the photo sits above the panel and the circles overlap its lower edge.
 * The text is always on solid navy, so it never depends on the photo for contrast.
 * The circle photos are illustrative (credited), not pictures of Matin activities.
 */
import '@fontsource/playfair-display/700-italic.css';
import { Picture } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import banner from '@/assets/home/hero-banner.jpg';
import PhotoCredit from '@/components/media/PhotoCredit.astro';
import { href, type UiLang } from '@/i18n/routes';
import { photos } from '@/lib/photos';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={banner}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 64rem) 55vw, 100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero__collage" aria-hidden="true">
    <span class="hero__circle hero__circle--a">
      <Picture
        src={photos.dancecircle.src}
        alt=""
        formats={['avif', 'webp']}
        widths={[240, 400, 560]}
        sizes="(min-width: 64rem) 19rem, 9rem"
        style={`object-position:${photos.dancecircle.focus}`}
      />
    </span>
    <span class="hero__circle hero__circle--b">
      <Picture
        src={photos.folkdance.src}
        alt=""
        formats={['avif', 'webp']}
        widths={[200, 320, 400]}
        sizes="(min-width: 64rem) 13rem, 6.5rem"
        style={`object-position:${photos.folkdance.focus}`}
      />
    </span>
  </div>
  <div class="hero__credit">
    <PhotoCredit credits={[photos.dancecircle.credit, photos.folkdance.credit]} variant="overlay" />
  </div>
  <div class="hero__panel on-dark">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        {t('home.heroEyebrow')}
      </h1>
      <p class="hero__tagline">{t('home.heroTitle')}</p>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__paragraph">{t('home.heroText')}</p>
      <div class="hero__actions">
        <a href={href('getInvolved', lang)} class="btn btn-primary">
          {t('home.involvedPrimary')}
          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
        </a>
        <a href={href('events', lang)} class="btn btn-outline">
          {t('home.eventsAll')}
        </a>
      </div>
    </div>
    <div class="mosaic hero__mosaic" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    isolation: isolate;
    background: var(--color-primary);
  }

  /* Phones and tablets: photo band on top, panel below. */
  .hero__media {
    position: relative;
    height: clamp(13rem, 52vw, 26rem);
    overflow: hidden;
  }
  .hero__media :global(picture),
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__media :global(img) {
    object-fit: cover;
    object-position: 50% 88%;
    /* Very slow zoom so the city feels alive (stops with reduced motion). */
    animation: hero-drift 28s ease-in-out infinite alternate;
    transform-origin: 50% 88%;
  }
  @keyframes hero-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  .hero__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) clamp(1.25rem, 0.5rem + 3vw, 3rem);
    background: var(--color-primary);
    color: var(--color-cream);
  }
  /* Two overlapping circles of people: cultures meeting. */
  .hero__collage {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    margin-block-start: -4.5rem;
    padding-inline: clamp(1.25rem, 0.5rem + 3vw, 3rem);
    pointer-events: none;
  }
  .hero__circle {
    display: block;
    overflow: hidden;
    border-radius: 50%;
    border: 5px solid var(--color-paper);
  }
  .hero__circle :global(picture),
  .hero__circle :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__circle--a {
    width: 9rem;
    height: 9rem;
    border-color: var(--color-coral);
  }
  .hero__circle--b {
    width: 6.5rem;
    height: 6.5rem;
    margin-inline-start: -1.75rem;
    margin-block-end: 3.25rem;
    border-color: var(--color-gold);
  }
  /* Credit chip for the circle photos: top corner of the photo band. */
  .hero__credit {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    z-index: 2;
    width: 100%;
    height: 3rem;
  }
  .hero__credit :global(.photo-credit--overlay) {
    inset-block: 0.6rem auto;
  }
  .hero__mosaic {
    position: absolute;
    inset-inline: clamp(1.25rem, 0.5rem + 3vw, 3rem);
    inset-block-end: 1.5rem;
    max-width: 16rem;
  }

  /* Desktop: navy panel on the reading side (start), photo to the far edge. */
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      min-height: clamp(36rem, 26rem + 20vw, 46rem);
    }
    .hero__media {
      grid-column: 2;
      grid-row: 1;
      height: auto;
    }
    /* The panel is about 46% of the screen: size the name to it so the longest word
       ("Intercultural", "interculturel") always fits on one line. */
    .hero .hero__title {
      font-size: min(5.5rem, 4.6vw);
    }
    .hero__panel {
      grid-column: 1;
      grid-row: 1;
      padding-inline: max(3rem, calc((100vw - 90rem) / 2 + 3rem)) 3.5rem;
      padding-block: 5rem 6rem;
    }
    .hero__mosaic {
      inset-inline-start: max(3rem, calc((100vw - 90rem) / 2 + 3rem));
      inset-block-end: 2.75rem;
    }
    /* Circles straddle the seam between panel and photo, near the bottom. */
    .hero__collage {
      position: absolute;
      inset-block-end: clamp(2rem, 1rem + 2vw, 3.5rem);
      inset-inline-start: calc(46% - clamp(2rem, 1rem + 1.5vw, 3rem));
      margin: 0;
      padding: 0;
      justify-content: flex-start;
    }
    .hero__circle--a {
      width: clamp(12rem, 5rem + 11vw, 19rem);
      height: clamp(12rem, 5rem + 11vw, 19rem);
      border-width: 7px;
    }
    .hero__circle--b {
      width: clamp(8rem, 3rem + 7vw, 13rem);
      height: clamp(8rem, 3rem + 7vw, 13rem);
      margin-inline-start: -2.75rem;
      margin-block-end: 5.5rem;
      border-width: 7px;
    }
    .hero__credit {
      inset-inline-start: 46%;
      width: auto;
    }
  }

  /* Name, tagline, line, paragraph and buttons rise in one after the other. */
  .hero__text > * {
    animation: hero-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__tagline {
    animation-delay: 0.12s;
  }
  .hero__text > .hero__rule {
    animation: hero-line 0.9s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__paragraph {
    animation-delay: 0.36s;
  }
  .hero__actions {
    animation-delay: 0.5s;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }
  @keyframes hero-line {
    from {
      transform: scaleX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img),
    .hero__text > * {
      animation: none;
    }
  }

  .hero__text {
    max-width: 40rem;
  }
  /* The institute's name: white Nunito ExtraBold, up to about 88px. */
  .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 4.6vw, 5.5rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--color-white);
    overflow-wrap: break-word;
  }
  /* Tagline: mustard gold in the logo's serif, bold italic (5.3:1 on navy). */
  .hero__tagline {
    margin-block-start: 0.85rem;
    font-family: var(--font-brand);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.5rem, 0.95rem + 1.9vw, 2.6rem);
    line-height: 1.25;
    color: var(--color-gold);
  }
  /* Persian: the brand serif has no Persian letters. */
  :global(html[lang='fa']) .hero__tagline {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 800;
  }
  .hero__rule {
    display: block;
    width: 6rem;
    height: 2px;
    margin-block: 1.5rem;
    background: var(--color-gold);
    transform-origin: left center;
  }
  :global([dir='rtl']) .hero__rule {
    transform-origin: right center;
  }
  /* About 22px on desktop, cream on navy (10:1). */
  .hero__paragraph {
    max-width: 36rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem);
    line-height: 1.6;
    color: var(--color-cream);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-block-start: 2.25rem;
  }
  @media (max-width: 30rem) {
    .hero__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
