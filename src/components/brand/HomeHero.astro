---
/**
 * Homepage hero: a full-width photo banner (Montréal skyline) right under the
 * header, with the institute's name, the tagline in gold italic, a thin gold
 * line, and the paragraph centered on it. The photo is shown as
 * is, with no veil; the text is dark so it reads on the bright sky.
 */
import '@fontsource/playfair-display/700-italic.css';
import { Picture } from 'astro:assets';
import banner from '@/assets/home/hero-banner.jpg';
import type { UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={banner}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container-site hero__inner">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        {t('home.heroEyebrow')}
      </h1>
      <p class="hero__tagline">{t('home.heroTitle')}</p>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__paragraph">{t('home.heroText')}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(34rem, 22rem + 30vw, 44rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-white);
    border-block-end: 1px solid var(--color-line);
  }

  /* Full-width photo behind the text. The skyline sits in the lower middle of
     the photo, so that is the part kept in view when the sides are cropped. */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 65%;
    /* Very slow zoom so the city feels alive (stops with reduced motion). */
    animation: hero-drift 28s ease-in-out infinite alternate;
    transform-origin: 50% 65%;
  }
  @keyframes hero-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }
  /* Name, tagline, line and paragraph rise in one after the other. */
  .hero__text > * {
    animation: hero-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__tagline {
    animation-delay: 0.15s;
  }
  .hero__text > .hero__rule {
    animation: hero-line 0.9s 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__paragraph {
    animation-delay: 0.45s;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }
  @keyframes hero-line {
    from {
      transform: scaleX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img),
    .hero__text > * {
      animation: none;
    }
  }
  .hero__inner {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .hero__text {
    max-width: 76rem;
    margin-inline: auto;
    text-align: center;
  }
  /* The institute's name, deep petroleum blue, in the same typography
     as the original "Cultures in Dialogue" headline: Nunito ExtraBold, up to
     88px, title case. */
  .hero__title {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 5.5rem);
    font-weight: 800;
    line-height: 1.04;
    text-wrap: balance;
    color: var(--color-primary);
    overflow-wrap: break-word;
  }
  /* Tagline: warm gold in the logo's serif, bold italic so the strokes are
     thick enough to read on the bright sky; a crisp 1px shadow (no glow) gives
     the gold an edge against the clouds. Smaller than the name. */
  .hero__tagline {
    margin-block-start: 0.5rem;
    font-family: var(--font-brand);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.5rem, 0.9rem + 2.2vw, 2.75rem);
    line-height: 1.3;
    color: var(--color-gold);
    text-shadow: 0 1px 1px color-mix(in srgb, var(--color-primary) 45%, transparent);
  }
  /* Persian: the brand serif has no Persian letters. */
  :global(html[lang='fa']) .hero__tagline {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 800;
  }
  /* Very thin gold line under the tagline. */
  .hero__rule {
    display: block;
    width: 7rem;
    height: 1.5px;
    margin: 1.25rem auto 1.75rem;
    background: var(--color-gold);
  }
  /* About 30px on desktop with a narrower, balanced measure, so the short
     paragraph sits on two even lines on wide screens (all three languages). */
  .hero__paragraph {
    max-width: 68ch;
    margin-inline: auto;
    font-size: clamp(1.375rem, 1.1rem + 0.85vw, 1.875rem);
    line-height: 1.6;
    text-wrap: balance;
    font-weight: 600;
    color: var(--color-primary);
    /* Soft white halo so the dark letters stay readable where the paragraph
       crosses the darker buildings of the skyline. */
    text-shadow:
      0 0 3px var(--color-white),
      0 0 8px var(--color-white),
      0 0 16px color-mix(in srgb, var(--color-white) 90%, transparent);
  }
</style>
