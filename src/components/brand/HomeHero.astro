---
/**
 * Homepage hero: an editorial split. A deep navy panel carries the institute's name,
 * the tagline in mustard italic, the paragraph and the two main calls to action; the
 * Montréal skyline photo fills the other side to the edge of the screen, unobstructed.
 * The mosaic (four colour bars) joins the two. On phones the photo sits above the panel.
 * The text is always on solid navy, so it never depends on the photo for contrast.
 */
import '@fontsource/playfair-display/700-italic.css';
import { Picture } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import banner from '@/assets/home/hero-banner.jpg';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={banner}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 64rem) 55vw, 100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero__panel on-dark">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        {t('home.heroEyebrow')}
      </h1>
      <p class="hero__tagline">{t('home.heroTitle')}</p>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__paragraph">{t('home.heroText')}</p>
      <div class="hero__actions">
        <a href={href('getInvolved', lang)} class="btn btn-primary">
          {t('home.involvedPrimary')}
          <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
        </a>
        <a href={href('events', lang)} class="btn btn-outline">
          {t('home.eventsAll')}
        </a>
      </div>
    </div>
    <div class="mosaic hero__mosaic" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    isolation: isolate;
    background: var(--color-primary);
  }

  /* Phones and tablets: photo band on top, panel below. */
  .hero__media {
    position: relative;
    height: clamp(13rem, 52vw, 26rem);
    overflow: hidden;
  }
  .hero__media :global(picture),
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__media :global(img) {
    object-fit: cover;
    object-position: 50% 88%;
    /* Very slow zoom so the city feels alive (stops with reduced motion). */
    animation: hero-drift 28s ease-in-out infinite alternate;
    transform-origin: 50% 88%;
  }
  @keyframes hero-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  .hero__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) clamp(1.25rem, 0.5rem + 3vw, 3rem);
    background: var(--color-primary);
    color: var(--color-cream);
  }
  .hero__mosaic {
    position: absolute;
    inset-inline: clamp(1.25rem, 0.5rem + 3vw, 3rem);
    inset-block-end: 1.5rem;
    max-width: 16rem;
  }

  /* Desktop: navy panel on the reading side (start), photo to the far edge. */
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      min-height: clamp(36rem, 26rem + 20vw, 46rem);
    }
    .hero__media {
      grid-column: 2;
      grid-row: 1;
      height: auto;
    }
    .hero__panel {
      grid-column: 1;
      grid-row: 1;
      padding-inline: max(3rem, calc((100vw - 90rem) / 2 + 3rem)) 3.5rem;
      padding-block: 5rem 6rem;
    }
    .hero__mosaic {
      inset-inline-start: max(3rem, calc((100vw - 90rem) / 2 + 3rem));
      inset-block-end: 2.75rem;
    }
  }

  /* Name, tagline, line, paragraph and buttons rise in one after the other. */
  .hero__text > * {
    animation: hero-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__tagline {
    animation-delay: 0.12s;
  }
  .hero__text > .hero__rule {
    animation: hero-line 0.9s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__paragraph {
    animation-delay: 0.36s;
  }
  .hero__actions {
    animation-delay: 0.5s;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }
  @keyframes hero-line {
    from {
      transform: scaleX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img),
    .hero__text > * {
      animation: none;
    }
  }

  /* A size container, so the name can be sized to the space it actually has. */
  .hero__text {
    container-type: inline-size;
    width: 100%;
    max-width: 40rem;
  }
  /* The institute's name: white Nunito ExtraBold, up to about 88px. */
  /* Never more than 1/6 of the text block's width: the longest word ("Intercultural"
     is 5.73 times the font size, "interculturel" 5.68, «بین‌فرهنگی» 4.45) always stays
     on one line, at every screen size and in every language. */
  .hero__title {
    font-size: min(clamp(2.6rem, 1.2rem + 4.6vw, 5.5rem), 100cqi / 6);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--color-white);
  }
  /* Tagline: mustard gold in the logo's serif, bold italic (5.3:1 on navy). */
  .hero__tagline {
    margin-block-start: 0.85rem;
    font-family: var(--font-brand);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.5rem, 0.95rem + 1.9vw, 2.6rem);
    line-height: 1.25;
    color: var(--color-gold);
  }
  /* Persian: the brand serif has no Persian letters. */
  :global(html[lang='fa']) .hero__tagline {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 800;
  }
  .hero__rule {
    display: block;
    width: 6rem;
    height: 2px;
    margin-block: 1.5rem;
    background: var(--color-gold);
    transform-origin: left center;
  }
  :global([dir='rtl']) .hero__rule {
    transform-origin: right center;
  }
  /* About 22px on desktop, cream on navy (10:1). */
  .hero__paragraph {
    max-width: 36rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem);
    line-height: 1.6;
    color: var(--color-cream);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-block-start: 2.25rem;
  }
  @media (max-width: 30rem) {
    .hero__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
