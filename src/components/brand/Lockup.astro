---
/**
 * Horizontal header lockup: round logo, "Matin" | maple-leaf rule | "Institut interculturel".
 * The words are HTML/CSS so they stay crisp at small sizes; the round logo (owner's file,
 * Oct 27 2026, assets/logo-matin-sun.jpg, only its white background removed) sits before them.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo-matin.png';
import MapleLeaf from './MapleLeaf.astro';
import { useTranslations } from '@/i18n/ui';
import { href, type UiLang } from '@/i18n/routes';

interface Props {
  lang: UiLang;
  /** Background the lockup sits on (the leaf is cut out of the rule with it). */
  variant?: 'white' | 'tint' | 'dark';
  /** 'large' is the size used in the site header. */
  size?: 'default' | 'large';
}
const { lang, variant = 'white', size = 'default' } = Astro.props;
const t = useTranslations(lang);
// The logo keeps its French/English wording; on Persian pages it shows the French logo.
const logoLang = lang === 'fa' ? 'fr' : lang;
const [line1, ...rest] = useTranslations(logoLang)('brand.institute').split(' ');
---

<a
  href={href('home', lang)}
  class:list={[
    'lockup',
    variant === 'tint' && 'lockup--tint',
    variant === 'dark' && 'lockup--dark',
    size === 'large' && 'lockup--large',
  ]}
  dir="ltr"
>
  <Image
    src={logo}
    alt=""
    widths={[96, 160, 240]}
    sizes="80px"
    class="lockup__logo"
    loading="eager"
  />
  <span class="lockup__word" lang={logoLang} dir="ltr">
    Matin
  </span>
  <span class="lockup__rule" aria-hidden="true">
    <MapleLeaf size={11} class="lockup__leaf" />
  </span>
  <span class="lockup__inst" lang={logoLang} dir="ltr">
    <span>{line1}</span>
    <span>{rest.join(' ')}</span>
  </span>
  <span class="sr-only">— {t('nav.home')}</span>
</a>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    line-height: 1;
  }
  .lockup__logo {
    flex: none;
    width: 3rem;
    height: auto;
  }
  .lockup__word {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 2.1rem;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    padding-bottom: 0.08em;
  }
  .lockup__rule {
    position: relative;
    align-self: stretch;
    width: 2px;
    margin-block: 0.2rem;
    background: var(--color-gold);
  }
  .lockup__rule :global(.lockup__leaf) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--color-gold);
    background: var(--lockup-bg, var(--color-white));
    padding: 2px 0;
    width: 13px;
    height: 15px;
  }
  .lockup__inst {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }
  /* Phones: a little larger than the default, still leaving room for the menu button. */
  .lockup--large .lockup__word {
    font-size: 2.4rem;
  }
  .lockup--large .lockup__inst {
    font-size: 0.8rem;
  }
  /* Larger header size from 640px up. */
  @media (min-width: 40rem) {
    .lockup--large {
      gap: 0.9rem;
    }
    /* Phase 2 (owner's brief, Oct 24 2026): a more prominent "Matin" and a readable
       "Intercultural Institute". */
    .lockup--large .lockup__logo {
      width: 4.75rem;
    }
    .lockup--large .lockup__word {
      font-size: 3rem;
    }
    .lockup--large .lockup__inst {
      gap: 0.3rem;
      font-size: 1.0625rem;
      letter-spacing: 0.03em;
    }
  }
  .lockup--tint {
    --lockup-bg: var(--color-tint);
  }
  /* On the deep terracotta footer: white "Matin", cream institute name. */
  .lockup--dark {
    --lockup-bg: var(--color-terracotta-deep);
  }
  .lockup--dark .lockup__word {
    color: var(--color-white);
  }
  .lockup--dark .lockup__inst {
    color: var(--color-cream);
  }
  /* Small phones: a smaller logo so the search and menu buttons stay on the same row. */
  @media (max-width: 29.99rem) {
    .lockup--large {
      gap: 0.45rem;
    }
    .lockup--large .lockup__logo {
      width: 2.5rem;
    }
    .lockup--large .lockup__word {
      font-size: 2.05rem;
    }
    .lockup--large .lockup__inst {
      font-size: 0.72rem;
    }
  }
</style>
