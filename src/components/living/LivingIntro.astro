---
/**
 * Living homepage, the first section after the hero (owner's brief, Oct 29 2026): who
 * Matin is, told as an editorial statement (the approved home.whoText, set large) beside
 * a collage of three photographs in different shapes. Photos come from the
 * registry (src/lib/media.ts), with one very small credit line.
 */
import { ArrowRight } from '@lucide/astro';
import MediaImage from '@/components/media/MediaImage.astro';
import MediaCredits from '@/components/media/MediaCredits.astro';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

/*
 * Owner, Oct 31 2026: the introduction read « too official ». The approved words stay
 * exactly as written; only their setting changes: the three ways (dialogue, arts,
 * research) are marked in the palette colours and the two aims are set in bold.
 */
const MARKS: Record<UiLang, { ways: string[]; aims: string[] }> = {
  en: { ways: ['dialogue', 'the arts', 'research'], aims: ['mutual understanding', 'a shared sense of belonging'] },
  fr: {
    ways: ['le dialogue', 'les arts', 'la recherche'],
    aims: ['la compréhension mutuelle', "un sentiment d['’]appartenance partagé"],
  },
  fa: { ways: ['گفت‌وگو', 'هنر', 'پژوهش'], aims: ['درک متقابل', 'احساس تعلقی مشترک'] },
};
const whoText = t('home.whoText');
const marks = MARKS[lang] ?? MARKS.en;
const esc = (x: string) => x.replace(/[.*+?^${}()|\\]/g, (c) => (c === '[' || c === ']' ? c : '\\' + c));
const pattern = new RegExp(
  `(${[...marks.ways, ...marks.aims].map((m) => m.split(/(\[['’]\])/).map((part) => (part.startsWith('[') ? part : esc(part))).join('').replace(/ /g, '[\\s\u00a0\u202f]')).join('|')})`,
  'g',
);
let wayIndex = 0;
const segments = whoText.split(pattern).map((text, i) => {
  if (i % 2 === 0) return { text, kind: 'plain' as const };
  const plain = text.replace(/[\u00a0\u202f]/g, ' ').replace(/’/g, "'");
  const isWay = marks.ways.some((w) => w.replace(/\[['’]\]/g, "'") === plain);
  return isWay
    ? { text, kind: 'way' as const, tone: ['firouzeh', 'soleil', 'brique'][wayIndex++ % 3] }
    : { text, kind: 'aim' as const };
});
---

<section class="lintro" data-own-ground aria-labelledby="lintro-title">
  <div class="container-site lintro__grid">
    <div class="lintro__text" data-reveal>
      <p class="living-kicker">{t('home.positioning')}</p>
      <h2 id="lintro-title" class="lintro__title">
        {t('home.whoTitle')}
      </h2>
      <p class="lintro__statement">
        {segments.map((seg) =>
          seg.kind === 'way' ? (
            <mark class:list={['lintro__way', `lintro__way--${seg.tone}`]}>{seg.text}</mark>
          ) : seg.kind === 'aim' ? (
            <strong class="lintro__aim">{seg.text}</strong>
          ) : (
            seg.text
          ),
        )}
      </p>
      <a href={href('about', lang)} class="living-link">
        {t('home.whoCardsLabel')}
        <ArrowRight size={20} class="flip-rtl" aria-hidden="true" />
      </a>
    </div>

    <div class="lintro__collage">
      <span class="lintro__sun" aria-hidden="true"></span>
      <MediaImage
        slot="introConversation"
        lang={lang}
        ratio={4 / 5}
        sizes="(min-width: 64rem) 26rem, 70vw"
        class="lintro__a"
        credit="none"
      />
      <MediaImage
        slot="introMaking"
        lang={lang}
        ratio={1}
        sizes="(min-width: 64rem) 16rem, 45vw"
        widths={[400, 640, 900]}
        class="lintro__b"
        credit="none"
      />
      <MediaImage
        slot="introGallery"
        lang={lang}
        ratio={3 / 2}
        sizes="(min-width: 64rem) 18rem, 50vw"
        widths={[400, 640, 900]}
        class="lintro__c"
        credit="none"
      />
      <MediaCredits
        slots={['introConversation', 'introMaking', 'introGallery']}
        lang={lang}
        class="lintro__credits"
      />
    </div>
  </div>
</section>

<style>
  /* Warm terracotta ground with flat turquoise and saffron shapes (owner, Oct 31 2026:
     this section was colourless and lifeless). */
  .lintro {
    background-color: color-mix(in srgb, var(--matin-brique) 22%, var(--matin-ivoire));
    background-image:
      radial-gradient(circle at 0 100%, color-mix(in srgb, var(--matin-firouzeh) 45%, transparent) 0 11rem, transparent 11rem),
      radial-gradient(circle at 100% 0, color-mix(in srgb, var(--matin-soleil) 70%, transparent) 0 8rem, transparent 8rem);
    background-repeat: no-repeat;
    padding-block: clamp(4rem, 3rem + 5vw, 8rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .lintro__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .lintro__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
  }
  .lintro__title {
    margin-block: 0.5rem 1.5rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.6rem, 1.8rem + 3.2vw, 4.75rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 144;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--matin-brique-ink);
  }
  :global(html[lang='fa']) .lintro__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.6rem);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: 0;
  }
  /* The approved introduction, warm and readable (owner, Oct 31 2026: less official):
     reading type, the three ways marked like a highlighter, the two aims in bold. */
  .lintro__statement {
    max-width: 36rem;
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-weight: 400;
    line-height: 1.75;
    color: var(--matin-encre);
    text-wrap: pretty;
  }
  :global(html[lang='fa']) .lintro__statement {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.7rem);
    font-weight: 500;
    line-height: 2;
    /* Owner's request, Oct 30 2026: a neat block, not ragged lines (« مرتب »). */
    text-wrap: balance;
  }
  .lintro__way {
    padding: 0 0.18em;
    border-radius: 0.35em 0.35em 0.35em 0.1em;
    font-weight: 700;
    color: var(--matin-encre);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .lintro__way--firouzeh {
    background: color-mix(in srgb, var(--matin-firouzeh) 32%, var(--matin-white));
  }
  .lintro__way--soleil {
    background: color-mix(in srgb, var(--matin-soleil) 55%, var(--matin-white));
  }
  .lintro__way--brique {
    background: color-mix(in srgb, var(--matin-brique) 32%, var(--matin-white));
  }
  .lintro__aim {
    font-weight: 700;
    color: var(--matin-brique-ink);
    text-decoration: underline;
    text-decoration-color: var(--matin-soleil);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.25em;
  }
  .lintro__text :global(.living-link) {
    margin-block-start: 2rem;
  }

  /* ---------- Collage: three shapes, overlapping, never a grid of equal boxes ---------- */
  .lintro__collage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    max-width: 36rem;
    margin-inline: auto;
    width: 100%;
  }
  .lintro__sun {
    position: absolute;
    inset-block-start: 6%;
    inset-inline-start: 2%;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--living-gold);
    opacity: 0.85;
  }
  .lintro__collage :global(.lintro__a) {
    grid-column: 3 / 12;
    grid-row: 1;
    z-index: 1;
    border-radius: 999px 999px 1.75rem 1.75rem;
  }
  .lintro__collage :global(.lintro__a .media__frame) {
    border-radius: 999px 999px 1.75rem 1.75rem;
  }
  .lintro__collage :global(.lintro__b) {
    grid-column: 1 / 6;
    grid-row: 2;
    z-index: 2;
    margin-block-start: -38%;
  }
  .lintro__collage :global(.lintro__b .media__frame) {
    border-radius: 50%;
    outline: 0.5rem solid var(--living-ivory);
  }
  .lintro__collage :global(.lintro__c) {
    grid-column: 6 / 13;
    grid-row: 2;
    z-index: 2;
    margin-block-start: -12%;
    margin-inline-start: 8%;
  }
  .lintro__collage :global(.lintro__c .media__frame) {
    border-radius: 1.5rem 4.5rem 1.5rem 1.5rem;
    outline: 0.5rem solid var(--living-ivory);
  }
  .lintro__collage :global(.lintro__credits) {
    grid-column: 1 / -1;
    grid-row: 3;
    margin-block-start: 1.25rem;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .lintro__collage :global(.media:hover img) {
      transform: scale(1.04);
    }
  }
</style>
