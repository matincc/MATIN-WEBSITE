---
/**
 * Cultural News in three region tabs: Montréal (default), Canada,
 * Around the World (owner's brief, Oct 25 2026). Editorial layout (owner's request,
 * Oct 27 2026: no boxed panel, no cards): the newest story leads on the reading side,
 * the next ones stack beside it, with thin gold rules between them. Owner's second request
 * of Oct 27 2026 (more colour, links must look like links, news must look like news):
 * newspaper serif headlines, underlined, with an arrow; the source as a teal label; a
 * coloured edge per story; « Lire la suite » as a filled terracotta button. Only published entries reach this list;
 * proposed or rejected stories are never in the repository (see
 * src/content/news/README.md). Each card names its source and links to it.
 */
import type { CollectionEntry } from 'astro:content';
import { ArrowUpRight, ExternalLink, Newspaper } from '@lucide/astro';
import { pick } from '@/i18n/ui';
import { formatDate } from '@/lib/dates';
import type { UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { newsRegions } from '@/lib/taxonomy';

interface Props {
  lang: UiLang;
  posts: CollectionEntry<'news'>[];
  /** Stories per tab (newest first); all of them when left out. */
  perTab?: number;
  id: string;
  /** Heading level of the region titles (shown without JavaScript); cards go one below. */
  level?: 3 | 4;
}
const { lang, posts, perTab, id, level = 3 } = Astro.props;
const RegionHeading = `h${level}` as 'h3' | 'h4';
const cardLevel = `h${level + 1}` as 'h4' | 'h5';
const t = useTranslations(lang);
const tabs = newsRegions.map((region) => {
  const all = posts.filter((p) => (p.data.region ?? 'international') === region);
  const items = perTab ? all.slice(0, perTab) : all;
  // An odd number of stories (3, 5…) gets a large lead spanning two rows; an even number
  // (2, 4…) sits in equal cards, two by two (owner's request, Oct 27 2026: four stories
  // per region in balanced boxes, without the empty space around a lone large lead).
  return { region, items, lead: items.length >= 3 && items.length % 2 === 1 };
});
---

<div data-tabs>
  <div class="region-tabs__list" role="tablist" aria-label={t('a11y.regionTabs')}>
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        class="region-tab"
        id={`${id}-tab-${tab.region}`}
        aria-controls={`${id}-${tab.region}`}
        aria-selected={i === 0 ? 'true' : 'false'}
      >
        {t(`newsRegions.${tab.region}`)}
      </button>
    ))}
  </div>
  {tabs.map((tab) => (
    <div
      class="region-panel"
      role="tabpanel"
      id={`${id}-${tab.region}`}
      aria-labelledby={`${id}-tab-${tab.region}`}
    >
      <RegionHeading class="region-panel__title">{t(`newsRegions.${tab.region}`)}</RegionHeading>
      {tab.items.length > 0 ? (
        <ul class:list={['wire', tab.lead && 'wire--lead']}>
          {tab.items.map((post, i) => {
            const d = post.data;
            const src = d.source!;
            const Heading = cardLevel;
            return (
              <li class:list={['wire__item', tab.lead && i === 0 && 'wire__item--lead']}>
                <p class="wire__kicker">
                  <span class="wire__source-name">{src.name}</span>
                  <span class="wire__dot" aria-hidden="true" />
                  <time datetime={d.date.toISOString().slice(0, 10)}>
                    {formatDate(d.date, lang)}
                  </time>
                </p>
                <Heading class="wire__title">
                  <a href={src.url} target="_blank" rel="noopener noreferrer">
                    {pick(d.title, lang)}
                    <ArrowUpRight size={20} class="wire__arrow flip-rtl" aria-hidden="true" />
                    <span class="sr-only">
                      {' '}
                      {t('news.sourceNamed', { name: src.name })} {t('a11y.externalLink')}
                    </span>
                  </a>
                </Heading>
                <p class="wire__excerpt">{pick(d.excerpt, lang)}</p>
                <a
                  class="wire__source"
                  href={src.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {t('news.readSource')}
                  <ExternalLink size={15} />
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="region-empty">
          <span class="region-empty__icon" aria-hidden="true">
            <Newspaper size={26} />
          </span>
          <p>{t('news.regionEmpty')}</p>
        </div>
      )}
    </div>
  ))}
</div>

<script>
  import { enhanceTabs } from '@/scripts/tabs';
  enhanceTabs();
</script>

<style>
  /* Stories as white cards on the navy band, each with a thick coloured top edge
     (terracotta, teal, gold); the lead story spans two rows on the reading side when there is an odd number. */
  .wire {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }
  @media (min-width: 52rem) {
    .wire {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .wire--lead {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
    .wire--lead .wire__item--lead {
      grid-row: span 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }
  }
  .wire__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: clamp(1.35rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius-card);
    border-block-start: 8px solid var(--color-terracotta);
    background: var(--color-white);
    color: var(--color-ink);
    box-shadow: 0 18px 40px -22px color-mix(in srgb, black 60%, transparent);
  }
  .wire__item:nth-child(4n + 2) {
    border-block-start-color: var(--color-teal);
  }
  .wire__item:nth-child(4n + 3) {
    border-block-start-color: var(--color-gold);
  }
  .wire__item:nth-child(4n + 4) {
    border-block-start-color: var(--color-coral);
  }
  /* Equal cards: the « read at source » button lines up at the bottom of each row. */
  .wire:not(.wire--lead) .wire__source {
    margin-block-start: auto;
  }
  .wire:not(.wire--lead) .wire__excerpt {
    margin-block-end: 1.1rem;
  }
  /* The lead story: a warm ivory card, so it reads first. */
  .wire__item--lead {
    background: var(--color-ivory);
  }
  .wire__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  /* The source as a small deep teal label (white text 6.2:1). */
  .wire__source-name {
    padding: 0.2rem 0.6rem;
    border-radius: 0.35rem;
    background: var(--color-teal-deep);
    color: var(--color-white);
  }
  .wire__kicker time {
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-ink);
  }
  .wire__dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-terracotta);
  }
  /* Newspaper headline: serif (Vazirmatn in Persian), navy, always underlined. */
  .wire__title {
    margin-block-start: 0.75rem;
    font-family: var(--font-news);
    font-weight: 700;
    font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.625rem);
    line-height: 1.25;
    color: var(--color-primary);
    text-wrap: balance;
  }
  :global(html[lang='fa']) .wire__title {
    font-weight: 800;
    line-height: 1.6;
  }
  .wire__item--lead .wire__title {
    font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem);
    line-height: 1.15;
  }
  .wire__title a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }
  .wire__title a:hover,
  .wire__title a:focus-visible {
    color: var(--color-terracotta-deep);
    text-decoration-color: var(--color-terracotta-deep);
  }
  .wire__title :global(.wire__arrow) {
    display: inline-block;
    margin-inline-start: 0.2em;
    vertical-align: -0.1em;
    color: var(--color-terracotta-deep);
  }
  .wire__excerpt {
    margin-block-start: 0.75rem;
    max-width: 62ch;
  }
  .wire__item--lead .wire__excerpt {
    font-size: 1.125rem;
  }
  /* « Lire la suite à la source »: a filled terracotta pill, clearly a button (white 5.9:1). */
  .wire__source {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 1.1rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--btn-accent-bg);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    color: var(--btn-accent-fg);
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .wire__source:hover {
    background: var(--btn-accent-bg-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .wire__title a,
    .wire__source {
      transition: none;
    }
  }

  /* No approved story yet: a short, finished panel, never sample content. */
  .region-empty {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    max-width: 52rem;
    padding: 1.35rem 1.6rem;
    border: 1px solid var(--color-card-edge);
    border-radius: var(--radius-card);
    background: var(--color-ivory);
    color: var(--color-primary);
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .region-empty__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-gold);
  }
</style>
