---
import { Picture } from 'astro:assets';
import { ArrowRight, Users } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import CoverArt from './CoverArt.astro';
import CategoryIcon from './CategoryIcon.astro';
import { slugOf } from '@/lib/content';
import { baseLang, href as hrefOf, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { NBSP } from '@/lib/frenchTypo';

interface Props {
  program: CollectionEntry<'programs'>;
  lang: UiLang;
  headingLevel?: 'h2' | 'h3';
}
const { program, lang, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const d = program.data;
const href = hrefOf('programs', lang, slugOf(program, baseLang(lang)));
const Heading = headingLevel;
const audienceLabel = t('programs.audience') + (lang === 'fr' ? `${NBSP}: ` : ': ');
---

<article
  class="card group relative flex flex-col overflow-hidden transition-colors duration-200 hover:border-gold"
  data-category={d.category}
>
  <div class="relative aspect-[16/10]">
    {d.image ? (
      <Picture
        src={d.image}
        alt={pick(d.imageAlt, lang) ?? ''}
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="size-full object-cover"
      />
    ) : (
      <CoverArt category={d.category} seed={program.id} class="size-full" />
    )}
  </div>
  <div class="relative flex flex-1 flex-col p-6 pt-9">
    <span class="absolute -top-7 left-6 grid size-14 place-items-center rounded-full border border-line bg-white text-gold-dark">
      <CategoryIcon category={d.category} size={24} />
    </span>
    <p class="eyebrow mb-2">{t(`categories.${d.category}`)}</p>
    <Heading class="mb-3 text-xl font-bold">
      <a
        href={href}
        class="text-primary no-underline after:absolute after:inset-0 after:content-['']"
      >
        {pick(d.title, lang)}
      </a>
    </Heading>
    <p class="mb-5 text-[0.95rem] text-muted">{pick(d.summary, lang)}</p>
    <div class="mt-auto flex items-center justify-between gap-3 border-t border-line/70 pt-4 text-sm">
      <span class="flex items-center gap-2 text-ink">
        <Users size={16} class="text-ink" aria-hidden="true" />
        <span>
          <span class="sr-only">{audienceLabel}</span>
          {pick(d.audience, lang)}
        </span>
      </span>
      <span class="link-arrow text-sm" aria-hidden="true">
        <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
      </span>
    </div>
  </div>
</article>
