---
/**
 * News card (owner's brief, Oct 25 2026: a small, credible cultural publication).
 * - Cultural News (`recommends`): image or the dialogue motif, region label, the source's
 *   publication date and name, headline, Matin's short summary and a "Read more at the
 *   source" action; the whole card opens the original article in a new tab.
 * - Matin News (`matin-news`): warm institutional card with a gold top edge, the date,
 *   headline, excerpt and a "Read article" action to the page on this site.
 * Warm ivory surfaces (never plain white), a gentle lift and image zoom on hover (none
 * with reduced motion). `featured` makes a wide card, image beside the text.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ArrowRight, CalendarDays, ExternalLink, MapPin } from '@lucide/astro';
import CoverArt from './CoverArt.astro';
import MatinNewsArt from '@/components/brand/MatinNewsArt.astro';
import { articleHref } from '@/lib/content';
import { type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { formatDate } from '@/lib/dates';

interface Props {
  post: CollectionEntry<'news'>;
  lang: UiLang;
  headingLevel?: 'h2' | 'h3' | 'h4' | 'h5';
  featured?: boolean;
}
const { post, lang, headingLevel = 'h3', featured = false } = Astro.props;
const t = useTranslations(lang);
const d = post.data;
const cultural = d.category === 'recommends';
const external = cultural && d.source ? d.source : undefined;
const href = external ? external.url : articleHref(post, lang);
const Heading = headingLevel;
---

<article
  class:list={[
    'post group',
    cultural ? 'post--cultural' : 'post--matin',
    featured && 'post--featured',
  ]}
>
  <div class="post__media">
    {d.image ? (
      <Picture
        src={d.image}
        alt={pick(d.imageAlt, lang) ?? ''}
        formats={['avif', 'webp']}
        widths={[400, 640, 800, 1200]}
        sizes={
          featured
            ? '(min-width: 768px) 50vw, 100vw'
            : '(min-width: 1024px) 28rem, (min-width: 640px) 50vw, 100vw'
        }
        class="post__img"
      />
    ) : cultural ? (
      <CoverArt category="arts" seed={post.id} class="post__img" />
    ) : (
      <MatinNewsArt lang={lang} class="post__img" />
    )}
    {cultural && d.region && (
      <span class="post__region">
        <MapPin size={15} aria-hidden="true" />
        {t(`newsRegions.${d.region}`)}
      </span>
    )}
  </div>
  <div class="post__body">
    <p class="post__meta">
      {!cultural && <span class="post__cat">{t('newsCategories.matin-news')}</span>}
      <span class="post__date">
        <CalendarDays size={16} aria-hidden="true" />
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, lang)}</time>
      </span>
      {external && <span class="post__source">{external.name}</span>}
    </p>
    <Heading class="post__title">
      <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        class="post__link"
      >
        {pick(d.title, lang)}
        {external && (
          <span class="sr-only">
            {' '}
            {t('news.sourceNamed', { name: external.name })} {t('a11y.externalLink')}
          </span>
        )}
      </a>
    </Heading>
    <p class="post__excerpt">{pick(d.excerpt, lang)}</p>
    <span class="post__action" aria-hidden="true">
      {external ? t('news.readSource') : t('news.readMore')}
      {external ? <ExternalLink size={17} /> : <ArrowRight size={18} class="flip-rtl" />}
    </span>
    {d.imageCredit && <p class="post__credit">{d.imageCredit}</p>}
  </div>
</article>

<style>
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-card-edge);
    border-radius: var(--radius-card);
    background: var(--color-ivory);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.3s;
  }
  .post--matin {
    border-block-start: 5px solid var(--color-gold);
  }
  .post:hover,
  .post:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 22px 40px -24px color-mix(in srgb, var(--color-primary) 55%, transparent);
  }
  .post__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-block-end: 4px solid var(--color-teal);
  }
  .post--matin .post__media {
    border-block-end-color: var(--color-gold);
  }
  .post__media :global(.post__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .post:hover .post__media :global(.post__img) {
    transform: scale(1.05);
  }
  /* Region label over the image: navy with white text (11.9:1). */
  .post__region {
    position: absolute;
    inset-block-start: 0.85rem;
    inset-inline-start: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 800;
  }
  .post__region :global(svg) {
    color: var(--color-gold);
  }
  .post__credit {
    margin-block-start: 0.85rem;
    font-size: 0.8125rem;
    color: var(--color-ink);
  }
  .post__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.35rem 1.5rem 1.6rem;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin-block-end: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .post__cat {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--color-champagne);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 800;
  }
  .post__date {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }
  .post__date :global(svg) {
    color: var(--color-primary);
  }
  .post__source {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-teal-deep);
  }
  .post__title {
    margin-block-end: 0.6rem;
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.55rem);
    font-weight: 800;
    line-height: 1.25;
    text-wrap: balance;
  }
  /* The whole card is one link (the title's), so the action below is not a second stop. */
  .post__link {
    color: var(--color-primary);
    text-decoration: none;
  }
  .post__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post:hover .post__link {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .post__excerpt {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink);
  }
  .post__action {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.45rem;
    margin-block-start: auto;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    background: var(--btn-secondary-bg);
    color: var(--btn-secondary-fg);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    transition: background-color 0.2s;
  }
  .post__body > .post__excerpt {
    margin-block-end: 1.25rem;
  }
  .post__action :global(svg) {
    color: currentColor;
  }
  .post:hover .post__action {
    background: var(--btn-secondary-bg-hover);
  }

  /* Lead story: one wide card, image beside the text. */
  .post--featured .post__body {
    justify-content: center;
    padding: clamp(1.75rem, 1.2rem + 2vw, 3.25rem);
  }
  .post--featured .post__title {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.625rem);
    line-height: 1.15;
  }
  .post--featured .post__excerpt {
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem);
  }
  .post--featured .post__action {
    margin-block-start: 0;
  }
  @media (min-width: 768px) {
    .post--featured {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
    .post--featured .post__media {
      height: 100%;
      min-height: 22rem;
      aspect-ratio: auto;
      border-block-end: none;
      border-inline-end: 6px solid var(--color-teal);
    }
  }
  /* Matin News lead (owner, Oct 31 2026: the card blended into the ground and the two
     equal squares felt repetitive): a navy card with two deep opposite corners; the
     Matin News art sits in a round medallion ringed in saffron, set off the card's
     start edge, the text in white beside it. White on encre 11:1, soleil on encre 6.6:1. */
  .post--matin.post--featured {
    border: none;
    border-block-start: none;
    background: var(--matin-encre);
    color: var(--color-white);
    box-shadow: 0 28px 50px -30px color-mix(in srgb, var(--matin-encre) 80%, transparent);
    overflow: visible;
  }
  .post--matin.post--featured:not(#o) {
    border-radius: 0;
    border-start-start-radius: 7rem;
    border-end-end-radius: 7rem;
    border-start-end-radius: 1.25rem;
    border-end-start-radius: 1.25rem;
  }
  .post--matin.post--featured .post__media {
    align-self: center;
    justify-self: center;
    width: min(100%, 24rem);
    aspect-ratio: 1;
    height: auto;
    min-height: 0;
    margin: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 10px solid var(--matin-soleil);
    border-radius: 50%;
    outline: 3px dashed color-mix(in srgb, var(--matin-soleil) 70%, transparent);
    outline-offset: 10px;
    background: var(--matin-ivoire);
  }
  .post--matin.post--featured .post__body {
    padding-inline-start: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }
  .post--matin.post--featured .post__meta,
  .post--matin.post--featured .post__excerpt,
  .post--matin.post--featured .post__credit {
    color: color-mix(in srgb, var(--color-white) 92%, var(--matin-ivoire));
  }
  .post--matin.post--featured .post__date :global(svg) {
    color: var(--matin-soleil);
  }
  .post--matin.post--featured .post__cat {
    background: var(--matin-soleil);
    color: var(--matin-encre);
  }
  .post--matin.post--featured .post__link {
    color: var(--color-white);
  }
  .post--matin.post--featured:hover .post__link {
    text-decoration-color: var(--matin-soleil);
  }
  .post--matin.post--featured .post__action,
  .post--matin.post--featured:hover .post__action {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
  }
  @media (min-width: 768px) {
    .post--matin.post--featured {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
    .post--matin.post--featured .post__media {
      height: auto;
      min-height: 0;
      aspect-ratio: 1;
      border-inline-end: 10px solid var(--matin-soleil);
      margin-inline-start: clamp(-2.5rem, -1rem - 2vw, -1rem);
    }
  }
  @media (max-width: 767px) {
    .post--matin.post--featured:not(#o) {
      border-start-start-radius: 4rem;
      border-end-end-radius: 4rem;
    }
    .post--matin.post--featured .post__media {
      width: min(80%, 18rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post,
    .post__media :global(.post__img) {
      transition: none;
    }
    .post:hover,
    .post:focus-within,
    .post:hover .post__media :global(.post__img) {
      transform: none;
    }
  }
</style>
