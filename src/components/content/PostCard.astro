---
/**
 * News & Insights card, magazine style: image (or the dialogue motif), coloured category
 * label, date, large headline, excerpt. `featured` makes it the lead story: one wide card
 * with the image beside the text on wider screens. A cultural news story (Matin
 * Recommends with a source) names its source and links straight to it.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ArrowRight, CalendarDays, ExternalLink } from '@lucide/astro';
import CoverArt from './CoverArt.astro';
import { articleHref } from '@/lib/content';
import { type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { formatDate } from '@/lib/dates';
import type { Category, NewsCategory } from '@/lib/taxonomy';

interface Props {
  post: CollectionEntry<'news'>;
  lang: UiLang;
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
}
const { post, lang, headingLevel = 'h3', featured = false } = Astro.props;
const t = useTranslations(lang);
const d = post.data;
const external = d.category === 'recommends' && d.source ? d.source : undefined;
const href = external ? external.url : articleHref(post, lang);
const Heading = headingLevel;
// Illustration used when the article has no photo.
const covers: Record<NewsCategory, Category> = {
  'matin-news': 'community',
  perspectives: 'lectures',
  'culture-cities': 'community',
  research: 'lectures',
  partnerships: 'community',
  recommends: 'arts',
};
// Each category keeps one accent across the site.
const accents: Record<NewsCategory, string> = {
  'matin-news': 'navy',
  perspectives: 'coral',
  'culture-cities': 'teal',
  research: 'mustard',
  partnerships: 'terracotta',
  recommends: 'teal',
};
---

<article
  class:list={['post group relative flex flex-col', featured && 'post--featured card card-lift']}
  data-accent={accents[d.category]}
>
  <div class="post__media relative aspect-[3/2] overflow-hidden">
    {d.image ? (
      <Picture
        src={d.image}
        alt={pick(d.imageAlt, lang) ?? ''}
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes={
          featured
            ? '(min-width: 768px) 45vw, 100vw'
            : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'
        }
        class="size-full object-cover transition duration-500 group-hover:scale-[1.03]"
      />
    ) : (
      <CoverArt
        category={covers[d.category]}
        seed={post.id}
        class="size-full transition duration-500 group-hover:scale-[1.03]"
      />
    )}
  </div>
  <div class="post__body flex flex-col">
    <p class="post__meta">
      <span class="post__cat">{t(`newsCategories.${d.category}`)}</span>
      <span class="post__date">
        <CalendarDays size={16} aria-hidden="true" />
        <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, lang)}</time>
      </span>
    </p>
    <Heading class="post__title">
      <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        class="text-primary no-underline after:absolute after:inset-0 after:content-[''] group-hover:underline group-hover:decoration-[var(--accent)] group-hover:decoration-2"
      >
        {pick(d.title, lang)}
        {external && <span class="sr-only">{t('a11y.externalLink')}</span>}
      </a>
    </Heading>
    <p class="post__excerpt">{pick(d.excerpt, lang)}</p>
    {external && <p class="post__source">{t('news.sourceNamed', { name: external.name })}</p>}
    <span class="link-arrow mt-4" aria-hidden="true">
      {external ? t('news.readSource') : t('news.readMore')}
      {external ? <ExternalLink size={17} /> : <ArrowRight size={18} class="flip-rtl" />}
    </span>
  </div>
</article>

<style>
  .post__media {
    margin-block-end: 1.25rem;
    border-radius: var(--radius-card);
    border-block-end: 5px solid var(--accent);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-block-end: 0.75rem;
  }
  /* Category label: light wash of the accent with text-safe ink (5:1 or more). */
  .post__cat {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, var(--color-white));
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 800;
  }
  .post__date {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .post__date :global(svg) {
    color: var(--color-primary);
  }
  .post__source {
    margin-block-start: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-teal-deep);
  }
  .post__title {
    margin-block-end: 0.6rem;
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.55rem);
    font-weight: 800;
    line-height: 1.25;
    text-wrap: balance;
  }
  .post__excerpt {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  /* Lead story: one wide card, image beside the text. */
  .post--featured {
    overflow: hidden;
  }
  .post--featured .post__media {
    margin: 0;
    border-radius: 0;
  }
  .post--featured .post__body {
    padding: clamp(1.75rem, 1.2rem + 2vw, 3.25rem);
  }
  .post--featured .post__title {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    line-height: 1.12;
  }
  .post--featured .post__excerpt {
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem);
  }
  @media (min-width: 768px) {
    .post--featured {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
    }
    .post--featured .post__media {
      height: 100%;
      min-height: 22rem;
      aspect-ratio: auto;
      border-block-end: none;
      border-inline-end: 6px solid var(--accent);
    }
  }
</style>
