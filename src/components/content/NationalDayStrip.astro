---
/**
 * National day greeting (owner's National Days project, Nov 2026): a full-width strip under
 * the menu, above the hero, shown only on the country's day (Montréal time), chosen in the
 * visitor's browser so the static page needs no daily rebuild. On deploy previews the next
 * coming day is shown so the owner can see it; `?fete=MM-DD` shows a given day.
 * Data and texts: src/lib/nationalDays.ts.
 */
import { nationalDays, nationalDayStrings as s } from '@/lib/nationalDays';
import type { UiLang } from '@/i18n/routes';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const preview = process.env.CONTEXT !== 'production';
const dir = lang === 'fa' ? 'rtl' : 'ltr';
---

<div class="nd" data-national-days data-preview={preview ? '1' : '0'} hidden>
  {
    nationalDays.map((d) => (
      <section class="nd__item" data-day={d.day} hidden aria-label={`${s.label[lang]} · ${d.country[lang]}`}>
        <div class="container-site nd__inner">
          <img
            class="nd__flag"
            src={`/flags/${d.code}.svg`}
            alt={s.flagAlt[lang].replace('{country}', d.country[lang])}
            width="72"
            height="54"
            loading="lazy"
            decoding="async"
          />
          <div class="nd__text">
            <p class="nd__label">
              {s.label[lang]} · {d.country[lang]}
            </p>
            <p class="nd__greeting" lang={d.greeting.lang} dir={d.greeting.dir}>
              {d.greeting.text}
            </p>
            {d.greeting.text !== d.translation[lang] && (
              <p class="nd__translation" dir={dir}>
                {d.translation[lang]}
              </p>
            )}
            <p class="nd__from">
              {s.from[lang]}
            </p>
          </div>
          <button type="button" class="nd__close" data-nd-close aria-label={s.close[lang]}>
            <span aria-hidden="true">×</span>
          </button>
        </div>
      </section>
    ))
  }
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-national-days]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-day]')];
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());
    const today = `${parts.find((p) => p.type === 'month')?.value}-${parts.find((p) => p.type === 'day')?.value}`;
    const asked = new URLSearchParams(location.search).get('fete');
    let shown = items.filter((el) => el.dataset.day === (asked ?? today));
    if (!shown.length && root.dataset.preview === '1') {
      const next = items.find((el) => (el.dataset.day ?? '') >= today) ?? items[0];
      shown = next ? [next] : [];
    }
    let closed = false;
    try {
      closed = sessionStorage.getItem('nd-closed') === (asked ?? today);
    } catch {
      /* storage unavailable: show it */
    }
    if (shown.length && !closed) {
      shown.forEach((el) => (el.hidden = false));
      root.hidden = false;
    }
    root.querySelectorAll('[data-nd-close]').forEach((btn) =>
      btn.addEventListener('click', () => {
        root.hidden = true;
        try {
          sessionStorage.setItem('nd-closed', asked ?? today);
        } catch {
          /* ignore */
        }
      }),
    );
  }
</script>

<style>
  .nd {
    background: var(--color-soleil);
    color: var(--color-primary);
    border-bottom: 4px solid var(--color-brique-ink);
  }
  .nd__item + .nd__item {
    border-top: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
  }
  .nd__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.5rem + 1.5vw, 1.75rem);
    padding-block: 0.9rem;
  }
  .nd__flag {
    flex: none;
    width: clamp(3.5rem, 2.75rem + 2vw, 4.5rem);
    height: auto;
    border-radius: 0.3rem;
    box-shadow: 0 0 0 2px var(--color-white);
  }
  .nd__text {
    flex: 1;
    min-width: 0;
  }
  .nd__label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  :global(html[lang='fa']) .nd__label {
    letter-spacing: 0;
  }
  .nd__greeting {
    margin-top: 0.15rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 700;
    line-height: 1.3;
  }
  .nd__translation {
    font-size: 1rem;
    font-weight: 600;
  }
  .nd__from {
    margin-top: 0.15rem;
    font-size: 0.9rem;
  }
  .nd__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    aspect-ratio: 1;
    border-radius: 999px;
    border: 2px solid var(--color-primary);
    background: transparent;
    color: var(--color-primary);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .nd__close:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }
  .nd__close:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
