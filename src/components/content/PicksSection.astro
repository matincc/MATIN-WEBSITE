---
/**
 * "Matin's Picks": a few upcoming events Matin especially recommends, shown on the Events
 * page and on the homepage. One source for both: `featuredUntil` in an event's YAML file
 * (src/content/events/README.md), so a change appears in both places at once. Hidden when
 * there is no pick.
 */
import EventCard from '@/components/content/EventCard.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import type { UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { forLang, getUpcomingEvents, picksOf } from '@/lib/content';

interface Props {
  lang: UiLang;
  /** Classes of the full-width section (background, vertical spacing). */
  class?: string;
  /** Optional link beside the title, e.g. to the Events page. */
  link?: { href: string; label: string };
}
const { lang, class: className = '', link } = Astro.props;
const t = useTranslations(lang);
const picks = forLang(picksOf(await getUpcomingEvents()), lang);
---

{picks.length > 0 && (
  <section id="picks" class:list={['scroll-mt-24', className]} aria-labelledby="picks-title">
    <div class="container-site">
      <SectionHeader
        align="start"
        id="picks-title"
        title={t('events.picksTitle')}
        subtitle={t('events.picksLede')}
        link={link}
        class="mb-10"
      />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-upcoming-list>
        {picks.map((event, i) => (
          <li data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <EventCard event={event} lang={lang} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
