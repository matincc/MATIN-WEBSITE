---
/**
 * A simple, friendly silhouette (head and shoulders) for a team slot that has no
 * member yet. `figure` gives a woman's (longer hair) or a man's outline. Decorative.
 */
interface Props {
  figure?: 'woman' | 'man';
  class?: string;
}
const { figure = 'woman', class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 200 200"
  class:list={['silhouette', className]}
  aria-hidden="true"
  focusable="false"
>
  {figure === 'woman' && (
    <path
      class="silhouette__hair"
      d="M60 94 C56 52 78 38 100 38 C122 38 144 52 140 94 C139 110 142 122 148 132 L122 128 C127 114 128 100 126 86 C114 66 86 66 74 86 C72 100 73 114 78 128 L52 132 C58 122 61 110 60 94 Z"
    />
  )}
  <path
    class="silhouette__body"
    d="M34 200 C34 152 62 132 100 132 C138 132 166 152 166 200 Z"
  ></path>
  <circle class="silhouette__head" cx="100" cy="86" r={figure === 'woman' ? 32 : 34}></circle>
  {figure === 'man' && (
    <path
      class="silhouette__hair"
      d="M66 80 C66 50 84 44 100 44 C120 44 136 52 134 80 C126 66 110 62 100 62 C88 62 74 66 66 80 Z"
    />
  )}
</svg>

<style>
  .silhouette {
    display: block;
    width: 100%;
    height: 100%;
  }
  .silhouette__body,
  .silhouette__head {
    fill: color-mix(in srgb, var(--color-primary) 55%, var(--color-white));
  }
  .silhouette__hair {
    fill: color-mix(in srgb, var(--color-primary) 80%, var(--color-white));
  }
</style>
