---
/**
 * The visual of a Matin item: a photo (cropped), a poster (shown whole on a cream
 * ground), a video thumbnail with a play badge, or the dialogue motif when there is no
 * image yet.
 */
import { Picture } from 'astro:assets';
import {
  BookOpen,
  CalendarDays,
  FileText,
  Megaphone,
  Newspaper,
  Play,
  Sparkles,
  Image as ImageIcon,
} from '@lucide/astro';
import DialogueArt from '@/components/brand/DialogueArt.astro';
import type { MatinItem } from '@/lib/matin';

interface Props {
  item: MatinItem;
  sizes: string;
  class?: string;
}
const { item, sizes, class: className = '' } = Astro.props;
const poster = item.type === 'poster';
const accents = {
  initiative: 'coral',
  event: 'teal',
  news: 'navy',
  announcement: 'mustard',
  report: 'terracotta',
  video: 'coral',
  poster: 'mustard',
} as const;
const icons = {
  initiative: Sparkles,
  event: CalendarDays,
  news: Newspaper,
  announcement: Megaphone,
  report: FileText,
  video: Play,
  poster: ImageIcon,
} as const;
const Icon = icons[item.type] ?? BookOpen;
---

<div
  class:list={['matin-media', poster && 'matin-media--poster', className]}
  data-accent={accents[item.type]}
>
  {item.image ? (
    <Picture
      src={item.image}
      alt={item.imageAlt}
      formats={['avif', 'webp']}
      widths={[480, 720, 960, 1280]}
      sizes={sizes}
    />
  ) : (
    <DialogueArt accent={accents[item.type]} seed={item.id} class="matin-media__art">
      <span class="matin-media__icon">
        <Icon size={30} stroke-width={1.6} aria-hidden="true" />
      </span>
    </DialogueArt>
  )}
  {item.type === 'video' && (
    <span class="matin-media__play" aria-hidden="true">
      <Play size={30} fill="currentColor" />
    </span>
  )}
</div>

<style>
  .matin-media {
    position: relative;
    overflow: hidden;
    background: var(--color-tint);
  }
  .matin-media :global(picture),
  .matin-media :global(img),
  .matin-media :global(.matin-media__art) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .matin-media :global(img) {
    object-fit: cover;
  }
  /* Posters are never cropped: the whole poster on a cream ground. */
  .matin-media--poster :global(img) {
    object-fit: contain;
    padding: 1rem;
  }
  .matin-media__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .matin-media__icon :global(svg) {
    box-sizing: content-box;
    padding: 1rem;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-primary);
  }
  /* Round play badge (navy on white, 11.9:1). */
  .matin-media__play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-white) 92%, transparent);
    color: var(--color-primary);
    box-shadow: 0 8px 24px -10px color-mix(in srgb, var(--color-ink) 60%, transparent);
  }
  .matin-media__play :global(svg) {
    margin-inline-start: 0.2rem;
  }
</style>
