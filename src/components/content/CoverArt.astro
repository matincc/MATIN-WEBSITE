---
/**
 * Branded illustrated cover used when an entry has no photo yet: the dialogue motif
 * (overlapping circles) in an accent tied to the category, with the category icon on a
 * white disc. Decorative.
 */
import CategoryIcon from './CategoryIcon.astro';
import DialogueArt from '@/components/brand/DialogueArt.astro';
import type { Category } from '@/lib/taxonomy';

interface Props {
  category: Category;
  seed?: string;
  class?: string;
}
const { category, seed = category, class: className = '' } = Astro.props;
const accents = {
  language: 'teal',
  arts: 'coral',
  youth: 'mustard',
  community: 'terracotta',
  newcomers: 'teal',
  lectures: 'navy',
  music: 'coral',
  celebration: 'mustard',
} as const;
---

<DialogueArt accent={accents[category]} seed={seed} class:list={['cover-art', className]}>
  <div class="cover-art__icon">
    <CategoryIcon category={category} size={40} strokeWidth={1.5} />
  </div>
</DialogueArt>

<style>
  .cover-art__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .cover-art__icon > :global(svg) {
    box-sizing: content-box;
    padding: 1.1rem;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-primary);
  }
</style>
