---
/**
 * The small flat drawing beside a seasonal greeting (SeasonalBand.astro): one per
 * occasion, palette colours only, decorative. Simple shapes, no faces, no food.
 */
interface Props {
  motif: 'lantern' | 'poppy' | 'diya' | 'lights' | 'moon' | 'tree' | 'sparkle';
}
const { motif } = Astro.props;
---

<svg class="motif" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
  {motif === 'lantern' && (
    <g>
      <circle cx="60" cy="60" r="56" fill="var(--matin-nuit)" />
      <circle cx="90" cy="30" r="9" fill="var(--matin-ivoire)" opacity="0.9" />
      <path
        d="M58 40 C58 32 62 26 68 22"
        fill="none"
        stroke="var(--matin-firouzeh)"
        stroke-width="5"
        stroke-linecap="round"
      />
      <ellipse cx="44" cy="68" rx="18" ry="26" fill="var(--matin-brique)" />
      <ellipse cx="76" cy="68" rx="18" ry="26" fill="var(--matin-brique)" />
      <ellipse cx="60" cy="68" rx="16" ry="28" fill="var(--matin-soleil)" />
      <path d="M60 40 L60 96" stroke="var(--matin-brique)" stroke-width="2" opacity="0.5" />
    </g>
  )}
  {motif === 'poppy' && (
    <g>
      <circle cx="60" cy="60" r="56" fill="var(--matin-sable)" />
      <path
        d="M60 64 C58 84 54 96 50 108"
        fill="none"
        stroke="var(--matin-encre)"
        stroke-width="4"
        stroke-linecap="round"
      />
      <circle cx="46" cy="48" r="17" fill="var(--matin-brique)" />
      <circle cx="74" cy="48" r="17" fill="var(--matin-brique)" />
      <circle cx="46" cy="72" r="17" fill="var(--matin-brique)" />
      <circle cx="74" cy="72" r="17" fill="var(--matin-brique)" />
      <circle cx="60" cy="60" r="9" fill="var(--matin-encre)" />
    </g>
  )}
  {motif === 'diya' && (
    <g>
      <circle cx="60" cy="60" r="56" fill="var(--matin-aube)" />
      <path d="M60 30 C70 44 68 56 60 60 C52 56 50 44 60 30 Z" fill="var(--matin-soleil)" />
      <path d="M60 40 C64 48 63 54 60 56 C57 54 56 48 60 40 Z" fill="var(--matin-ivoire)" />
      <path d="M26 66 L94 66 C90 84 76 92 60 92 C44 92 30 84 26 66 Z" fill="var(--matin-brique)" />
      <path
        d="M36 76 L84 76"
        stroke="var(--matin-soleil)"
        stroke-width="3"
        stroke-linecap="round"
      />
    </g>
  )}
  {motif === 'lights' && (
    <g>
      <circle cx="60" cy="60" r="56" fill="var(--matin-firouzeh-pale)" />
      {[24, 34, 44, 54, 66, 76, 86, 96].map((x) => (
        <g>
          <rect x={x - 3} y="58" width="6" height="26" rx="2" fill="var(--matin-firouzeh)" />
          <path
            d={`M${x} 44 C${x + 5} 50 ${x + 4} 55 ${x} 56 C${x - 4} 55 ${x - 5} 50 ${x} 44 Z`}
            fill="var(--matin-soleil)"
          />
        </g>
      ))}
      <rect x="18" y="84" width="84" height="6" rx="3" fill="var(--matin-encre)" />
    </g>
  )}
  {motif === 'moon' && (
    <g>
      <circle cx="60" cy="60" r="56" fill="var(--matin-nuit)" />
      <path d="M72 28 A34 34 0 1 0 72 92 A27 27 0 1 1 72 28 Z" fill="var(--matin-soleil)" />
      <circle cx="84" cy="44" r="3" fill="var(--matin-ivoire)" />
      <circle cx="94" cy="66" r="2" fill="var(--matin-ivoire)" />
      <circle cx="78" cy="80" r="2.5" fill="var(--matin-ivoire)" />
      <circle cx="34" cy="26" r="2" fill="var(--matin-ivoire)" />
    </g>
  )}
  {motif === 'tree' && (
    <g>
      <circle cx="60" cy="60" r="56" fill="var(--matin-sable)" />
      <path d="M60 24 L86 62 L34 62 Z" fill="var(--matin-firouzeh)" />
      <path d="M60 42 L94 88 L26 88 Z" fill="var(--matin-firouzeh-ink)" />
      <rect x="54" y="88" width="12" height="12" fill="var(--matin-brique)" />
      <path
        d="M60 12 L63 20 L71 20 L65 25 L67 33 L60 28 L53 33 L55 25 L49 20 L57 20 Z"
        fill="var(--matin-soleil)"
      />
      <circle cx="48" cy="76" r="3.5" fill="var(--matin-soleil)" />
      <circle cx="70" cy="70" r="3.5" fill="var(--matin-brique)" />
      <circle cx="62" cy="54" r="3" fill="var(--matin-soleil)" />
    </g>
  )}
  {motif === 'sparkle' && (
    <g>
      <circle cx="60" cy="60" r="56" fill="var(--matin-encre)" />
      <path
        d="M58 22 C60 46 66 54 88 56 C66 58 60 66 58 92 C56 66 50 58 28 56 C50 54 56 46 58 22 Z"
        fill="var(--matin-soleil)"
      />
      <path
        d="M88 24 C89 32 91 34 98 35 C91 36 89 38 88 46 C87 38 85 36 78 35 C85 34 87 32 88 24 Z"
        fill="var(--matin-ivoire)"
      />
      <path
        d="M32 78 C33 84 35 86 40 87 C35 88 33 90 32 96 C31 90 29 88 24 87 C29 86 31 84 32 78 Z"
        fill="var(--matin-brique)"
      />
    </g>
  )}
</svg>

<style>
  .motif {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
