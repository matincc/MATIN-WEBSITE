---
/**
 * Agenda card for every kind of event. Matin's own and co-organized events link to their
 * page on this site; selected external events name their organizer and link out to the
 * organizer's page (Matin never hosts registration for them).
 * Colour: the top stripe, date block and subject label take the subject's accent; Matin's
 * own events also get a navy outline and a solid navy label, selected events an outlined one.
 * In Matin's Picks (`picked`, owner's brief Oct 25 2026): a warm sand card with a deep teal
 * top edge, larger text, a gentle enlargement on hover and a round (+) button over the
 * image that opens it in the page's fullscreen viewer (Lightbox.astro, `lightboxGroup`).
 */
import RemoteEventImage from '@/components/content/RemoteEventImage.astro';
import { Picture, getImage } from 'astro:assets';
import {
  BookOpen,
  Building,
  MapPinned,
  CalendarDays,
  ExternalLink,
  Landmark,
  Languages,
  MapPin,
  MessagesSquare,
  MonitorPlay,
  Palette,
  Plus,
  Star,
  Ticket,
  Users,
} from '@lucide/astro';
import DialogueArt from '@/components/brand/DialogueArt.astro';
import type { EventEntry } from '@/lib/content';
import { cityOf, isMatinEvent, placeName, slugOf } from '@/lib/content';
import { baseLang, href as link, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { dateBadge, formatDate, formatWhen } from '@/lib/dates';

interface Props {
  event: EventEntry;
  lang: UiLang;
  headingLevel?: 'h2' | 'h3';
  /** Shown in Matin's Picks: adds the "Selected by Matin" label. */
  picked?: boolean;
  /** Group name for the fullscreen viewer: the image becomes a link that opens it. */
  lightboxGroup?: string;
  /** « row »: image beside the text (Events page, owner Nov 1 2026: shorter boxes);
      « compact »: the same, with only date, place and the button (upcoming list). */
  layout?: 'card' | 'row' | 'compact';
}
const {
  event,
  lang,
  headingLevel = 'h3',
  picked = false,
  lightboxGroup,
  layout = 'card',
} = Astro.props;
const t = useTranslations(lang);
const d = event.data;
const tz = d.timeZone;
const ours = isMatinEvent(event);
const href = ours ? link('events', lang, slugOf(event, baseLang(lang))) : d.eventUrl;
const badge = dateBadge(event.startDate, lang, tz);
const Heading = headingLevel;
const price =
  d.price.type === 'free'
    ? t('events.free')
    : d.price.type === 'paid'
      ? pick(d.price.label, lang) || t('events.paid')
      : t('events.priceUnknown');
const place = [
  d.format !== 'online' && placeName(event, lang),
  cityOf(event, lang),
  d.country !== 'Canada' && d.country,
]
  .filter(Boolean)
  .join(', ');
const why = pick(d.whyItMatters, lang);
const verified = d.lastVerified && formatDate(new Date(d.lastVerified), lang);
const accents = {
  dialogue: 'coral',
  community: 'terracotta',
  arts: 'mustard',
  cities: 'teal',
  policy: 'teal',
  research: 'navy',
} as const;
const accent = accents[d.subject] ?? 'navy';
// Without an event image, the card opens with the dialogue motif and the subject's icon.
const subjectIcons = {
  dialogue: MessagesSquare,
  community: Users,
  arts: Palette,
  cities: MapPinned,
  policy: Landmark,
  research: BookOpen,
} as const;
const SubjectIcon = subjectIcons[d.subject] ?? MessagesSquare;
const title = pick(d.title, lang) ?? '';
// Large version for the viewer (never wider than the original).
const large =
  lightboxGroup && d.image
    ? (await getImage({ src: d.image, format: 'webp', width: Math.min(d.image.width, 1800) })).src
    : undefined;
---

<article
  class:list={[
    'card card-lift agenda-card',
    { 'is-cancelled': d.status === 'cancelled', 'is-matin': ours, 'agenda-card--pick': picked },
    layout !== 'card' && `agenda-card--row agenda-card--${layout}`,
  ]}
  data-accent={accent}
  data-event-end={event.endDate.toISOString()}
>
  {!d.image && d.remoteImage && (
    <RemoteEventImage
      image={d.remoteImage}
      alt={pick(d.imageAlt, lang) ?? ''}
      class="agenda-image"
    />
  )}
  {!d.image && !d.remoteImage && (
    <DialogueArt accent={accent} seed={event.id} class="agenda-image agenda-image--art">
      <span class="agenda-art-icon">
        <SubjectIcon size={30} stroke-width={1.6} aria-hidden="true" />
      </span>
    </DialogueArt>
  )}
  {d.image && !large && (
    <div class="agenda-image">
      <Picture
        src={d.image}
        alt={pick(d.imageAlt, lang) ?? ''}
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 28rem, (min-width: 768px) 45vw, 100vw"
      />
    </div>
  )}
  {d.image && large && (
    <a
      href={large}
      class="agenda-image agenda-zoom"
      data-lightbox={lightboxGroup}
      data-alt={pick(d.imageAlt, lang) ?? ''}
      data-caption={title}
      aria-label={t('gallery.openImage', { title })}
    >
      <Picture
        src={d.image}
        alt=""
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 28rem, (min-width: 768px) 45vw, 100vw"
      />
      <span class="agenda-zoom__icon" aria-hidden="true">
        <Plus size={24} stroke-width={2.5} />
      </span>
    </a>
  )}
  <div class="flex items-start gap-4">
    <div class="date-badge" aria-hidden="true">
      <span class="date-badge__day">{badge.day}</span>
      <span class="date-badge__month">{badge.month.replace('.', '')}</span>
    </div>
    <div class="flex flex-wrap gap-2 pt-1">
      {picked && (
        <span class="pill pill--pick">
          <Star size={14} aria-hidden="true" />
          {t('events.selectedByMatin')}
        </span>
      )}
      <span class:list={['pill', ours ? 'pill--matin' : 'pill--selected']}>
        {t(`agendaKinds.${d.kind}`)}
      </span>
      {d.status !== 'scheduled' && (
        <span class="pill pill--status">{t(`agendaStatus.${d.status}`)}</span>
      )}
    </div>
  </div>

  <p class="agenda-subject">{t(`agendaSubjects.${d.subject}`)}</p>
  <Heading class="agenda-title">{title}</Heading>

  <ul class="agenda-meta">
    <li>
      <CalendarDays size={17} aria-hidden="true" />
      <span>
        <time datetime={event.startDate.toISOString()}>
          {formatWhen(event.startDate, d.end ? event.endDate : undefined, lang, {
            allDay: d.allDay,
            timeZone: tz,
          })}
        </time>
      </span>
    </li>
    <li>
      {d.format === 'online' ? (
        <MonitorPlay size={17} aria-hidden="true" />
      ) : (
        <MapPin size={17} aria-hidden="true" />
      )}
      <span>
        {d.format === 'online' ? t('agendaFormats.online') : place}
        {d.format === 'hybrid' && ` · ${t('agendaFormats.online')}`}
      </span>
    </li>
    <li>
      <Building size={17} aria-hidden="true" />
      <span>
        {t('events.organizedBy')} <strong>{d.organizer.name}</strong>
      </span>
    </li>
    {d.language && (
      <li>
        <Languages size={17} aria-hidden="true" />
        <span>{t(`agendaLanguages.${d.language}`)}</span>
      </li>
    )}
    <li>
      <Ticket size={17} aria-hidden="true" />
      <span>{price}</span>
    </li>
  </ul>

  <p class="agenda-summary">{pick(d.summary, lang)}</p>

  {why && (
    <p class="agenda-why">
      <strong>{t('events.whyItMatters')}</strong>
      {why}
    </p>
  )}

  <div class="mt-auto flex flex-col gap-3 pt-2">
    {href && (
      <a
        href={href}
        class:list={['btn agenda-cta', picked ? 'btn-primary' : 'btn-outline']}
        target={ours ? undefined : '_blank'}
        rel={ours ? undefined : 'noopener noreferrer'}
      >
        {ours ? t('events.details') : t('events.viewExternal')}
        {!ours && <ExternalLink size={16} aria-hidden="true" />}
        {!ours && <span class="sr-only">{t('a11y.externalLink')}</span>}
      </a>
    )}
    {!ours && verified && (
      <p class="agenda-checked">{t('events.lastChecked', { date: verified })}</p>
    )}
  </div>
</article>

<style>
  .agenda-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    padding: 1.75rem;
    overflow: hidden;
    border-block-start: 6px solid var(--accent);
  }
  /* Matin's own and co-organized events: navy outline all around. */
  .agenda-card.is-matin {
    border: 2px solid var(--color-primary);
    border-block-start: 6px solid var(--accent);
  }
  .agenda-image {
    margin: -1.75rem -1.75rem 0.25rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .agenda-card :global(.remote-img.agenda-image) {
    margin: -1.75rem -1.75rem 0.25rem;
    aspect-ratio: 16 / 9;
  }
  .agenda-card :global(.agenda-image--art) {
    margin: -1.75rem -1.75rem 0.25rem;
    height: clamp(8rem, 6rem + 4vw, 10rem);
  }
  .agenda-art-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .agenda-art-icon :global(svg) {
    box-sizing: content-box;
    padding: 0.9rem;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-primary);
  }
  .agenda-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .agenda-card:hover .agenda-image :global(img) {
    transform: scale(1.05);
  }
  /* Date block on a light wash of the subject's accent (navy text, 7:1 or more). */
  .date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 5rem;
    padding: 0.65rem 0.85rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--accent) 20%, var(--color-white));
  }
  .date-badge__day {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
  }
  .date-badge__month {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .pill {
    display: inline-block;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.4;
  }
  /* Solid navy with mustard text (5.3:1) for Matin; outlined for selected events. */
  .pill--matin {
    background: var(--color-primary);
    color: var(--color-gold);
  }
  /* Matin's Picks: navy with mustard (5.3:1), with a small star. */
  .pill--pick {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-primary);
    color: var(--color-gold);
  }
  .pill--pick :global(svg) {
    fill: currentColor;
  }
  .pill--selected {
    border: 1.5px solid var(--color-primary);
    background: var(--color-white);
    color: var(--color-primary);
  }
  .pill--status {
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
  }
  .agenda-subject {
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .agenda-title {
    font-size: clamp(1.35rem, 1.2rem + 0.45vw, 1.6rem);
    line-height: 1.25;
    font-weight: 800;
    text-wrap: balance;
  }
  .is-cancelled .agenda-title {
    text-decoration: line-through;
    text-decoration-color: var(--color-gold);
  }
  .agenda-meta {
    display: grid;
    gap: 0.45rem;
    font-size: 1rem;
    color: var(--color-ink);
  }
  .agenda-meta li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  /* Date and place first, in bold: what visitors scan for. */
  .agenda-meta li:nth-child(-n + 2) {
    font-weight: 700;
    color: var(--color-primary);
  }
  .agenda-meta :global(svg) {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--color-primary);
  }
  .agenda-summary {
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .agenda-why {
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--accent);
    font-size: 1rem;
    line-height: 1.55;
  }
  .agenda-why strong {
    display: block;
    color: var(--color-primary);
  }
  .agenda-cta {
    align-self: flex-start;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    font-size: 1rem;
  }
  .agenda-checked {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  /* The (+) over a zoomable image (Matin's Picks), as on the Gallery posters. */
  .agenda-zoom {
    position: relative;
    display: block;
    cursor: zoom-in;
  }
  .agenda-zoom__icon {
    position: absolute;
    inset-block-end: 0.85rem;
    inset-inline-end: 0.85rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    box-shadow: 0 6px 18px -6px color-mix(in srgb, var(--color-primary) 70%, transparent);
    transition:
      opacity 0.3s,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* With a mouse it appears on hover or keyboard focus; on touch screens it stays visible. */
  @media (hover: hover) and (pointer: fine) {
    .agenda-zoom__icon {
      opacity: 0;
      transform: scale(0.8);
    }
    .agenda-card:hover .agenda-zoom__icon,
    .agenda-zoom:focus-visible .agenda-zoom__icon {
      opacity: 1;
      transform: scale(1);
    }
  }
  .agenda-zoom:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: -3px;
  }

  /* Matin's Picks: warm ivory surface (lighter than the cream band around it), deep teal
     top edge, navy date block, larger text. */
  .agenda-card--pick {
    gap: 1rem;
    padding: 1.9rem;
    background: var(--color-ivory);
    border-color: var(--color-card-edge);
    box-shadow: 0 10px 28px -20px color-mix(in srgb, var(--color-primary) 45%, transparent);
    border-block-start: 6px solid var(--color-teal-deep);
  }
  .agenda-card--pick.is-matin {
    border-block-start-color: var(--color-teal-deep);
  }
  .agenda-card--pick .agenda-image,
  .agenda-card--pick :global(.agenda-image--art) {
    margin: -1.9rem -1.9rem 0.35rem;
    border-block-end: 4px solid var(--color-gold);
  }
  .agenda-card--pick .date-badge {
    background: var(--color-primary);
  }
  .agenda-card--pick .date-badge__day {
    color: var(--color-white);
  }
  .agenda-card--pick .date-badge__month {
    color: var(--color-gold);
  }
  .agenda-card--pick .pill {
    font-size: 0.9375rem;
  }
  .agenda-card--pick .pill--selected {
    background: var(--color-paper);
  }
  .agenda-card--pick .agenda-subject {
    font-size: 0.9375rem;
    color: var(--color-teal-deep);
  }
  .agenda-card--pick .agenda-title {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    line-height: 1.2;
  }
  .agenda-card--pick .agenda-meta {
    gap: 0.6rem;
    padding: 1rem 1.15rem;
    border-radius: 1rem;
    background: var(--color-white);
    font-size: 1.0625rem;
  }
  .agenda-card--pick .agenda-meta :global(svg) {
    color: var(--color-teal-deep);
  }
  .agenda-card--pick .agenda-summary {
    font-size: 1.125rem;
    line-height: 1.7;
  }
  .agenda-card--pick .agenda-why {
    padding: 0.9rem 1.1rem;
    border-inline-start: 4px solid var(--color-gold);
    border-start-end-radius: 0.75rem;
    border-end-end-radius: 0.75rem;
    background: var(--color-champagne);
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .agenda-card--pick .agenda-cta {
    min-height: 3rem;
    font-size: 1.0625rem;
  }
  .agenda-card--pick .agenda-checked {
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  /* Gentle enlargement on hover (desktop pointer only, never with reduced motion). */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .agenda-card--pick.card-lift:hover {
      transform: scale(1.03);
      box-shadow: 0 22px 40px -22px color-mix(in srgb, var(--color-primary) 55%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .agenda-zoom__icon,
    .agenda-image :global(img) {
      transition: none;
    }
    .agenda-card:hover .agenda-image :global(img) {
      transform: none;
    }
  }

  /* ---------- Row layouts (owner, Nov 1 2026: « boxes too long and tall ») ----------
     From 40rem the image sits beside the text, filling the card's height; the text is
     shortened. Below 40rem the card keeps its usual vertical layout. */
  @media (min-width: 40rem) {
    .agenda-card--row:not(#o) {
      --pad: 1.6rem;
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-auto-rows: min-content;
      align-content: start;
      column-gap: 1.6rem;
      row-gap: 0.6rem;
      padding: var(--pad);
      height: 100%;
    }
    .agenda-card--row > :global(*) {
      grid-column: 2;
    }
    .agenda-card--row > .agenda-image:not(#o),
    .agenda-card--row > :global(.agenda-image):not(#o) {
      grid-column: 1;
      grid-row: 1 / span 12;
      align-self: stretch;
      aspect-ratio: auto;
      height: auto;
      min-height: 100%;
      /* Logical margins so the bleed goes to the card's outer edge in RTL (Persian) too. */
      margin-block: calc(var(--pad) * -1);
      margin-inline: calc(var(--pad) * -1) 0;
      border-block-end: 0;
    }
    .agenda-card--row .agenda-image :global(picture),
    .agenda-card--row .agenda-image :global(img) {
      height: 100%;
    }
    .agenda-card--row .agenda-title:not(#o) {
      font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.45rem);
    }
    .agenda-card--row .agenda-summary:not(#o),
    .agenda-card--row .agenda-why:not(#o) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }
    .agenda-card--row .agenda-why:not(#o) {
      -webkit-line-clamp: 2;
    }
    .agenda-card--row .agenda-meta:not(#o) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 1.1rem;
      padding: 0;
      background: none;
      font-size: 1rem;
    }
    /* Picks and upcoming rows: only the date and the place. */
    .agenda-card--row:is(.agenda-card--pick, .agenda-card--compact) .agenda-meta > li:nth-child(n + 3),
    .agenda-card--row .agenda-checked:not(#o) {
      display: none;
    }
    .agenda-card--row .mt-auto {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 1rem;
    }
    .agenda-card--compact:not(#o) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
    .agenda-card--compact :is(.agenda-summary, .agenda-why, .agenda-checked, .agenda-subject):not(#o),
    .agenda-card--compact .agenda-meta > li:nth-child(n + 3) {
      display: none;
    }
  }
</style>
