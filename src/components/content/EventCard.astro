---
/**
 * Agenda card for every kind of event. Matin's own and co-organized events link to their
 * page on this site; selected external events name their organizer and link out to the
 * organizer's page (Matin never hosts registration for them).
 * Colour: the top stripe, date block and subject label take the subject's accent; Matin's
 * own events also get a navy outline and a solid navy label, selected events an outlined one.
 */
import { Picture } from 'astro:assets';
import {
  BookOpen,
  Building,
  MapPinned,
  CalendarDays,
  ExternalLink,
  Landmark,
  Languages,
  MapPin,
  MessagesSquare,
  MonitorPlay,
  Palette,
  Star,
  Ticket,
  Users,
} from '@lucide/astro';
import DialogueArt from '@/components/brand/DialogueArt.astro';
import type { EventEntry } from '@/lib/content';
import { cityOf, isMatinEvent, placeName, slugOf } from '@/lib/content';
import { baseLang, href as link, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { dateBadge, formatDate, formatWhen } from '@/lib/dates';

interface Props {
  event: EventEntry;
  lang: UiLang;
  headingLevel?: 'h2' | 'h3';
  /** Shown in Matin's Picks: adds the "Selected by Matin" label. */
  picked?: boolean;
}
const { event, lang, headingLevel = 'h3', picked = false } = Astro.props;
const t = useTranslations(lang);
const d = event.data;
const tz = d.timeZone;
const ours = isMatinEvent(event);
const href = ours ? link('events', lang, slugOf(event, baseLang(lang))) : d.eventUrl;
const badge = dateBadge(event.startDate, lang, tz);
const Heading = headingLevel;
const price =
  d.price.type === 'free'
    ? t('events.free')
    : d.price.type === 'paid'
      ? pick(d.price.label, lang) || t('events.paid')
      : t('events.priceUnknown');
const place = [
  d.format !== 'online' && placeName(event, lang),
  cityOf(event, lang),
  d.country !== 'Canada' && d.country,
]
  .filter(Boolean)
  .join(', ');
const why = pick(d.whyItMatters, lang);
const verified = d.lastVerified && formatDate(new Date(d.lastVerified), lang);
const accents = {
  dialogue: 'coral',
  community: 'terracotta',
  arts: 'mustard',
  cities: 'teal',
  policy: 'teal',
  research: 'navy',
} as const;
const accent = accents[d.subject] ?? 'navy';
// Without an event image, the card opens with the dialogue motif and the subject's icon.
const subjectIcons = {
  dialogue: MessagesSquare,
  community: Users,
  arts: Palette,
  cities: MapPinned,
  policy: Landmark,
  research: BookOpen,
} as const;
const SubjectIcon = subjectIcons[d.subject] ?? MessagesSquare;
---

<article
  class:list={[
    'card card-lift agenda-card',
    { 'is-cancelled': d.status === 'cancelled', 'is-matin': ours },
  ]}
  data-accent={accent}
  data-event-end={event.endDate.toISOString()}
>
  {!d.image && (
    <DialogueArt accent={accent} seed={event.id} class="agenda-image agenda-image--art">
      <span class="agenda-art-icon">
        <SubjectIcon size={30} stroke-width={1.6} aria-hidden="true" />
      </span>
    </DialogueArt>
  )}
  {d.image && (
    <div class="agenda-image">
      <Picture
        src={d.image}
        alt={pick(d.imageAlt, lang) ?? ''}
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 28rem, (min-width: 768px) 45vw, 100vw"
      />
    </div>
  )}
  <div class="flex items-start gap-4">
    <div class="date-badge" aria-hidden="true">
      <span class="date-badge__day">{badge.day}</span>
      <span class="date-badge__month">{badge.month.replace('.', '')}</span>
    </div>
    <div class="flex flex-wrap gap-2 pt-1">
      {picked && (
        <span class="pill pill--pick">
          <Star size={14} aria-hidden="true" />
          {t('events.selectedByMatin')}
        </span>
      )}
      <span class:list={['pill', ours ? 'pill--matin' : 'pill--selected']}>
        {t(`agendaKinds.${d.kind}`)}
      </span>
      {d.status !== 'scheduled' && (
        <span class="pill pill--status">{t(`agendaStatus.${d.status}`)}</span>
      )}
    </div>
  </div>

  <p class="agenda-subject">{t(`agendaSubjects.${d.subject}`)}</p>
  <Heading class="agenda-title">{pick(d.title, lang)}</Heading>

  <ul class="agenda-meta">
    <li>
      <CalendarDays size={17} aria-hidden="true" />
      <span>
        <time datetime={event.startDate.toISOString()}>
          {formatWhen(event.startDate, d.end ? event.endDate : undefined, lang, {
            allDay: d.allDay,
            timeZone: tz,
          })}
        </time>
      </span>
    </li>
    <li>
      {d.format === 'online' ? (
        <MonitorPlay size={17} aria-hidden="true" />
      ) : (
        <MapPin size={17} aria-hidden="true" />
      )}
      <span>
        {d.format === 'online' ? t('agendaFormats.online') : place}
        {d.format === 'hybrid' && ` · ${t('agendaFormats.online')}`}
      </span>
    </li>
    <li>
      <Building size={17} aria-hidden="true" />
      <span>
        {t('events.organizedBy')} <strong>{d.organizer.name}</strong>
      </span>
    </li>
    {d.language && (
      <li>
        <Languages size={17} aria-hidden="true" />
        <span>{t(`agendaLanguages.${d.language}`)}</span>
      </li>
    )}
    <li>
      <Ticket size={17} aria-hidden="true" />
      <span>{price}</span>
    </li>
  </ul>

  <p class="agenda-summary">{pick(d.summary, lang)}</p>

  {why && (
    <p class="agenda-why">
      <strong>{t('events.whyItMatters')}</strong>
      {why}
    </p>
  )}

  <div class="mt-auto flex flex-col gap-3 pt-2">
    {href && (
      <a
        href={href}
        class="btn btn-outline agenda-cta"
        target={ours ? undefined : '_blank'}
        rel={ours ? undefined : 'noopener noreferrer'}
      >
        {ours ? t('events.details') : t('events.viewExternal')}
        {!ours && <ExternalLink size={16} aria-hidden="true" />}
        {!ours && <span class="sr-only">{t('a11y.externalLink')}</span>}
      </a>
    )}
    {!ours && verified && (
      <p class="agenda-checked">{t('events.lastChecked', { date: verified })}</p>
    )}
  </div>
</article>

<style>
  .agenda-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    padding: 1.75rem;
    overflow: hidden;
    border-block-start: 6px solid var(--accent);
  }
  /* Matin's own and co-organized events: navy outline all around. */
  .agenda-card.is-matin {
    border: 2px solid var(--color-primary);
    border-block-start: 6px solid var(--accent);
  }
  .agenda-image {
    margin: -1.75rem -1.75rem 0.25rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .agenda-card :global(.agenda-image--art) {
    margin: -1.75rem -1.75rem 0.25rem;
    height: clamp(8rem, 6rem + 4vw, 10rem);
  }
  .agenda-art-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .agenda-art-icon :global(svg) {
    box-sizing: content-box;
    padding: 0.9rem;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-primary);
  }
  .agenda-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .agenda-card:hover .agenda-image :global(img) {
    transform: scale(1.05);
  }
  /* Date block on a light wash of the subject's accent (navy text, 7:1 or more). */
  .date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 5rem;
    padding: 0.65rem 0.85rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--accent) 20%, var(--color-white));
  }
  .date-badge__day {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
  }
  .date-badge__month {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .pill {
    display: inline-block;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.4;
  }
  /* Solid navy with mustard text (5.3:1) for Matin; outlined for selected events. */
  .pill--matin {
    background: var(--color-primary);
    color: var(--color-gold);
  }
  /* Matin's Picks: navy with mustard (5.3:1), with a small star. */
  .pill--pick {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-primary);
    color: var(--color-gold);
  }
  .pill--pick :global(svg) {
    fill: currentColor;
  }
  .pill--selected {
    border: 1.5px solid var(--color-primary);
    background: var(--color-white);
    color: var(--color-primary);
  }
  .pill--status {
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
  }
  .agenda-subject {
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .agenda-title {
    font-size: clamp(1.35rem, 1.2rem + 0.45vw, 1.6rem);
    line-height: 1.25;
    font-weight: 800;
    text-wrap: balance;
  }
  .is-cancelled .agenda-title {
    text-decoration: line-through;
    text-decoration-color: var(--color-gold);
  }
  .agenda-meta {
    display: grid;
    gap: 0.45rem;
    font-size: 1rem;
    color: var(--color-ink);
  }
  .agenda-meta li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  /* Date and place first, in bold: what visitors scan for. */
  .agenda-meta li:nth-child(-n + 2) {
    font-weight: 700;
    color: var(--color-primary);
  }
  .agenda-meta :global(svg) {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--color-primary);
  }
  .agenda-summary {
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .agenda-why {
    padding-inline-start: 0.9rem;
    border-inline-start: 3px solid var(--accent);
    font-size: 1rem;
    line-height: 1.55;
  }
  .agenda-why strong {
    display: block;
    color: var(--color-primary);
  }
  .agenda-cta {
    align-self: flex-start;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    font-size: 1rem;
  }
  .agenda-checked {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
