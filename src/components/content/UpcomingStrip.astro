---
/**
 * "Coming up" (Matin Alive, owner's brief Oct 27 2026): the next activities of the
 * agenda in one horizontal strip right under the hero, so upcoming dates are visible at
 * once. Same data as the Events page (src/content/events/): Matin's own events link to
 * their page, selected events to the organizer, clearly labelled. Hidden when the agenda
 * is empty; ExpireEvents hides any item that ends between two builds.
 */
import { ArrowRight, ChevronLeft, ChevronRight, ExternalLink } from '@lucide/astro';
import { baseLang, href as link, type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import { aliveStrings } from '@/i18n/alive';
import { cityOf, forLang, getUpcomingEvents, isMatinEvent, slugOf } from '@/lib/content';
import { dateBadge } from '@/lib/dates';

interface Props {
  lang: UiLang;
  limit?: number;
}
const { lang, limit = 8 } = Astro.props;
const t = useTranslations(lang);
const a = aliveStrings(lang);
// Owner's request (Oct 30 2026): "Coming up" must never show a date already past.
// Selected (external) events appear only until they START (a festival under way keeps
// its place on the Events page and in Matin's Picks); Matin's own activities stay until
// they end and always come first.
const now = new Date();
const events = forLang(await getUpcomingEvents(), lang)
  .filter((e) => e.data.status !== 'cancelled')
  .filter((e) => isMatinEvent(e) || e.startDate >= now)
  .sort((x, y) => Number(isMatinEvent(y)) - Number(isMatinEvent(x)))
  .slice(0, limit)
  .map((e) => {
    const ours = isMatinEvent(e);
    return {
      id: e.id,
      ours,
      // Read by ExpireEvents between builds: an external item hides once it has begun.
      end: (ours ? e.endDate : e.startDate).toISOString(),
      href: ours ? link('events', lang, slugOf(e, baseLang(lang))) : e.data.eventUrl,
      title: pick(e.data.title, lang) ?? '',
      city: cityOf(e, lang),
      badge: dateBadge(e.startDate, lang, e.data.timeZone),
      subject: e.data.subject,
    };
  });
const accents = ['coral', 'gold', 'blue', 'green'] as const;
---

{events.length > 0 && (
  <section class="upcoming" aria-labelledby="upcoming-title" data-upcoming>
    <div class="container-site upcoming__inner">
      <h2 id="upcoming-title" class="upcoming__title">
        <span class="upcoming__pulse" aria-hidden="true"></span>
        {a.upcomingTitle}
      </h2>
      <ul class="upcoming__track" data-upcoming-track data-upcoming-list>
        {events.map((e, i) => (
          <li class="upcoming__item" data-event-end={e.end} data-tone={accents[i % accents.length]}>
            <a
              href={e.href}
              class="upcoming__link"
              target={e.ours ? undefined : '_blank'}
              rel={e.ours ? undefined : 'noopener noreferrer'}
            >
              <span class="upcoming__date" aria-hidden="true">
                <span class="upcoming__day">{e.badge.day}</span>
                <span class="upcoming__month">{e.badge.month}</span>
              </span>
              <span class="upcoming__body">
                <span class:list={['upcoming__kind', e.ours && 'is-matin']}>
                  {e.ours ? a.upcomingMatin : a.upcomingSelected}
                </span>
                <span class="upcoming__name">{e.title}</span>
                <span class="upcoming__city">{e.city}</span>
              </span>
              {!e.ours && (
                <>
                  <ExternalLink size={16} class="upcoming__ext" aria-hidden="true" />
                  <span class="sr-only">{t('a11y.externalLink')}</span>
                </>
              )}
            </a>
          </li>
        ))}
      </ul>
      <div class="upcoming__side">
        <div class="upcoming__nav">
          <button type="button" class="upcoming__btn" data-upcoming-prev>
            <ChevronLeft size={20} class="flip-rtl" aria-hidden="true" />
            <span class="sr-only">{a.upcomingPrev}</span>
          </button>
          <button type="button" class="upcoming__btn" data-upcoming-next>
            <ChevronRight size={20} class="flip-rtl" aria-hidden="true" />
            <span class="sr-only">{a.upcomingNext}</span>
          </button>
        </div>
        <a href={link('events', lang)} class="upcoming__all">
          {t('home.eventsAll')}
          <ArrowRight size={16} class="flip-rtl" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-upcoming]')) {
    const track = root.querySelector<HTMLElement>('[data-upcoming-track]')!;
    const rtl = getComputedStyle(root).direction === 'rtl';
    const step = (dir: number) =>
      track.scrollBy({ left: dir * track.clientWidth * 0.8 * (rtl ? -1 : 1), behavior: 'smooth' });
    root.querySelector('[data-upcoming-prev]')!.addEventListener('click', () => step(-1));
    root.querySelector('[data-upcoming-next]')!.addEventListener('click', () => step(1));
  }
</script>

<style>
  /* Warm cream right under the bright hero photo (owner's request, Oct 29 2026: no
     dark band). */
  .upcoming {
    background: var(--matin-cream);
    color: var(--matin-blue);
  }
  .upcoming__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem 2.5rem;
    padding-block: 1.5rem 1.75rem;
    border-block-start: 4px solid var(--matin-gold);
  }
  .upcoming__title {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--matin-terracotta-deep);
    white-space: nowrap;
  }
  :global(html[lang='fa']) .upcoming__title {
    letter-spacing: 0;
    font-size: 1.1rem;
  }
  /* A soft pulse: the agenda is alive. Stops under reduced motion. */
  .upcoming__pulse {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--alive-coral);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--alive-coral) 60%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .upcoming__pulse {
      animation: upcoming-pulse 2.4s ease-out 3;
    }
  }
  @keyframes upcoming-pulse {
    to {
      box-shadow: 0 0 0 0.75rem transparent;
    }
  }
  .upcoming__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 1fr);
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block: 0.25rem;
  }
  .upcoming__track::-webkit-scrollbar {
    display: none;
  }
  .upcoming__item {
    scroll-snap-align: start;
  }
  /* Quiet rules between the dates instead of boxes. */
  .upcoming__item + .upcoming__item {
    border-inline-start: 1px solid color-mix(in srgb, var(--matin-blue) 18%, transparent);
  }
  .upcoming__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 0.5rem 2.25rem 0.5rem 1.25rem;
    border-radius: 0.75rem;
    color: var(--matin-blue);
    text-decoration: none;
    transition: background 0.3s ease;
  }
  .upcoming__item:first-child .upcoming__link {
    padding-inline-start: 0;
  }
  .upcoming__link:hover {
    background: var(--color-ivory);
  }
  .upcoming__link:hover .upcoming__name {
    text-decoration: underline;
    text-decoration-color: var(--matin-gold);
    text-underline-offset: 0.2em;
  }
  .upcoming__link:focus-visible {
    outline: 3px solid var(--matin-blue);
    outline-offset: 2px;
  }
  .upcoming__date {
    display: grid;
    flex-shrink: 0;
    justify-items: center;
    gap: 0.3rem;
    min-width: 3.2rem;
    padding-inline-end: 1rem;
    border-inline-end: 2px solid var(--tone);
    line-height: 1;
    color: var(--matin-blue);
  }
  [data-tone='coral'] {
    --tone: var(--matin-coral);
  }
  [data-tone='gold'] {
    --tone: var(--matin-gold);
  }
  [data-tone='blue'] {
    --tone: var(--matin-teal);
  }
  [data-tone='green'] {
    --tone: var(--matin-terracotta);
  }
  /* The day in the headline's serif, the month in small capitals. */
  .upcoming__day {
    font-family: var(--font-brand);
    font-size: 2.1rem;
    font-weight: 700;
  }
  :global(html[lang='fa']) .upcoming__day {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.8rem;
  }
  .upcoming__month {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--matin-terracotta-deep);
  }
  .upcoming__body {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
  }
  .upcoming__kind {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--matin-teal-deep);
  }
  .upcoming__kind.is-matin {
    color: var(--matin-terracotta-deep);
  }
  .upcoming__name {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .upcoming__city {
    font-size: 0.85rem;
    color: var(--matin-ink);
  }
  .upcoming__link :global(.upcoming__ext) {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-end: 0.6rem;
    opacity: 0.7;
  }
  .upcoming__side {
    display: grid;
    justify-items: end;
    gap: 0.6rem;
  }
  .upcoming__nav {
    display: flex;
    gap: 0.5rem;
  }
  .upcoming__btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1.5px solid color-mix(in srgb, var(--matin-blue) 45%, transparent);
    color: var(--matin-blue);
  }
  .upcoming__btn:hover {
    background: var(--matin-blue);
    border-color: var(--matin-blue);
    color: var(--matin-white);
  }
  .upcoming__btn:focus-visible,
  .upcoming__all:focus-visible {
    outline: 3px solid var(--matin-blue);
    outline-offset: 2px;
  }
  .upcoming__all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--matin-blue);
    white-space: nowrap;
  }
  @media (max-width: 63.99rem) {
    .upcoming__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .upcoming__track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .upcoming__side {
      grid-row: 1;
      grid-column: 2;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .upcoming__nav {
      display: none;
    }
  }
</style>
