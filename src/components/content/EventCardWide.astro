---
/**
 * Wide, landscape event card for the homepage: image beside the text on larger
 * screens, stacked on phones. Larger title, date and description for readability.
 */
import { Picture } from 'astro:assets';
import { CalendarDays, MapPin } from '@lucide/astro';
import CoverArt from './CoverArt.astro';
import { cityOf, slugOf, type EventEntry } from '@/lib/content';
import { baseLang, href as link, type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import { formatWhen } from '@/lib/dates';
import { subjectCover } from '@/lib/taxonomy';

interface Props {
  event: EventEntry;
  lang: UiLang;
  past?: boolean;
}
const { event, lang, past = false } = Astro.props;
const d = event.data;
const t = useTranslations(lang);
const href = link('events', lang, slugOf(event, baseLang(lang)));
---

<article
  class="event-wide group relative grid overflow-hidden rounded-[var(--radius-card)] border border-line bg-white transition-colors duration-200 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"
  data-event-end={past ? undefined : event.endDate.toISOString()}
>
  <div class="relative aspect-[16/10] sm:aspect-auto sm:min-h-full">
    {d.image ? (
      <Picture
        src={d.image}
        alt={pick(d.imageAlt, lang) ?? ''}
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 40vw, 100vw"
        class="absolute inset-0 size-full object-cover"
      />
    ) : (
      <CoverArt
        category={subjectCover[d.subject]}
        seed={event.id}
        class="absolute inset-0 size-full"
      />
    )}
  </div>
  <div class="flex flex-col gap-3 p-6 sm:p-7">
    <p class="flex items-start gap-2 text-base font-semibold text-gold-dark">
      <CalendarDays size={18} class="mt-1 shrink-0" aria-hidden="true" />
      <span>
        <time datetime={event.startDate.toISOString()}>
          {formatWhen(event.startDate, d.end ? event.endDate : undefined, lang, {
            allDay: d.allDay,
            timeZone: d.timeZone,
          })}
        </time>
      </span>
    </p>
    <h4 class="text-2xl leading-snug font-bold">
      <a
        href={href}
        class="text-primary no-underline after:absolute after:inset-0 after:content-[''] group-hover:text-ink"
      >
        {pick(d.title, lang)}
      </a>
    </h4>
    <p class="text-[1.05rem] text-ink/85">{pick(d.summary, lang)}</p>
    <p class="mt-auto flex items-start gap-2 pt-1 text-[0.95rem] text-muted">
      <MapPin size={17} class="mt-1 shrink-0 text-ink" aria-hidden="true" />
      <span>
        {d.format === 'online'
          ? t('agendaFormats.online')
          : (d.location?.name ?? cityOf(event, lang))}
      </span>
    </p>
  </div>
</article>
