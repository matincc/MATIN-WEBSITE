---
/**
 * The three areas of work as large photo cards, each with its own accent: used on the
 * homepage and on the Programs page. Texts are the approved home.area* strings.
 * With `linked` (homepage), each card links to the Programs page.
 */
import { ArrowRight } from '@lucide/astro';
import { Picture } from 'astro:assets';
import PhotoCredit from '@/components/media/PhotoCredit.astro';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { photos } from '@/lib/photos';

interface Props {
  lang: UiLang;
  linked?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { lang, linked = true, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
const areas = [
  {
    title: t('home.area1Title'),
    text: t('home.area1Text'),
    photo: photos.placejc,
    accent: 'navy',
  },
  {
    title: t('home.area2Title'),
    text: t('home.area2Text'),
    photo: photos.publicart,
    accent: 'mustard',
  },
  { title: t('home.area3Title'), text: t('home.area3Text'), photo: photos.library, accent: 'teal' },
];
---

<ul class="areas-grid areas-grid--loose">
  {areas.map((a, i) => (
    <li data-reveal style={`--reveal-delay:${i * 130}ms`}>
      <article class:list={['area-card', linked && 'card-lift']} data-accent={a.accent}>
        <div class="area-card__media">
          <Picture
            src={a.photo.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[480, 720, 960]}
            sizes="(min-width: 64rem) 28rem, (min-width: 48rem) 45vw, 92vw"
            style={`object-position:${a.photo.focus}`}
          />
          <PhotoCredit credit={a.photo.credit} variant="overlay" />
        </div>
        <div class="area-card__body">
          <Heading class="area-card__title">
            {linked ? (
              <a href={href('programs', lang)} class="area-card__link">
                {a.title}
              </a>
            ) : (
              a.title
            )}
          </Heading>
          <p class="area-card__text">{a.text}</p>
          {linked && (
            <span class="area-card__cta" aria-hidden="true">
              {t('common.learnMore')}
              <ArrowRight size={18} class="flip-rtl" />
            </span>
          )}
        </div>
      </article>
    </li>
  ))}
</ul>

<style>
  /* ---------- Areas of work ---------- */
  .areas-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .areas-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .areas-grid > li:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .areas-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 0.5rem + 1.5vw, 2.5rem);
    }
    /* Editorial stagger: the middle card sits a little lower. */
    .areas-grid > li:nth-child(2) {
      margin-block-start: 3rem;
    }
  }
  /* Less uniform (owner's requests, Oct 28 and 29 2026): the cards sit slightly
     off-straight, like prints laid on a table, and straighten on hover; each has its
     own deep corner (an arch on one side), mirrored on the Persian page. */
  @media (min-width: 48rem) {
    .areas-grid--loose > li:nth-child(1) .area-card {
      rotate: -1.1deg;
    }
    .areas-grid--loose > li:nth-child(2) .area-card {
      rotate: 0.8deg;
    }
    .areas-grid--loose > li:nth-child(3) .area-card {
      rotate: -0.5deg;
    }
    .areas-grid--loose .area-card {
      transition: rotate 0.45s ease;
    }
    .areas-grid--loose .area-card:hover,
    .areas-grid--loose .area-card:focus-within {
      rotate: 0deg;
    }
  }
  .area-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-card);
    background: var(--color-white);
  }
  .areas-grid > li:nth-child(1) .area-card {
    border-start-start-radius: 6rem;
  }
  .areas-grid > li:nth-child(2) .area-card {
    border-end-end-radius: 5rem;
  }
  .areas-grid > li:nth-child(3) .area-card {
    border-start-end-radius: 6rem;
  }
  .area-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-block-end: 6px solid var(--accent);
  }
  .area-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .area-card:hover .area-card__media :global(img) {
    transform: scale(1.05);
  }
  /* Coloured cards, not white (owner, Oct 31 2026): navy, saffron, turquoise. */
  .areas-grid > li:nth-child(3n + 1) .area-card {
    --card-bg: var(--matin-encre);
    --card-fg: var(--matin-white);
  }
  .areas-grid > li:nth-child(3n + 2) .area-card {
    --card-bg: var(--matin-soleil);
    --card-fg: var(--matin-encre);
  }
  .areas-grid > li:nth-child(3n) .area-card {
    --card-bg: var(--matin-firouzeh-ink);
    --card-fg: var(--matin-white);
  }
  .areas-grid .area-card {
    border: 0;
    background: var(--card-bg);
    color: var(--card-fg);
  }
  .areas-grid .area-card :global(.area-card__title),
  .areas-grid .area-card .area-card__link,
  .areas-grid .area-card .area-card__text,
  .areas-grid .area-card .area-card__cta {
    color: var(--card-fg);
  }
  .area-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.75rem, 1.4rem + 1vw, 2.5rem);
  }
  .area-card__title {
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.9rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 48;
    line-height: 1.2;
    text-wrap: balance;
  }
  .area-card__link {
    color: var(--color-primary);
    text-decoration: none;
  }
  /* The whole card is clickable; the photo credit links stay above this layer. */
  .area-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .area-card__link:focus-visible {
    outline: none;
  }
  .area-card:has(.area-card__link:focus-visible) {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }
  .area-card__text {
    font-size: 1.125rem;
    line-height: 1.65;
  }
  .area-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: auto;
    padding-block-start: 0.75rem;
    font-weight: 800;
    font-size: 1.0625rem;
    color: var(--accent-ink);
  }
  .area-card__cta :global(svg) {
    transition: transform 0.2s;
  }
  .area-card:hover .area-card__cta :global(svg) {
    transform: translateX(4px);
  }
  :global([dir='rtl']) .area-card:hover .area-card__cta :global(svg) {
    transform: scaleX(-1) translateX(4px);
  }
</style>
