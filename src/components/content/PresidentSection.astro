---
/**
 * The President on Our Team as a newspaper page (owner, Nov 1 2026: smaller, « like a
 * newspaper », a coloured ground instead of the pale one): a cream sheet on a deep
 * turquoise band, a masthead rule, the name as the headline, the opening sentence as the
 * deck, then the biography in newspaper columns with the portrait set in the first one.
 * Earlier (Oct 29 2026): the opening profile of a magazine, no card. The approved portrait stands on a deep
 * brick colour field that runs to the page edge, and stays in view while the biography is
 * read beside it in one comfortable column (about 20px) instead of small columns. The
 * opening sentence about culture leads, set large in the editorial serif. The LinkedIn link
 * and the President's notes close the text as two quiet invitations.
 * Texts come from src/content/about/about.yaml (president), unchanged. The portrait is
 * src/assets/brand/president.(jpg|png|webp), never altered; without it, his initials.
 * Persian mirrors through logical properties.
 */
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import Prose from '@/components/ui/Prose.astro';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSingleton, initials, renderMarkdown } from '@/lib/content';
import { teamText } from '@/lib/teamStrings';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { president: p } = await getSingleton('about');
const photos = import.meta.glob<ImageMetadata>('/src/assets/brand/president.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const photo = Object.values(photos)[0];
const name = pick(p.displayName, lang) || p.name;
const position = pick(p.position, lang) || pick(p.title, lang);
const bio = lang === 'fa' ? (p.bio?.fa ?? p.bio?.en) : p.bio?.[lang];
// The opening sentence about culture leads; the rest follows in one reading column.
const [bioLead = '', ...bioParts] = (bio ?? '').split(/\n\s*\n/);
const bioRest = bioParts.join('\n\n');
// LinkedIn glyph (simple-icons does not ship it).
const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z';
---

{bio && (
  <section id="our-president" class="pres scroll-mt-24" aria-labelledby="our-president-title" data-own-ground>
    <span class="pres__sun" aria-hidden="true" />
    <div class="container-site">
      <article class="pres__paper">
        <header class="pres__head">
          <p class="pres__kicker">{t('about.ourPresident')}</p>
          <h2 id="our-president-title" class="pres__name">
            {name}
          </h2>
          {position && <p class="pres__position">{position}</p>}
          <Prose html={renderMarkdown(bioLead, lang)} class="pres__lead" />
        </header>

        <div class="pres__cols">
          <figure class="pres__fig">
            {photo ? (
              <Image
                src={photo}
                alt={t('about.presidentPhotoAlt', { name: lang === 'fa' ? name : p.name })}
                widths={[320, 480, 640]}
                sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 40vw, 88vw"
                class="pres__photo"
                loading="eager"
                fetchpriority="high"
              />
            ) : (
              <span class="pres__photo pres__initials" aria-hidden="true">
                {initials(p.name)}
              </span>
            )}
            <figcaption class="pres__caption">{name}{position && ` · ${position}`}</figcaption>
          </figure>
          {bioRest && <Prose html={renderMarkdown(bioRest, lang)} class="pres__bio" />}
        </div>

        <ul class="pres__invites">
          {p.linkedin && (
            <li>
              <a href={p.linkedin} class="pres__invite" target="_blank" rel="noopener noreferrer">
                <span class="pres__badge pres__badge--in" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d={linkedinPath} />
                  </svg>
                </span>
                <span class="pres__invite-text">{t('about.discoverPresident')}</span>
                <ArrowUpRight size={18} aria-hidden="true" class="pres__arrow" />
                <span class="sr-only">{t('a11y.externalLink')}</span>
              </a>
            </li>
          )}
          <li>
            <a href={href('notes', lang)} class="pres__invite">
              <span class="pres__badge pres__badge--notes" aria-hidden="true">
                ”
              </span>
              <span class="pres__invite-text">{teamText('readNotes', lang)}</span>
              <ArrowRight size={18} aria-hidden="true" class="pres__arrow rtl:-scale-x-100" />
            </a>
          </li>
        </ul>
      </article>
    </div>
  </section>
)}

<style>
  /* A deep turquoise band with a saffron sun (owner, Nov 1 2026: the pale ground was
     colourless), holding one cream newspaper sheet. */
  .pres {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    background: var(--matin-firouzeh-ink);
  }
  .pres__sun {
    position: absolute;
    z-index: -1;
    inset-block-start: -7rem;
    inset-inline-end: -5rem;
    width: clamp(14rem, 9rem + 14vw, 24rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--matin-soleil);
  }
  .pres::after {
    /* A terracotta arch rising at the other corner. */
    content: '';
    position: absolute;
    z-index: -1;
    inset-block-end: -6rem;
    inset-inline-start: -4rem;
    width: clamp(12rem, 8rem + 12vw, 20rem);
    aspect-ratio: 1;
    border-radius: 50% 50% 0 0;
    background: var(--matin-brique);
  }
  .pres__paper {
    max-width: 76rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: 0.75rem;
    border-start-end-radius: 4rem;
    background: var(--matin-ivoire);
    box-shadow: 0 30px 50px -30px color-mix(in srgb, var(--matin-nuit) 80%, transparent);
  }

  /* Masthead: kicker over a double rule, the name as the headline, the deck. */
  .pres__head {
    padding-block-end: 1.25rem;
    border-block-end: 1px solid color-mix(in srgb, var(--matin-encre) 35%, transparent);
  }
  .pres__kicker {
    padding-block-end: 0.5rem;
    border-block-end: 4px double var(--matin-encre);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--matin-brique-ink);
  }
  :global(html[lang='fa']) .pres__kicker {
    letter-spacing: 0;
    font-size: 1rem;
  }
  .pres__name {
    margin-block-start: 0.9rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.6rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--matin-encre);
  }
  :global(html[lang='fa']) .pres__name {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0;
  }
  .pres__position {
    margin-block-start: 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    color: var(--matin-firouzeh-ink);
  }
  .pres__head :global(.pres__lead) {
    max-width: 58rem;
    margin-block-start: 1rem;
  }
  .pres__head :global(.pres__lead p) {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.2rem, 1.1rem + 0.45vw, 1.45rem);
    line-height: 1.5;
    color: var(--matin-encre);
  }
  :global(html[lang='fa']) .pres__head :global(.pres__lead p) {
    font-family: inherit;
    font-style: normal;
    font-weight: 600;
    line-height: 1.9;
  }

  /* The biography in newspaper columns, the portrait set in the first one. */
  .pres__cols {
    margin-block-start: 1.5rem;
    column-gap: 2rem;
    column-rule: 1px solid color-mix(in srgb, var(--matin-encre) 22%, transparent);
  }
  @media (min-width: 40rem) {
    .pres__cols {
      columns: 2;
    }
  }
  @media (min-width: 64rem) {
    .pres__cols {
      columns: 3;
    }
  }
  .pres__fig {
    break-inside: avoid;
    margin: 0 0 1.25rem;
  }
  .pres__fig :global(.pres__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.4rem;
    border-start-end-radius: 2.5rem;
  }
  .pres__initials {
    display: grid;
    place-items: center;
    background: var(--matin-encre);
    color: var(--matin-white);
    font-family: var(--font-editorial);
    font-size: 4rem;
  }
  .pres__caption {
    margin-block-start: 0.5rem;
    padding-block-start: 0.4rem;
    border-block-start: 2px solid var(--matin-soleil);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .pres__cols :global(.pres__bio) {
    font-size: clamp(1rem, 0.97rem + 0.15vw, 1.0625rem);
    line-height: 1.7;
    color: var(--color-ink);
  }
  .pres__cols :global(.pres__bio p) {
    margin: 0 0 0.9rem;
    text-align: justify;
    hyphens: auto;
  }
  :global(html[lang='fa']) .pres__cols :global(.pres__bio) {
    line-height: 2;
  }
  :global(html:not([lang='fa'])) .pres__cols :global(.pres__bio > p:first-child::first-letter) {
    float: inline-start;
    margin-inline-end: 0.5rem;
    font-family: var(--font-editorial);
    font-size: 3.6em;
    font-weight: 700;
    line-height: 0.85;
    color: var(--matin-brique-ink);
  }

  /* Two quiet invitations under a rule. */
  .pres__invites {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-block-start: 0.75rem;
    padding-block-start: 1.1rem;
    border-block-start: 4px double var(--matin-encre);
  }
  .pres__invite {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--matin-encre);
    text-decoration: none;
  }
  .pres__invite:hover .pres__invite-text {
    text-decoration: underline;
    text-decoration-color: var(--matin-soleil);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .pres__badge {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--matin-brique-ink);
    color: var(--matin-white);
    font-family: var(--font-editorial);
    font-size: 1.4rem;
    line-height: 1;
  }
  .pres__badge--notes {
    background: var(--matin-soleil);
    color: var(--matin-encre);
  }
  .pres__arrow {
    color: var(--matin-brique-ink);
  }
</style>
