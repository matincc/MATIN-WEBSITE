---
/**
 * "Our President" on the About page: vertical portrait, name with credentials, position,
 * approved biography and a link to his personal LinkedIn profile. Texts come from
 * src/content/about/about.yaml (president). The portrait is
 * src/assets/brand/president.(jpg|png|webp): replace that file to change it; without it,
 * a plain framed initials panel is shown.
 */
import { Image } from 'astro:assets';
import { ExternalLink } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Prose from '@/components/ui/Prose.astro';
import type { UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { getSingleton, initials, renderMarkdown } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { president: p } = await getSingleton('about');
const photos = import.meta.glob<ImageMetadata>('/src/assets/brand/president.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const photo = Object.values(photos)[0];
const name = pick(p.displayName, lang) || p.name;
const position = pick(p.position, lang) || pick(p.title, lang);
const bio = lang === 'fa' ? (p.bio?.fa ?? p.bio?.en) : p.bio?.[lang];
// The opening paragraph sits beside the portrait; the rest of the biography runs under
// both, across the card (owner's request, Oct 29 2026: the card was too tall).
const [bioLead = '', ...bioParts] = (bio ?? '').split(/\n\s*\n/);
const bioRest = bioParts.join('\n\n');
// LinkedIn glyph (simple-icons does not ship it).
const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z';
---

{bio && (
  <section
    id="our-president"
    class="president-band scroll-mt-24 py-14 sm:py-20"
    aria-labelledby="our-president-title"
  >
    <span class="president-band__sun" aria-hidden="true"></span>
    <div class="container-site relative">
      <SectionHeader
        align="start"
        id="our-president-title"
        title={t('about.ourPresident')}
        class="mb-8"
      />
      <div class="president-bio">
        <div class="president-bio__media">
          <span class="president-bio__block" aria-hidden="true"></span>
          {photo ? (
            <Image
              src={photo}
              alt={t('about.presidentPhotoAlt', { name: lang === 'fa' ? name : p.name })}
              widths={[320, 480, 640]}
              sizes="(min-width: 768px) 26rem, 90vw"
              class="president-bio__photo"
            />
          ) : (
            <span class="president-bio__photo president-bio__initials" aria-hidden="true">
              {initials(p.name)}
            </span>
          )}
        </div>
        <div class="president-bio__text">
          <h3 class="president-bio__name">{name}</h3>
          {position && <p class="president-bio__position">{position}</p>}
          <Prose html={renderMarkdown(bioLead, lang)} class="president-bio__prose" />
        </div>
        <div class="president-bio__more">
          {bioRest && (
            <Prose
              html={renderMarkdown(bioRest, lang)}
              class="president-bio__prose president-bio__prose--rest"
            />
          )}
          {p.linkedin && (
            <a
              href={p.linkedin}
              class="btn btn-primary president-bio__cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d={linkedinPath} />
              </svg>
              {t('about.discoverPresident')}
              <ExternalLink size={18} aria-hidden="true" />
              <span class="sr-only">{t('a11y.externalLink')}</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  /* Deep navy band (owner's choice, Oct 24 2026: navy, teal, cream and matte gold on the
     Our Team page); the warm-white card keeps the biography in ink and navy. */
  /* Warmer and more human (owner's request, Oct 29 2026): an apricot dawn ground with a
     large sun rising behind the card, in place of the night band. */
  .president-band {
    position: relative;
    overflow: hidden;
    background: var(--color-aube);
  }
  .president-band__sun {
    position: absolute;
    inset-block-start: clamp(2rem, 1rem + 3vw, 5rem);
    inset-inline-end: clamp(-6rem, -2rem - 4vw, -2rem);
    width: clamp(12rem, 6rem + 18vw, 26rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-soleil);
  }
  /* Inside the warm-white card the LinkedIn button is the brique main button again. */
  .president-bio :global(.btn-primary) {
    background: var(--color-brique-ink);
    color: var(--color-white);
  }
  .president-bio :global(.btn-primary:hover) {
    background: color-mix(in srgb, var(--color-brique-ink) 80%, black);
  }
  /* Inside the white card the focus ring is navy again (white would vanish). */
  .president-bio :global(:focus-visible) {
    outline-color: var(--color-primary);
  }
  /* Two balanced columns (owner's brief, Oct 21 2026): the portrait in its own column,
     staying in view while the biography is read; no text wraps around it. In Persian
     the grid mirrors, so the portrait is on the right. Stacked on phones. */
  /* Warm white card (Phase 3, owner's brief Oct 24 2026), with the shared card edge. */
  .president-bio {
    display: grid;
    gap: 2.5rem;
    max-width: 84rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3.25rem);
    border: 1px solid var(--color-card-edge);
    border-block-start: 5px solid var(--color-gold);
    border-radius: var(--radius-card);
    border-start-end-radius: 7rem;
    border-end-start-radius: 4rem;
    background: var(--color-paper);
    box-shadow: var(--shadow-card);
    color: var(--color-ink);
  }
  .president-bio__media {
    position: relative;
    width: min(100%, 24rem);
    margin-block-end: 1rem;
  }
  /* The sun rising behind one corner of the portrait (scheme A, Oct 29 2026). */
  .president-bio__block {
    position: absolute;
    inset-block-end: -1.5rem;
    inset-inline-end: -1.5rem;
    width: 58%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-firouzeh);
  }
  .president-bio__photo {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border: 6px solid var(--color-white);
    border-radius: var(--radius-card);
    border-start-start-radius: 6rem;
    box-shadow: 0 1rem 2rem -1.25rem color-mix(in srgb, var(--color-primary) 45%, transparent);
  }
  /* The portrait sits slightly askew like a printed photo and straightens, rising a
     little, under a desktop pointer. */
  @media (min-width: 768px) {
    .president-bio__photo {
      rotate: -1.5deg;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .president-bio__photo {
      transition:
        rotate 0.5s ease,
        translate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .president-bio__media:hover .president-bio__photo {
      rotate: 0deg;
      translate: 0 -0.6rem;
    }
    .president-bio__block {
      transition: scale 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .president-bio__media:hover .president-bio__block {
      scale: 1.08;
    }
  }
  .president-bio__initials {
    display: grid;
    place-items: center;
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-cream);
  }
  .president-bio__text {
    max-width: 44rem;
  }
  .president-bio__name {
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 1.7rem + 2vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-primary);
  }
  /* The approved position, as written, under the name with a thin gold rule. */
  .president-bio__position {
    margin-top: 0.75rem;
    padding-bottom: 1.4rem;
    border-bottom: 2px solid var(--color-soleil);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.375rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-brique-ink);
  }
  /* About 19 to 20px reading text, a comfortable line and paragraph spacing. */
  .president-bio__text :global(.president-bio__prose),
  .president-bio__more :global(.president-bio__prose) {
    margin-top: 2rem;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.8;
  }
  .president-bio__text :global(.president-bio__prose > * + *),
  .president-bio__more :global(.president-bio__prose > * + *) {
    margin-top: 1.3em;
  }
  /* The opening sentence (about culture and people) leads, slightly larger. */
  .president-bio__text :global(.president-bio__prose > p:first-child) {
    font-size: 1.15em;
    color: var(--color-primary);
  }
  .president-bio__cta {
    margin-top: 2.5rem;
    gap: 0.6rem;
  }
  .president-bio__more {
    max-width: none;
  }
  /* The rest of the biography no longer opens with a larger first paragraph. */
  .president-bio__more :global(.president-bio__prose--rest) {
    margin-top: 0;
  }
  .president-bio__more :global(.president-bio__prose--rest > p:first-child) {
    font-size: inherit;
    color: inherit;
  }
  @media (min-width: 768px) {
    .president-bio {
      grid-template-columns: minmax(15rem, 2fr) minmax(0, 3fr);
      align-items: center;
      column-gap: clamp(2.5rem, 1rem + 3vw, 4.5rem);
      row-gap: 2.5rem;
    }
    .president-bio__media {
      width: 100%;
    }
    .president-bio__more {
      grid-column: 1 / -1;
      padding-block-start: 2rem;
      border-block-start: 2px solid var(--color-sable);
    }
  }
  /* Wide screens: the rest of the biography in two columns, so the card stays short. */
  @media (min-width: 64rem) {
    .president-bio__more :global(.president-bio__prose--rest) {
      columns: 2;
      column-gap: clamp(2.5rem, 1rem + 3vw, 4.5rem);
    }
    .president-bio__more :global(.president-bio__prose--rest > *) {
      break-inside: avoid;
    }
  }
</style>
