---
/**
 * One note from the President, laid out like a LinkedIn post (owner's request, Oct 27
 * 2026): portrait, name and position, publication date, the text exactly as published,
 * an optional photo, and the link to the post on LinkedIn. A long text is folded after a
 * few lines with « Voir plus » (shown in full without JavaScript). A note written in
 * another language is shown in that language, with its own lang and direction.
 * Warmer type (owner's request, Oct 29 2026: not formal, cheerful): the opening line as a
 * soft Fraunces title, the text in rounded Nunito (Vazirmatn in Persian), a closing
 * question in a speech bubble. No sign-off under the text: his name and position are
 * already in the card's head (owner's request, Oct 29 2026).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { ExternalLink } from '@lucide/astro';
import { type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import { getSingleton } from '@/lib/content';
import { formatDate } from '@/lib/dates';
import { typo } from '@/lib/frenchTypo';

interface Props {
  note: CollectionEntry<'notes'>;
  lang: UiLang;
  headingLevel?: 'h2' | 'h3';
  /** Fold long texts after a few lines (« Voir plus »). */
  fold?: boolean;
}
const { note, lang, headingLevel: Heading = 'h2', fold = true } = Astro.props;
const t = useTranslations(lang);
const n = note.data;
const { president: p } = await getSingleton('about');
const photos = import.meta.glob<ImageMetadata>('/src/assets/brand/president.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const portrait = Object.values(photos)[0];
const shownLang = n.text[lang] ? lang : n.original;
const raw = n.text[shownLang]!;
const text = shownLang === 'fr' ? typo(raw, 'fr') : raw;
const paragraphs = text
  .trim()
  .split(/\n\s*\n/)
  .map((para) => para.trim());
const translated = shownLang !== lang;
// A translation of a note written in another language says so under the signature.
const isTranslation = !translated && shownLang !== n.original;
const headlineRaw = n.headline?.[shownLang];
const headline = headlineRaw && shownLang === 'fr' ? typo(headlineRaw, 'fr') : headlineRaw;
// The closing question of a post, set apart as an invitation to reply.
const last = paragraphs.at(-1) ?? '';
const question = paragraphs.length > 1 && /[?؟]$/.test(last) ? paragraphs.pop() : undefined;
const date = formatDate(n.date, lang);
const datetime = n.date.toISOString().slice(0, 10);
const role = pick(p.title, lang);
const org = t('president.org');
const name = lang === 'fa' ? 'رضا معافی' : p.name;
const alt = pick(n.imageAlt, lang) ?? '';
---

<article
  class:list={['note', n.sample && 'note--sample']}
  id={`note-${note.id}`}
  aria-labelledby={`note-${note.id}-title`}
  data-note={fold ? '' : undefined}
>
  <div class="note__mosaic" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>
  <header class="note__head">
    {portrait ? (
      <Image src={portrait} alt="" width={112} height={112} class="note__avatar" />
    ) : (
      <span class="note__avatar note__avatar--initials" aria-hidden="true">
        RM
      </span>
    )}
    <div class="note__who">
      <p class="note__name">{name}</p>
      <p class="note__role">
        {role} · {org}
      </p>
      <p class="note__date">
        <time datetime={datetime}>{date}</time>
        <svg viewBox="0 0 24 24" class="note__in" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z" />
        </svg>
      </p>
    </div>
    {n.sample && <span class="note__sample">{t('notes.sample')}</span>}
  </header>

  {translated && (
    <p class="note__lang">
      {t('notes.originalLanguage', { language: t(`notes.languageNames.${shownLang}`) })}
    </p>
  )}

  <Heading
    id={`note-${note.id}-title`}
    class:list={['note__title', !headline && 'sr-only']}
    lang={translated ? shownLang : undefined}
    dir={translated ? (shownLang === 'fa' ? 'rtl' : 'ltr') : undefined}
  >
    {headline ?? t('notes.noteOf', { date })}
  </Heading>

  <div
    class="note__text"
    lang={translated ? shownLang : undefined}
    dir={translated ? (shownLang === 'fa' ? 'rtl' : 'ltr') : undefined}
    data-note-text
  >
    {paragraphs.map((para) => (
      <p>{para}</p>
    ))}
    {question && <p class="note__question">{question}</p>}
  </div>
  {isTranslation && (
    <p class="note__translation">
      {t('notes.translatedFrom', { language: t(`notes.languageNames.${n.original}`) })}
    </p>
  )}
  {fold && (
    <button
      type="button"
      class="note__more"
      data-note-more
      data-more={t('notes.readMore')}
      data-less={t('notes.readLess')}
      aria-expanded="false"
      hidden
    >
      {t('notes.readMore')}
    </button>
  )}

  {n.image && (
    <figure class="note__figure">
      <Image
        src={n.image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 46rem, 92vw"
        class="note__image"
      />
      {n.imageCredit && (
        <figcaption class="note__credit" dir="ltr">
          {n.imageCredit}
        </figcaption>
      )}
    </figure>
  )}

  {n.linkedin && (
    <footer class="note__foot">
      <a href={n.linkedin} class="note__link" target="_blank" rel="noopener noreferrer">
        {t('notes.onLinkedin')}
        <ExternalLink size={17} aria-hidden="true" />
        <span class="sr-only">{t('a11y.externalLink')}</span>
      </a>
    </footer>
  )}
  {!n.linkedin && !n.image && <div class="note__end" aria-hidden="true" />}
</article>

<script>
  // Fold long notes after a few lines, like LinkedIn; « Voir plus » opens them in place.
  for (const card of document.querySelectorAll<HTMLElement>('[data-note]')) {
    const text = card.querySelector<HTMLElement>('[data-note-text]')!;
    const more = card.querySelector<HTMLButtonElement>('[data-note-more]')!;
    text.classList.add('is-folded');
    if (text.scrollHeight <= text.clientHeight + 4) {
      text.classList.remove('is-folded');
      continue;
    }
    more.hidden = false;
    more.addEventListener('click', () => {
      const open = text.classList.toggle('is-folded') === false;
      more.setAttribute('aria-expanded', String(open));
      more.textContent = open ? more.dataset.less! : more.dataset.more!;
    });
  }
</script>

<style>
  .note {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-card-edge);
    background: var(--color-white);
    box-shadow: 0 18px 40px -26px color-mix(in srgb, var(--color-ink) 70%, transparent);
    color: var(--color-ink);
  }
  .note__mosaic {
    display: flex;
    height: 0.4rem;
  }
  .note__mosaic > span {
    flex: 1;
  }
  .note__mosaic > span:nth-child(1) {
    background: var(--color-coral);
  }
  .note__mosaic > span:nth-child(2) {
    background: var(--color-gold);
  }
  .note__mosaic > span:nth-child(3) {
    background: var(--color-teal);
  }
  .note__mosaic > span:nth-child(4) {
    background: var(--color-terracotta);
  }
  .note__title {
    position: relative;
    margin: 1.4rem 1.75rem 0;
    padding-inline-start: 1.1rem;
    border-inline-start: 4px solid var(--color-gold);
    font-family: var(--font-editorial);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 72;
    font-size: clamp(1.45rem, 1.2rem + 0.9vw, 1.95rem);
    line-height: 1.22;
    color: var(--color-terracotta-deep);
    text-wrap: balance;
  }
  .note__question {
    position: relative;
    margin-top: 1.4em !important;
    padding: 0.85rem 1.2rem;
    border-radius: 1.1rem;
    border-end-start-radius: 0.25rem;
    background: var(--color-aqua);
    color: var(--color-primary);
    font-weight: 700;
  }

  .note__translation {
    margin: 0.9rem 1.75rem 0;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-ink);
  }
  .note__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.75rem 1.1rem;
    border-bottom: 1px dashed var(--color-card-edge);
    background: var(--color-ivory);
  }
  .note__avatar {
    flex: none;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 999px;
    object-fit: cover;
    box-shadow:
      0 0 0 3px var(--color-white),
      0 0 0 5px var(--color-gold);
  }
  .note__avatar--initials {
    display: grid;
    place-items: center;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 800;
  }
  .note__who {
    min-width: 0;
    flex: 1;
  }
  .note__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-primary);
  }
  .note__role {
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .note__date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-teal-deep);
  }
  .note__in {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }
  .note__sample {
    align-self: flex-start;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1.5px dashed var(--color-terracotta-deep);
    background: var(--color-champagne);
    color: var(--color-terracotta-deep);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .note__lang {
    margin: 1rem 1.75rem 0;
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--color-aqua);
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .note__text {
    padding: 1.1rem 1.75rem 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.8;
    white-space: pre-line;
  }
  .note__text > p + p {
    margin-top: 0.9em;
  }
  .note__text.is-folded {
    max-height: calc(1.15rem * 1.8 * 6);
    overflow: hidden;
  }
  .note__more {
    margin: 0.35rem 1.75rem 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .note__figure {
    margin-top: 1.25rem;
    background: var(--color-cream);
  }
  .note__image {
    display: block;
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
  }
  .note__credit {
    padding: 0.4rem 1.75rem;
    font-size: 0.8rem;
    color: var(--color-ink);
  }
  .note__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.25rem;
    padding: 0.9rem 1.75rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-ivory);
  }
  .note__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 800;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .note__link:hover {
    background: var(--color-primary-hover);
  }
  .note__end {
    height: 1.6rem;
  }
  @media (max-width: 30rem) {
    .note__sample {
      position: absolute;
      top: 0.9rem;
      inset-inline-end: 1.15rem;
    }
    .note--sample .note__head {
      padding-top: 2.9rem;
    }
    .note__head,
    .note__text {
      padding-inline: 1.15rem;
    }
    .note__lang,
    .note__title,
    .note__translation,
    .note__more {
      margin-inline: 1.15rem;
    }
  }
</style>
