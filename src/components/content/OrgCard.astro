---
/**
 * One organization in the Cultural Resources directory (owner's brief, Oct 25 2026): the
 * official logo on the start side, then the official name, an optional kind (e.g. "Municipal
 * public body"), a short description and a short clickable name that opens the official
 * website in a new tab. Without a verified logo, the tile shows the organization's short
 * name as plain text (never an invented logo or a generic icon).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { ExternalLink } from '@lucide/astro';
import type { UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
  name: string;
  /** Short clickable name (e.g. « CALQ »). */
  label: string;
  url: string;
  logo?: ImageMetadata;
  description?: string;
  kind?: string;
  status?: 'listed' | 'member' | 'partner';
  accent: string;
}
const { lang, name, label, url, logo, description, kind, status = 'listed', accent } = Astro.props;
const t = useTranslations(lang);
---

<li class="org" data-accent={accent}>
  <div class="org__logo">
    {logo ? (
      <Image
        src={logo}
        alt={`${t('resources.logo')}${name}`}
        width={360}
        class="org__img"
        loading="lazy"
      />
    ) : (
      <span class="org__wordmark" aria-hidden="true">
        <bdi>{label}</bdi>
      </span>
    )}
  </div>
  <div class="org__body">
    {(kind || status !== 'listed') && (
      <p class="org__tags">
        {kind && <span class="org__kind">{kind}</span>}
        {status !== 'listed' && <span class="org__status">{t(`resources.status_${status}`)}</span>}
      </p>
    )}
    <h3 class="org__name">
      <bdi>{name}</bdi>
    </h3>
    {description && <p class="org__text">{description}</p>}
    <a href={url} class="org__link" target="_blank" rel="noopener noreferrer">
      <bdi>{label}</bdi>
      <ExternalLink size={16} class="flip-rtl" aria-hidden="true" />
      <span class="sr-only">{t('a11y.externalLink')}</span>
    </a>
  </div>
</li>

<style>
  /* Logo on the start side, text beside it; stacked on small screens. */
  .org {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    height: 100%;
    padding: 1.35rem;
    border: 1px solid var(--color-card-edge);
    border-block-start: 5px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--org-surface, var(--color-ivory));
    box-shadow: var(--shadow-card);
    transition:
      border-color 0.2s,
      transform 0.25s,
      box-shadow 0.25s;
  }
  .org:hover,
  .org:focus-within {
    border-color: var(--color-gold);
    border-block-start-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 18px 34px -22px color-mix(in srgb, var(--color-primary) 55%, transparent);
  }
  @media (min-width: 40rem) {
    .org {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1.5rem;
    }
  }
  /* Logos sit on white, as organizations design them, kept in proportion. */
  .org__logo {
    display: grid;
    place-items: center;
    height: 5.5rem;
    padding: 0.75rem;
    border: 1px solid var(--color-card-edge);
    border-radius: 0.9rem;
    background: var(--color-white);
  }
  @media (min-width: 40rem) {
    .org__logo {
      height: 9.5rem;
    }
  }
  .org :global(.org__img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /* No verified logo yet: the short name, as text. */
  .org__wordmark {
    padding-block-end: 0.45rem;
    border-block-end: 3px solid var(--color-gold);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.25;
    text-align: center;
    color: var(--color-primary);
    overflow-wrap: anywhere;
  }
  .org__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }
  .org__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .org__kind,
  .org__status {
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 800;
  }
  .org__kind {
    border: 1px solid var(--color-aqua-edge);
    background: var(--color-aqua);
    color: var(--color-primary);
  }
  .org__status {
    background: var(--color-teal-deep);
    color: var(--color-white);
  }
  .org__name {
    font-size: 1.1875rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-primary);
  }
  .org__text {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .org__link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.45rem;
    margin-block-start: auto;
    min-height: 2.5rem;
    padding: 0.35rem 1rem;
    border: 1.5px solid var(--color-primary);
    border-radius: 999px;
    background: var(--color-white);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-primary);
    text-align: start;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .org__link :global(svg) {
    flex-shrink: 0;
    color: var(--color-teal-deep);
  }
  .org__link:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }
  .org__link:hover :global(svg) {
    color: var(--color-gold);
  }
  @media (prefers-reduced-motion: reduce) {
    .org {
      transition: none;
    }
    .org:hover,
    .org:focus-within {
      transform: none;
    }
  }
</style>
