---
/**
 * Consent banner + preferences dialog.
 * The banner only appears when an analytics provider is configured, because
 * otherwise the site sets no optional cookies at all and there is nothing to ask.
 * The preferences dialog is always reachable from the footer ("Manage cookies").
 */
import { Cookie, X } from '@lucide/astro';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="consent-banner"
  role="region"
  aria-labelledby="consent-title"
  hidden
  data-consent-banner
>
  <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:gap-8">
    <div class="flex gap-4">
      <Cookie size={28} class="mt-1 hidden shrink-0 text-gold-dark sm:block" aria-hidden="true" />
      <div>
        <h2 id="consent-title" class="mb-1 font-sans text-base font-bold text-ink">
          {t('consent.title')}
        </h2>
        <p class="text-sm">
          {t('consent.text')}{' '}
          <a href={href('privacy', lang)} class="font-bold text-ink">
            {t('consent.policyLink')}
          </a>
        </p>
      </div>
    </div>
    <!-- Refuse and accept are equally prominent (Law 25: no nudging). -->
    <div class="flex shrink-0 flex-wrap gap-2">
      <button type="button" class="btn btn-outline" data-consent="refuse">
        {t('consent.refuse')}
      </button>
      <button type="button" class="btn btn-outline" data-consent-open>
        {t('consent.customize')}
      </button>
      <button type="button" class="btn btn-outline" data-consent="accept">
        {t('consent.accept')}
      </button>
    </div>
  </div>
</div>

<dialog class="consent-dialog" aria-labelledby="consent-prefs-title" data-consent-dialog>
  <form method="dialog" class="p-6 sm:p-8">
    <div class="mb-5 flex items-start justify-between gap-4">
      <h2 id="consent-prefs-title" class="text-2xl font-bold">
        {t('consent.prefsTitle')}
      </h2>
      <button type="submit" value="cancel" class="close-btn" formnovalidate>
        <X size={22} aria-hidden="true" />
        <span class="sr-only">{t('consent.close')}</span>
      </button>
    </div>

    <ul class="space-y-3">
      <li class="pref">
        <div>
          <p class="font-bold text-ink">{t('consent.necessary')}</p>
          <p class="text-sm text-muted">{t('consent.necessaryText')}</p>
        </div>
        <span class="shrink-0 text-xs font-bold text-ink">{t('consent.alwaysOn')}</span>
      </li>
      <li class="pref" data-consent-analytics-row>
        <div>
          <label for="consent-analytics" class="font-bold text-ink">
            {t('consent.analytics')}
          </label>
          <p class="text-sm text-muted" id="consent-analytics-desc">
            {t('consent.analyticsText')}
          </p>
        </div>
        <input
          id="consent-analytics"
          type="checkbox"
          role="switch"
          class="switch"
          aria-describedby="consent-analytics-desc"
          data-consent-analytics
        />
      </li>
      <li class="pref">
        <div>
          <p class="font-bold text-ink">{t('consent.media')}</p>
          <p class="text-sm text-muted">{t('consent.mediaText')}</p>
        </div>
      </li>
    </ul>

    <p class="mt-4 text-sm font-semibold text-ink" role="status" data-consent-status></p>

    <div class="mt-6 flex flex-wrap justify-end gap-2">
      <button type="button" class="btn btn-outline" data-consent="refuse">
        {t('consent.refuse')}
      </button>
      <button type="button" class="btn btn-primary" data-consent="save">
        {t('consent.save')}
      </button>
    </div>
    <p class="sr-only" data-consent-saved-msg>
      {t('consent.saved')}
    </p>
  </form>
</dialog>

<script>
  import { analyticsEnabled, applyConsent, readConsent, saveConsent } from '@/scripts/consent';

  const banner = document.querySelector<HTMLElement>('[data-consent-banner]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-consent-dialog]')!;
  const toggle = dialog.querySelector<HTMLInputElement>('[data-consent-analytics]')!;
  const status = dialog.querySelector<HTMLElement>('[data-consent-status]')!;
  const savedMsg = dialog.querySelector<HTMLElement>('[data-consent-saved-msg]')!.textContent ?? '';

  const current = readConsent();
  applyConsent(current);
  // Without an analytics tool there is nothing optional to consent to.
  if (!analyticsEnabled) dialog.querySelector('[data-consent-analytics-row]')?.remove();
  if (analyticsEnabled && !current) banner.hidden = false;

  const decide = (analytics: boolean) => {
    saveConsent(analytics);
    banner.hidden = true;
    if (dialog.open) {
      status.textContent = savedMsg;
      setTimeout(() => dialog.close(), 700);
    }
  };

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest<HTMLElement>(
      '[data-consent], [data-consent-open]',
    );
    if (!target) return;
    if (target.hasAttribute('data-consent-open')) {
      status.textContent = '';
      toggle.checked = readConsent()?.analytics ?? false;
      dialog.showModal();
      return;
    }
    const action = target.dataset.consent;
    if (action === 'accept') decide(true);
    else if (action === 'refuse') decide(false);
    else if (action === 'save') decide(toggle.checked);
  });
</script>

<style>
  .consent-banner {
    position: fixed;
    z-index: 45;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    color: var(--color-ink);
    background: var(--color-white);
    box-shadow: var(--shadow-lift);
    border: 1px solid var(--color-line);
  }
  .consent-dialog {
    color: var(--color-ink);
    width: min(36rem, calc(100% - 2rem));
    margin: auto;
    border: 0;
    border-radius: 1.25rem;
    padding: 0;
    box-shadow: var(--shadow-lift);
  }
  .consent-dialog::backdrop {
    background: color-mix(in srgb, var(--color-ink) 40%, transparent);
  }
  .pref {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-radius: 0.9rem;
    background: var(--color-tint);
  }
  .close-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-primary);
    cursor: pointer;
  }
  .close-btn:hover {
    background: var(--color-tint);
  }
  .switch {
    appearance: none;
    flex-shrink: 0;
    position: relative;
    width: 3rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--color-muted);
    cursor: pointer;
    transition: background 0.2s;
  }
  .switch::after {
    content: '';
    position: absolute;
    top: 0.2rem;
    inset-inline-start: 0.2rem;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--color-white);
    transition: transform 0.2s;
  }
  .switch:checked {
    background: var(--color-primary);
  }
  .switch:checked::after {
    transform: translateX(1.25rem);
  }
  :global([dir='rtl']) .switch:checked::after {
    transform: translateX(-1.25rem);
  }
</style>
