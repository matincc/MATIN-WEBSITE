---
import { ChevronDown, Menu, X, Search } from '@lucide/astro';
import Lockup from '@/components/brand/Lockup.astro';
import LangToggle from './LangToggle.astro';
import { href, type Alternates, type RouteKey, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { emptySections, forLang, getTeam } from '@/lib/content';

interface Props {
  lang: UiLang;
  alternates: Alternates;
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);

const items: RouteKey[] = [
  'about',
  'programs',
  'events',
  'news',
  'gallery',
  'getInvolved',
  'contact',
];
// The gallery appears in the menu once it has an album.
const empty = await emptySections();
const links = items
  .filter((key) => key !== 'gallery' || !empty.has('gallery'))
  .map((key) => ({ key, href: href(key, lang), label: t(`nav.${key}`) }));
const aboutHref = href('about', lang);
// Sub-links of "About": anchors on the About page. The Persian About page has the
// values and team sections only (the other texts are not translated yet).
// "Our team" appears once at least one member is published.
const hasTeam = forLang(await getTeam(), lang).length > 0;
const aboutLinks = [
  { id: 'who-we-are', label: t('nav.whoWeAre') },
  { id: 'mission', label: t('nav.mission') },
  { id: 'vision', label: t('nav.vision') },
  { id: 'our-president', label: t('nav.ourPresident') },
  { id: 'values', label: t('nav.values') },
  { id: 'story', label: t('nav.story') },
  ...(hasTeam ? [{ id: 'team', label: t('nav.team') }] : []),
  { id: 'president', label: t('nav.president') },
]
  .filter((l) => lang !== 'fa' || ['our-president', 'values', 'team'].includes(l.id))
  .map((l) => ({ ...l, href: `${aboutHref}#${l.id}` }));

const current = Astro.url.pathname;
const isActive = (url: string) => !url.includes('?') && current.startsWith(url);
---

<header class="site-header" data-header>
  <div class="header-row flex items-center justify-between gap-4">
    <Lockup lang={lang} size="large" />

    <nav aria-label={t('a11y.mainNav')} class="desktop-nav">
      <ul class="flex items-center gap-1">
        {links.map((l) =>
          l.key === 'about' ? (
            <li class="has-sub" data-submenu>
              <div class="flex items-center">
                <a
                  href={l.href}
                  class:list={['nav-link', isActive(l.href) && 'is-active']}
                  aria-current={isActive(l.href) ? 'page' : undefined}
                >
                  {l.label}
                </a>
                <button
                  type="button"
                  class="sub-toggle"
                  aria-expanded="false"
                  aria-controls="about-submenu"
                  data-submenu-toggle
                >
                  <ChevronDown size={18} aria-hidden="true" />
                  <span class="sr-only">{t('a11y.aboutSubmenu')}</span>
                </button>
              </div>
              <ul id="about-submenu" class="submenu" hidden data-submenu-list>
                {aboutLinks.map((s) => (
                  <li>
                    <a href={s.href} class="submenu-link">
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={l.href}
                class:list={['nav-link', isActive(l.href) && 'is-active']}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <a href={href('search', lang)} class="menu-btn">
        <Search size={24} aria-hidden="true" />
        <span class="sr-only">{t('nav.search')}</span>
      </a>
      <div class="hidden sm:block">
        <LangToggle lang={lang} alternates={alternates} />
      </div>
      <button
        type="button"
        class="menu-btn mobile-only"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Menu size={26} aria-hidden="true" />
        <span class="sr-only">{t('a11y.openMenu')}</span>
      </button>
    </div>
  </div>

  <dialog id="mobile-menu" class="mobile-menu" aria-label={t('a11y.mainNav')}>
    <div class="flex h-[4.75rem] items-center justify-between px-5">
      <Lockup lang={lang} />
      <button type="button" class="menu-btn" data-menu-close>
        <X size={28} aria-hidden="true" />
        <span class="sr-only">{t('a11y.closeMenu')}</span>
      </button>
    </div>
    <nav aria-label={t('a11y.mainNav')} class="px-5 pt-2 pb-10">
      <div class="mb-6 rounded-2xl bg-tint px-4 py-3">
        <LangToggle lang={lang} alternates={alternates} large />
      </div>
      <ul>
        <li>
          <a href={href('home', lang)} class="mobile-link">
            {t('nav.home')}
          </a>
        </li>
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="mobile-link"
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
            {l.key === 'about' && (
              <ul class="mobile-sub">
                {aboutLinks.map((s) => (
                  <li>
                    <a href={s.href} class="mobile-sublink" data-menu-anchor>
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </dialog>
</header>

<script>
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  openBtn?.addEventListener('click', () => {
    dialog?.showModal();
    document.documentElement.style.overflow = 'hidden';
  });
  dialog?.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
  // Escape fires "cancel"; some browsers then skip "close", so clean up on both.
  const onClosed = () => {
    document.documentElement.style.overflow = '';
    openBtn?.focus();
  };
  dialog?.addEventListener('close', onClosed);
  dialog?.addEventListener('cancel', onClosed);
  // Close when the backdrop is clicked, or when an anchor on the current page is chosen.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-menu-anchor]');
    if (a && a.pathname === location.pathname) dialog.close();
  });

  // "About" dropdown: button toggles it (keyboard, mouse, touch); hover opens it on
  // devices with a mouse; Escape or leaving it closes it.
  document.querySelectorAll<HTMLElement>('[data-submenu]').forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('[data-submenu-toggle]')!;
    const list = item.querySelector<HTMLElement>('[data-submenu-list]')!;
    let openedByHover = false;
    const set = (open: boolean) => {
      list.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      if (!open) openedByHover = false;
    };
    // A click right after hovering keeps the menu open instead of closing it.
    btn.addEventListener('click', () => {
      if (openedByHover) openedByHover = false;
      else set(list.hidden === true);
    });
    const hover = window.matchMedia('(hover: hover) and (pointer: fine)');
    item.addEventListener('mouseenter', () => {
      if (hover.matches && list.hidden) {
        set(true);
        openedByHover = true;
      }
    });
    item.addEventListener('mouseleave', () => hover.matches && set(false));
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !list.hidden) {
        set(false);
        btn.focus();
      }
      if (e.key === 'ArrowDown' && document.activeElement === btn) {
        e.preventDefault();
        set(true);
        list.querySelector<HTMLElement>('a')?.focus();
      }
    });
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) set(false);
    });
    document.addEventListener('click', (e) => {
      if (!item.contains(e.target as Node)) set(false);
    });
  });

  // Subtle shadow once the page is scrolled.
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-white);
    border-block-end: 1px solid transparent;
    transition:
      box-shadow 0.25s,
      border-color 0.25s;
  }
  .site-header.is-scrolled {
    border-block-end-color: var(--color-line);
  }
  /* Wider than the page content so the logo sits further left and the search
     and language links further right. */
  .header-row {
    width: 100%;
    max-width: 110rem;
    height: 5.5rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 40rem) {
    .header-row {
      padding-inline: 2rem;
    }
  }
  @media (min-width: 96rem) {
    .header-row {
      padding-inline: 3rem;
    }
  }

  /* The full menu needs this width at 20px (French, the longest, needs about
     1405px); below it, the mobile menu is used. */
  .desktop-nav {
    display: none;
  }
  @media (min-width: 89rem) {
    .desktop-nav {
      display: block;
    }
    .menu-btn.mobile-only {
      display: none;
    }
  }

  .nav-link {
    position: relative;
    display: block;
    padding: 0.55rem 0.75rem;
    font-weight: 600;
    font-size: 1.25rem; /* 20px */
    white-space: nowrap;
    color: var(--color-primary);
    text-decoration: none;
    border-radius: 999px;
  }
  /* Thin gold underline: grows in on hover, stays on the current page. */
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0.75rem;
    inset-block-end: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-gold);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .has-sub {
    position: relative;
  }
  .sub-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2.25rem;
    margin-inline-start: -0.4rem;
    border-radius: 999px;
    color: var(--color-primary);
    cursor: pointer;
  }
  .sub-toggle:hover {
    background: var(--color-tint);
  }
  .sub-toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  .submenu {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + 0.4rem);
    min-width: 15rem;
    padding: 0.5rem;
    border-radius: 1rem;
    background: var(--color-white);
    box-shadow: var(--shadow-lift);
    border: 1px solid var(--color-line);
  }
  .submenu::before {
    /* Bridges the gap so the menu doesn't close while the pointer moves down. */
    content: '';
    position: absolute;
    inset-inline: 0;
    top: -0.6rem;
    height: 0.6rem;
  }
  .submenu-link {
    display: block;
    padding: 0.6rem 0.9rem;
    border-radius: 0.6rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .submenu-link:hover,
  .submenu-link:focus-visible {
    background: var(--color-tint);
    color: var(--color-primary);
  }

  .menu-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-primary);
    cursor: pointer;
  }
  @media (min-width: 40rem) {
    .menu-btn {
      width: 3.1rem;
      height: 3.1rem;
    }
  }
  .menu-btn:hover {
    background: var(--color-tint);
  }

  .mobile-menu {
    margin: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    border: 0;
    padding: 0;
    color: var(--color-ink);
    background: var(--color-white);
  }
  .mobile-menu::backdrop {
    background: color-mix(in srgb, var(--color-ink) 40%, transparent);
  }
  .mobile-menu[open] {
    animation: menu-in 0.25s ease-out;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .mobile-link {
    display: block;
    padding: 0.75rem 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    border-block-end: 1px solid var(--color-line);
  }
  .mobile-link:hover,
  .mobile-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
  }
  .mobile-sub {
    padding-block: 0.4rem 0.6rem;
    padding-inline-start: 1rem;
    border-block-end: 1px solid var(--color-line);
  }
  .mobile-sublink {
    display: block;
    padding: 0.6rem 0;
    min-height: 2.75rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }
  .mobile-sublink:hover {
    text-decoration: underline;
  }
</style>
