---
import {
  ChevronDown,
  Contrast,
  HeartHandshake,
  Menu,
  Search,
  Type,
  UserPlus,
  X,
} from '@lucide/astro';
import Lockup from '@/components/brand/Lockup.astro';
import LangToggle from './LangToggle.astro';
import { newsAnchors, href, type Alternates, type RouteKey, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { strings as cultureMapStrings } from '@/lib/cultureMap';
import { storyStrings } from '@/i18n/stories';
import { getNetworks, getUpcomingEvents, picksOf } from '@/lib/content';
import { guideStrings } from '@/lib/localGuide';

interface Props {
  lang: UiLang;
  alternates: Alternates;
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
// Header signature (design-system brief, Oct 31 2026): the slogan in the page's language
// and, under it, the Persian institutional slogan, on the Persian pages only (owner, Oct 31 2026).
const faSlogan = useTranslations('fa')('home.positioning');
/** Adds #id to a page URL. */
const anchor = (url: string, id: string) => `${url}#${id}`;

// Main menu, in this order (owner's brief, Oct 24 2026). Get Involved is merged into
// Contact & Collaboration (Phase 3). Lighter menu (owner, Oct 30 2026): the Gallery is no
// longer a top-level item; its Photos, Videos and Posters sit under Events.
const items: RouteKey[] = ['about', 'team', 'programs', 'events', 'news', 'resources', 'contact'];
const links = items.map((key) => ({ key, href: href(key, lang), label: t(`nav.${key}`) }));
const aboutHref = href('about', lang);
// Sub-links of "About": only Who We Are (the President's note moved to the homepage
// letter, owner's request Oct 29 2026). Mission, Vision,
// Values, Our Story and Legal status stay on the About page with their anchors
// (#mission, #vision, #values, #story, #legal-status), so old links keep working.
const aboutLinks = [
  {
    id: 'who-we-are',
    label: t('nav.whoWeAre'),
    href: `${aboutHref}#who-we-are`,
  },
];
// Sub-links of "Our Team" (owner's brief, Oct 24 2026): the President, the Board of
// Directors (owner, Oct 31 2026), the Executive Team and the invitation to collaborate (Oct 28 2026), on the Our Team page.
const teamHref = href('team', lang);
const teamLinks = [
  { id: 'our-president', label: t('nav.teamPresident') },
  { id: 'board', label: t('nav.teamBoard') },
  { id: 'executive-team', label: t('nav.teamExecutive') },
  { id: 'advisors', label: t('nav.teamAdvisors') },
].map((l) => ({ ...l, href: `${teamHref}#${l.id}` }));
// Sub-links of "Events", in the owner's order: Matin Events, Matin's Picks (only while
// there are picks, the section is hidden otherwise), Upcoming Events, then Past Events.
const eventsHref = href('events', lang);
const hasPicks = picksOf(await getUpcomingEvents()).length > 0;
const eventsLinks = [
  { id: 'matin-events', label: t('events.matinTitle') },
  ...(hasPicks ? [{ id: 'picks', label: t('events.picksTitle') }] : []),
  { id: 'upcoming', label: t('events.upcoming') },
].map((l) => ({ ...l, href: `${eventsHref}#${l.id}` }));
eventsLinks.push({ id: 'past', label: t('nav.eventsArchive'), href: href('eventsArchive', lang) });
// Sub-links of "News": its two sections (owner's brief, Oct 25 2026), then the President's notes.
const newsHref = href('news', lang);
const newsLinks: { id: string; label: string; href: string }[] = (
  Object.keys(newsAnchors) as (keyof typeof newsAnchors)[]
).map((c) => ({
  id: newsAnchors[c] as string,
  label: t(`newsCategories.${c}`),
  href: anchor(newsHref, newsAnchors[c]),
}));
// Notes from the President (owner's request, Oct 27 2026): their own page, under News.
newsLinks.push({ id: 'president-notes', label: t('nav.notes'), href: href('notes', lang) });
// Sub-links of "Gallery" and "Resources": sections of those pages.
const galleryHref = href('gallery', lang);
const galleryLinks = [
  { id: 'photos', label: t('gallery.filterPhotos') },
  { id: 'videos', label: t('gallery.filterVideos') },
  { id: 'posters', label: t('gallery.filterPosters') },
].map((l) => ({ ...l, label: `${t('nav.gallery')} · ${l.label}`, href: anchor(galleryHref, l.id) }));
// « My Story in 15 Seconds » (owner's request, Oct 31 2026) sits right after Gallery · Videos.
const videosAt = galleryLinks.findIndex((l) => l.id === 'videos') + 1;
galleryLinks.splice(videosAt, 0, {
  id: 'my-story',
  label: storyStrings(lang).nav,
  href: href('stories', lang),
});
eventsLinks.push(...galleryLinks);
const resourcesHref = href('resources', lang);
// Until International Cultural Networks has entries, its link opens the directory's
// international category instead (the networks section is hidden while empty).
const hasNetworks = (await getNetworks()).length > 0;
const resourcesLinks = [
  { id: 'directory', label: t('nav.resourcesDirectory') },
  hasNetworks
    ? { id: 'networks', label: t('resources.networksTitle') }
    : { id: 'cat-international', label: t('resources.international') },
  { id: 'policy', label: t('resources.policyTitle') },
].map((l) => ({ ...l, href: anchor(resourcesHref, l.id) }));
// The Local Guide (owner's request, Oct 30 2026): its own page, under Resources.
resourcesLinks.push({
  id: 'local-guide',
  label: guideStrings(lang).title,
  href: href('localGuide', lang),
});
// Living map of cultures (owner's request, Oct 31 2026): its own page, LaSalle first.
resourcesLinks.push({
  id: 'culture-map',
  label: cultureMapStrings.nav[lang],
  href: href('cultureMap', lang),
});
// Sub-links of "Contact & Collaboration" (owner's request, Oct 29 2026), in his order:
// Write to us, Membership, Join Matin's Volunteer Team, all sections of the Contact page.
const contactHref = href('contact', lang);
const contactLinks = [
  { id: 'write', label: t('contact.formTitle') },
  { id: lang === 'fr' ? 'adhesion' : 'membership', label: t('nav.contactMembership') },
  { id: lang === 'fr' ? 'benevolat' : 'volunteer', label: t('involved.volunteerTitle') },
].map((l) => ({ ...l, href: anchor(contactHref, l.id) }));
// Menu items that open a dropdown.
const subMenus: Partial<Record<RouteKey, { id: string; label: string; links: typeof aboutLinks }>> =
  {
    about: { id: 'about-submenu', label: t('a11y.aboutSubmenu'), links: aboutLinks },
    team: { id: 'team-submenu', label: t('a11y.teamSubmenu'), links: teamLinks },
    events: { id: 'events-submenu', label: t('a11y.eventsSubmenu'), links: eventsLinks },
    news: { id: 'news-submenu', label: t('a11y.newsSubmenu'), links: newsLinks },
    resources: {
      id: 'resources-submenu',
      label: t('a11y.resourcesSubmenu'),
      links: resourcesLinks,
    },
    contact: { id: 'contact-submenu', label: t('a11y.contactSubmenu'), links: contactLinks },
  };

const current = Astro.url.pathname;
const isActive = (url: string) => !url.includes('?') && current.startsWith(url);
---

<header class="site-header" data-header>
  <div class="header-row">
    <div class="brand-block">
      <Lockup lang={lang} size="large" />
      <p class="header-slogan">
        <span class="header-slogan__main">{t('brand.tagline')}</span>
        {lang === 'fa' && <span class="header-slogan__fa" lang="fa" dir="rtl">{faSlogan}</span>}
      </p>
    </div>

    <div class="header-tools gap-1 sm:gap-2">
      <!-- Donate (owner's request, Oct 30 2026), like other NGOs: always in the top row. -->
      <a href={`${href('support', lang)}#don`} class="donate-btn">
        <HeartHandshake size={18} aria-hidden="true" />
        <span>{t('nav.donate')}</span>
      </a>
      <!-- Become a Member (NGO review, Oct 30 2026): beside Donate, on wide screens. -->
      <a href={href('membership', lang)} class="join-btn">
        <UserPlus size={18} aria-hidden="true" />
        <span>{t('nav.join')}</span>
      </a>
      <!-- Reading comfort: larger text and high contrast, remembered on this device. -->
      <div class="display-opts" role="group" aria-label={t('a11y.displayOptions')}>
        <button type="button" class="menu-btn" data-a11y="large" aria-pressed="false">
          <Type size={22} aria-hidden="true" />
          <span class="sr-only">{t('a11y.largerText')}</span>
        </button>
        <button type="button" class="menu-btn" data-a11y="contrast" aria-pressed="false">
          <Contrast size={22} aria-hidden="true" />
          <span class="sr-only">{t('a11y.highContrast')}</span>
        </button>
      </div>
      <a href={href('search', lang)} class="menu-btn">
        <Search size={24} aria-hidden="true" />
        <span class="sr-only">{t('nav.search')}</span>
      </a>
      <div class="hidden sm:block">
        <LangToggle lang={lang} alternates={alternates} />
      </div>
      <button
        type="button"
        class="menu-btn mobile-only"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Menu size={26} aria-hidden="true" />
        <span class="sr-only">{t('a11y.openMenu')}</span>
      </button>
    </div>
    <nav aria-label={t('a11y.mainNav')} class="desktop-nav">
      <ul class="flex items-center gap-1">
        {links.map((l) =>
          subMenus[l.key] ? (
            <li class="has-sub" data-submenu>
              <div class="flex items-center">
                <a
                  href={l.href}
                  class:list={['nav-link', isActive(l.href) && 'is-active']}
                  aria-current={isActive(l.href) ? 'page' : undefined}
                >
                  {l.label}
                </a>
                <button
                  type="button"
                  class="sub-toggle"
                  aria-expanded="false"
                  aria-controls={subMenus[l.key]!.id}
                  data-submenu-toggle
                >
                  <ChevronDown size={18} aria-hidden="true" />
                  <span class="sr-only">{subMenus[l.key]!.label}</span>
                </button>
              </div>
              <ul id={subMenus[l.key]!.id} class="submenu" hidden data-submenu-list>
                {subMenus[l.key]!.links.map((s) => (
                  <li>
                    <a href={s.href} class="submenu-link">
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={l.href}
                class:list={['nav-link', isActive(l.href) && 'is-active']}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
  </div>

  <dialog id="mobile-menu" class="mobile-menu" aria-label={t('a11y.mainNav')}>
    <div class="flex h-[4.75rem] items-center justify-between px-5">
      <Lockup lang={lang} />
      <button type="button" class="menu-btn" data-menu-close>
        <X size={28} aria-hidden="true" />
        <span class="sr-only">{t('a11y.closeMenu')}</span>
      </button>
    </div>
    <nav aria-label={t('a11y.mainNav')} class="px-5 pt-2 pb-10">
      <p class="header-slogan header-slogan--menu">
        <span class="header-slogan__main">{t('brand.tagline')}</span>
        {lang === 'fa' && <span class="header-slogan__fa" lang="fa" dir="rtl">{faSlogan}</span>}
      </p>
      <div class="mb-6 rounded-2xl bg-tint px-4 py-3">
        <LangToggle lang={lang} alternates={alternates} large />
      </div>
      <a href={`${href('support', lang)}#don`} class="donate-btn donate-btn--menu">
        <HeartHandshake size={20} aria-hidden="true" />
        <span>{t('nav.donate')}</span>
      </a>
      <a href={href('membership', lang)} class="join-btn join-btn--menu">
        <UserPlus size={20} aria-hidden="true" />
        <span>{t('nav.join')}</span>
      </a>
      <div class="display-opts--menu" role="group" aria-label={t('a11y.displayOptions')}>
        <button type="button" class="opt-btn" data-a11y="large" aria-pressed="false">
          <Type size={20} aria-hidden="true" />
          <span>{t('a11y.largerText')}</span>
        </button>
        <button type="button" class="opt-btn" data-a11y="contrast" aria-pressed="false">
          <Contrast size={20} aria-hidden="true" />
          <span>{t('a11y.highContrast')}</span>
        </button>
      </div>
      <ul>
        <li>
          <a href={href('home', lang)} class="mobile-link">
            {t('nav.home')}
          </a>
        </li>
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="mobile-link"
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
            {subMenus[l.key] && (
              <ul class="mobile-sub">
                {subMenus[l.key]!.links.map((s) => (
                  <li>
                    <a href={s.href} class="mobile-sublink" data-menu-anchor>
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </dialog>
</header>

<script>
  // Reading comfort (larger text, high contrast): a class on <html>, remembered on this device.
  const root = document.documentElement;
  const prefs = ['large', 'contrast'] as const;
  const read = (k: string) => {
    try {
      return localStorage.getItem(`matin-a11y-${k}`) === '1';
    } catch {
      return false;
    }
  };
  const apply = (k: string, on: boolean) => {
    root.classList.toggle(`a11y-${k}`, on);
    document
      .querySelectorAll(`[data-a11y="${k}"]`)
      .forEach((b) => b.setAttribute('aria-pressed', String(on)));
  };
  prefs.forEach((k) => apply(k, read(k)));
  document.querySelectorAll<HTMLButtonElement>('[data-a11y]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const k = btn.dataset.a11y!;
      const on = !root.classList.contains(`a11y-${k}`);
      apply(k, on);
      try {
        localStorage.setItem(`matin-a11y-${k}`, on ? '1' : '0');
      } catch {
        /* storage blocked: the choice lasts for this page only */
      }
    }),
  );

  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  openBtn?.addEventListener('click', () => {
    dialog?.showModal();
    document.documentElement.style.overflow = 'hidden';
  });
  dialog?.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
  // Escape fires "cancel"; some browsers then skip "close", so clean up on both.
  const onClosed = () => {
    document.documentElement.style.overflow = '';
    openBtn?.focus();
  };
  dialog?.addEventListener('close', onClosed);
  dialog?.addEventListener('cancel', onClosed);
  // Close when the backdrop is clicked, or when an anchor on the current page is chosen.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-menu-anchor]');
    if (a && a.pathname === location.pathname) dialog.close();
  });

  // "About" dropdown: button toggles it (keyboard, mouse, touch); hover opens it on
  // devices with a mouse; Escape or leaving it closes it.
  document.querySelectorAll<HTMLElement>('[data-submenu]').forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('[data-submenu-toggle]')!;
    const list = item.querySelector<HTMLElement>('[data-submenu-list]')!;
    let openedByHover = false;
    const set = (open: boolean) => {
      list.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      if (!open) openedByHover = false;
    };
    // A click right after hovering keeps the menu open instead of closing it.
    btn.addEventListener('click', () => {
      if (openedByHover) openedByHover = false;
      else set(list.hidden === true);
    });
    const hover = window.matchMedia('(hover: hover) and (pointer: fine)');
    item.addEventListener('mouseenter', () => {
      if (hover.matches && list.hidden) {
        set(true);
        openedByHover = true;
      }
    });
    item.addEventListener('mouseleave', () => hover.matches && set(false));
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !list.hidden) {
        set(false);
        btn.focus();
      }
      if (e.key === 'ArrowDown' && document.activeElement === btn) {
        e.preventDefault();
        set(true);
        list.querySelector<HTMLElement>('a')?.focus();
      }
    });
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) set(false);
    });
    document.addEventListener('click', (e) => {
      if (!item.contains(e.target as Node)) set(false);
    });
  });

  // Subtle shadow once the page is scrolled.
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  /* Cream header, navy menu band (design-system brief, Oct 31 2026). */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--matin-ivoire);
    border-block-end: 1px solid transparent;
    transition:
      box-shadow 0.25s,
      border-color 0.25s;
  }
  .site-header.is-scrolled {
    border-block-end-color: var(--color-line);
  }
  /* Wider than the page content so the logo sits further left and the search
     and language links further right. */
  .header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 1rem;
    width: 100%;
    max-width: 110rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  .brand-block {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }
  /* The slogans beside the logo, from wide screens (the top row has room there). */
  .header-slogan {
    display: none;
    flex-direction: column;
    gap: 0.2rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 1px solid color-mix(in srgb, var(--matin-brique) 45%, transparent);
    line-height: 1.15;
  }
  @media (min-width: 84rem) {
    .header-slogan {
      display: flex;
    }
  }
  /* In the phone and tablet menu, the slogans open the panel. */
  .header-slogan--menu {
    display: flex;
    margin-block-end: 1.25rem;
    padding-inline-start: 1rem;
    border-inline-start-width: 3px;
    border-inline-start-color: var(--matin-soleil);
  }
  .header-slogan__main {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--matin-encre);
    white-space: nowrap;
  }
  :global([dir='rtl']) .header-slogan__main {
    font-family: 'Vazirmatn Variable', Tahoma, sans-serif;
    font-style: normal;
    font-size: 1.35rem;
  }
  .header-slogan__fa {
    font-family: 'Vazirmatn Variable', Tahoma, sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--matin-brique-ink);
    white-space: nowrap;
  }
  .donate-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.45rem 1.05rem;
    margin-inline-end: 0.5rem;
    border-radius: 999px;
    background: var(--btn-accent-bg);
    color: var(--btn-accent-fg);
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s ease;
  }
  .donate-btn:hover {
    background: var(--btn-accent-bg-hover);
    color: var(--btn-accent-fg);
  }
  /* Phones: the top row has no room (it would wrap), so the button opens the menu instead. */
  .donate-btn--menu {
    display: flex;
    justify-content: center;
    margin: 0 0 1.5rem;
    min-height: 3.25rem;
    font-size: 1.1rem;
  }
  @media (max-width: 30rem) {
    .header-tools .donate-btn {
      display: none;
    }
  }
  .join-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.4rem 1rem;
    margin-inline-end: 0.25rem;
    border-radius: 999px;
    border: 2px solid var(--btn-secondary-bg);
    color: var(--btn-secondary-bg);
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .join-btn:hover {
    background: var(--btn-secondary-bg);
    color: var(--btn-secondary-fg);
  }
  .join-btn--menu {
    display: flex;
    justify-content: center;
    margin: -0.75rem 0 1.25rem;
    min-height: 3.25rem;
    font-size: 1.1rem;
  }
  .display-opts {
    display: none;
  }
  .display-opts [aria-pressed='true'],
  .opt-btn[aria-pressed='true'] {
    background: var(--matin-encre);
    color: var(--matin-white);
  }
  .display-opts--menu {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-block-end: 1.5rem;
  }
  .opt-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3rem;
    padding: 0.5rem;
    border-radius: 1rem;
    border: 1px solid var(--color-card-edge);
    background: var(--matin-white);
    color: var(--matin-encre);
    font-family: var(--font-display);
    font-weight: 700;
  }
  /* Wide screens only: on smaller ones the top row has no room, the menu has them. */
  @media (max-width: 63.99rem) {
    .header-tools .join-btn {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .display-opts {
      display: flex;
      gap: 0.1rem;
    }
  }
  /* The search and language links set the height of the top row. */
  .header-tools {
    display: flex;
    align-items: center;
    height: 5.5rem;
  }
  @media (min-width: 40rem) {
    .header-row {
      padding-inline: 2rem;
    }
  }
  @media (min-width: 96rem) {
    .header-row {
      padding-inline: 3rem;
    }
  }

  /* Nine menu items (owner's brief, Oct 24 2026) do not fit beside the logo, so on
     desktop the menu has its own row under the logo, the same in every language. When
     the page scrolls, the top row slides away and only the menu row stays in view. */
  .desktop-nav {
    display: none;
  }
  @media (min-width: 78rem) {
    .site-header {
      top: -5.5rem;
    }
    /* The menu row is a full-width navy band. */
    .desktop-nav {
      display: block;
      flex-basis: 100%;
      background: var(--matin-encre);
      box-shadow: 0 0 0 100vmax var(--matin-encre);
      clip-path: inset(0 -100vmax);
    }
    .desktop-nav > ul {
      justify-content: center;
      height: 3.5rem;
    }
    .menu-btn.mobile-only {
