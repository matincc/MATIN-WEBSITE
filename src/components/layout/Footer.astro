---
import { MapPin, Phone, Mail, Clock } from '@lucide/astro';
import Lockup from '@/components/brand/Lockup.astro';
import MontrealSkyline from '@/components/brand/MontrealSkyline.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import { href, type RouteKey, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { emptySections, getSettings } from '@/lib/content';

interface Props {
  lang: UiLang;
  showNewsletter?: boolean;
}
const { lang, showNewsletter = true } = Astro.props;
const t = useTranslations(lang);
const s = await getSettings();
// The Persian institutional slogan, on the Persian pages only (owner, Oct 31 2026).
const faSlogan = useTranslations('fa')('home.positioning');

// Same order as the header menu; the FAQ (left out until it has questions), Become a Member
// (Oct 28 2026) and Careers (owner's request, Oct 27 2026; neither in the header menu) sit
// before Contact.
// Help when a click on the address opens no mail app (owner, Oct 31 2026): copy it, or
// write through the site's own form.
const mailHelp = {
  fr: { copy: 'Copier l’adresse', copied: 'Adresse copiée', form: 'ou écrivez-nous ici' },
  en: { copy: 'Copy address', copied: 'Address copied', form: 'or write to us here' },
  fa: { copy: 'کپی نشانی', copied: 'نشانی کپی شد', form: 'یا از اینجا برای ما بنویسید' },
}[lang];
const empty = await emptySections();
const explore = (
  [
    'about',
    'team',
    'programs',
    'events',
    'news',
    'gallery',
    'resources',
    'faq',
    'membership',
    'support',
    'careers',
    'contact',
  ] as RouteKey[]
).filter((k) => k !== 'faq' || !empty.has('faq'));
const links = explore.map((key) => ({ href: href(key, lang), label: t(`nav.${key}`) }));
const legal: RouteKey[] = ['legalInfo', 'privacy', 'terms', 'accessibility'];
const year = new Intl.NumberFormat(lang === 'fa' ? 'fa-IR' : 'en-CA', {
  useGrouping: false,
}).format(new Date().getFullYear());
// Contact details appear only once they are set in the site settings.
const a = s.address;
const fullAddress = a && `${a.street}, ${a.city} (${a.region}) ${a.postalCode}`;
const mapsUrl =
  fullAddress &&
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
const hasContact = Boolean(a || s.phone || s.email);
---

<footer class="footer on-dark text-white">
  <!-- Terracotta and saffron edge (design-system brief, Oct 31 2026). -->
  <div class="footer-edge" aria-hidden="true"><span></span><span></span></div>
  <!-- Signature: logo and name, then the two slogans, as in the header. -->
  <div class="container-site footer-sign">
    <Lockup lang={lang} variant="dark" />
    <p class="footer-slogan">
      <span class="footer-slogan__main">{t('brand.tagline')}</span>
      {lang === 'fa' && <span class="footer-slogan__fa" lang="fa" dir="rtl">{faSlogan}</span>}
    </p>
  </div>
  <div class="container-site grid gap-12 pt-10 pb-12 md:grid-cols-2 lg:grid-cols-12">
    <div class:list={[hasContact || s.hours ? 'lg:col-span-3 2xl:col-span-4' : 'lg:col-span-5']}>
      <p class="footer-about">{t('footer.about')}</p>
      {!hasContact && <SocialLinks lang={lang} social={s.social} class="mt-6" />}
    </div>

    <nav aria-label={t('a11y.footerNav')} class="lg:col-span-3">
      <h2 class="footer-title">{t('footer.linksTitle')}</h2>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href} class="footer-link">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {(hasContact || s.hours) && (
      <div class:list={[showNewsletter ? 'lg:col-span-3 2xl:col-span-2' : 'lg:col-span-3']}>
        {hasContact && (
          <>
            <h2 class="footer-title">{t('footer.contactTitle')}</h2>
            <address class="mb-8 space-y-3 text-[1.1875rem] not-italic">
              {a && (
                <p class="flex gap-3">
                  <MapPin size={18} class="mt-1 shrink-0 text-soleil" aria-hidden="true" />
                  <a href={mapsUrl} class="footer-link" target="_blank" rel="noopener noreferrer">
                    {a.street}
                    <br />
                    {a.city} ({a.region}) {a.postalCode}
                    <span class="sr-only">{t('a11y.externalLink')}</span>
                  </a>
                </p>
              )}
              {s.phone && (
                <p class="flex gap-3">
                  <Phone size={18} class="mt-1 shrink-0 text-soleil" aria-hidden="true" />
                  <a
                    href={`tel:${s.phone.replace(/[^\d+]/g, '')}`}
                    class="footer-link whitespace-nowrap"
                    dir="ltr"
                  >
                    {s.phone}
                  </a>
                </p>
              )}
              {s.email && (
                <p class="flex gap-3">
                  <Mail size={18} class="mt-1 shrink-0 text-soleil" aria-hidden="true" />
                  <span class="flex flex-col gap-1.5">
                    <a href={`mailto:${s.email}`} class="footer-link whitespace-nowrap" dir="ltr">
                      {s.email}
                    </a>
                    <span class="mail-help">
                      <button
                        type="button"
                        class="mail-help__copy"
                        data-copy-email={s.email}
                        data-copied={mailHelp.copied}
                      >
                        {mailHelp.copy}
                      </button>
                      <a href={`${href('contact', lang)}#write`} class="footer-link">
                        {mailHelp.form}
                      </a>
                    </span>
                  </span>
                </p>
              )}
            </address>
            {/* Social links under the contact details (owner's brief, Oct 24 2026). */}
            <SocialLinks lang={lang} social={s.social} class="-mt-2 mb-8" />
          </>
        )}
        {s.hours && (
          <>
            <h2 class="footer-title">{t('footer.hoursTitle')}</h2>
            <p class="flex gap-3 text-[1.1875rem] whitespace-pre-line">
              <Clock size={18} class="mt-1 shrink-0 text-soleil" aria-hidden="true" />
              <span>{pick(s.hours, lang)}</span>
            </p>
          </>
        )}
      </div>
    )}

    {showNewsletter && (
      <div
        id="stay-connected"
        class:list={[
          'scroll-mt-24 md:col-span-2',
          hasContact || s.hours ? 'lg:col-span-3' : 'lg:col-span-4',
        ]}
      >
        {/* Old #newsletter links (the homepage panel was removed, Oct 25 2026) land here. */}
        <span id="newsletter" class="block scroll-mt-24" aria-hidden="true"></span>
        <h2 class="footer-title">{t('footer.newsletterTitle')}</h2>
        <p class="mb-4 text-[1.125rem] text-cream">{t('newsletter.text')}</p>
        <NewsletterForm lang={lang} compact id="footer-newsletter" />
      </div>
    )}
  </div>

  <!-- Montréal on the horizon: the city stands on the copyright bar. -->
  <MontrealSkyline class="mt-4" />
  <div class="footer-base">
    <div class="container-site flex flex-col gap-4 py-7 text-[1.0625rem] md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {t('meta.siteName')}. {t('footer.rights')}
        {s.charityNumber && (
          <span class="block md:inline">
            {t('footer.charity')} {s.charityNumber}
          </span>
        )}
      </p>
      <nav aria-label={t('a11y.legalNav')}>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {legal.map((key) => (
            <li>
              <a href={href(key, lang)} class="footer-link">
                {t(`nav.${key}`)}
              </a>
            </li>
          ))}
          <li>
            <button type="button" class="footer-link cursor-pointer" data-consent-open>
              {t('consent.manage')}
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
  <!-- Two soft waves, terracotta and saffron, close the page. -->
  <svg
    class="footer-waves"
    viewBox="0 0 1440 48"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path class="footer-waves__terra" d="M0 48 V24 C260 2 520 4 760 20 C1000 36 1220 32 1440 8 V48 Z"></path>
    <path class="footer-waves__saffron" d="M0 48 V38 C320 20 600 22 860 32 C1100 42 1280 36 1440 22 V48 Z"></path>
  </svg>
</footer>

<style>
  /* Navy footer (design-system brief, Oct 31 2026): white text 11.6:1, saffron 5.5:1. */
  .footer {
    background: var(--matin-encre);
  }
  .footer-edge {
    display: flex;
    height: 0.35rem;
  }
  .footer-edge > span:first-child {
    flex: 3;
    background: var(--matin-brique);
  }
  .footer-edge > span:last-child {
    flex: 2;
    background: var(--matin-soleil);
  }
  .footer-sign {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    padding-block: 2.75rem 2.25rem;
    border-block-end: 1px solid color-mix(in srgb, var(--matin-white) 14%, transparent);
  }
  .footer-slogan {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-inline-start: 2rem;
    border-inline-start: 1px solid color-mix(in srgb, var(--matin-soleil) 55%, transparent);
    line-height: 1.2;
  }
  .footer-slogan__main {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    color: var(--matin-soleil);
  }
  :global([dir='rtl']) .footer-slogan__main {
    font-family: 'Vazirmatn Variable', Tahoma, sans-serif;
    font-style: normal;
  }
  /* Light terracotta on navy, 5.3:1. */
  .footer-slogan__fa {
    font-family: 'Vazirmatn Variable', Tahoma, sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: color-mix(in srgb, var(--matin-brique) 60%, white);
  }
  /* The copyright bar: the deeper navy the city stands on. */
  .footer-base {
    background: var(--color-nuit);
  }
  .footer-waves {
    display: block;
    width: 100%;
    height: clamp(2rem, 1.2rem + 2vw, 3.5rem);
    margin-block-start: -1px;
    background: var(--color-nuit);
  }
  .footer-waves__terra {
    fill: var(--matin-brique);
  }
  .footer-waves__saffron {
    fill: var(--matin-soleil);
  }
  /* The introduction under "Cultures in Dialogue": more room and air (owner's brief,
     Oct 24 2026). */
  .footer-about {
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-sable);
    text-wrap: pretty;
  }
  .footer-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 1rem;
  }
  /* White on deep terracotta 6.4:1; cream underline on hover. */
  .footer-link {
    color: var(--color-white);
    text-decoration: none;
  }
  .footer-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-soleil);
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    column-gap: 2.5rem;
    row-gap: 0.55rem;
    font-size: 1.1875rem;
  }
</style>

<style>
  .mail-help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-size: 0.95rem;
  }
  .mail-help__copy {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    border: 1.5px solid var(--matin-soleil);
    color: var(--matin-soleil);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
  }
  .mail-help__copy:hover,
  .mail-help__copy[data-done] {
    background: var(--matin-soleil);
    color: var(--matin-encre);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyEmail!);
        btn.textContent = btn.dataset.copied!;
        btn.setAttribute('data-done', '');
        setTimeout(() => {
          btn.textContent = label;
          btn.removeAttribute('data-done');
        }, 2500);
      } catch {
        /* clipboard blocked: the address stays visible to copy by hand */
      }
    });
  });
</script>
