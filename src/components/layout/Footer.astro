---
import { MapPin, Phone, Mail, Clock } from '@lucide/astro';
import Lockup from '@/components/brand/Lockup.astro';
import MontrealSkyline from '@/components/brand/MontrealSkyline.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import { href, type RouteKey, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { emptySections, getSettings } from '@/lib/content';

interface Props {
  lang: UiLang;
  showNewsletter?: boolean;
}
const { lang, showNewsletter = true } = Astro.props;
const t = useTranslations(lang);
const s = await getSettings();

// Same order as the header menu; the FAQ (left out until it has questions) sits before
// Contact.
const empty = await emptySections();
const explore = (
  [
    'about',
    'team',
    'programs',
    'events',
    'news',
    'gallery',
    'resources',
    'faq',
    'contact',
  ] as RouteKey[]
).filter((k) => k !== 'faq' || !empty.has('faq'));
const links = explore.map((key) => ({ href: href(key, lang), label: t(`nav.${key}`) }));
const legal: RouteKey[] = ['legalInfo', 'privacy', 'terms', 'accessibility'];
const year = new Intl.NumberFormat(lang === 'fa' ? 'fa-IR' : 'en-CA', {
  useGrouping: false,
}).format(new Date().getFullYear());
// Contact details appear only once they are set in the site settings.
const a = s.address;
const fullAddress = a && `${a.street}, ${a.city} (${a.region}) ${a.postalCode}`;
const mapsUrl =
  fullAddress &&
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
const hasContact = Boolean(a || s.phone || s.email);
---

<footer class="footer on-terracotta text-white">
  <div class="mosaic footer-mosaic" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="container-site grid gap-12 pt-16 pb-12 md:grid-cols-2 lg:grid-cols-12">
    <div class:list={[hasContact || s.hours ? 'lg:col-span-3 2xl:col-span-4' : 'lg:col-span-5']}>
      <div class="mb-6">
        <Lockup lang={lang} variant="dark" />
      </div>
      <p class="mb-4 font-display text-[1.75rem] font-extrabold text-white">{t('brand.tagline')}</p>
      <p class="footer-about">{t('footer.about')}</p>
      {!hasContact && <SocialLinks lang={lang} social={s.social} class="mt-6" />}
    </div>

    <nav aria-label={t('a11y.footerNav')} class="lg:col-span-3">
      <h2 class="footer-title">{t('footer.linksTitle')}</h2>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href} class="footer-link">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {(hasContact || s.hours) && (
      <div class:list={[showNewsletter ? 'lg:col-span-3 2xl:col-span-2' : 'lg:col-span-3']}>
        {hasContact && (
          <>
            <h2 class="footer-title">{t('footer.contactTitle')}</h2>
            <address class="mb-8 space-y-3 text-[1.1875rem] not-italic">
              {a && (
                <p class="flex gap-3">
                  <MapPin size={18} class="mt-1 shrink-0 text-cream" aria-hidden="true" />
                  <a href={mapsUrl} class="footer-link" target="_blank" rel="noopener noreferrer">
                    {a.street}
                    <br />
                    {a.city} ({a.region}) {a.postalCode}
                    <span class="sr-only">{t('a11y.externalLink')}</span>
                  </a>
                </p>
              )}
              {s.phone && (
                <p class="flex gap-3">
                  <Phone size={18} class="mt-1 shrink-0 text-cream" aria-hidden="true" />
                  <a
                    href={`tel:${s.phone.replace(/[^\d+]/g, '')}`}
                    class="footer-link whitespace-nowrap"
                    dir="ltr"
                  >
                    {s.phone}
                  </a>
                </p>
              )}
              {s.email && (
                <p class="flex gap-3">
                  <Mail size={18} class="mt-1 shrink-0 text-cream" aria-hidden="true" />
                  <a href={`mailto:${s.email}`} class="footer-link whitespace-nowrap" dir="ltr">
                    {s.email}
                  </a>
                </p>
              )}
            </address>
            {/* Social links under the contact details (owner's brief, Oct 24 2026). */}
            <SocialLinks lang={lang} social={s.social} class="-mt-2 mb-8" />
          </>
        )}
        {s.hours && (
          <>
            <h2 class="footer-title">{t('footer.hoursTitle')}</h2>
            <p class="flex gap-3 text-[1.1875rem] whitespace-pre-line">
              <Clock size={18} class="mt-1 shrink-0 text-cream" aria-hidden="true" />
              <span>{pick(s.hours, lang)}</span>
            </p>
          </>
        )}
      </div>
    )}

    {showNewsletter && (
      <div
        id="stay-connected"
        class:list={[
          'scroll-mt-24 md:col-span-2',
          hasContact || s.hours ? 'lg:col-span-3' : 'lg:col-span-4',
        ]}
      >
        {/* Old #newsletter links (the homepage panel was removed, Oct 25 2026) land here. */}
        <span id="newsletter" class="block scroll-mt-24" aria-hidden="true"></span>
        <h2 class="footer-title">{t('footer.newsletterTitle')}</h2>
        <p class="mb-4 text-[1.125rem] text-cream">{t('newsletter.text')}</p>
        <NewsletterForm lang={lang} compact id="footer-newsletter" />
      </div>
    )}
  </div>

  <!-- Montréal on the horizon: the city stands on the copyright bar. -->
  <MontrealSkyline class="mt-4" />
  <div class="footer-base">
    <div class="container-site flex flex-col gap-4 py-7 text-[1.0625rem] md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {t('meta.siteName')}. {t('footer.rights')}
        {s.charityNumber && (
          <span class="block md:inline">
            {t('footer.charity')} {s.charityNumber}
          </span>
        )}
      </p>
      <nav aria-label={t('a11y.legalNav')}>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {legal.map((key) => (
            <li>
              <a href={href(key, lang)} class="footer-link">
                {t(`nav.${key}`)}
              </a>
            </li>
          ))}
          <li>
            <button type="button" class="footer-link cursor-pointer" data-consent-open>
              {t('consent.manage')}
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  /* The four-colour mosaic as the footer's top edge. */
  .footer-mosaic {
    gap: 0;
    height: 0.4rem;
  }
  .footer-mosaic > span {
    border-radius: 0;
  }
  /* Warm footer (owner's request, Oct 2026): deep terracotta, white text 6.4:1. */
  .footer {
    background: var(--color-terracotta-deep);
  }
  /* Darker warm brown under the skyline; white text 9:1 or more. */
  .footer-base {
    background: color-mix(in srgb, var(--color-terracotta-deep) 62%, black);
  }
  /* The introduction under "Cultures in Dialogue": more room and air (owner's brief,
     Oct 24 2026). */
  .footer-about {
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-cream);
    text-wrap: pretty;
  }
  .footer-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 1rem;
  }
  /* White on deep terracotta 6.4:1; cream underline on hover. */
  .footer-link {
    color: var(--color-white);
    text-decoration: none;
  }
  .footer-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-cream);
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    column-gap: 2.5rem;
    row-gap: 0.55rem;
    font-size: 1.1875rem;
  }
</style>
