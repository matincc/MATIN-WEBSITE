---
import { MapPin, Phone, Mail, Clock } from '@lucide/astro';
import Lockup from '@/components/brand/Lockup.astro';
import LeafRule from '@/components/brand/LeafRule.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import { href, type RouteKey, type UiLang } from '@/i18n/routes';
import { useTranslations, pick } from '@/i18n/ui';
import { emptySections, forLang, getSettings, getTeam } from '@/lib/content';

interface Props {
  lang: UiLang;
  showNewsletter?: boolean;
}
const { lang, showNewsletter = true } = Astro.props;
const t = useTranslations(lang);
const s = await getSettings();

// Pages without content yet (empty gallery, FAQ…) are left out rather than linked.
const empty = await emptySections();
const hasTeam = forLang(await getTeam(), lang).length > 0;
const explore = (
  [
    'about',
    'events',
    'news',
    'programs',
    'getInvolved',
    'gallery',
    'resources',
    'faq',
    'contact',
  ] as RouteKey[]
).filter((k) => !empty.has(k as 'gallery' | 'faq' | 'resources'));
const links = explore.map((key) => ({ href: href(key, lang), label: t(`nav.${key}`) }));
if (hasTeam) links.splice(1, 0, { href: `${href('about', lang)}#team`, label: t('nav.team') });
const legal: RouteKey[] = ['privacy', 'terms', 'accessibility'];
const year = new Intl.NumberFormat(lang === 'fa' ? 'fa-IR' : 'en-CA', {
  useGrouping: false,
}).format(new Date().getFullYear());
// Contact details appear only once they are set in the site settings.
const a = s.address;
const fullAddress = a && `${a.street}, ${a.city} (${a.region}) ${a.postalCode}`;
const mapsUrl =
  fullAddress &&
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
const hasContact = Boolean(a || s.phone || s.email);
---

<footer class="on-dark border-t-4 border-gold bg-primary text-white">
  <div class="container-site grid gap-12 pt-14 pb-12 md:grid-cols-2 lg:grid-cols-12">
    <div class:list={[hasContact || s.hours ? 'lg:col-span-4' : 'lg:col-span-5']}>
      <div class="mb-6">
        <Lockup lang={lang} variant="dark" />
      </div>
      <p class="mb-3 font-display text-2xl font-bold text-white">{t('brand.tagline')}</p>
      <p class="max-w-md text-[0.95rem] leading-relaxed">{t('footer.about')}</p>
      <SocialLinks lang={lang} social={s.social} class="mt-6" />
    </div>

    <nav aria-label={t('a11y.footerNav')} class="lg:col-span-3">
      <h2 class="footer-title">{t('footer.linksTitle')}</h2>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href} class="footer-link">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {(hasContact || s.hours) && (
      <div class="lg:col-span-3">
        {hasContact && (
          <>
            <h2 class="footer-title">{t('footer.contactTitle')}</h2>
            <address class="mb-8 space-y-3 text-[0.95rem] not-italic">
              {a && (
                <p class="flex gap-3">
                  <MapPin size={18} class="mt-1 shrink-0 text-gold" aria-hidden="true" />
                  <a href={mapsUrl} class="footer-link" target="_blank" rel="noopener noreferrer">
                    {a.street}
                    <br />
                    {a.city} ({a.region}) {a.postalCode}
                    <span class="sr-only">{t('a11y.externalLink')}</span>
                  </a>
                </p>
              )}
              {s.phone && (
                <p class="flex gap-3">
                  <Phone size={18} class="mt-1 shrink-0 text-gold" aria-hidden="true" />
                  <a href={`tel:${s.phone.replace(/[^\d+]/g, '')}`} class="footer-link">
                    {s.phone}
                  </a>
                </p>
              )}
              {s.email && (
                <p class="flex gap-3">
                  <Mail size={18} class="mt-1 shrink-0 text-gold" aria-hidden="true" />
                  <a href={`mailto:${s.email}`} class="footer-link break-all">
                    {s.email}
                  </a>
                </p>
              )}
            </address>
          </>
        )}
        {s.hours && (
          <>
            <h2 class="footer-title">{t('footer.hoursTitle')}</h2>
            <p class="flex gap-3 text-[0.95rem] whitespace-pre-line">
              <Clock size={18} class="mt-1 shrink-0 text-gold" aria-hidden="true" />
              <span>{pick(s.hours, lang)}</span>
            </p>
          </>
        )}
      </div>
    )}

    {showNewsletter && (
      <div
        id="stay-connected"
        class:list={[
          'scroll-mt-24 md:col-span-2',
          hasContact || s.hours ? 'lg:col-span-3' : 'lg:col-span-4',
        ]}
      >
        <h2 class="footer-title">{t('footer.newsletterTitle')}</h2>
        <p class="mb-4 text-[0.95rem]">{t('newsletter.text')}</p>
        <NewsletterForm lang={lang} compact id="footer-newsletter" />
      </div>
    )}
  </div>

  <div class="container-site">
    <LeafRule class="mx-auto max-w-none" />
  </div>
  <div class="container-site flex flex-col gap-4 py-7 text-sm md:flex-row md:items-center md:justify-between">
    <p>
      © {year} {t('meta.siteName')}. {t('footer.rights')}
      {s.charityNumber && (
        <span class="block md:inline">
          {t('footer.charity')} {s.charityNumber}
        </span>
      )}
    </p>
    <nav aria-label={t('a11y.legalNav')}>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {legal.map((key) => (
          <li>
            <a href={href(key, lang)} class="footer-link">
              {t(`nav.${key}`)}
            </a>
          </li>
        ))}
        <li>
          <button type="button" class="footer-link cursor-pointer" data-consent-open>
            {t('consent.manage')}
          </button>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 1rem;
  }
  /* White on blue 11.6:1; gold underline on hover. */
  .footer-link {
    color: var(--color-white);
    text-decoration: none;
  }
  .footer-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    column-gap: 2.5rem;
    row-gap: 0.4rem;
  }
</style>
