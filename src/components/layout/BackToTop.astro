---
/**
 * "Back to Top": a pill-shaped link centred just above the footer on every page (never
 * floating, so it covers nothing; owner's brief, Oct 25 2026).
 * The page scrolls up smoothly, or jumps under prefers-reduced-motion (global.css).
 */
import { ArrowUp } from '@lucide/astro';
import type { UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
}
const t = useTranslations(Astro.props.lang);
---

<nav class="back-to-top" aria-label={t('a11y.backToTop')} data-pagefind-ignore>
  <a href="#top" class="back-to-top__link">
    <span class="back-to-top__icon" aria-hidden="true">
      <ArrowUp size={18} stroke-width={2.25} />
    </span>
    {t('a11y.backToTop')}
  </a>
</nav>

<style>
  .back-to-top {
    display: flex;
    justify-content: center;
    padding-block: 2.5rem;
  }
  /* Ivory pill with a teal edge and navy text (10.9:1); navy with white text on hover. */
  .back-to-top__link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3rem;
    padding: 0.4rem 1.4rem 0.4rem 0.45rem;
    border: 1.5px solid var(--color-teal-edge);
    border-radius: 999px;
    background: var(--color-ivory);
    box-shadow: var(--shadow-card);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-primary);
    text-decoration: none;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global([dir='rtl']) .back-to-top__link {
    padding: 0.4rem 0.45rem 0.4rem 1.4rem;
  }
  .back-to-top__icon {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-primary);
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .back-to-top__link:hover {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
    transform: translateY(-2px);
  }
  .back-to-top__link:hover .back-to-top__icon {
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-top__link,
    .back-to-top__icon {
      transition: none;
    }
    .back-to-top__link:hover,
    .back-to-top__link:hover .back-to-top__icon {
      transform: none;
    }
  }
</style>
