---
/**
 * The one section-title pattern used across the site: centred title, then a thin gold
 * line on each side of a small gold maple leaf. Optional eyebrow, lede and link.
 */
import { ArrowRight } from '@lucide/astro';
import LeafRule from '@/components/brand/LeafRule.astro';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  link?: { href: string; label: string };
  /** Heading level; h2 by default. */
  as?: 'h2' | 'h3';
  class?: string;
}
const { id, eyebrow, title, lede, link, as: Tag = 'h2', class: className = 'mb-12' } = Astro.props;
---

<div class:list={['flex flex-col items-center text-center', className]} data-reveal>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <Tag id={id} class="section-title max-w-3xl">
    {title}
  </Tag>
  <LeafRule class="mt-5 w-48" />
  {lede && <p class="lede mt-5 max-w-2xl">{lede}</p>}
  {link && (
    <a href={link.href} class="link-arrow mt-5">
      {link.label}
      <ArrowRight size={18} class="flip-rtl" aria-hidden="true" />
    </a>
  )}
</div>
