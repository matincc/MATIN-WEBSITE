---
/**
 * Click-to-play YouTube facade: nothing is requested from YouTube until the
 * visitor clicks (privacy + performance). Uses the youtube-nocookie domain.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { Play } from '@lucide/astro';
import type { UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
  youtubeId: string;
  title: string;
  /** Still image shown until the visitor clicks (stored on this site, not YouTube's). */
  thumbnail?: ImageMetadata;
  /** Hide the caption (when the title is shown elsewhere). */
  bare?: boolean;
}
const { lang, youtubeId, title, thumbnail, bare = false } = Astro.props;
const t = useTranslations(lang);
---

<figure class="video">
  <div class="video__frame" data-video={youtubeId} data-video-title={title}>
    {thumbnail && (
      <Picture
        src={thumbnail}
        alt=""
        formats={['avif', 'webp']}
        widths={[640, 960, 1280]}
        sizes="(min-width: 64rem) 50vw, 100vw"
        class="video__thumb"
      />
    )}
    <button type="button" class="video__btn" data-video-play>
      <span class="video__play" aria-hidden="true">
        <Play size={30} fill="currentColor" />
      </span>
      <span class="sr-only">{t('gallery.play', { title })}</span>
    </button>
  </div>
  <figcaption class:list={['mt-3', bare && 'sr-only']}>
    <span class="block font-bold text-ink">{title}</span>
    <span class="text-xs text-muted">{t('gallery.videoNotice')}</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((frame) => {
    frame.querySelector('[data-video-play]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.video}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.videoTitle ?? 'YouTube';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-tint);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
  }
  .video__frame :global(.video__thumb),
  .video__frame :global(.video__thumb img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__btn {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .video__play {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    padding-left: 4px;
    border-radius: 999px;
    color: var(--color-ink);
    background: var(--color-gold);
    transition: transform 0.2s;
  }
  .video__btn:hover .video__play {
    transform: scale(1.08);
  }
  .video__btn:focus-visible {
    outline-color: var(--color-primary);
    outline-offset: -6px;
  }
</style>
