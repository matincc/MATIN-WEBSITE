---
/**
 * One published story: a vertical (9:16) click-to-play card. Nothing is requested from
 * YouTube until the visitor clicks (youtube-nocookie, like VideoFacade). Before that, the
 * card shows the person's first name, city and question on a palette ground.
 */
import { Play } from '@lucide/astro';
import type { UiLang } from '@/i18n/routes';
import { storyPrompt, storyStrings } from '@/i18n/stories';
import { pick } from '@/i18n/ui';
import type { Story } from '@/lib/stories';

interface Props {
  lang: UiLang;
  story: Story;
  /** Position in its list, to vary the ground colour. */
  index?: number;
}
const { lang, story, index = 0 } = Astro.props;
const s = storyStrings(lang);
const tones = ['firouzeh', 'brique', 'encre'] as const;
const caption = pick(story.caption, lang);
---

<figure class="clip" data-tone={tones[index % tones.length]}>
  <div
    class="clip__frame"
    data-story-video={story.videoId}
    data-story-title={s.play.replace('{name}', story.firstName)}
  >
    <div class="clip__cover" aria-hidden="true">
      <span class="clip__sun"></span>
      <p class="clip__prompt">{storyPrompt(story.prompt, lang)}</p>
    </div>
    <button type="button" class="clip__btn" data-story-play>
      <span class="clip__play" aria-hidden="true">
        <Play size={28} fill="currentColor" />
      </span>
      <span class="sr-only">{s.play.replace('{name}', story.firstName)}</span>
    </button>
  </div>
  <figcaption class="clip__who">
    <span class="clip__name">{story.firstName}</span>
    <span class="clip__city">{story.city}</span>
    {caption && <span class="clip__caption">{caption}</span>}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-story-video]').forEach((frame) => {
    frame.querySelector('[data-story-play]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.storyVideo}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = frame.dataset.storyTitle ?? 'YouTube';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .clip {
    --tone: var(--matin-firouzeh-ink);
    margin: 0;
  }
  .clip[data-tone='brique'] {
    --tone: var(--matin-brique-ink);
  }
  .clip[data-tone='encre'] {
    --tone: var(--matin-encre);
  }
  .clip__frame {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 1.25rem;
    border-start-end-radius: 3.5rem;
    background: var(--tone);
  }
  .clip__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .clip__cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem 1.25rem;
  }
  .clip__sun {
    position: absolute;
    inset-block-start: 1.5rem;
    inset-inline-end: 1.5rem;
    width: 3.5rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--matin-soleil);
  }
  .clip__prompt {
    font-family: var(--font-editorial);
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--matin-white);
  }
  .clip__btn {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .clip__play {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    padding-inline-start: 4px;
    border-radius: 999px;
    color: var(--matin-encre);
    background: var(--matin-soleil);
    transition: transform 0.2s;
  }
  .clip__btn:hover .clip__play {
    transform: scale(1.08);
  }
  .clip__btn:focus-visible {
    outline: 3px solid var(--matin-soleil);
    outline-offset: -6px;
  }
  .clip__who {
    display: grid;
    gap: 0.15rem;
    margin-block-start: 0.85rem;
  }
  .clip__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--matin-encre);
  }
  .clip__city {
    font-size: 0.95rem;
    color: var(--matin-firouzeh-ink);
    font-weight: 600;
  }
  .clip__caption {
    margin-block-start: 0.3rem;
    color: var(--matin-ink);
    line-height: 1.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .clip__play {
      transition: none;
    }
  }
</style>
