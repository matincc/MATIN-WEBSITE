---
/**
 * "Express your interest" form (Netlify Forms, form name "interet").
 * Collects no payment or banking information. While settings `formsEnabled` is false,
 * a short "opens soon" message with a link to Contact is shown, and the form stays
 * hidden in the HTML so Netlify can still detect it once form detection is turned on.
 */
import { Mail } from '@lucide/astro';
import FormShell from './FormShell.astro';
import Field from './Field.astro';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getSettings } from '@/lib/content';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { formsEnabled } = await getSettings();
const areas = [
  { name: 'interest_partnerships', label: t('interest.areaPartnerships') },
  { name: 'interest_research', label: t('interest.areaResearch') },
  { name: 'interest_programs', label: t('interest.areaPrograms') },
  { name: 'interest_volunteering', label: t('interest.areaVolunteering') },
  { name: 'interest_updates', label: t('interest.areaUpdates') },
];
---

{!formsEnabled && (
  <div class="closed" role="status">
    <p class="mb-1 text-lg font-bold text-ink">{t('interest.closedTitle')}</p>
    <p class="mb-4">{t('interest.closedText')}</p>
    <a href={href('contact', lang)} class="btn btn-primary">
      <Mail size={18} aria-hidden="true" />
      {t('interest.closedLink')}
    </a>
  </div>
)}

<FormShell
  lang={lang}
  name="interet"
  id="interest"
  submitLabel={t('interest.submit')}
  consentText={t('interest.consent')}
  action={`${href('getInvolved', lang)}?sent=1`}
  disabled={!formsEnabled}
>
  <div class="grid gap-5 sm:grid-cols-2">
    <Field
      lang={lang}
      id="interest-name"
      name="name"
      label={t('form.name')}
      required
      autocomplete="name"
    />
    <Field
      lang={lang}
      id="interest-email"
      name="email"
      type="email"
      label={t('form.email')}
      required
      autocomplete="email"
    />
  </div>
  <Field
    lang={lang}
    id="interest-language"
    name="preferred_language"
    as="select"
    label={t('interest.preferredLanguage')}
    required
    placeholderOption="—"
    options={[t('interest.langFr'), t('interest.langEn'), t('interest.langFa')]}
  />
  <Field
    lang={lang}
    id="interest-organization"
    name="organization"
    label={t('interest.organization')}
    autocomplete="organization"
  />
  <fieldset class="field">
    <legend class="field-label mb-1">{t('interest.areas')}</legend>
    <p class="mb-2 text-sm text-muted">{t('interest.areasHint')}</p>
    <div class="grid gap-2">
      {areas.map((a) => (
        <label class="check">
          <input type="checkbox" name={a.name} value="oui" />
          <span>{a.label}</span>
        </label>
      ))}
    </div>
    <p class="mt-2 text-sm text-muted">{t('interest.updatesNote')}</p>
  </fieldset>
  <Field
    lang={lang}
    id="interest-message"
    name="message"
    as="textarea"
    label={t('interest.message')}
  />
  <p slot="before-submit" class="notice">
    {t('interest.notice')}
  </p>
</FormShell>

<style>
  .closed {
    padding: 1.25rem 1.4rem;
    border-radius: 1rem;
    background: var(--color-tint);
    color: var(--color-ink);
    border-inline-start: 4px solid var(--color-gold);
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    border-radius: 0.75rem;
    border: 1.5px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
    background: var(--color-white);
    cursor: pointer;
  }
  .check input {
    width: 1.15rem;
    height: 1.15rem;
    accent-color: var(--color-primary);
  }
  .notice {
    padding: 0.85rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.92rem;
    background: var(--color-white);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }
</style>
