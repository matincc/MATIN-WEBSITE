---
/**
 * Newsletter sign-up (email only).
 * PUBLIC_NEWSLETTER_MODE=brevo → sent to /api/newsletter (Brevo, double opt-in).
 * Otherwise (default) → stored in Netlify Forms ("newsletter").
 *
 * While settings `formsEnabled` is false (submissions don't reach Matin yet), the form
 * stays in the HTML but hidden — so Netlify can still detect it — and a short
 * "opens soon" note is shown instead.
 */
import { PUBLIC_NEWSLETTER_MODE } from 'astro:env/client';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { getSettings } from '@/lib/content';

interface Props {
  lang: UiLang;
  compact?: boolean;
  id: string;
}
const { lang, compact = false, id } = Astro.props;
const t = useTranslations(lang);
const { formsEnabled } = await getSettings();
---

{!formsEnabled && (
  <p class:list={['newsletter-closed', compact && 'newsletter-closed--compact']}>
    {t('newsletter.closed')}
  </p>
)}
<form
  class:list={['newsletter', compact && 'newsletter--compact']}
  name="newsletter"
  method="post"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-newsletter
  hidden={!formsEnabled}
  inert={!formsEnabled}
  data-mode={PUBLIC_NEWSLETTER_MODE}
  data-msg-email={t('form.errEmail')}
  data-msg-consent={t('form.errConsent')}
  data-msg-success={
    PUBLIC_NEWSLETTER_MODE === 'brevo' ? t('newsletter.success') : t('newsletter.successDirect')
  }
  data-msg-error={t('newsletter.error')}
  data-msg-sending={t('form.sending')}
>
  <input type="hidden" name="form-name" value="newsletter" />
  <input type="hidden" name="lang" value={lang} />
  <p class="hidden" aria-hidden="true">
    <label>
      Ne pas remplir / Do not fill <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="newsletter__row">
    <label for={`${id}-email`} class:list={[compact ? 'sr-only' : 'newsletter__label']}>
      {t('newsletter.emailLabel')}
    </label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={t('newsletter.emailPlaceholder')}
      class="newsletter__input"
      dir="auto"
    />
    <button type="submit" class="btn btn-primary shrink-0">
      {t('newsletter.submit')}
    </button>
  </div>
  <div class="newsletter__consent">
    <input id={`${id}-consent`} type="checkbox" name="consent" required />
    <!-- prettier-ignore -->
    <label for={`${id}-consent`}>{t('newsletter.consent')} <a href={href('privacy', lang)}>{t('newsletter.privacyLink')}</a>.</label>
  </div>
  <p class="newsletter__status" role="status" aria-live="polite" tabindex="-1"></p>
</form>

<script>
  import { enhanceNewsletters } from '@/scripts/forms';
  enhanceNewsletters();
</script>

<style>
  .newsletter {
    container-type: inline-size;
  }
  .newsletter__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }
  @container (min-width: 400px) {
    .newsletter__row {
      grid-template-columns: 1fr auto;
    }
    .newsletter__label {
      grid-column: 1 / -1;
    }
  }
  .newsletter__label {
    font-weight: 700;
    font-size: 0.95rem;
    color: inherit;
  }
  .newsletter__input {
    min-height: 3.1rem;
    width: 100%;
    border-radius: 999px;
    padding-inline: 1.25rem;
    background: var(--color-white);
    color: var(--color-ink);
    border: 1.5px solid color-mix(in srgb, var(--color-primary) 45%, transparent);
  }
  .newsletter__input::placeholder {
    color: var(--color-muted);
  }
  .newsletter__input:focus-visible {
    border-color: var(--color-primary);
  }
  .newsletter__consent {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: 0.9rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .newsletter__consent input {
    margin-top: 0.2rem;
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
    accent-color: var(--color-primary);
  }
  :global(.on-terracotta) .newsletter__consent input {
    accent-color: var(--color-primary);
  }
  :global(.on-dark) .newsletter__consent input {
    accent-color: var(--color-gold);
  }
  /* In the blue footer the submit button is white with blue text. */
  .newsletter__consent a {
    color: inherit;
    font-weight: 700;
  }
  .newsletter__status:not(:empty) {
    margin-top: 0.75rem;
    font-weight: 700;
  }
  .newsletter-closed {
    padding: 0.9rem 1.1rem;
    border-radius: 0.9rem;
    font-weight: 600;
    background: var(--color-tint);
    color: var(--color-ink);
    border-inline-start: 4px solid var(--color-gold);
  }
  .newsletter-closed--compact {
    background: var(--color-white);
  }
</style>
