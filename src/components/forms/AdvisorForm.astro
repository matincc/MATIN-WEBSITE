---
/**
 * Matin Advisory Circle application (owner's request, Oct 31 2026). Netlify form
 * « conseillers » (multipart, for the CV): first and last name, email, phone, country,
 * city, highest degree, discipline, expertise, areas, working languages, LinkedIn,
 * motivation, CV (required, PDF or Word, 5 MB at most), then three commitments (terms,
 * no employment, three-year register) and the privacy consent. No photo (Law 25: only
 * what is needed). The terms are shown in full just above the commitments.
 * Values for degree, areas and languages are sent in English so every Sheet row reads alike.
 */
import FormShell from './FormShell.astro';
import Field from './Field.astro';
import { href, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { countryNames } from '@/lib/countries';
import {
  advisorStrings,
  advisorsAnchor,
  AREA_VALUES,
  DEGREE_VALUES,
} from '@/i18n/advisors';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = advisorStrings(lang);
const countries = countryNames(lang);
const degreeLabels = a.degrees.split('|');
const areaLabels = a.areaNames.split('|');
const LANGUAGES = ['French', 'English', 'Persian', 'Arabic', 'Spanish', 'Chinese', 'Other'] as const;
const req = ` (${t('form.required')})`;
---

<FormShell
  lang={lang}
  name="conseillers"
  id="advisor"
  action={`${href('contact', lang)}?sent=1#${advisorsAnchor(lang)}`}
  submitLabel={a.submit}
  consentText={a.consent}
  successMessage={a.success}
  multipart
>
  <div class="grid gap-5 sm:grid-cols-2">
    <Field lang={lang} id="adv-first" name="first_name" label={a.firstName} required autocomplete="given-name" />
    <Field lang={lang} id="adv-last" name="last_name" label={a.lastName} required autocomplete="family-name" />
    <Field lang={lang} id="adv-email" name="email" type="email" label={t('form.email')} required autocomplete="email" />
    <Field lang={lang} id="adv-phone" name="phone" type="tel" label={a.phone} autocomplete="tel" />
    <div class="field">
      <label for="adv-country" class="field-label" data-short={t('form.country')}>
        <span data-label-text>{t('form.country')}</span><span class="req">{req}</span>
      </label>
      <input
        id="adv-country"
        name="country"
        type="text"
        class="input"
        list="adv-country-list"
        autocomplete="country-name"
        required
        aria-describedby="adv-country-error"
      />
      <datalist id="adv-country-list">
        {countries.map((c) => <option value={c} />)}
      </datalist>
      <p id="adv-country-error" class="field-error" hidden></p>
    </div>
    <Field lang={lang} id="adv-city" name="city" label={t('form.city')} autocomplete="address-level2" />
    <div class="field">
      <label for="adv-degree" class="field-label" data-short={a.degree}>
        <span data-label-text>{a.degree}</span><span class="req">{req}</span>
      </label>
      <select id="adv-degree" name="degree" class="input" required aria-describedby="adv-degree-error">
        <option value="">{a.degreeChoose}</option>
        {DEGREE_VALUES.map((v, i) => <option value={v}>{degreeLabels[i]}</option>)}
      </select>
      <p id="adv-degree-error" class="field-error" hidden></p>
    </div>
    <Field lang={lang} id="adv-discipline" name="discipline" label={a.discipline} required />
  </div>

  <div class="field">
    <label for="adv-expertise" class="field-label" data-short={a.expertise}>
      <span data-label-text>{a.expertise}</span><span class="req">{req}</span>
    </label>
    <p id="adv-expertise-hint" class="adv-hint">{a.expertiseHint}</p>
    <textarea
      id="adv-expertise"
      name="expertise"
      class="input adv-textarea"
      required
      aria-describedby="adv-expertise-hint adv-expertise-error"
    ></textarea>
    <p id="adv-expertise-error" class="field-error" hidden></p>
  </div>

  <fieldset class="field adv-group">
    <legend class="field-label">{a.areas}</legend>
    <ul class="adv-choices">
      {AREA_VALUES.map((v, i) => (
        <li>
          <input type="checkbox" id={`adv-area-${i}`} name="areas" value={v} class="size-5 accent-primary" />
          <label for={`adv-area-${i}`}>{areaLabels[i]}</label>
        </li>
      ))}
    </ul>
  </fieldset>

  <fieldset class="field adv-group" aria-describedby="adv-lang-0-error">
    <legend class="field-label">
      {a.languages} <span class="req">({t('form.required')})</span>
    </legend>
    <ul class="adv-choices">
      {LANGUAGES.map((l, i) => (
        <li>
          <input
            type="checkbox"
            id={`adv-lang-${i}`}
            name="languages"
            value={l}
            class="size-5 accent-primary"
            data-group-required={i === 0 ? '' : undefined}
          />
          <label for={`adv-lang-${i}`}>{t(`form.languageNames.${l}`)}</label>
        </li>
      ))}
    </ul>
    <p id="adv-lang-0-error" class="field-error" hidden></p>
  </fieldset>

  <div class="grid gap-5 sm:grid-cols-2">
    <Field lang={lang} id="adv-linkedin" name="linkedin" type="url" label={a.linkedin} />
  </div>
  <Field lang={lang} id="adv-motivation" name="motivation" as="textarea" label={a.motivation} class="adv-motivation" />

  <div class="field">
    <label for="adv-cv" class="field-label" data-short={a.cv}>
      <span data-label-text>{a.cv}</span><span class="req">{req}</span>
    </label>
    <p id="adv-cv-hint" class="adv-hint">{a.cvHint}</p>
    <input
      id="adv-cv"
      name="cv"
      type="file"
      class="input adv-file"
      required
      accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      data-max-bytes="5242880"
      data-msg-too-big={a.cvTooBig}
      data-msg-type={a.cvType}
      aria-describedby="adv-cv-hint adv-cv-error"
    />
    <p id="adv-cv-error" class="field-error" hidden></p>
  </div>

  <details class="adv-terms">
    <summary>{a.termsTitle}</summary>
    <ol>
      {a.terms.split('\n').map((line) => <li>{line}</li>)}
    </ol>
  </details>

  {[
    { id: 'adv-terms', name: 'accept_terms', text: a.acceptTerms },
    { id: 'adv-noemp', name: 'no_employment', text: a.noEmployment },
    { id: 'adv-keep', name: 'retention', text: a.retention },
  ].map((c) => (
    <div class="field">
      <div class="flex items-start gap-3">
        <input
          id={c.id}
          type="checkbox"
          name={c.name}
          value="yes"
          required
          class="mt-1 size-5 shrink-0 accent-primary"
          aria-describedby={`${c.id}-error`}
        />
        <label for={c.id} class="text-sm leading-relaxed" data-short={c.text.split(/[,.]/)[0]}>
          {c.text} <span class="text-muted">({t('form.required')})</span>
        </label>
      </div>
      <p id={`${c.id}-error`} class="field-error" hidden></p>
    </div>
  ))}
</FormShell>

<style>
  .adv-hint {
    margin-block-end: 0.4rem;
    font-size: 0.95rem;
    color: var(--color-ink);
  }
  .adv-textarea {
    min-height: 8rem;
  }
  .adv-motivation :global(textarea) {
    min-height: 6rem;
  }
  .adv-file {
    padding-block: 0.6rem;
    cursor: pointer;
    background: var(--color-white);
  }
  .adv-group {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .adv-group legend {
    margin-block-end: 0.6rem;
    padding: 0;
  }
  .adv-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .adv-choices li {
    position: relative;
  }
  .adv-choices label {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.45rem;
    padding-inline: 2.4rem 1rem;
    border: 1.5px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
    border-radius: 999px;
    background: var(--color-white);
    cursor: pointer;
  }
  .adv-choices input {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.85rem;
    transform: translateY(-50%);
  }
  .adv-choices input:checked + label {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--matin-soleil) 24%, var(--color-white));
    font-weight: 600;
  }
  .adv-choices input:focus-visible + label {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .adv-terms {
    padding: 1rem 1.25rem;
    border-radius: 0.9rem;
    background: var(--color-white);
    border-inline-start: 5px solid var(--matin-soleil);
  }
  .adv-terms summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--matin-encre);
  }
  .adv-terms ol {
    margin-block-start: 0.75rem;
    padding-inline-start: 1.25rem;
    list-style: decimal;
    display: grid;
    gap: 0.5rem;
    line-height: 1.6;
  }
</style>
