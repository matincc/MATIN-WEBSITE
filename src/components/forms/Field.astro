---
/** Labelled form field with an associated (initially hidden) error message. */
import type { HTMLAttributes } from 'astro/types';
import type { UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';

interface Props {
  lang: UiLang;
  id: string;
  name: string;
  label: string;
  as?: 'input' | 'textarea' | 'select';
  type?: HTMLAttributes<'input'>['type'];
  required?: boolean;
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  options?: string[];
  placeholderOption?: string;
  /** Required only when another field has a value, e.g. "requester_type=organization". */
  requiredWhen?: string;
  /** Another label while another field has a value (the form script swaps it). */
  labelWhen?: { when: string; label: string };
  class?: string;
  /** Longest answer accepted (default 2000 for text boxes, 200 for fields). */
  maxlength?: number;
}
const {
  lang,
  id,
  name,
  label,
  as = 'input',
  type = 'text',
  required = false,
  autocomplete,
  options = [],
  placeholderOption,
  requiredWhen,
  labelWhen,
  class: className = '',
  maxlength,
} = Astro.props;
const t = useTranslations(lang);
const errorId = `${id}-error`;
---

<div class:list={['field', className]}>
  <label
    for={id}
    class="field-label"
    data-short={label}
    data-label-when={labelWhen?.when}
    data-label-alt={labelWhen?.label}
  >
    <span data-label-text>{label}</span>
    {(required || requiredWhen) && (
      <span class="req" hidden={!required} data-req-mark>
        {' '}
        ({t('form.required')})
      </span>
    )}
  </label>
  {as === 'textarea' ? (
    <textarea id={id} name={name} class="input" required={required} aria-describedby={errorId} maxlength={maxlength ?? 2000} />
  ) : as === 'select' ? (
    <select id={id} name={name} class="input" required={required} aria-describedby={errorId}>
      {placeholderOption !== undefined && <option value="">{placeholderOption}</option>}
      {options.map((o) => (
        <option value={o}>{o}</option>
      ))}
    </select>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      class="input"
      required={required}
      data-required-when={requiredWhen}
      autocomplete={autocomplete}
      aria-describedby={errorId}
      maxlength={maxlength ?? 200}
    />
  )}
  <p id={errorId} class="field-error" hidden></p>
</div>
