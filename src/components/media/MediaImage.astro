---
/**
 * One photograph of the image registry (src/lib/media.ts), named by its slot. Local files
 * go through Astro's optimizer; temporary Unsplash photos are loaded from Unsplash's image
 * server at the sizes the slot needs, cropped to the slot's shape around faces. A
 * temporary photo always carries the « Photo temporaire » label; every photo carries its
 * credit (photographer, source, licence).
 */
import { Picture } from 'astro:assets';
import type { UiLang } from '@/i18n/routes';
import { livingStrings } from '@/i18n/living';
import { media, unsplashUrl, type MediaEntry, type MediaSlot } from '@/lib/media';

interface Props {
  slot: MediaSlot;
  lang: UiLang;
  /** Width / height of the frame, e.g. 4 / 5. */
  ratio: number;
  sizes: string;
  /** Widths offered to the browser. */
  widths?: number[];
  /** Illustrative photos are decorative (alt="", CLAUDE.md); pass a text only if meaningful. */
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  /** Where the label and credit sit: over the photo (default), under it, or nowhere when
      the section lists the credits together (<MediaCredits>). */
  credit?: 'overlay' | 'below' | 'none';
}
const {
  slot,
  lang,
  ratio,
  sizes,
  widths = [480, 800, 1200, 1600],
  alt = '',
  class: className,
  loading = 'lazy',
  credit = 'overlay',
} = Astro.props;
const l = livingStrings(lang);
const m: MediaEntry = media[slot];
const largest = widths[widths.length - 1];
const creditText = l.photoCredit
  .replace('{author}', m.credit.author)
  .replace('{source}', m.credit.sourceName);
---

<figure
  class:list={['media', `media--${credit}`, m.temporary && 'media--temp', className]}
  style={`--ratio:${ratio}`}
>
  <div class="media__frame">
    {m.unsplash ? (
      <img
        src={unsplashUrl(m.unsplash, Math.min(1200, largest), ratio)}
        srcset={widths.map((w) => `${unsplashUrl(m.unsplash!, w, ratio)} ${w}w`).join(', ')}
        sizes={sizes}
        alt={alt}
        width={largest}
        height={Math.round(largest / ratio)}
        loading={loading}
        decoding="async"
        style={m.focus ? `object-position:${m.focus}` : undefined}
      />
    ) : (
      m.src && (
        <Picture
          src={m.src}
          alt={alt}
          formats={['avif', 'webp']}
          widths={widths.filter((w) => w <= m.src!.width)}
          sizes={sizes}
          loading={loading}
          style={m.focus ? `object-position:${m.focus}` : undefined}
        />
      )
    )}
  </div>
  {credit !== 'none' && (
    <figcaption class="media__credit">
      {m.temporary && <span class="media__temp">{l.tempPhoto}</span>}
      <a href={m.credit.authorUrl ?? m.credit.source} target="_blank" rel="noopener noreferrer">
        {creditText}
      </a>
      <span aria-hidden="true">·</span>
      <a href={m.credit.licenseUrl} target="_blank" rel="noopener noreferrer license">
        {m.credit.licenseKey === 'unsplash' ? l.unsplashLicense : m.credit.license}
      </a>
    </figcaption>
  )}
</figure>

<style>
  .media {
    position: relative;
    margin: 0;
  }
  .media__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    border-radius: inherit;
    /* Shown while the photo loads, and if it cannot load. */
    background: var(--living-sand);
  }
  .media__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* The temporary label: a small, honest tag at the start of the credit. */
  .media__temp {
    margin-inline-end: 0.2rem;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background: var(--living-gold);
    color: var(--living-charcoal);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .media__credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 0.4rem;
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .media__credit a {
    color: inherit;
    text-decoration: none;
  }
  .media__credit a:hover,
  .media__credit a:focus-visible {
    text-decoration: underline;
  }
  .media--overlay .media__credit {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-end: 0.6rem;
    max-width: calc(100% - 1.2rem);
    padding: 0.2rem 0.6rem 0.2rem 0.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--living-charcoal) 62%, transparent);
    color: var(--matin-white);
  }
  .media--below .media__credit {
    margin-block-start: 0.5rem;
    color: var(--living-charcoal);
  }
</style>
