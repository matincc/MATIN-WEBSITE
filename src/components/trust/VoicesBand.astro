---
/**
 * Words of participants (owner's request, Oct 30 2026): quotes from src/content/testimonials/,
 * each published with the person's consent, first name only, in the language it was said in
 * unless a translation is given. While there are none, a warm invitation to share one.
 * Above them, the three newest clips of « My Story in 15 Seconds » (owner's request,
 * Oct 31 2026), with links to all stories and to the upload form.
 */
import { getCollection } from 'astro:content';
import { Quote } from '@lucide/astro';
import { href, type UiLang } from '@/i18n/routes';
import { pick, useTranslations } from '@/i18n/ui';
import StoryClip from '@/components/stories/StoryClip.astro';
import { storyStrings } from '@/i18n/stories';
import { getStories } from '@/lib/stories';

interface Props {
  lang: UiLang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const quotes = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((q) => {
    const own = q.data.quote[lang];
    const shownLang = own ? lang : q.data.original;
    return { ...q.data, text: own ?? q.data.quote[q.data.original] ?? '', shownLang };
  })
  .filter((q) => q.text);
const clips = await getStories(3);
const st = storyStrings(lang);
const storiesHref = href('stories', lang);
---

<section class="voices" aria-labelledby="voices-title">
  <div class:list={['container-site', { 'voices--empty': !quotes.length && !clips.length }]}>
    {clips.length > 0 ? (
      <div class="voices__clips-wrap">
        <div class="voices__intro">
          <h2 id="voices-title" class="voices__title">{t('home.voicesTitle')}</h2>
          <p class="voices__lede">{st.lede}</p>
          <p class="voices__links">
            <a href={`${storiesHref}#stories`} class="voices__cta">{st.seeAll}</a>
            <a href={`${storiesHref}#share`} class="voices__cta voices__cta--quiet">{st.shareCta}</a>
          </p>
        </div>
        <ul class="voices__clips">
          {clips.map((c, i) => (
            <li>
              <StoryClip lang={lang} story={c} index={i} />
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <h2 id="voices-title" class="voices__title">{t('home.voicesTitle')}</h2>
    )}
    {
      quotes.length ? (
        <ul class="voices__list">
          {quotes.map((q) => (
            <li class="voice">
              <Quote size={28} class="voice__mark" aria-hidden="true" />
              <blockquote lang={q.shownLang} dir={q.shownLang === 'fa' ? 'rtl' : 'ltr'}>
                <p>{q.text}</p>
              </blockquote>
              <p class="voice__who">
                {q.firstName}
                {pick(q.context, lang) && <span> · {pick(q.context, lang)}</span>}
              </p>
            </li>
          ))}
        </ul>
      ) : clips.length ? null : (
        <div class="voices__empty">
          <Quote size={36} class="voice__mark" aria-hidden="true" />
          <p>{t('home.voicesEmpty')}</p>
          <p class="voices__links">
            <a href={`${href('contact', lang)}#write`} class="voices__cta">
              {t('home.voicesCta')}
            </a>
            <a href={`${storiesHref}#share`} class="voices__cta voices__cta--quiet">
              {st.nav}
            </a>
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .voices {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .voices__title {
    margin-block-end: 1.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 700;
    color: var(--matin-encre);
  }
  :global(html[lang='fa']) .voices__title {
    font-weight: 800;
  }
  .voices__list {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .voice,
  .voices__empty {
    display: grid;
    gap: 0.9rem;
    padding: 1.75rem;
    background: var(--matin-white);
    border: 1px solid var(--color-card-edge);
    border-radius: 1rem;
    border-end-start-radius: 2.75rem;
  }
  /* While there are no quotes: the title on the reading side, the invitation beside it. */
  @media (min-width: 64rem) {
    .voices--empty {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: center;
      gap: 3rem;
    }
    .voices--empty .voices__title {
      margin: 0;
    }
  }
  .voices__empty {
    max-width: 46rem;
    background: var(--matin-firouzeh-pale);
    border-color: transparent;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--matin-encre);
  }
  .voices :global(.voice__mark) {
    color: var(--matin-brique);
  }
  .voice blockquote p {
    font-family: var(--font-editorial);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--matin-encre);
  }
  .voice__who {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--matin-firouzeh-ink);
  }
  .voice__who span {
    font-weight: 600;
    color: var(--matin-ink);
  }
  .voices__cta {
    justify-self: start;
    padding: 0.6rem 1.3rem;
    border-radius: 999px;
    background: var(--matin-brique-ink);
    color: var(--matin-white);
    font-family: var(--font-display);
    font-weight: 800;
    text-decoration: none;
  }
  .voices__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .voices__cta--quiet {
    background: transparent;
    color: var(--matin-encre);
    box-shadow: inset 0 0 0 2px var(--matin-firouzeh-ink);
  }
  .voices__clips-wrap {
    display: grid;
    gap: 2rem;
    margin-block-end: 2.5rem;
  }
  .voices__intro {
    display: grid;
    gap: 1.25rem;
    align-content: center;
  }
  .voices__intro .voices__title {
    margin: 0;
  }
  .voices__lede {
    max-width: 32rem;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--matin-ink);
  }
  .voices__clips {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (min-width: 64rem) {
    .voices__clips-wrap {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 3.5rem;
      align-items: center;
    }
  }
  @media (max-width: 40rem) {
    .voices__clips {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 72%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-block-end: 0.5rem;
    }
    .voices__clips li {
      scroll-snap-align: start;
    }
  }
  .voices__cta:hover {
    background: var(--matin-encre);
    color: var(--matin-white);
  }
</style>
