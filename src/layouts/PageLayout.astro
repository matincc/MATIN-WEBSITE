---
/**
 * Layout for every inner page: banner with breadcrumbs, title and intro,
 * then the page content. Breadcrumb structured data is added automatically.
 * Banner (scheme A, Oct 29 2026): sable ground, the title in the editorial serif, and on
 * the end side the logo's sun rising over the horizon with a second circle in the
 * section's colour (`accent`), the two shapes of cultures in dialogue.
 */
import { ChevronRight } from '@lucide/astro';
import BaseLayout from './BaseLayout.astro';
import LeafRule from '@/components/brand/LeafRule.astro';
import { href, type Alternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { breadcrumbJsonLd } from '@/lib/seo';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  lang: UiLang;
  /** Visible H1. */
  title: string;
  /** <title> when different from the H1. */
  metaTitle?: string;
  description?: string;
  lede?: string;
  /** A slightly larger, medium-weight intro (Events, Contact). */
  ledeStrong?: boolean;
  eyebrow?: string;
  alternates: Alternates;
  /** Intermediate crumbs between "Home" and the current page. */
  crumbs?: Crumb[];
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'event';
  jsonLd?: object[];
  noindex?: boolean;
  searchable?: boolean;
  /** Colour of the circle beside the sun: brique (events, gallery, contact), firouzeh
      (default: about, news, programs), encre (team, resources). */
  accent?: 'brique' | 'firouzeh' | 'encre';
}

const {
  lang,
  title,
  metaTitle,
  description,
  lede,
  ledeStrong = false,
  eyebrow,
  alternates,
  crumbs = [],
  image,
  imageAlt,
  type,
  jsonLd = [],
  noindex,
  searchable = true,
  accent = 'firouzeh',
} = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const trail = [
  { label: t('common.home'), href: href('home', lang) },
  ...crumbs,
  { label: title, href: alternates[lang] ?? alternates.en },
];
// Every banner is compact like About's (owner, Nov 1 2026: « too much empty space
// between the navy menu and the page's text; only About's spacing is good »).
const compact = true;
---

<BaseLayout
  lang={lang}
  title={metaTitle ?? title}
  description={description ?? lede}
  alternates={alternates}
  image={image}
  imageAlt={imageAlt}
  type={type}
  noindex={noindex}
  searchable={searchable}
  jsonLd={[
    breadcrumbJsonLd(
      trail.map((c) => ({ name: c.label, url: c.href })),
      site,
    ),
    ...jsonLd,
  ]}
>
  <section
    class:list={['page-head', compact ? 'page-head--compact' : 'mb-12']}
    data-accent-ground={accent}
    aria-labelledby="page-title"
  >
    <div class="container-site page-head__inner">
      <nav aria-label={t('a11y.breadcrumbs')} class="mb-4">
        <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[0.95rem] text-muted">
          {trail.map((c, i) => {
            const last = i === trail.length - 1;
            return (
              <li class="flex items-center gap-1.5">
                {i > 0 && (
                  <ChevronRight size={14} class="flip-rtl text-gold-dark" aria-hidden="true" />
                )}
                {last ? (
                  <span aria-current="page" class="font-semibold text-ink">
                    {c.label}
                  </span>
                ) : (
                  <a
                    href={c.href}
                    class="text-muted underline-offset-4 hover:text-ink hover:underline"
                  >
                    {c.label}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </nav>
      <div class:list={['page-head__grid', lede && 'page-head__grid--split']}>
        <div>
          {eyebrow && <p class="eyebrow eyebrow--teal mb-3">{eyebrow}</p>}
          <h1 id="page-title" class="page-head__title">
            {title}
          </h1>
          <LeafRule class="mt-6 w-44" />
        </div>
        {lede && (
          <p class:list={['lede page-head__lede', ledeStrong && 'page-head__lede--strong']}>
            {lede}
          </p>
        )}
      </div>
      <slot name="hero" />
    </div>
    <div class="page-head__art" aria-hidden="true">
      <span class="page-head__circle"></span>
      <span class="page-head__sun"></span>
    </div>
  </section>

  <slot />
</BaseLayout>

<style>
  /* Inner page banner (scheme A): apricot dawn ground (warmer, owner's request Oct 29
     2026) closed by a navy horizon line; title in
     the editorial serif on the reading side, lede beside it on wide screens; the sun and
     a second circle rise on the horizon at the end side. */
  .page-head {
    --head-accent: var(--color-firouzeh);
    position: relative;
    overflow: hidden;
    background: var(--color-aube);
    border-block-end: 3px solid var(--color-primary);
  }
  .page-head[data-accent-ground='brique'] {
    --head-accent: var(--color-brique);
  }
  .page-head[data-accent-ground='encre'] {
    --head-accent: var(--color-primary);
  }
  .page-head__inner {
    position: relative;
    z-index: 1;
    padding-block: 2.5rem clamp(5.5rem, 3.5rem + 5vw, 6.5rem);
  }
  .page-head__title {
    max-width: 52rem;
    font-family: var(--font-editorial);
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.75rem);
    font-weight: 700;
    font-variation-settings:
      'SOFT' 100,
      'opsz' 144;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    text-wrap: balance;
  }
  :global(html[lang='fa']) .page-head__title {
    font-weight: 800;
    font-variation-settings: normal;
    line-height: 1.3;
  }
  .page-head__grid {
    display: grid;
    gap: 1.75rem;
  }
  /* The line beside the big title, larger so the two balance (owner, Oct 31 2026: it was
     far too small next to the title). */
  .page-head__lede,
  .page-head__lede--strong {
    max-width: 40rem;
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.95rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--matin-encre);
    text-wrap: pretty;
  }
  /* The sun and its companion circle sit on the horizon, cut by it: a sunrise. */
  .page-head__art {
    --sun: clamp(7rem, 4rem + 11vw, 17rem);
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: max(1rem, calc((100% - 90rem) / 2 + 2rem));
    width: calc(var(--sun) * 1.55);
    height: calc(var(--sun) * 0.5);
    overflow: hidden;
    pointer-events: none;
  }
  .page-head__sun,
  .page-head__circle {
    position: absolute;
    inset-block-start: 0;
    border-radius: 50%;
  }
  .page-head__sun {
    inset-inline-end: 0;
    width: var(--sun);
    height: var(--sun);
    background: var(--color-soleil);
  }
  .page-head__circle {
    inset-inline-start: 0;
    inset-block-start: calc(var(--sun) * 0.12);
    width: calc(var(--sun) * 0.76);
    height: calc(var(--sun) * 0.76);
    background: var(--head-accent);
  }
  .page-head--compact .page-head__inner,
  .page-head--compact .page-head__inner:not(#o) {
    padding-block: 1.5rem 2.25rem;
  }
  .page-head--compact nav {
    margin-block-end: 1rem;
  }
  .page-head--compact .page-head__grid {
    gap: 1rem;
  }
  .page-head--compact .page-head__lede {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.55rem);
  }
  .page-head--compact .page-head__art {
    --sun: clamp(5rem, 3rem + 6vw, 10rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .page-head__sun {
      animation: sunrise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both;
    }
    .page-head__circle {
      animation: sunrise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }
  @keyframes sunrise {
    from {
      transform: translateY(45%);
    }
    to {
      transform: none;
    }
  }
  @media (min-width: 64rem) {
    .page-head__grid--split {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }
    .page-head__lede {
      padding-block-end: 0.5rem;
    }
    .page-head__inner {
      padding-block-end: clamp(5rem, 2rem + 6vw, 9.5rem);
    }
  }

  /* ---------- Warm banner (owner, Nov 1 2026: « the cream looks pale; a very warm
     colour ») ----------
     Deep terracotta with white title and lede, saffron sun, and a warm apricot ground
     under the page's own sections. White on brique-ink 6.4:1. */
  .page-head:not(#o) {
    background: var(--matin-brique-ink);
    border-block-end-color: var(--matin-soleil);
  }
  .page-head:not(#o) .page-head__title,
  .page-head:not(#o) .page-head__lede {
    color: var(--matin-white);
  }
  .page-head:not(#o) nav :is(a, span) {
    color: var(--matin-white);
  }
  .page-head:not(#o) nav :global(svg) {
    color: var(--matin-soleil);
  }
  .page-head:not(#o) nav a:focus-visible {
    outline-color: var(--matin-soleil);
  }
  .page-head[data-accent-ground]:not(#o) {
    --head-accent: var(--matin-firouzeh);
  }
  .page-head[data-accent-ground='firouzeh']:not(#o) {
    --head-accent: var(--matin-encre);
  }
  :global(body:has(.page-head)) {
    background: color-mix(in srgb, var(--matin-brique) 10%, color-mix(in srgb, var(--matin-soleil) 24%, var(--matin-ivoire)));
  }
</style>
