---
/**
 * Layout for every inner page: banner with breadcrumbs, title and intro,
 * then the page content. Breadcrumb structured data is added automatically.
 */
import { ChevronRight } from '@lucide/astro';
import BaseLayout from './BaseLayout.astro';
import LeafRule from '@/components/brand/LeafRule.astro';
import { href, type Alternates, type UiLang } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { breadcrumbJsonLd } from '@/lib/seo';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  lang: UiLang;
  /** Visible H1. */
  title: string;
  /** <title> when different from the H1. */
  metaTitle?: string;
  description?: string;
  lede?: string;
  eyebrow?: string;
  alternates: Alternates;
  /** Intermediate crumbs between "Home" and the current page. */
  crumbs?: Crumb[];
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'event';
  jsonLd?: object[];
  noindex?: boolean;
  searchable?: boolean;
}

const {
  lang,
  title,
  metaTitle,
  description,
  lede,
  eyebrow,
  alternates,
  crumbs = [],
  image,
  imageAlt,
  type,
  jsonLd = [],
  noindex,
  searchable = true,
} = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(Astro.url.origin);
const trail = [
  { label: t('common.home'), href: href('home', lang) },
  ...crumbs,
  { label: title, href: alternates[lang] ?? alternates.en },
];
---

<BaseLayout
  lang={lang}
  title={metaTitle ?? title}
  description={description ?? lede}
  alternates={alternates}
  image={image}
  imageAlt={imageAlt}
  type={type}
  noindex={noindex}
  searchable={searchable}
  jsonLd={[
    breadcrumbJsonLd(
      trail.map((c) => ({ name: c.label, url: c.href })),
      site,
    ),
    ...jsonLd,
  ]}
>
  <section class="page-head mb-12" aria-labelledby="page-title">
    <div class="container-site page-head__inner">
      <nav aria-label={t('a11y.breadcrumbs')} class="mb-8">
        <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[0.95rem] text-muted">
          {trail.map((c, i) => {
            const last = i === trail.length - 1;
            return (
              <li class="flex items-center gap-1.5">
                {i > 0 && (
                  <ChevronRight size={14} class="flip-rtl text-gold-dark" aria-hidden="true" />
                )}
                {last ? (
                  <span aria-current="page" class="font-semibold text-ink">
                    {c.label}
                  </span>
                ) : (
                  <a
                    href={c.href}
                    class="text-muted underline-offset-4 hover:text-ink hover:underline"
                  >
                    {c.label}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </nav>
      <div class:list={['page-head__grid', lede && 'page-head__grid--split']}>
        <div>
          {eyebrow && <p class="eyebrow eyebrow--terracotta mb-3">{eyebrow}</p>}
          <h1 id="page-title" class="page-head__title">
            {title}
          </h1>
          <LeafRule class="mt-6 w-44" />
        </div>
        {lede && <p class="lede page-head__lede">{lede}</p>}
      </div>
      <slot name="hero" />
    </div>
    <div class="mosaic page-head__mosaic" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </section>

  <slot />
</BaseLayout>

<style>
  /* Inner page banner: warm cream, title on the reading side, lede beside it on wide
     screens, and the four-colour mosaic along the bottom edge. */
  .page-head {
    position: relative;
    background: var(--color-tint);
  }
  .page-head__inner {
    padding-block: 2.5rem clamp(3rem, 2rem + 3vw, 4.75rem);
  }
  .page-head__title {
    max-width: 52rem;
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.5rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.015em;
  }
  .page-head__grid {
    display: grid;
    gap: 1.75rem;
  }
  .page-head__lede {
    max-width: 40rem;
  }
  @media (min-width: 64rem) {
    .page-head__grid--split {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }
    .page-head__lede {
      padding-block-end: 0.5rem;
    }
  }
  .page-head__mosaic {
    gap: 0;
    height: 0.4rem;
  }
  .page-head__mosaic > span {
    border-radius: 0;
  }
</style>
