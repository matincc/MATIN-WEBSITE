---
import '@/styles/global.css';
import nunito from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import dmSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import playfair800 from '@fontsource/playfair-display/files/playfair-display-latin-800-normal.woff2?url';
import SEO from '@/components/layout/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import BackToTop from '@/components/layout/BackToTop.astro';
import CookieBanner from '@/components/layout/CookieBanner.astro';
import { isRtl, type Alternates, type UiLang } from '@/i18n/routes';
import { faFallbackNotice } from '@/i18n/fa';
import { useTranslations } from '@/i18n/ui';
import { getSettings } from '@/lib/content';
import { organizationJsonLd } from '@/lib/seo';

interface Props {
  lang: UiLang;
  /** Page title without the site name (omit on the home page). */
  title?: string;
  description?: string;
  /** Equivalent URL of this page in each language (toggle + hreflang). */
  alternates: Alternates;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'event';
  noindex?: boolean;
  jsonLd?: object[];
  /** Hide the footer newsletter when the page already has one. */
  footerNewsletter?: boolean;
  /** Include this page in the site search index (Pagefind). */
  searchable?: boolean;
}

const {
  lang,
  title,
  description,
  alternates,
  image,
  imageAlt,
  type,
  noindex,
  jsonLd = [],
  footerNewsletter = true,
  searchable = true,
} = Astro.props;
const t = useTranslations(lang);
const settings = await getSettings();
const fullTitle = title ? `${title} | ${t('meta.siteName')}` : t('meta.homeTitle');
const site = Astro.site ?? new URL(Astro.url.origin);
const htmlLang = lang === 'fr' ? 'fr-CA' : lang === 'en' ? 'en-CA' : 'fa';
---

<!doctype html>
<html lang={htmlLang} dir={isRtl(lang) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#243B50" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={nunito} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfair800} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t('meta.siteName')} — ${t('nav.news')}`}
      href={`/${lang}/rss.xml`}
    />
    <SEO
      lang={lang}
      title={fullTitle}
      description={description ?? t('meta.defaultDescription')}
      alternates={alternates}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      jsonLd={[organizationJsonLd(settings, lang, site, t('meta.defaultDescription')), ...jsonLd]}
    />
  </head>
  <body id="top" class="flex min-h-dvh flex-col">
    <script>
      import '@/scripts/bgPreview';
    </script>
    <a href="#main" class="sr-only-focusable btn btn-primary fixed start-3 top-3 z-50">
      {t('a11y.skipToContent')}
    </a>
    <Header lang={lang} alternates={alternates} />
    <main
      id="main"
      tabindex="-1"
      class="outline-none"
      data-pagefind-body={searchable ? '' : undefined}
    >
      {lang !== 'fa' && (
        <div
          class="fa-notice"
          lang="fa"
          dir="rtl"
          role="note"
          hidden
          data-fa-notice
          data-pagefind-ignore
        >
          <p>
            {faFallbackNotice.text} <a href="/fa/">{faFallbackNotice.back}</a>
          </p>
        </div>
      )}
      <slot />
    </main>
    <!-- On short pages, keeps the footer at the bottom of the window. -->
    <div class="flex-1" aria-hidden="true"></div>
    <BackToTop lang={lang} />
    <Footer lang={lang} showNewsletter={footerNewsletter} />
    <CookieBanner lang={lang} />

    <script>
      // Opened from the Persian site (?from=fa): say why the page is not in Persian.
      if (new URL(location.href).searchParams.get('from') === 'fa') {
        const note = document.querySelector<HTMLElement>('[data-fa-notice]');
        if (note) note.hidden = false;
      }

      // Gentle fade-in on scroll. Content is visible by default; only animated when
      // the visitor allows motion and IntersectionObserver exists.
      const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      if (motionOk && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-ready');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .fa-notice {
    padding: 0.75rem 1.25rem;
    text-align: center;
    font-family: Tahoma, 'Segoe UI', system-ui, sans-serif;
    background: var(--color-tint);
    color: var(--color-ink);
    border-block-end: 1px solid var(--color-line);
  }
  .fa-notice a {
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: underline;
  }
</style>
