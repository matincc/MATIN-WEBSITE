# Copy to .env for local development, and set the same names in Netlify:
# Site configuration → Environment variables. Never commit real values.
# Every variable is optional: without them the site still works.

# ── Site ────────────────────────────────────────────────────────────────
# Final domain, used for canonical URLs, the sitemap and social previews.
SITE_URL=https://www.matin-institut.example

# ── Daily rebuild (moves past events every morning) ─────────────────────
# Netlify → Site configuration → Build & deploy → Build hooks → Add build hook.
BUILD_HOOK_URL=

# ── Analytics (loaded only after the visitor accepts) ───────────────────
# none | plausible | ga4. With "none", no cookie banner is shown at all.
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_GA_ID=

# ── Newsletter ──────────────────────────────────────────────────────────
# netlify = sign-ups are stored in Netlify Forms (export them as CSV).
# brevo   = sign-ups go to Brevo with email confirmation (double opt-in).
PUBLIC_NEWSLETTER_MODE=netlify
BREVO_API_KEY=
BREVO_LIST_ID_FR=
BREVO_LIST_ID_EN=
BREVO_DOI_TEMPLATE_ID=

# ── Form notifications (contact, interest, volunteer, newsletter) ───────
# netlify = submissions are stored in Netlify Forms (turn on email notifications
#           to matincc.mtl@gmail.com in Netlify → Forms → Form notifications).
# email   = submissions go to /api/submit, which emails them through Brevo
#           (transactional API, BREVO_API_KEY above) to NOTIFY_TO, with Reply-To set
#           to the visitor, and sends the visitor an acknowledgement.
PUBLIC_FORMS_MODE=netlify
# Sender address, verified in Brevo → Senders, domains & dedicated IPs.
NOTIFY_FROM=
NOTIFY_FROM_NAME=Site web Matin
# Administrative inbox (default: matincc.mtl@gmail.com).
NOTIFY_TO=

# ── Anti-spam (optional) ────────────────────────────────────────────────
# Cloudflare Turnstile. Leave empty to rely on the honeypot + Netlify's spam filter.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Personal access token, used only to delete submissions that fail Turnstile.
NETLIFY_API_TOKEN=
